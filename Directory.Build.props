<Project>

  <!--
    Shared settings for XGoodFit's own projects (src/, tests/, tools/).
    Projects under upstream/ never see this file: MSBuild stops at the nearest Directory.Build.props,
    which is either the upstream repository's own or the empty upstream/Directory.Build.props.
    So upstream code compiles exactly as upstream intends.
  -->
  <PropertyGroup>
    <RepositoryRoot>$(MSBuildThisFileDirectory)</RepositoryRoot>
    <UpstreamRoot>$(RepositoryRoot)upstream/</UpstreamRoot>
    <UpstreamFrameworkSrc>$(UpstreamRoot)WPF-Framework/src/</UpstreamFrameworkSrc>
    <UpstreamBestFitSrc>$(UpstreamRoot)RMC-BestFit/src/</UpstreamBestFitSrc>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <!-- `dotnet test` shows each failed test's name and message (MSTest.Sdk hides them otherwise), so CI logs say what failed. -->
    <TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>
  </PropertyGroup>

  <!--
    Avalonia settings for the ported UI. Upstream XAML relies on reflection bindings, so Avalonia 12's
    compiled-bindings default stays off until x:DataType is added (docs/migration-plan.md §5.1).
  -->
  <PropertyGroup>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!--
    Product branding (docs/migration-plan.md §1.1). Only the branding layer uses these;
    library and namespace names stay identical to upstream to keep upstream diffs small.
  -->
  <PropertyGroup>
    <XGoodFitProductName>XGoodFit</XGoodFitProductName>
    <XGoodFitAppId>io.github.jonklaric.xgoodfit</XGoodFitAppId>
    <Product>$(XGoodFitProductName)</Product>
    <Company>XGoodFit contributors</Company>
    <Copyright>Copyright (c) 2026 Jon Klaric</Copyright>
    <Version>0.1.0-dev</Version>
    <!-- The update feed: Velopack reads this repository's GitHub Releases (plan §9.3, decision D7). -->
    <XGoodFitUpdateRepository>https://github.com/jonklaric/XGoodFit</XGoodFitUpdateRepository>
    <!--
      The application icon (.ico, up to 256 px), from which scripts/package.sh renders each OS's icons,
      and the same icon at 1024 px (PNG) for macOS's sizes above 256 px. tools/Branding draws both
      (branding/README.md).
    -->
    <XGoodFitIcon>$(RepositoryRoot)branding/XGoodFit.ico</XGoodFitIcon>
    <XGoodFitLargeIcon>$(RepositoryRoot)branding/xgoodfit-1024.png</XGoodFitLargeIcon>
  </PropertyGroup>

</Project>
