<Project>

  <!--
    Central package versions for XGoodFit's own projects (docs/migration-plan.md §4.2).
    Vendored upstream projects under upstream/ use their own Directory.Packages.props.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <AvaloniaVersion>12.1.4</AvaloniaVersion>
    <!--
      Velopack moves fast (plan §9.3), so it's pinned. The vpk tool in .config/dotnet-tools.json must be
      the same version: scripts/package.sh refuses to pack with any other.
    -->
    <VelopackVersion>1.2.161</VelopackVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.HarfBuzz" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Skia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Themes.Simple" Version="$(AvaloniaVersion)" />
    <!-- WPF's DataGrid: cell selection, SelectedCells, CanUserAddRows, copy and paste (plan §4.2). -->
    <PackageVersion Include="ProDataGrid" Version="12.1.0.6" />
    <!--
      FrameworkUI's docking: AvalonDock's API and layout XML over Dock's Avalonia controls (MIT).
      Projects store AvalonDock layout XML, which it reads and writes unchanged (plan §4.3).
    -->
    <PackageVersion Include="Dock.Avalonia.AvalonDock" Version="12.1.0.13" />
    <!-- The expression editor's syntax colouring (WPF's RichTextBox in upstream, plan §4.3). -->
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <!--
      The field calculator's help pages (WPF's WebBrowser in upstream, plan §2.3): a managed HTML 4 and
      CSS 2 renderer that draws through Avalonia, so it needs no native browser engine on any OS.
    -->
    <PackageVersion Include="Avalonia.HtmlRenderer" Version="12.0.0" />
    <!-- Installers and updates on every OS, from this repository's GitHub Releases (decision D7). -->
    <PackageVersion Include="Velopack" Version="$(VelopackVersion)" />
  </ItemGroup>

</Project>
