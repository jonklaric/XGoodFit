<Project>

  <!--
    Stops the build with a pointer to the fix when the pinned upstream sources are missing, or were
    fetched for a different upstream.lock (for example after a pull that bumped a pin).
    scripts/fetch-upstream.sh writes upstream/.fetched.lock when a fetch succeeds.
    Runs as an initial target of the solution (Directory.Solution.targets) and of every XGoodFit
    project (Directory.Build.props), before restore reaches the upstream project references.
  -->
  <PropertyGroup>
    <XGoodFitLockFile>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)../upstream.lock'))</XGoodFitLockFile>
    <XGoodFitFetchedLockFile>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)../upstream/.fetched.lock'))</XGoodFitFetchedLockFile>
  </PropertyGroup>

  <Target Name="XGoodFitCheckUpstream">
    <Error Condition="!Exists('$(XGoodFitFetchedLockFile)')"
           Text="The pinned upstream sources have not been fetched. Run scripts/fetch-upstream.sh first (from Git Bash on Windows). See README.md." />
    <PropertyGroup>
      <_XGoodFitLockHash>$([MSBuild]::StableStringHash($([System.IO.File]::ReadAllText('$(XGoodFitLockFile)'))))</_XGoodFitLockHash>
      <_XGoodFitFetchedLockHash>$([MSBuild]::StableStringHash($([System.IO.File]::ReadAllText('$(XGoodFitFetchedLockFile)'))))</_XGoodFitFetchedLockHash>
    </PropertyGroup>
    <Error Condition="'$(_XGoodFitLockHash)' != '$(_XGoodFitFetchedLockHash)'"
           Text="upstream.lock has changed since the upstream sources were fetched. Re-run scripts/fetch-upstream.sh." />
  </Target>

</Project>
