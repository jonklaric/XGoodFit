<!--
    XGoodFit port of upstream's GUI/RatingCurveAnalysis/RatingCurveAnalysisPropertiesControl.xaml, as the
    Univariate properties panel (UnivariateAnalysisPropertiesControl.axaml):
    - GenericControls' resource dictionary is an Avalonia resource include. The grid's width follows the
      scroll viewer's viewport (WPF's ViewportWidth is Viewport.Width).
    - Styles are themes; the tab panel's style is a style of the tab control's items panel (WPF's TabPanel).
      PropertiesTabItemStyle is a dynamic resource: the theme's, in another file.
    - The PreviewMouseLeftButtonDown handlers are added in the code-behind (Avalonia has no Preview events
      in XAML). ToolTip is ToolTip.Tip, Visibility="Hidden" is WpfCompat's Visibility, and the time series
      borders' Visibility="Visible" is the default.
    - The combo boxes' DisplayMemberPath is their DisplayMemberBinding.
    - The dates format in WPF's binding culture (WpfCompat's FormattingCulture, plan §5.2).
    - As upstream, the property widths bind to the discharge data's and the Bayesian output's
      ActualPropertyWidth, so the value columns line up, and the name's ExistingNames isn't bound.
-->
<UserControl x:Class="RMC_BestFit.RatingCurveAnalysisPropertiesControl" x:Name="RatingCurveAnalysisProperties"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="using:RMC_BestFit"
             xmlns:cntrls="using:GenericControls"
             xmlns:numcntrls="using:NumericControls"
             xmlns:sys="using:System"
             xmlns:wpf="using:WpfCompat"
             mc:Ignorable="d" 
             MinWidth="100"
             MinHeight="100"
             d:DesignHeight="450" d:DesignWidth="800"
             KeyDown="Properties_KeyDown"
             Background="{DynamicResource PropertyGrid.Content.Background}"
             Foreground="{DynamicResource EnvironmentWindowText}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://GenericControls/Resources/ResourceDictionary.axaml"/>
                <ResourceDictionary>
                    <cntrls:DoubleToGridLengthConverter x:Key="ActualToLengthConverter" />
                    <cntrls:BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
                    <cntrls:ReverseBooleanConverter x:Key="ReverseBoolConverter"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="10000000*" MinHeight="200"/>
            <RowDefinition Height="*" MinHeight="1"/>
            <RowDefinition Height="Auto" MinHeight="50" MaxHeight="200" />
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="Viewer" Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="MainGrid" Width="{Binding ElementName=Viewer, Path=Viewport.Width}" MinWidth="200" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TabControl Background="Transparent" DockPanel.Dock="Top" BorderBrush="Transparent" BorderThickness="0" Padding="0" Margin="0,5,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                    <TabControl.Styles>
                        <Style Selector="TabControl /template/ ItemsPresenter#PART_ItemsPresenter > WrapPanel">
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                        </Style>
                    </TabControl.Styles>
                    <TabItem x:Name="General_TabItem" Header="General" Theme="{DynamicResource PropertiesTabItemStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--Function Properties-->
                            <Expander x:Name="PropertiesExpander" Grid.Row="0" 
                            Margin="0,4,4,8" 
                            Header="RATING CURVE ANALYSIS PROPERTIES" 
                            IsExpanded="True" 
                            Theme="{DynamicResource PropertyExpanderStyle}">
                                <DockPanel>

                                    <cntrls:NameTextPropertyControl x:Name="ElementName" Margin="0 2" CharacterLimit="50" DockPanel.Dock="Top" Title="Name" MaxPropertyWidth="200"
                                                        Text="{Binding Element.Name, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                        PropertyWidth="{Binding ElementName=DischargeDataComboBox, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"
                                                        GotFocus="Name_GotFocus" LostFocus="Name_LostFocus"/>

                                    <cntrls:ResizeableTextPropertyControl x:Name="Description" Margin="0 2" DockPanel.Dock="Top" Title="Description" MaxPropertyWidth="200" 
                                                                Text="{Binding Element.Description, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                                PropertyWidth="{Binding ElementName=DischargeDataComboBox, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

                                    <cntrls:TextPropertyControl x:Name="CreationDate" Margin="0 2" DockPanel.Dock="Top" Title="Created On" MaxPropertyWidth="200" IsReadOnly="True"
                                                    Text="{Binding Element.CreationDate, UpdateSourceTrigger=PropertyChanged, Mode=OneWay, ConverterCulture={x:Static wpf:FormattingCulture.Current}}"
                                                    PropertyWidth="{Binding ElementName=DischargeDataComboBox, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

                                    <cntrls:TextPropertyControl x:Name="LastModified" Margin="0 2" DockPanel.Dock="Top" Title="Last Modified" MaxPropertyWidth="200" IsReadOnly="True" 
                                                    Text="{Binding Element.LastModified, UpdateSourceTrigger=PropertyChanged, Mode=OneWay, ConverterCulture={x:Static wpf:FormattingCulture.Current}}"
                                                    PropertyWidth="{Binding ElementName=DischargeDataComboBox, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>
                                    
                                    <!--Stage Data-->
                                    <cntrls:ContentPropertyControl x:Name="StageDataComboBox" Margin="0 2" DockPanel.Dock="Top" Title="Stage Data" MaxPropertyWidth="200"
                                                ToolTip.Tip="Please select a valid stage time series."
                                                PropertyWidth="{Binding ElementName=DischargeDataComboBox, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}">
                                        <cntrls:ContentPropertyControl.InnerContent>
                                            <Border BorderBrush="Red" BorderThickness="1">
                                                <ComboBox HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Loaded="StageDataComboBox_Loaded"
                                                    SelectedValue="{Binding Element.StageData, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                    DisplayMemberBinding="{Binding Name}" SelectionChanged="StageDataComboBox_SelectionChanged">
                                                </ComboBox>
                                            </Border>
                                        </cntrls:ContentPropertyControl.InnerContent>
                                    </cntrls:ContentPropertyControl>

                                    <!--Discharge Data-->
                                    <cntrls:ContentPropertyControl x:Name="DischargeDataComboBox" Margin="0 2" DockPanel.Dock="Top" Title="Discharge Data" MaxPropertyWidth="200"
                                                ToolTip.Tip="Please select a valid discharge time series.">
                                        <cntrls:ContentPropertyControl.InnerContent>
                                            <Border BorderBrush="Red" BorderThickness="1">
                                                <ComboBox HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Loaded="DischargeDataComboBox_Loaded"
                                                    SelectedValue="{Binding Element.DischargeData, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                    DisplayMemberBinding="{Binding Name}" SelectionChanged="DischargeDataComboBox_SelectionChanged">
                                                </ComboBox>
                                            </Border>
                                        </cntrls:ContentPropertyControl.InnerContent>
                                    </cntrls:ContentPropertyControl>
                                    
                                    <!-- Number of Segments -->
                                    <cntrls:ContentPropertyControl x:Name="NumberOfSegments" Margin="0 2" DockPanel.Dock="Top" Title="Segments" MaxPropertyWidth="200"
                                                PropertyWidth="{Binding ElementName=DischargeDataComboBox, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"
                                                >
                                        <cntrls:ContentPropertyControl.InnerContent>
                                            <cntrls:NumericUpDown HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" DecimalPlaces="0" ThousandsSeparator="False"
                                                Minimum="1" Maximum="3" Value="{Binding Element.RatingCurve.NumberOfSegments, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                                            </cntrls:NumericUpDown>
                                        </cntrls:ContentPropertyControl.InnerContent>
                                    </cntrls:ContentPropertyControl>

                                </DockPanel>
                            </Expander>

                            <!--Parameter Priors-->
                            <Expander x:Name="ParameterPriorsExpander" Grid.Row="1" 
                                Margin="0,4,4,8" 
                                Header="PARAMETER PRIORS" 
                                IsExpanded="True" 
                                Theme="{DynamicResource PropertyExpanderStyle}">
                                <DockPanel >
                                    <local:ParameterPriorsControl x:Name="ParameterPriorsControl" DockPanel.Dock="Top" Model="{Binding ElementName=RatingCurveAnalysisProperties, Path=Element.RatingCurve, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}" 
                                                        ShowPropertyAttributes="ParameterPriorsControl_ShowPropertyAttributes"/>

                                    <!--Use Default Flat Priors-->
                                    <cntrls:BooleanPropertyControl x:Name="UseJeffreysRule" Margin="0 2" Grid.Row="1" Title="Use Jeffreys' Rule for Scale"
                                       IsSelected="{Binding Element.RatingCurve.UseJeffreysRuleForScale, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"  />
                                    
                                </DockPanel>
                            </Expander>

                            <!--Estimate Button-->
                            <Grid Grid.Row="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="100" Value="0" Height="24" Margin="2,5,4,0" Grid.Column="0" wpf:WpfElement.Visibility="Hidden" Background="{DynamicResource ProgressBar.Static.Background}" Foreground="{DynamicResource ProgressBar.Static.Foreground}" BorderBrush="{DynamicResource ProgressBar.Static.Border}"/>
                                <TextBlock x:Name="ProgressTextBlock" Text="0%" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,5,4,0" Grid.Column="0" wpf:WpfElement.Visibility="Hidden" Foreground="{DynamicResource EnvironmentWindowText}"/>
                                <Button Name="EstimateButton" ToolTip.Tip="Click to run the analysis" Grid.Row="0" Grid.Column="1"  VerticalContentAlignment="Center" HorizontalContentAlignment="Center" 
                                    Width="83" Height="24" Margin="0,5,5,0" Cursor="Hand" Click="EstimateButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <ContentControl Content="{DynamicResource RunIcon}" Margin="0,0,4,0"/>
                                        <TextBlock Text="Estimate" />
                                    </StackPanel>
                                </Button>
                                <Button Name="CancelButton" ToolTip.Tip="Click to cancel the analysis" Grid.Row="0" Grid.Column="1"  VerticalContentAlignment="Center" HorizontalContentAlignment="Center" 
                                    wpf:WpfElement.Visibility="Hidden" Width="83" Height="24" Margin="0,5,5,0" Cursor="Hand" Click="CancelButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <ContentControl Content="{DynamicResource StopIcon}" Margin="0,0,4,0"/>
                                        <TextBlock Text="Cancel" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                        </Grid>
                    </TabItem>
                    <TabItem x:Name="Options_TabItem" Header="Options" Theme="{DynamicResource PropertiesTabItemStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--Bayesian Analysis Control-->
                            <local:BayesianOptionsControl x:Name="BayesianOptionsControl" Grid.Row="1" Analysis="{Binding ElementName=RatingCurveAnalysisProperties, Path=Element.BayesianAnalysis, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                                                ShowPropertyAttributes="BayesianOptionsControl_ShowPropertyAttributes"/>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="Output_TabItem" Header="Output" Theme="{DynamicResource PropertiesTabItemStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--Bayesian Output Control-->
                            <local:BayesianOutputControl x:Name="BayesianOutputControl" Grid.Row="0" Analysis="{Binding ElementName=RatingCurveAnalysisProperties, Path=Element.BayesianAnalysis, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                                                ShowPropertyAttributes="BayesianOutputControl_ShowPropertyAttributes"/>

                            <!--Stage Bins-->
                            <Expander Grid.Row="1" 
                                Margin="0,4,4,8" 
                                Header="STAGE BINS" 
                                IsExpanded="True" 
                                Grid.ColumnSpan="2"
                                Theme="{DynamicResource PropertyExpanderStyle}">            
                                <DockPanel >

                                    <!--Minimum Stage-->
                                    <cntrls:NumericPropertyControl x:Name="MinStage" Margin="0 2" DockPanel.Dock="Top" Title="Min Stage" MaxPropertyWidth="200" 
                                                               CanHaveNegative="True" MinValue="{x:Static sys:Double.MinValue}" MaxValue="{Binding Element.MaxStage, UpdateSourceTrigger=PropertyChanged}"
                                                               Number="{Binding Element.MinStage, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" IsTextBoxEnabled="{Binding IsSelected, ElementName=UseDefaults, Converter={StaticResource ReverseBoolConverter}}"
                                                               PropertyWidth="{Binding ElementName=BayesianOutputControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

                                    <!--Maximum Stage-->
                                    <cntrls:NumericPropertyControl x:Name="MaxStage" Margin="0 2" DockPanel.Dock="Top" Title="Max Stage" MaxPropertyWidth="200"
                                                               CanHaveNegative="True" MinValue="{Binding Element.MinStage, UpdateSourceTrigger=PropertyChanged}" MaxValue="{x:Static sys:Double.MaxValue}"
                                                               Number="{Binding Element.MaxStage, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" IsTextBoxEnabled="{Binding IsSelected, ElementName=UseDefaults, Converter={StaticResource ReverseBoolConverter}}"
                                                               PropertyWidth="{Binding ElementName=BayesianOutputControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

                                    <!--Stage Bins-->
                                    <cntrls:NumericPropertyControl x:Name="StageBins" Margin="0 2" DockPanel.Dock="Top" Title="Stage Bins" MaxPropertyWidth="200" 
                                                              CanHaveNegative="False" MinValue="10" MaxValue="1000" Number="{Binding Element.StageBins, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" IsTextBoxEnabled="{Binding IsSelected, ElementName=UseDefaults, Converter={StaticResource ReverseBoolConverter}}"
                                                              PropertyWidth="{Binding ElementName=BayesianOutputControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

                                    <!--Use Defaults-->
                                    <cntrls:BooleanPropertyControl x:Name="UseDefaults" Margin="0,0,0,5" DockPanel.Dock="Top" Title="Use Defaults"
                                                               IsSelected="{Binding Element.UseDefaultStageBins, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

                                </DockPanel>
                            </Expander>

                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </ScrollViewer>
        <!--Property Attributes-->
        <GridSplitter Grid.Row="1" Height="1" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Background="{DynamicResource SeparatorBorder}"/>
        <cntrls:PropertyAttributes x:Name="PropertyAttributes" Grid.Row="2"/>
    </Grid>
</UserControl>
