<!--
    XGoodFit port of upstream's GUI/Support/Controls/MCMCReportControl.xaml: the read-only RichTextBox is WpfCompat's
    (Avalonia has none), which shows the same flow document; its page width scrolls sideways, as WPF's does.
-->
<UserControl x:Class="RMC_BestFit.MCMCReportControl"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:RMC_BestFit"
             xmlns:wpfc="using:WpfCompat.Controls"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             Background="{DynamicResource EnvironmentWindowBackground}"
             Foreground="{DynamicResource EnvironmentWindowText}">
    <wpfc:RichTextBox x:Name="ReportTextBox" Margin="6"
                 IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12"
                 Background="{DynamicResource EnvironmentWindowBackground}"
                 Foreground="{DynamicResource EnvironmentWindowText}"
                 BorderThickness="0"/>
</UserControl>
