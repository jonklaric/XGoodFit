<!--
    XGoodFit port of upstream's GUI/UnivariateAnalysis/Mixture/MixtureAnalysisControl.xaml, as the Univariate
    view's port:
    - The PreviewMouseDown handler, and the label's MouseLeftButtonUp handler, are added in the code-behind
      (Avalonia has no Preview events in XAML; WpfCompat's mouse events filter the left button). The label
      is named AlternativesTextBlock for that.
    - Styles are themes: the tab items', the grids', the splitter's and the toggle button's, and the columns'
      HeaderStyle and CellStyle are their HeaderTheme and CellTheme. Avalonia's XAML can't name a grid column:
      the code-behind finds upstream's named columns (UpperColumn, LowerColumn, PredictiveColumn, ModeColumn,
      StatValueColumn) by position; AEPColumn and StatNameColumn are unnamed (nothing uses the names).
    - The tables' numbers format in WPF's binding culture (WpfCompat's FormattingCulture, plan §5.2).
    - The alternatives panel's Visibility binding is WpfCompat's Visibility, and ToolTip is ToolTip.Tip. Not
      ported: SnapsToDevicePixels.
-->
<UserControl x:Class="RMC_BestFit.MixtureAnalysisControl" x:Name="MixtureControl"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="using:RMC_BestFit"
             xmlns:cntrls="using:GenericControls"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:oxyCntrls="using:OxyPlotControls"
             xmlns:wpf="using:WpfCompat"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded"
             LostFocus="UserControl_LostFocus"
             Background="{DynamicResource EnvironmentWindowBackground}"
             Foreground="{DynamicResource EnvironmentWindowText}"
            >
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <cntrls:DoubleToNAConverter x:Key="NAConverter"/>
                    <cntrls:BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <TabControl Grid.Row="0" Margin="4" TabStripPlacement="Left" Background="Transparent">
            <TabItem x:Name="DistributionResultsTabItem" Header="Distribution Results" Theme="{DynamicResource VerticalTabItemStyle}">
                <TabControl Grid.Row="0" Margin="4" TabStripPlacement="Top" Background="Transparent">
                    <TabItem x:Name="FrequencyResultsTabItem" Header="Frequency Plot" IsSelected="True" Theme="{DynamicResource HorizontalTabItemStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel 
                                    Orientation="Horizontal" 
                                    Grid.Row="0" 
                                    Margin="5,0,0,0"
                                    Height="22"
                                    VerticalAlignment="Center" 
                                    HorizontalAlignment="Left"
                                    ToolTip.Tip="Show options for viewing alternative results.">

                                <ToggleButton 
                                        x:Name="ShowFilterToggleButton" 
                                        VerticalAlignment="Center" 
                                        HorizontalAlignment="Left"
                                        IsChecked="False"
                                        Theme="{DynamicResource PlusMinusToggleStyle}"/>

                                <TextBlock x:Name="AlternativesTextBlock" Text="Alternative Results" VerticalAlignment="Center" Margin="2,0,0,0" Foreground="{DynamicResource EnvironmentWindowText}"/>
                            </StackPanel>


                            <Grid Grid.Row="1" Grid.ColumnSpan="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!--Alternatives-->
                                <local:AlternativeControl x:Name="AlternativeSelector"
                                                            Grid.Column="0"
                                                            HorizontalAlignment="Left"
                                                            Margin="0,0,5,0"
                                                            Element="{Binding ElementName=MixtureControl, Path=Element}"
                                                            wpf:WpfElement.Visibility="{Binding ElementName=ShowFilterToggleButton, Path=IsChecked, Converter={StaticResource BoolToVisConverter}}"                                                                        
                                                            AnalysisAdded="AlternativeSelector_AnalysisAdded" AnalysisRemoved="AlternativeSelector_AnalysisRemoved"/>

                                <!--Frequency Plot-->
                                <ContentControl x:Name="FrequencyPlotHost" Grid.Column="1" Margin="2,2,0,0" />

                                <!--Plot Toolbar-->
                                <oxyCntrls:OxyPlotToolbar x:Name="FrequencyPlotToolbar" Grid.Row="0" Grid.Column="2" Background="Transparent" VerticalAlignment="Stretch" ToolBarOrientation="Vertical" PropertiesCalled="PlotToolbar_PropertiesCalled" />
                            </Grid>

                        </Grid>
                    </TabItem>

                    <TabItem Header="Tabular Results" Theme="{DynamicResource HorizontalTabItemStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.75*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="0.25*" MinWidth="200" MaxWidth="500"/>
                            </Grid.ColumnDefinitions>

                            <cntrls:SeparatorWithHeader Header="Frequency Curve Results" Grid.Column="0" Grid.Row="0" Margin="5" />

                            <cntrls:CopyPasteDataGrid x:Name="FrequencyCurveTable" Grid.Column="0" Grid.Row="1" Margin="0,0,2,0"  Theme="{DynamicResource CopyPasteDataGridStyle}"  
                                                    AutoGenerateColumns="False" SelectionMode="Extended" SelectionUnit="Cell" HeadersVisibility="Column" IsReadOnly="True"
                                                    CanUserAddInsertDeleteRows="False" CanUserDeleteRows="False" CanUserAddRows="False" CanUserResizeRows="False" 
                                                    CanUserResizeColumns="True" CanUserSortColumns="True" CanUserReorderColumns="False"  >

                                <cntrls:CopyPasteDataGrid.Columns>
                                    <DataGridTextColumn Header="Probability" IsReadOnly="True"  MinWidth="30"  Width="0.14286*"
                                                    Binding="{Binding Path=Probability, ConverterCulture={x:Static wpf:FormattingCulture.Current}}"
                                                    HeaderTheme="{DynamicResource Center_ColumnHeaderStyle}" 
                                                    CellTheme="{DynamicResource Right_CellStyle}" />
                                    <DataGridTextColumn Header="Upper" IsReadOnly="True" MinWidth="30"  Width="0.14286*" 
                                                    Binding="{Binding Path=Upper, ConverterCulture={x:Static wpf:FormattingCulture.Current}}"
                                                    HeaderTheme="{DynamicResource Center_ColumnHeaderStyle}" 
                                                    CellTheme="{DynamicResource Right_CellStyle}"/>
                                    <DataGridTextColumn Header="Lower" IsReadOnly="True" MinWidth="30"  Width="0.14286*"
                                                    Binding="{Binding Path=Lower, ConverterCulture={x:Static wpf:FormattingCulture.Current}}"
                                                    HeaderTheme="{DynamicResource Center_ColumnHeaderStyle}" 
                                                    CellTheme="{DynamicResource Right_CellStyle}"/>
                                    <DataGridTextColumn Header="Posterior Predictive" IsReadOnly="True" MinWidth="30"  Width="0.14286*"
                                                    Binding="{Binding Path=Predictive, ConverterCulture={x:Static wpf:FormattingCulture.Current}}"
                                                    HeaderTheme="{DynamicResource Center_ColumnHeaderStyle}" 
                                                    CellTheme="{DynamicResource Right_CellStyle}"/>
                                    <DataGridTextColumn Header="Posterior Mode" IsReadOnly="True" MinWidth="30"  Width="0.14286*" 
                                                    Binding="{Binding Path=Mode, ConverterCulture={x:Static wpf:FormattingCulture.Current}}"
                                                    HeaderTheme="{DynamicResource Center_ColumnHeaderStyle}" 
                                                    CellTheme="{DynamicResource Right_CellStyle}"/>
                                </cntrls:CopyPasteDataGrid.Columns>
                            </cntrls:CopyPasteDataGrid>


                            <GridSplitter  Grid.Column="1" Grid.Row="1" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Left" VerticalAlignment="Stretch" Background="Transparent" Theme="{DynamicResource VerticalGridSplitterStyle}"/>

                            <cntrls:SeparatorWithHeader Header="Summary Statistics" Grid.Column="2" Grid.Row="0" Margin="5"/>

                            <Grid Grid.Column="2" Grid.Row="1" Margin="4,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <cntrls:CopyPasteDataGrid Name="SummaryStatisticsTable" Grid.Row="0" Margin="2,0,0,0" HeadersVisibility="Column" Theme="{DynamicResource CopyPasteDataGridStyle}"
                                                AutoGenerateColumns="False" SelectionMode="Extended" SelectionUnit="Cell" IsReadOnly="True" 
                                                CanUserDeleteRows="False" CanUserAddRows="False" CanUserResizeColumns="True" 
                                                CanUserResizeRows="False" CanUserSortColumns="False" CanUserReorderColumns="False"
                                                LoadingRow="SummaryStatisticsTable_LoadingRow">

                                    <cntrls:CopyPasteDataGrid.Columns>
                                        <DataGridTextColumn Header="Measure" IsReadOnly="True" MinWidth="50" Width="0.5*"
                                                        Binding="{Binding Path=Name}" 
                                                        HeaderTheme="{DynamicResource Left_ColumnHeaderStyle}"
                                                        CellTheme="{DynamicResource Left_CellStyle}"/>
                                        <DataGridTextColumn Header="Posterior Mode" IsReadOnly="True"  MinWidth="50" Width="0.5*"
                                                        Binding="{Binding Path=Value, StringFormat='F4', FallbackValue=N/A, TargetNullValue=N/A, Converter={StaticResource NAConverter}, ConverterCulture={x:Static wpf:FormattingCulture.Current}}" 
                                                        HeaderTheme="{DynamicResource Center_ColumnHeaderStyle}"
                                                        CellTheme="{DynamicResource Right_CellStyle}"/>
                                    </cntrls:CopyPasteDataGrid.Columns>
                                </cntrls:CopyPasteDataGrid>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </TabItem>
            <TabItem x:Name="ParameterSetsTabItem" Header="Parameter Sets" Theme="{DynamicResource VerticalTabItemStyle}">
                <local:ParameterSetsControl x:Name ="ParameterSetsControl" Grid.Row="1" Analysis="{Binding ElementName=MixtureControl, Path=Element.BayesianAnalysis, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"/>
            </TabItem>
            <TabItem x:Name="InfluenceDiagnosticsTabItem" Header="Influence" Theme="{DynamicResource VerticalTabItemStyle}">
                <local:InfluenceDiagnosticsControl x:Name="InfluenceDiagnosticsControl" Grid.Row="1"
                    Analysis="{Binding ElementName=MixtureControl, Path=Element.BayesianAnalysis, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                    PlotPropertiesCalled="PlotToolbar_PropertiesCalled"/>
            </TabItem>
            <TabItem x:Name="KernelDensityTabItem" Header="Kernel Density" Theme="{DynamicResource VerticalTabItemStyle}">
                <local:KernelDensityControl x:Name ="KernelDensityControl" Grid.Row="1" Analysis="{Binding ElementName=MixtureControl, Path=Element.BayesianAnalysis, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                                            PlotPropertiesCalled="PlotToolbar_PropertiesCalled"/>
            </TabItem>
            <TabItem x:Name="HistogramTabItem" Header="Histogram" Theme="{DynamicResource VerticalTabItemStyle}">
                <local:HistogramControl x:Name ="HistogramControl" Grid.Row="1" Analysis="{Binding ElementName=MixtureControl, Path=Element.BayesianAnalysis, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                                        PlotPropertiesCalled="PlotToolbar_PropertiesCalled"/>
            </TabItem>
            <TabItem x:Name="BivariateTabItem" Header="Bivariate" Theme="{DynamicResource VerticalTabItemStyle}">
                <local:BivariateHeatMapControl x:Name ="BivariateHeatMapControl" Grid.Row="1" Analysis="{Binding ElementName=MixtureControl, Path=Element.BayesianAnalysis, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                                               PlotPropertiesCalled="PlotToolbar_PropertiesCalled"/>
            </TabItem>
            <TabItem x:Name="MeanLikelihoodTabItem" Header="Mean Likelihood" Theme="{DynamicResource VerticalTabItemStyle}">
                <local:MeanLikelihoodControl x:Name ="MeanLikelihoodControl" Grid.Row="1" Analysis="{Binding ElementName=MixtureControl, Path=Element.BayesianAnalysis, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                                             PlotPropertiesCalled="PlotToolbar_PropertiesCalled"/>
            </TabItem>
            <TabItem x:Name="AutocorrelationTabItem" Header="Autocorrelation" Theme="{DynamicResource VerticalTabItemStyle}">
                <local:AutocorrelationControl x:Name ="AutocorrelationControl" Grid.Row="1" Analysis="{Binding ElementName=MixtureControl, Path=Element.BayesianAnalysis, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                                              PlotPropertiesCalled="PlotToolbar_PropertiesCalled"/>
            </TabItem>
            <TabItem x:Name="MarkovChainTabItem" Header="Markov Chain Traces" Theme="{DynamicResource VerticalTabItemStyle}">
                <local:MarkovChainTraceControl x:Name ="MarkovChainTraceControl" Grid.Row="1" Analysis="{Binding ElementName=MixtureControl, Path=Element.BayesianAnalysis, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                                               PlotPropertiesCalled="PlotToolbar_PropertiesCalled"/>
            </TabItem>
            <TabItem x:Name="MCMCReportTabItem" Header="MCMC Report" Theme="{DynamicResource VerticalTabItemStyle}">
                <local:MCMCReportControl x:Name="MCMCReportControl" Analysis="{Binding ElementName=MixtureControl, Path=Element.BayesianAnalysis, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"/>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
