<!--
    XGoodFit port of upstream's GUI/UnivariateAnalysis/Univariate/UnivariateAnalysisPropertiesControl.xaml, as
    FrameworkUI's ProjectPropertiesControl:
    - GenericControls' resource dictionary is an Avalonia resource include. The grid's width follows the
      scroll viewer's viewport (WPF's ViewportWidth is Viewport.Width).
    - Styles are themes; the tab panel's style is a style of the tab control's items panel (WPF's TabPanel).
      PropertiesTabItemStyle is a dynamic resource: the theme's, in another file. The trend model grid's
      columns' HeaderStyle and CellStyle are their HeaderTheme and CellTheme; Avalonia's XAML can't name a
      grid column, so the code-behind finds ParameterNameColumn and TrendModelColumn by position.
    - The PreviewMouseLeftButtonDown handlers are added in the code-behind (Avalonia has no Preview events
      in XAML); the probability ordinates control is named ProbabilityOrdinatesControl for that. ToolTip is
      ToolTip.Tip, Visibility="Hidden" is WpfCompat's Visibility, and the input data border's
      Visibility="Visible" is the default.
    - The combo boxes' DisplayMemberPath and SelectedValuePath are their DisplayMemberBinding and
      SelectedValueBinding.
    - The dates format in WPF's binding culture (WpfCompat's FormattingCulture, plan §5.2).
    - As upstream, the property widths bind to LastModified's and the Bayesian options' ActualPropertyWidth,
      so the value columns line up, and the name's ExistingNames isn't bound.
-->
<UserControl x:Class="RMC_BestFit.UnivariateAnalysisPropertiesControl" x:Name="UnivariateAnalysisProperties"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="using:RMC_BestFit"
             xmlns:cntrls="using:GenericControls"
             xmlns:numcntrls="using:NumericControls"
             xmlns:wpf="using:WpfCompat"
             mc:Ignorable="d" 
             MinWidth="100"
             MinHeight="100"
             d:DesignHeight="450" d:DesignWidth="800"
             KeyDown="UnivariateAnalysisProperties_KeyDown"
             Background="{DynamicResource PropertyGrid.Content.Background}"
             Foreground="{DynamicResource EnvironmentWindowText}"
>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://GenericControls/Resources/ResourceDictionary.axaml"/>
                <ResourceDictionary>
                    <cntrls:DoubleToGridLengthConverter x:Key="ActualToLengthConverter" />
                    <cntrls:BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
                    <cntrls:ReverseBooleanConverter x:Key="ReverseBoolConverter"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="10000000*" MinHeight="200"/>
            <RowDefinition Height="*" MinHeight="1"/>
            <RowDefinition Height="Auto" MinHeight="50" MaxHeight="200" />
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="Viewer" Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="MainGrid" Width="{Binding ElementName=Viewer, Path=Viewport.Width}" MinWidth="200" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TabControl Background="Transparent" DockPanel.Dock="Top" BorderBrush="Transparent" BorderThickness="0" Padding="0" Margin="0,5,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                    <TabControl.Styles>
                        <Style Selector="TabControl /template/ ItemsPresenter#PART_ItemsPresenter > WrapPanel">
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                        </Style>
                    </TabControl.Styles>
                    <TabItem x:Name="General_TabItem" Header="General" Theme="{DynamicResource PropertiesTabItemStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--Function Properties-->
                            <Expander x:Name="PropertiesExpander" Grid.Row="0" 
                            Margin="0,4,4,8" 
                            Header="UNIVARIATE ANALYSIS PROPERTIES" 
                            IsExpanded="True" 
                            Theme="{DynamicResource PropertyExpanderStyle}">
                                <DockPanel>

                                    <cntrls:NameTextPropertyControl x:Name="ElementName" Margin="0 2" CharacterLimit="50" DockPanel.Dock="Top" Title="Name" MaxPropertyWidth="200"
                                                        Text="{Binding Element.Name, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                        PropertyWidth="{Binding ElementName=LastModified, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"
                                                        GotFocus="Name_GotFocus" LostFocus="Name_LostFocus"/>

                                    <cntrls:ResizeableTextPropertyControl x:Name="Description" Margin="0 2" DockPanel.Dock="Top" Title="Description" MaxPropertyWidth="200" 
                                                                Text="{Binding Element.Description, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                                PropertyWidth="{Binding ElementName=LastModified, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

                                    <cntrls:TextPropertyControl x:Name="CreationDate" Margin="0 2" DockPanel.Dock="Top" Title="Created On" MaxPropertyWidth="200" IsReadOnly="True"
                                                    Text="{Binding Element.CreationDate, UpdateSourceTrigger=PropertyChanged, Mode=OneWay, ConverterCulture={x:Static wpf:FormattingCulture.Current}}"
                                                    PropertyWidth="{Binding ElementName=LastModified, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

                                    <cntrls:TextPropertyControl x:Name="LastModified" Margin="0 2" DockPanel.Dock="Top" Title="Last Modified" MaxPropertyWidth="200" IsReadOnly="True" 
                                                    Text="{Binding Element.LastModified, UpdateSourceTrigger=PropertyChanged, Mode=OneWay, ConverterCulture={x:Static wpf:FormattingCulture.Current}}"/>

                                    <!--Input Data-->
                                    <cntrls:ContentPropertyControl x:Name="InputDataComboBox" Margin="0 2" DockPanel.Dock="Top" Title="Input Data" MaxPropertyWidth="200"
                                                ToolTip.Tip="Please select a valid input data."
                                                PropertyWidth="{Binding ElementName=LastModified, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}">
                                        <cntrls:ContentPropertyControl.InnerContent>
                                            <Border BorderBrush="Red" BorderThickness="1">
                                                <ComboBox HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Loaded="ComboBox_Loaded"
                                            SelectedValue="{Binding Element.InputData, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                            DisplayMemberBinding="{Binding Name}" SelectionChanged="InputDataComboBox_SelectionChanged">
                                                </ComboBox>
                                            </Border>
                                        </cntrls:ContentPropertyControl.InnerContent>
                                    </cntrls:ContentPropertyControl>

                                    <!--Distribution-->
                                    <cntrls:ContentPropertyControl x:Name="Distribution" Margin="0 2" DockPanel.Dock="Top" Title="Distribution" MaxPropertyWidth="200"
                                        PropertyWidth="{Binding ElementName=LastModified, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"  >
                                        <cntrls:ContentPropertyControl.InnerContent>
                                            <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                            ItemsSource="{Binding DistributionList, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValue="{Binding Element.UnivariateDistribution.DistributionType, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                            DisplayMemberBinding="{Binding DisplayName}" SelectedValueBinding="{Binding Value}" SelectionChanged="DistributionComboBox_SelectionChanged"
                                            Loaded="DistributionComboBox_Loaded">
                                            </ComboBox>
                                        </cntrls:ContentPropertyControl.InnerContent>
                                    </cntrls:ContentPropertyControl>

                                </DockPanel>
                            </Expander>

                            <!--Parameter Priors-->
                            <Expander x:Name="ParameterPriorsExpander" Grid.Row="1" 
                            Margin="0,4,4,8" 
                            Header="PARAMETER PRIORS" 
                            IsExpanded="True" 
                            Theme="{DynamicResource PropertyExpanderStyle}">
                                <DockPanel >
                                    <local:ParameterPriorsControl x:Name="ParameterPriorsControl" DockPanel.Dock="Top" Model="{Binding ElementName=UnivariateAnalysisProperties, Path=Element.UnivariateDistribution, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}" 
                                                        ShowPropertyAttributes="ParameterPriorsControl_ShowPropertyAttributes"/>

                                    <!--Use Default Flat Priors-->
                                    <cntrls:BooleanPropertyControl x:Name="UseJeffreysRule" Margin="0 2" Grid.Row="1" Title="Use Jeffreys' Rule for Scale"
                                       IsSelected="{Binding Element.UnivariateDistribution.UseJeffreysRuleForScale, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"  />

                                </DockPanel>
                            </Expander>

                            <!--Quantile Priors-->
                            <Expander x:Name="QuantilePriorsExpander" Grid.Row="2" 
                            Margin="0,4,4,8" 
                            Header="QUANTILE PRIORS" 
                            IsExpanded="True" 
                            Theme="{DynamicResource PropertyExpanderStyle}">
                                <DockPanel >

                                    <local:QuantilePriorsControl x:Name="QuantilePriorsControl" DockPanel.Dock="Top" Model="{Binding ElementName=UnivariateAnalysisProperties, Path=Element.UnivariateDistribution, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}" 
                                                        ShowPropertyAttributes="QuantilePriorsControl_ShowPropertyAttributes"/>

                                </DockPanel>
                            </Expander>

                            <!--Estimate Button-->
                            <Grid Grid.Row="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="100" Value="0" Height="24" Margin="2,5,4,0" Grid.Column="0" wpf:WpfElement.Visibility="Hidden" Background="{DynamicResource ProgressBar.Static.Background}" Foreground="{DynamicResource ProgressBar.Static.Foreground}" BorderBrush="{DynamicResource ProgressBar.Static.Border}"/>
                                <TextBlock x:Name="ProgressTextBlock" Text="0%" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,5,4,0" Grid.Column="0" wpf:WpfElement.Visibility="Hidden" Foreground="{DynamicResource EnvironmentWindowText}"/>
                                <Button Name="EstimateButton" ToolTip.Tip="Click to run the analysis" Grid.Row="0" Grid.Column="1"  VerticalContentAlignment="Center" HorizontalContentAlignment="Center" 
                            Width="83" Height="24" Margin="0,5,5,0" Cursor="Hand" Click="EstimateButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <ContentControl Content="{DynamicResource RunIcon}" Margin="0,0,4,0"/>
                                        <TextBlock Text="Estimate" />
                                    </StackPanel>
                                </Button>
                                <Button Name="CancelButton" ToolTip.Tip="Click to cancel the analysis" Grid.Row="0" Grid.Column="1"  VerticalContentAlignment="Center" HorizontalContentAlignment="Center" 
                                wpf:WpfElement.Visibility="Hidden" Width="83" Height="24" Margin="0,5,5,0" Cursor="Hand" Click="CancelButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <ContentControl Content="{DynamicResource StopIcon}" Margin="0,0,4,0"/>
                                        <TextBlock Text="Cancel" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                        </Grid>
                    </TabItem>
                    <TabItem x:Name="Options_TabItem" Header="Options" Theme="{DynamicResource PropertiesTabItemStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--Quantile Priors-->
                            <Expander Grid.Row="0" 
                        Margin="0,4,4,8" 
                        Header="MODEL OPTIONS" 
                        IsExpanded="True" 
                        Theme="{DynamicResource PropertyExpanderStyle}">
                                <DockPanel >

                                    <!--Is Nonstationary-->
                                    <cntrls:BooleanPropertyControl x:Name="IsNonstationary" Margin="0 2" DockPanel.Dock="Top" Title="Nonstationary" Checked="IsNonstationary_Checked" Unchecked="IsNonstationary_Unchecked"
                                    IsSelected="{Binding Element.UnivariateDistribution.IsNonstationary, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

                                    <!--Time Step-->
                                    <cntrls:NumericPropertyControl x:Name="ParameterTimeStep" Margin="0 2" DockPanel.Dock="Top" Title="Time Index" MaxPropertyWidth="200" 
                                    CanHaveNegative="True" Number="{Binding Element.UnivariateDistribution.ParameterTimeIndex, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                                    IsTextBoxEnabled="{Binding IsSelected, ElementName=IsNonstationary, UpdateSourceTrigger=PropertyChanged }"
                                    PropertyWidth="{Binding ElementName=BayesianOptionsControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

                                    <!--Alpha-->
                                    <cntrls:NumericPropertyControl x:Name="Alpha" Margin="0 2" DockPanel.Dock="Top" Title="Alpha" MaxPropertyWidth="200"
                                    CanHaveNegative="False" BoundsAreExclusive="False" MinValue="0" MaxValue="1" Number="{Binding Element.UnivariateDistribution.Alpha, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                                    IsTextBoxEnabled="{Binding IsSelected, ElementName=IsNonstationary, UpdateSourceTrigger=PropertyChanged }"
                                    PropertyWidth="{Binding ElementName=BayesianOptionsControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>


                                    <!--Trend Model Data Grid Visibility="{Binding ElementName=IsNonstationary, Path=IsSelected, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BoolToVisConverter}}"-->
                                    <cntrls:CopyPasteDataGrid Name="TrendModelDataGrid" Margin="0,4,0,0" Grid.Row="0" HeadersVisibility="Column" Theme="{DynamicResource CopyPasteDataGridStyle}"
                                                    SelectionMode="Extended" SelectionUnit="Cell" IsReadOnly="True" AutoGenerateColumns="False"
                                                    CanUserDeleteRows="False" CanUserAddRows="False" CanUserResizeColumns="True" CanUserAddInsertDeleteRows="False"
                                                    CanUserResizeRows="False" CanUserSortColumns="False" CanUserReorderColumns="False" 
                                                    >
                                        <cntrls:CopyPasteDataGrid.Columns>
                                            <DataGridTextColumn Header="Parameter" IsReadOnly="True" Width="0.5*" Binding="{Binding Path=Name}"
                                                HeaderTheme="{DynamicResource Left_ColumnHeaderStyle}" CellTheme="{DynamicResource Left_CellStyle}"/>
                                            <DataGridTemplateColumn Header="Trend Model Type" IsReadOnly="False" Width="0.5*" HeaderTheme="{DynamicResource Center_ColumnHeaderStyle}"  >
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox x:Name="TrendModelComboBox" SelectionChanged="TrendModelComboBox_SelectionChanged" Height="22"
                                                    IsEnabled="{Binding IsSelected, ElementName=IsNonstationary, UpdateSourceTrigger=PropertyChanged}"
                                                    ItemsSource="{Binding ElementName=UnivariateAnalysisProperties, Path=TrendFunctionItems}" 
                                                    SelectedValue="{Binding Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                    DisplayMemberBinding="{Binding DisplayName}" SelectedValueBinding="{Binding Value}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </cntrls:CopyPasteDataGrid.Columns>
                                    </cntrls:CopyPasteDataGrid>

                                </DockPanel>
                            </Expander>

                            <!--Bayesian Options Control-->
                            <local:BayesianOptionsControl x:Name="BayesianOptionsControl" Grid.Row="1" Analysis="{Binding ElementName=UnivariateAnalysisProperties, Path=Element.BayesianAnalysis, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                                                ShowPropertyAttributes="BayesianOptionsControl_ShowPropertyAttributes"/>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="Output_TabItem" Header="Output" Theme="{DynamicResource PropertiesTabItemStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--Bayesian Output Control-->
                            <local:BayesianOutputControl x:Name="BayesianOutputControl" Grid.Row="0" Analysis="{Binding ElementName=UnivariateAnalysisProperties, Path=Element.BayesianAnalysis, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                                                ShowPropertyAttributes="BayesianOutputControl_ShowPropertyAttributes"/>

                            <!--Probability Ordinates-->
                            <Expander Grid.Row="1" 
                                Margin="0,4,4,8" 
                                Header="PROBABILITY ORDINATES" 
                                IsExpanded="True" 
                                Grid.ColumnSpan="2"
                                Theme="{DynamicResource PropertyExpanderStyle}">
                                <DockPanel >
                                    <!--Probability Ordinates-->
                                    <numcntrls:ProbabilityOrdinatesControl x:Name="ProbabilityOrdinatesControl" ProbabilityOrdinates="{Binding ElementName=UnivariateAnalysisProperties, Path=Element.ProbabilityOrdinates, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"/>
                                </DockPanel>
                            </Expander>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </ScrollViewer>
        <!--Property Attributes-->
        <GridSplitter Grid.Row="1" Height="1" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Background="{DynamicResource SeparatorBorder}"/>
        <cntrls:PropertyAttributes x:Name="PropertyAttributes" Grid.Row="2"/>
    </Grid>
</UserControl>
