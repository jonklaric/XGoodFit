    <UpstreamCompileInclude Include="GUI/Support/ComboBoxItems/PointEstimatorItem.cs" />
    <UpstreamCompileInclude Include="GUI/Support/ComboBoxItems/SamplerTypeItem.cs" />
    <UpstreamCompileInclude Include="GUI/Support/ComboBoxItems/SmoothingFunctionItem.cs" />
    <UpstreamCompileInclude Include="GUI/Support/ComboBoxItems/TimeBlockItem.cs" />
    <UpstreamCompileInclude Include="GUI/Support/ComboBoxItems/TimeIntervalItem.cs" />
    <UpstreamCompileInclude Include="GUI/Support/ComboBoxItems/TimeSeriesAlternativeItem.cs" />
    <UpstreamCompileInclude Include="GUI/Support/ComboBoxItems/TimeSeriesEntryMethodItem.cs" />
    <UpstreamCompileInclude Include="GUI/Support/ComboBoxItems/TimeSeriesTypeItem.cs" />
    <UpstreamCompileInclude Include="GUI/Support/ComboBoxItems/TransformTypeItem.cs" />
