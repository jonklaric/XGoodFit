    <UpstreamCompileInclude Include="GUI/Support/ComboBoxItems/CopulaEstimationItem.cs" />
    <UpstreamCompileInclude Include="GUI/Support/ComboBoxItems/CopulaItem.cs" />
    <UpstreamCompileInclude Include="GUI/Support/ComboBoxItems/CovariateExtensionItem.cs" />
    <UpstreamCompileInclude Include="GUI/Support/ComboBoxItems/CredibleIntervalItem.cs" />
    <UpstreamCompileInclude Include="GUI/Support/ComboBoxItems/DependencyItem.cs" />
    <UpstreamCompileInclude Include="GUI/Support/ComboBoxItems/DepthUnitItem.cs" />
    <UpstreamCompileInclude Include="GUI/Support/ComboBoxItems/ExactDataMethodItem.cs" />
    <UpstreamCompileInclude Include="GUI/Support/ComboBoxItems/GMMEstimationTypeItem.cs" />
    <UpstreamCompileInclude Include="GUI/Support/ComboBoxItems/InputDataSelectionItem.cs" />
    <UpstreamCompileInclude Include="GUI/Support/ComboBoxItems/MathFunctionItem.cs" />
    <UpstreamCompileInclude Include="GUI/Support/ComboBoxItems/MonthItem.cs" />
    <UpstreamCompileInclude Include="GUI/Support/ComboBoxItems/ParameterPriorItem.cs" />
