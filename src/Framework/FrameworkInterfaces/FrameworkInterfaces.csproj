<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Avalonia port of upstream/WPF-Framework/src/FrameworkInterfaces: messaging, undo/redo and the
    project/element hierarchy. Upstream C# files compile unchanged unless a ported copy exists here
    (Directory.Build.targets). Only the six files that used WPF media types are ported.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FrameworkInterfaces</RootNamespace>
    <AssemblyName>FrameworkInterfaces</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <UpstreamProjectDir>$(UpstreamFrameworkSrc)FrameworkInterfaces/</UpstreamProjectDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <!-- Element and project icons: WPF's ImageSource becomes Avalonia's IImage, keeping the upstream name. -->
    <Using Include="Avalonia.Media.IImage" Alias="ImageSource" />
  </ItemGroup>

</Project>
