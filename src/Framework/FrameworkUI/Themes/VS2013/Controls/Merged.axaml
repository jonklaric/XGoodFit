<!--
    XGoodFit port of upstream's Themes/VS2013/Controls/Merged.xaml.
    - MainWindowStyle.xaml isn't merged or ported: all its styles are keyed, and only that file uses
      their keys (the main window takes Themes' MetroWindowStyle, whose button styles have keys of their
      own), so none of them applies to the shell. The main window's resources don't merge it either.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FrameworkUI">

    <!--
    FrameworkUI-specific control styles.
    Common control styles (Button, CheckBox, ComboBox, etc.) are provided by the Themes library.
    This file only includes styles that are unique to FrameworkUI.
    -->

    <ResourceDictionary.MergedDictionaries>

        <!-- Icon resources - must be loaded before styles that reference them -->
        <ResourceInclude Source="avares://FrameworkUI/Icons/IconDictionary.axaml"/>

        <!-- FrameworkUI-specific styles -->
        <ResourceInclude Source="avares://FrameworkUI/Themes/VS2013/Controls/MessageWindow.axaml"/>
        <ResourceInclude Source="avares://FrameworkUI/Themes/VS2013/Controls/ProjectExplorer.axaml"/>

    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
