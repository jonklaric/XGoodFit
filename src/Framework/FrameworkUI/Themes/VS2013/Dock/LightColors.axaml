<!--
    XGoodFit addition: the Light colours of the VS2013 dock theme (Generic.axaml). They are the colours
    of AvalonDock's VS2013 Light theme, the reference for the dock's look
    (upstream/WPF-Framework/src/AvalonDock/Xceed.Wpf.AvalonDock.Themes.VS2013/LightBrushs.xaml), under
    its names with a Vs2013Dock. prefix: the theme is merged into a docking manager's resources, so its
    keys must not hide the application's own resources from the panes' content. The last section gives
    Dock's own resource keys, which Dock's controls under the adapter use, the matching colours.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- General -->
    <SolidColorBrush x:Key="Vs2013Dock.Background" Color="#EEEEF2" />
    <SolidColorBrush x:Key="Vs2013Dock.PanelBorderBrush" Color="#CCCEDB" />
    <SolidColorBrush x:Key="Vs2013Dock.TabBackground" Color="#F5F5F5" />

    <!-- Tool window caption -->
    <SolidColorBrush x:Key="Vs2013Dock.ToolWindowCaptionActiveBackground" Color="#007ACC" />
    <SolidColorBrush x:Key="Vs2013Dock.ToolWindowCaptionActiveGrip" Color="#59A8DE" />
    <SolidColorBrush x:Key="Vs2013Dock.ToolWindowCaptionActiveText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Vs2013Dock.ToolWindowCaptionInactiveBackground" Color="#EEEEF2" />
    <SolidColorBrush x:Key="Vs2013Dock.ToolWindowCaptionInactiveGrip" Color="#999999" />
    <SolidColorBrush x:Key="Vs2013Dock.ToolWindowCaptionInactiveText" Color="#444444" />

    <!-- Tool window caption buttons -->
    <SolidColorBrush x:Key="Vs2013Dock.ToolWindowCaptionButtonActiveGlyph" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Vs2013Dock.ToolWindowCaptionButtonActiveHoveredBackground" Color="#52B0EF" />
    <SolidColorBrush x:Key="Vs2013Dock.ToolWindowCaptionButtonActiveHoveredBorder" Color="#52B0EF" />
    <SolidColorBrush x:Key="Vs2013Dock.ToolWindowCaptionButtonActiveHoveredGlyph" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Vs2013Dock.ToolWindowCaptionButtonActivePressedBackground" Color="#0E6198" />
    <SolidColorBrush x:Key="Vs2013Dock.ToolWindowCaptionButtonActivePressedBorder" Color="#0E6198" />
    <SolidColorBrush x:Key="Vs2013Dock.ToolWindowCaptionButtonActivePressedGlyph" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Vs2013Dock.ToolWindowCaptionButtonInactiveGlyph" Color="#1E1E1E" />
    <SolidColorBrush x:Key="Vs2013Dock.ToolWindowCaptionButtonInactiveHoveredBackground" Color="#F7F7F9" />
    <SolidColorBrush x:Key="Vs2013Dock.ToolWindowCaptionButtonInactiveHoveredBorder" Color="#F7F7F9" />
    <SolidColorBrush x:Key="Vs2013Dock.ToolWindowCaptionButtonInactiveHoveredGlyph" Color="#717171" />
    <SolidColorBrush x:Key="Vs2013Dock.ToolWindowCaptionButtonInactivePressedBackground" Color="#0E6198" />
    <SolidColorBrush x:Key="Vs2013Dock.ToolWindowCaptionButtonInactivePressedBorder" Color="#0E6198" />
    <SolidColorBrush x:Key="Vs2013Dock.ToolWindowCaptionButtonInactivePressedGlyph" Color="#FFFFFF" />

    <!-- Tool window tabs -->
    <SolidColorBrush x:Key="Vs2013Dock.ToolWindowTabSelectedActiveBackground" Color="#F5F5F5" />
    <SolidColorBrush x:Key="Vs2013Dock.ToolWindowTabSelectedActiveText" Color="#0E70C0" />
    <SolidColorBrush x:Key="Vs2013Dock.ToolWindowTabSelectedInactiveBackground" Color="#F5F5F5" />
    <SolidColorBrush x:Key="Vs2013Dock.ToolWindowTabSelectedInactiveText" Color="#0E70C0" />
    <SolidColorBrush x:Key="Vs2013Dock.ToolWindowTabUnselectedBackground" Color="#EEEEF2" />
    <SolidColorBrush x:Key="Vs2013Dock.ToolWindowTabUnselectedText" Color="#444444" />
    <SolidColorBrush x:Key="Vs2013Dock.ToolWindowTabUnselectedHoveredBackground" Color="#C9DEF5" />
    <SolidColorBrush x:Key="Vs2013Dock.ToolWindowTabUnselectedHoveredText" Color="#1E1E1E" />

    <!-- Document tabs -->
    <SolidColorBrush x:Key="Vs2013Dock.DocumentWellTabSelectedActiveBackground" Color="#007ACC" />
    <SolidColorBrush x:Key="Vs2013Dock.DocumentWellTabSelectedActiveText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Vs2013Dock.DocumentWellTabSelectedInactiveBackground" Color="#CCCEDB" />
    <SolidColorBrush x:Key="Vs2013Dock.DocumentWellTabSelectedInactiveText" Color="#717171" />
    <SolidColorBrush x:Key="Vs2013Dock.DocumentWellTabUnselectedBackground" Color="#EEEEF2" />
    <SolidColorBrush x:Key="Vs2013Dock.DocumentWellTabUnselectedText" Color="#1E1E1E" />
    <SolidColorBrush x:Key="Vs2013Dock.DocumentWellTabUnselectedHoveredBackground" Color="#1C97EA" />
    <SolidColorBrush x:Key="Vs2013Dock.DocumentWellTabUnselectedHoveredText" Color="#FFFFFF" />

    <!-- Document tab close buttons -->
    <SolidColorBrush x:Key="Vs2013Dock.DocumentWellTabButtonSelectedActiveGlyph" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Vs2013Dock.DocumentWellTabButtonSelectedActiveHoveredBackground" Color="#1C97EA" />
    <SolidColorBrush x:Key="Vs2013Dock.DocumentWellTabButtonSelectedActiveHoveredBorder" Color="#1C97EA" />
    <SolidColorBrush x:Key="Vs2013Dock.DocumentWellTabButtonSelectedActiveHoveredGlyph" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Vs2013Dock.DocumentWellTabButtonSelectedActivePressedBackground" Color="#0E6198" />
    <SolidColorBrush x:Key="Vs2013Dock.DocumentWellTabButtonSelectedActivePressedBorder" Color="#0E6198" />
    <SolidColorBrush x:Key="Vs2013Dock.DocumentWellTabButtonSelectedActivePressedGlyph" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Vs2013Dock.DocumentWellTabButtonSelectedInactiveGlyph" Color="#6D6D70" />
    <SolidColorBrush x:Key="Vs2013Dock.DocumentWellTabButtonSelectedInactiveHoveredBackground" Color="#E6E7ED" />
    <SolidColorBrush x:Key="Vs2013Dock.DocumentWellTabButtonSelectedInactiveHoveredBorder" Color="#E6E7ED" />
    <SolidColorBrush x:Key="Vs2013Dock.DocumentWellTabButtonSelectedInactiveHoveredGlyph" Color="#717171" />
    <SolidColorBrush x:Key="Vs2013Dock.DocumentWellTabButtonSelectedInactivePressedBackground" Color="#B7B9C5" />
    <SolidColorBrush x:Key="Vs2013Dock.DocumentWellTabButtonSelectedInactivePressedBorder" Color="#B7B9C5" />
    <SolidColorBrush x:Key="Vs2013Dock.DocumentWellTabButtonSelectedInactivePressedGlyph" Color="#2D2D2D" />
    <SolidColorBrush x:Key="Vs2013Dock.DocumentWellTabButtonUnselectedTabHoveredGlyph" Color="#D0E6F5" />
    <SolidColorBrush x:Key="Vs2013Dock.DocumentWellTabButtonUnselectedTabHoveredButtonHoveredBackground" Color="#52B0EF" />
    <SolidColorBrush x:Key="Vs2013Dock.DocumentWellTabButtonUnselectedTabHoveredButtonHoveredBorder" Color="#52B0EF" />
    <SolidColorBrush x:Key="Vs2013Dock.DocumentWellTabButtonUnselectedTabHoveredButtonHoveredGlyph" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Vs2013Dock.DocumentWellTabButtonUnselectedTabHoveredButtonPressedBackground" Color="#0E6198" />
    <SolidColorBrush x:Key="Vs2013Dock.DocumentWellTabButtonUnselectedTabHoveredButtonPressedBorder" Color="#0E6198" />
    <SolidColorBrush x:Key="Vs2013Dock.DocumentWellTabButtonUnselectedTabHoveredButtonPressedGlyph" Color="#FFFFFF" />

    <!-- Document well overflow button -->
    <SolidColorBrush x:Key="Vs2013Dock.DocumentWellOverflowButtonDefaultGlyph" Color="#717171" />
    <SolidColorBrush x:Key="Vs2013Dock.DocumentWellOverflowButtonHoveredBackground" Color="#C9DEF5" />
    <SolidColorBrush x:Key="Vs2013Dock.DocumentWellOverflowButtonHoveredBorder" Color="#C9DEF5" />
    <SolidColorBrush x:Key="Vs2013Dock.DocumentWellOverflowButtonHoveredGlyph" Color="#007ACC" />
    <SolidColorBrush x:Key="Vs2013Dock.DocumentWellOverflowButtonPressedBackground" Color="#007ACC" />
    <SolidColorBrush x:Key="Vs2013Dock.DocumentWellOverflowButtonPressedBorder" Color="#007ACC" />
    <SolidColorBrush x:Key="Vs2013Dock.DocumentWellOverflowButtonPressedGlyph" Color="#FFFFFF" />

    <!-- Auto-hide tabs -->
    <SolidColorBrush x:Key="Vs2013Dock.AutoHideTabDefaultBackground" Color="#EEEEF2" />
    <SolidColorBrush x:Key="Vs2013Dock.AutoHideTabDefaultBorder" Color="#CCCEDB" />
    <SolidColorBrush x:Key="Vs2013Dock.AutoHideTabDefaultText" Color="#444444" />
    <SolidColorBrush x:Key="Vs2013Dock.AutoHideTabHoveredBackground" Color="#EEEEF2" />
    <SolidColorBrush x:Key="Vs2013Dock.AutoHideTabHoveredBorder" Color="#1BA1E2" />
    <SolidColorBrush x:Key="Vs2013Dock.AutoHideTabHoveredText" Color="#1BA1E2" />

    <!-- Floating windows -->
    <SolidColorBrush x:Key="Vs2013Dock.FloatingDocumentWindowBackground" Color="#EEEEF2" />
    <SolidColorBrush x:Key="Vs2013Dock.FloatingDocumentWindowBorder" Color="#9B9FB9" />
    <SolidColorBrush x:Key="Vs2013Dock.FloatingToolWindowBackground" Color="#EEEEF2" />
    <SolidColorBrush x:Key="Vs2013Dock.FloatingToolWindowBorder" Color="#9B9FB9" />

    <!-- Navigator window -->
    <SolidColorBrush x:Key="Vs2013Dock.NavigatorWindowBackground" Color="#EEEEEE" />
    <SolidColorBrush x:Key="Vs2013Dock.NavigatorWindowForeground" Color="#808080" />
    <SolidColorBrush x:Key="Vs2013Dock.NavigatorWindowSelectedBackground" Color="#007ACC" />
    <SolidColorBrush x:Key="Vs2013Dock.NavigatorWindowSelectedText" Color="#FFFFFF" />

    <!-- Docking targets -->
    <SolidColorBrush x:Key="Vs2013Dock.Accent" Color="#1BA1E2" />
    <SolidColorBrush x:Key="Vs2013Dock.DockingButtonBackground" Color="#20000000" />
    <SolidColorBrush x:Key="Vs2013Dock.DockingButtonForeground" Color="#1BA1E2" />
    <SolidColorBrush x:Key="Vs2013Dock.DockingButtonForegroundArrow" Color="#000000" />
    <SolidColorBrush x:Key="Vs2013Dock.DockingButtonStarBorder" Color="#40808080" />
    <SolidColorBrush x:Key="Vs2013Dock.DockingButtonStarBackground" Color="#20000000" />
    <SolidColorBrush x:Key="Vs2013Dock.PreviewBoxBorder" Color="#1BA1E2" />
    <SolidColorBrush x:Key="Vs2013Dock.PreviewBoxBackground" Color="#1BA1E2" Opacity="0.5" />

    <!-- Dock's resource keys (Dock.Avalonia.Themes.Fluent's Accents/Fluent.axaml) -->
    <StaticResource x:Key="DockThemeBackgroundBrush" ResourceKey="Vs2013Dock.Background" />
    <StaticResource x:Key="DockThemeBorderLowBrush" ResourceKey="Vs2013Dock.PanelBorderBrush" />
    <StaticResource x:Key="DockThemeAccentBrush" ResourceKey="Vs2013Dock.ToolWindowCaptionActiveBackground" />
    <StaticResource x:Key="DockThemeForegroundBrush" ResourceKey="Vs2013Dock.DocumentWellTabUnselectedText" />
    <StaticResource x:Key="DockThemeControlBackgroundBrush" ResourceKey="Vs2013Dock.TabBackground" />
    <StaticResource x:Key="DockSurfaceWorkbenchBrush" ResourceKey="Vs2013Dock.Background" />
    <StaticResource x:Key="DockSurfaceSidebarBrush" ResourceKey="Vs2013Dock.Background" />
    <StaticResource x:Key="DockSurfaceEditorBrush" ResourceKey="Vs2013Dock.FloatingToolWindowBackground" />
    <StaticResource x:Key="DockSurfacePanelBrush" ResourceKey="Vs2013Dock.TabBackground" />
    <StaticResource x:Key="DockSurfaceHeaderBrush" ResourceKey="Vs2013Dock.ToolWindowCaptionInactiveBackground" />
    <StaticResource x:Key="DockSurfaceHeaderActiveBrush" ResourceKey="Vs2013Dock.ToolWindowCaptionActiveBackground" />
    <StaticResource x:Key="DockBorderSubtleBrush" ResourceKey="Vs2013Dock.PanelBorderBrush" />
    <StaticResource x:Key="DockBorderStrongBrush" ResourceKey="Vs2013Dock.PanelBorderBrush" />
    <StaticResource x:Key="DockSeparatorBrush" ResourceKey="Vs2013Dock.PanelBorderBrush" />
    <SolidColorBrush x:Key="DockSplitterIdleBrush" Color="Transparent" />
    <SolidColorBrush x:Key="DockSplitterHoverBrush" Color="Transparent" />
    <SolidColorBrush x:Key="DockSplitterDragBrush" Color="Transparent" />
    <StaticResource x:Key="DockTargetIndicatorBrush" ResourceKey="Vs2013Dock.Accent" />
    <SolidColorBrush x:Key="DockTabBackgroundBrush" Color="Transparent" />
    <StaticResource x:Key="DockTabHoverBackgroundBrush" ResourceKey="Vs2013Dock.DocumentWellTabUnselectedHoveredBackground" />
    <StaticResource x:Key="DockTabActiveBackgroundBrush" ResourceKey="Vs2013Dock.DocumentWellTabSelectedActiveBackground" />
    <StaticResource x:Key="DockTabActiveIndicatorBrush" ResourceKey="Vs2013Dock.DocumentWellTabSelectedActiveBackground" />
    <StaticResource x:Key="DockTabForegroundBrush" ResourceKey="Vs2013Dock.DocumentWellTabUnselectedText" />
    <StaticResource x:Key="DockTabSelectedForegroundBrush" ResourceKey="Vs2013Dock.ToolWindowTabSelectedActiveText" />
    <StaticResource x:Key="DockTabActiveForegroundBrush" ResourceKey="Vs2013Dock.ToolWindowCaptionActiveText" />
    <StaticResource x:Key="DockTabCloseHoverBackgroundBrush" ResourceKey="Vs2013Dock.DocumentWellTabButtonSelectedActiveHoveredBackground" />
    <SolidColorBrush x:Key="DockDocumentTabStripBackgroundBrush" Color="Transparent" />
    <StaticResource x:Key="DockDocumentTabSelectedForegroundBrush" ResourceKey="Vs2013Dock.DocumentWellTabSelectedInactiveText" />
    <StaticResource x:Key="DockDocumentTabPointerOverForegroundBrush" ResourceKey="Vs2013Dock.DocumentWellTabUnselectedHoveredText" />
    <StaticResource x:Key="DockDocumentTabCloseSelectedForegroundBrush" ResourceKey="Vs2013Dock.DocumentWellTabButtonSelectedActiveGlyph" />
    <StaticResource x:Key="DockDocumentTabClosePointerOverForegroundBrush" ResourceKey="Vs2013Dock.DocumentWellTabButtonUnselectedTabHoveredGlyph" />
    <StaticResource x:Key="DockDocumentContentBorderBrush" ResourceKey="Vs2013Dock.PanelBorderBrush" />
    <StaticResource x:Key="DockToolChromeIconBrush" ResourceKey="Vs2013Dock.ToolWindowCaptionButtonInactiveGlyph" />
    <StaticResource x:Key="DockChromeButtonForegroundBrush" ResourceKey="Vs2013Dock.ToolWindowCaptionButtonInactiveGlyph" />
    <StaticResource x:Key="DockChromeButtonHoverBackgroundBrush" ResourceKey="Vs2013Dock.ToolWindowCaptionButtonInactiveHoveredBackground" />
    <StaticResource x:Key="DockChromeButtonPressedBackgroundBrush" ResourceKey="Vs2013Dock.ToolWindowCaptionButtonInactivePressedBackground" />
    <StaticResource x:Key="DockChromeButtonDangerHoverBrush" ResourceKey="Vs2013Dock.ToolWindowCaptionButtonInactiveHoveredBackground" />
    <SolidColorBrush x:Key="DockChromeGripBrush" Color="Transparent" />

</ResourceDictionary>
