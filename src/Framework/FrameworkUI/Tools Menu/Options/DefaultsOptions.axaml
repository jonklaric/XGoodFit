<!--
    XGoodFit port of upstream's Tools Menu/Options/DefaultsOptions.xaml: the XAML namespaces change, the
    text box's ToolTip is ToolTip.Tip, and its two-way Text binding updates on LostFocus, WPF's default
    for a text box (plan §5.2).
-->
<UserControl x:Class="FrameworkUI.DefaultsOptions"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:cntrls="using:GenericControls"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300" MaxHeight="600" MaxWidth="350"
             Background="{DynamicResource EnvironmentWindowBackground}"
             Foreground="{DynamicResource EnvironmentWindowText}"
             DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Default Directory:" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="0" Grid.Column="0" Margin="4,4,4,4"/>
        <Grid x:Name="LocationGrid" Grid.Row="0" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="33"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="LocationTextBox" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Grid.Column="0" Height="24" Margin="4,4,0,4" IsReadOnly="True" Text="{Binding DefaultLocation, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip.Tip="{Binding DefaultLocation, Mode=OneWay}" />
            <Button x:Name="BrowseButton" ToolTip.Tip="Browse..." Height="24" Width="24" Grid.Column="1" Margin="4" Cursor="Hand" Click="BrowseButton_Click">
                <TextBlock Text="..." HorizontalAlignment="Center"/>
            </Button>
        </Grid>
        <TextBlock Text="Decimal Digits:" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="1" Grid.Column="0" Margin="4,4,4,4"/>
        <cntrls:NumericUpDown x:Name="DecimalDigits" Maximum="10" Minimum="0" Increment="1" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" Height="24" Width="52" Margin="4" Value="{Binding DefaultValueDigits, Mode=TwoWay}"/>

        <ScrollViewer Grid.Row="2" Grid.ColumnSpan="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <ContentControl x:Name="CustomContentControl" Margin="4" Content="{Binding CustomOptions}" Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </ScrollViewer>
   </Grid>
</UserControl>
