<!--
    XGoodFit port of upstream's Date and Time Controls/ClockControl.xaml:
    - The styles are ControlThemes. The AM/PM style's EventSetters are pointer handlers the code-behind
      adds to the AM and PM faces; the clock toggles' triggers are nested styles in the same order.
    - The time text blocks' DataTriggers are classes bound to the clock's state, with a style for each.
    - Mouse events are pointer events, and Visibility bindings are WpfCompat's. Lines are Avalonia lines
      (StartPoint and EndPoint), and actual sizes are the bounds' sizes.
    - Not ported: SnapsToDevicePixels and TextOptions.TextFormattingMode, WPF rendering settings.
-->
<UserControl x:Class="GenericControls.ClockControl" x:Name="TimePicker"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:GenericControls"
             xmlns:wpf="using:WpfCompat"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <local:BooleanToVisibilityConverter x:Key="FalseToCollapsed" TrueValue="Visible" FalseValue="Collapsed"/>
        <local:BooleanToVisibilityConverter x:Key="TrueToCollapsed" TrueValue="Collapsed" FalseValue="Visible"/>
        <local:TimeTextConverter x:Key="Hour24TimeToTextConverter" TimeType="Hour" Is24Hour="True"/>
        <local:TimeTextConverter x:Key="Hour12TimeToTextConverter" TimeType="Hour" Is24Hour="False"/>
        <local:TimeTextConverter x:Key="MinuteTimeToTextConverter" TimeType="Minute"/>
        <local:TimeTextConverter x:Key="SecondTimeToTextConverter" TimeType="Second"/>
        <local:TimeTextConverter x:Key="AMPMTimeToTextConverter" TimeType="Meridian"/>
        <ControlTheme TargetType="Border" x:Key="AMPMStyle">
            <Setter Property="Width" Value="15"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Background" Value="{Binding ElementName=TimePicker, Path=FaceColor}"/>
        </ControlTheme>
        <ControlTheme TargetType="local:ClockToggle" x:Key="ClockMajorValueStyle">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Background" Value="{Binding ElementName=TimePicker, Path=FaceColor}"/>
            <Style Selector="^[IsSelected=True]">
                <Setter Property="Background" Value="{Binding ElementName=TimePicker, Path=SelectedColor}"/>
                    <Setter Property="FontColor" Value="{Binding ElementName=TimePicker, Path=SelectedFontColor}"/>
            </Style>
            <Style Selector="^[IsHighlighted=True]">
                <Setter Property="Background" Value="{Binding ElementName=TimePicker, Path=HighlightColor}"/>
                    <Setter Property="FontColor" Value="{Binding ElementName=TimePicker, Path=FontColor}"/>
            </Style>
            <Style Selector="^[IsHighlighted=False][IsSelected=False]">
                <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="FontColor" Value="{Binding ElementName=TimePicker, Path=FontColor}"/>
            </Style>
        </ControlTheme>
        <ControlTheme TargetType="local:ClockToggle" x:Key="ClockMinorValueStyle">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Height" Value="4"/>
            <Setter Property="Background" Value="{Binding ElementName=TimePicker, Path=FaceColor}"/>
            <Style Selector="^[IsSelected=True]">
                <Setter Property="Background" Value="{Binding ElementName=TimePicker, Path=SelectedColor}"/>
            </Style>
            <Style Selector="^[IsHighlighted=True]">
                <Setter Property="Background" Value="{Binding ElementName=TimePicker, Path=HighlightColor}"/>
            </Style>
            <Style Selector="^[IsHighlighted=False][IsSelected=False]">
                <Setter Property="Background" Value="Transparent"/>
            </Style>
        </ControlTheme>
    </UserControl.Resources>
    <Border BorderBrush="{Binding ElementName=TimePicker, Path=BorderBrush}"
            BorderThickness="{Binding ElementName=TimePicker, Path=BorderThickness}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource EnvironmentWindowBackground}" Grid.Row="0" Margin="1 0">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <TextBlock PointerReleased="HoursMouseUp"
                           Classes.selected="{Binding ElementName=TimePicker, Path=IsHours}"
                           Classes.is24Hour="{Binding ElementName=TimePicker, Path=Is24Hour}">
                    <TextBlock.Styles>
                        <Style Selector="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Bottom"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                        <Style Selector="TextBlock.selected">
                            <Setter Property="FontSize" Value="{Binding ElementName=TimePicker, Path=SelectedTimeFontSize}"/>
                                <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
                        </Style>
                        <Style Selector="TextBlock:not(.selected)">
                            <Setter Property="FontSize" Value="{Binding ElementName=TimePicker, Path=TimeFontSize}"/>
                            <Setter Property="Foreground" Value="{Binding ElementName=TimePicker, Path=TimeColor}"/>
                        </Style>
                        <Style Selector="TextBlock.is24Hour">
                            <Setter Property="Text" Value="{Binding ElementName=TimePicker, Path=Time, Converter={StaticResource Hour24TimeToTextConverter}}"/>
                        </Style>
                        <Style Selector="TextBlock:not(.is24Hour)">
                            <Setter Property="Text" Value="{Binding ElementName=TimePicker, Path=Time, Converter={StaticResource Hour12TimeToTextConverter}}"/>
                        </Style>
                    </TextBlock.Styles>
                </TextBlock>
                <TextBlock Text=":" FontSize="{Binding ElementName=TimePicker, Path=TimeFontSize}"></TextBlock>
                <TextBlock Text="{Binding ElementName=TimePicker, Path=Time, Converter={StaticResource MinuteTimeToTextConverter}}" PointerReleased="MinutesMouseUp"
                           Classes.selected="{Binding ElementName=TimePicker, Path=IsMinutes}">
                    <TextBlock.Styles>
                        <Style Selector="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Bottom"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                        <Style Selector="TextBlock.selected">
                            <Setter Property="FontSize" Value="{Binding ElementName=TimePicker, Path=SelectedTimeFontSize}"/>
                            <Setter Property="Foreground" Value="{Binding ElementName=TimePicker, Path=SelectedTimeColor}"/>
                        </Style>
                        <Style Selector="TextBlock:not(.selected)">
                            <Setter Property="FontSize" Value="{Binding ElementName=TimePicker, Path=TimeFontSize}"/>
                            <Setter Property="Foreground" Value="{Binding ElementName=TimePicker, Path=TimeColor}"/>
                        </Style>
                    </TextBlock.Styles>
                </TextBlock>
                <TextBlock Text=":" FontSize="{Binding ElementName=TimePicker, Path=TimeFontSize}" wpf:WpfElement.Visibility="{Binding ElementName=TimePicker, Path=HasSeconds, Converter={StaticResource FalseToCollapsed}}"></TextBlock>
                <TextBlock Text="{Binding ElementName=TimePicker, Path=Time, Converter={StaticResource SecondTimeToTextConverter}}" PointerReleased="SecondsMouseUp" wpf:WpfElement.Visibility="{Binding ElementName=TimePicker, Path=HasSeconds, Converter={StaticResource FalseToCollapsed}}"
                           Classes.selected="{Binding ElementName=TimePicker, Path=IsSeconds}">
                    <TextBlock.Styles>
                        <Style Selector="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Bottom"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                        <Style Selector="TextBlock.selected">
                            <Setter Property="FontSize" Value="{Binding ElementName=TimePicker, Path=SelectedTimeFontSize}"/>
                            <Setter Property="Foreground" Value="{Binding ElementName=TimePicker, Path=SelectedTimeColor}"/>
                        </Style>
                        <Style Selector="TextBlock:not(.selected)">
                            <Setter Property="FontSize" Value="{Binding ElementName=TimePicker, Path=TimeFontSize}"/>
                            <Setter Property="Foreground" Value="{Binding ElementName=TimePicker, Path=TimeColor}"/>
                        </Style>
                    </TextBlock.Styles>
                </TextBlock>
                <TextBlock Text=" " FontSize="{Binding ElementName=TimePicker, Path=TimeFontSize}" VerticalAlignment="Bottom"></TextBlock>
                <TextBlock Text="{Binding ElementName=TimePicker, Path=Time, Converter={StaticResource AMPMTimeToTextConverter}}" FontSize="{Binding ElementName=TimePicker, Path=TimeFontSize}" Foreground="{Binding ElementName=TimePicker, Path=TimeColor}" VerticalAlignment="Bottom" PointerReleased="AmPmMouseUp" wpf:WpfElement.Visibility="{Binding ElementName=TimePicker, Path=Is24Hour, Converter={StaticResource TrueToCollapsed}}"></TextBlock>
            </StackPanel>
        </Border>

        <Viewbox Grid.Row="1" Margin="0,5,0,5">
            <Canvas x:Name="MyCanvas" Width="100" Height="100">
                <Ellipse Name="ClockFace" Fill="{Binding ElementName=TimePicker, Path=FaceColor}" Width="100" Height="100" PointerMoved="ClockFace_MouseMove" PointerPressed="ClockFace_MouseDown" PointerReleased="ClockFace_MouseUp" PointerEntered="ClockFace_MouseEnter" PointerExited="ClockFace_MouseLeave"></Ellipse>
                <Border Name="AMFace" Theme="{StaticResource AMPMStyle}" wpf:WpfElement.Visibility="{Binding ElementName=TimePicker, Path=Is24Hour, Converter={StaticResource TrueToCollapsed}}">
                    <TextBlock Name="AMText" Text="AM" FontSize="7" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                </Border>
                <Border Name="PMFace" Theme="{StaticResource AMPMStyle}" Margin="85,0,0,0" wpf:WpfElement.Visibility="{Binding ElementName=TimePicker, Path=Is24Hour, Converter={StaticResource TrueToCollapsed}}">
                    <TextBlock Name="PMText" Text="PM" FontSize="7" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                </Border>
                <Grid x:Name="HoursGrid" Width="{Binding Bounds.Width, ElementName=MyCanvas}" Height="{Binding Bounds.Height, ElementName=MyCanvas}" wpf:WpfElement.Visibility="{Binding ElementName=TimePicker, Path=IsHours, Converter={StaticResource FalseToCollapsed}, UpdateSourceTrigger=PropertyChanged}" IsHitTestVisible="False">
                    <Line x:Name="PreviewHourHandLine" StartPoint="0,0" EndPoint="0,0"  Stroke="{Binding ElementName=TimePicker, Path=PreviewHandColor}" StrokeThickness="1" IsHitTestVisible="False">
                        <Line.RenderTransform>
                            <TranslateTransform X="50" Y="50"/>
                        </Line.RenderTransform>
                    </Line>   
                    <Ellipse Fill="{Binding ElementName=TimePicker, Path=HandColor}" Width="4" Height="4" IsHitTestVisible="False"></Ellipse>
                    <Line x:Name="HourHandLine" StartPoint="0,0" EndPoint="0,0"  Stroke="{Binding ElementName=TimePicker, Path=HandColor}" StrokeThickness="1" IsHitTestVisible="False">
                        <Line.RenderTransform>
                            <TranslateTransform X="50" Y="50"/>
                        </Line.RenderTransform>
                    </Line>
                </Grid>
                <Grid x:Name="MinutesGrid" Width="{Binding Bounds.Width, ElementName=MyCanvas}" Height="{Binding Bounds.Height, ElementName=MyCanvas}" wpf:WpfElement.Visibility="{Binding ElementName=TimePicker, Path=IsMinutes, Converter={StaticResource FalseToCollapsed}, UpdateSourceTrigger=PropertyChanged}" IsHitTestVisible="False">
                    <Line x:Name="PreviewMinuteHandLine" StartPoint="0,0" EndPoint="0,0"  Stroke="{Binding ElementName=TimePicker, Path=PreviewHandColor}" StrokeThickness="1" IsHitTestVisible="False">
                        <Line.RenderTransform>
                            <TranslateTransform X="50" Y="50"/>
                        </Line.RenderTransform>
                    </Line>
                    <Ellipse Fill="{Binding ElementName=TimePicker, Path=HandColor}" Width="4" Height="4"></Ellipse>
                    <Line x:Name="MinuteHandLine" StartPoint="0,0" EndPoint="0,0"  Stroke="{Binding ElementName=TimePicker, Path=HandColor}" StrokeThickness="1">
                        <Line.RenderTransform>
                            <TranslateTransform X="50" Y="50"/>
                        </Line.RenderTransform>
                    </Line>
                </Grid>
                <Grid x:Name="SecondsGrid" Width="{Binding Bounds.Width, ElementName=MyCanvas}" Height="{Binding Bounds.Height, ElementName=MyCanvas}" wpf:WpfElement.Visibility="{Binding ElementName=TimePicker, Path=IsSeconds, Converter={StaticResource FalseToCollapsed}, UpdateSourceTrigger=PropertyChanged}" IsHitTestVisible="False">
                    <Line x:Name="PreviewSecondHandLine" StartPoint="0,0" EndPoint="0,0"  Stroke="{Binding ElementName=TimePicker, Path=PreviewHandColor}" StrokeThickness="1" IsHitTestVisible="False">
                        <Line.RenderTransform>
                            <TranslateTransform X="50" Y="50"/>
                        </Line.RenderTransform>
                    </Line>
                    <Ellipse Fill="{Binding ElementName=TimePicker, Path=HandColor}" Width="4" Height="4"></Ellipse>
                    <Line x:Name="SecondHandLine" StartPoint="0,0" EndPoint="0,0"  Stroke="{Binding ElementName=TimePicker, Path=HandColor}" StrokeThickness="1">
                        <Line.RenderTransform>
                            <TranslateTransform X="50" Y="50"/>
                        </Line.RenderTransform>
                    </Line>
                </Grid>
            </Canvas>
        </Viewbox>


        </Grid>
    </Border>
</UserControl>
