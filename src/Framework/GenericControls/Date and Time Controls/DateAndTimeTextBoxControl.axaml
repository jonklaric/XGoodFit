<!--
    XGoodFit port of upstream's Date and Time Controls/DateAndTimeTextBoxControl.xaml:
    - The text box's DataTriggers are an "is24Hour" class bound to Is24Hour, with a style for each
      format. Each text binding updates the date when the text box loses focus, WPF's default for a
      text box, and converts with WPF's binding culture (WpfCompat's FormattingCulture, en-US), so the
      date reads as month/day on every machine, as upstream's did. ValidatesOnDataErrors had no effect
      (the control has no IDataErrorInfo); Avalonia's text box shows conversion errors, as WPF's did.
    - The button takes the toolbar style key as a dynamic resource; actual sizes are the bounds' sizes.
    - The popup: StaysOpen="False" is Avalonia's IsLightDismissEnabled, and WPF's Bottom placement (left
      edges aligned) is Avalonia's BottomEdgeAlignedLeft. Not ported: AllowsTransparency.
-->
<UserControl x:Class="GenericControls.DateAndTimeTextBoxControl" x:Name="DateAndTimeTextBoxSelector"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="using:GenericControls"
             xmlns:wpf="using:WpfCompat"
             mc:Ignorable="d" 
             d:DesignHeight="22"
             d:DesignWidth="250">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://GenericControls/Resources/ResourceDictionary.axaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:ReverseBooleanConverter x:Key="ReverseBoolConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <!--Can update string format of textbox in binding (example: StringFormat='yyyy-MM-dd HH:mm:ss')-->
        <TextBox
            x:Name="DateTimeTextBox"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            VerticalContentAlignment="Center"
            KeyUp="Textbox_KeyUp"
            Classes.is24Hour="{Binding ElementName=DateAndTimeTextBoxSelector, Path=Is24Hour}">
            <TextBox.Styles>
                <Style Selector="TextBox:not(.is24Hour)">
                    <Setter Property="Text" Value="{Binding SelectedDateTime, ElementName=DateAndTimeTextBoxSelector, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='MM/dd/yyyy hh:mm tt', ConverterCulture={x:Static wpf:FormattingCulture.Current}}"/>
                </Style>
                <Style Selector="TextBox.is24Hour">
                    <Setter Property="Text" Value="{Binding SelectedDateTime, ElementName=DateAndTimeTextBoxSelector, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='MM/dd/yyyy HH:mm', ConverterCulture={x:Static wpf:FormattingCulture.Current}}"/>
                </Style>
            </TextBox.Styles>
        </TextBox>
        
        <RadioButton 
            Width="{Binding ElementName=DateTimeTextBox, Path=Bounds.Height}"
            Height="{Binding ElementName=DateTimeTextBox, Path=Bounds.Height}"
            x:Name="DateTimeRadioButton" 
            Grid.Column="1" 
            Padding="0"
            Theme="{DynamicResource ToolBar.RadioButtonStyleKey}" 
            IsChecked="False" 
            IsHitTestVisible="{Binding ElementName=DateTimePopup, Path=IsOpen, Converter={StaticResource ReverseBoolConverter}}">

            <ContentControl Content="{StaticResource CalendarIcon}"
                            Width="16" Height="16"/>
        </RadioButton>
        
        <Popup
            x:Name="DateTimePopup" 
            IsOpen="{Binding ElementName=DateTimeRadioButton, Path=IsChecked, Mode=TwoWay}" 
            IsLightDismissEnabled="True"
            Placement="BottomEdgeAlignedLeft"  
            PlacementTarget="{Binding ElementName=DateTimeTextBox}">
            
            <Border BorderBrush="{DynamicResource Button.Static.Border}"
                    BorderThickness="1"
                    Background="{DynamicResource EnvironmentWindowBackground}">
                <local:DateAndTimePickerControl
                    x:Name="DateAndTimePicker"
                    HasSeconds="False"
                    SetToHoursOnLoad="True"
                    Background="{DynamicResource EnvironmentWindowBackground}"
                    DateAndTime="{Binding SelectedDateTime, ElementName=DateAndTimeTextBoxSelector, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    Is24Hour="{Binding ElementName=DateAndTimeTextBoxSelector, Path=Is24Hour, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
            </Border>
        </Popup>
    </Grid>
</UserControl>
