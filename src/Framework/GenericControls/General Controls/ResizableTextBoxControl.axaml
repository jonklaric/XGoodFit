<!--
    XGoodFit port of upstream's General Controls/ResizableTextBoxControl.xaml:
    - The text binding updates the control's Text when the text box loses focus, WPF's default for a
      text box (Avalonia's is on every change). A text box's scroll bar setting is the attached
      ScrollViewer property in Avalonia. PreviewKeyUp is a tunnelling handler added in the code-behind.
    - The thumb's style is a ControlTheme. Its lines are Avalonia lines (StartPoint and EndPoint), and
      its mouse-over trigger is a nested style; WPF's SizeNWSE cursor is Avalonia's TopLeftCorner.
-->
<UserControl x:Class="GenericControls.ResizableTextBoxControl" x:Name="ResizableTextControl"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="using:GenericControls"
             mc:Ignorable="d" 
             d:DesignHeight="23" d:DesignWidth="300">
    <Grid>

        <TextBox x:Name="ResizableTextBox" 
                 Text="{Binding Text, ElementName=ResizableTextControl, UpdateSourceTrigger=LostFocus}"
                 TextWrapping="Wrap"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 IsReadOnly="{Binding IsReadOnly, ElementName=ResizableTextControl, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
        </TextBox> 
        <Thumb x:Name="ResizeThumb" Width="18" Height="18" VerticalAlignment="Bottom" HorizontalAlignment="Right" Cursor="Hand" DragDelta="ResizeThumb_DragDelta">
            <Thumb.Theme>
                <ControlTheme TargetType="Thumb">
                    <Setter Property="Template">
                        <ControlTemplate>
                            <Grid VerticalAlignment="Bottom">
                                <Line StartPoint="6,18" EndPoint="18,6" Stroke="{DynamicResource Button.Static.Border}" StrokeThickness="1.5"/>
                                <!--smallest/right|bottom most -->
                                <Line StartPoint="10,18" EndPoint="18,10" Stroke="{DynamicResource Button.Static.Border}" StrokeThickness="1.5"/>
                                <Line StartPoint="14,18" EndPoint="18,14" Stroke="{DynamicResource Button.Static.Border}" StrokeThickness="1.5"/>
                                <!--longer/left|top most-->
                                <Grid.Styles>
                                    <Style Selector="Grid:pointerover">
                                        <Setter Property="Cursor" Value="TopLeftCorner"/>
                                    </Style>
                                </Grid.Styles>
                            </Grid>
                        </ControlTemplate>
                    </Setter>
                </ControlTheme>
            </Thumb.Theme>
        </Thumb>
    </Grid>
</UserControl>
