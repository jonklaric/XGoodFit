<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Avalonia port of upstream/WPF-Framework/src/GenericControls: themed windows, data grids, numeric
    inputs, property editors and the other reusable controls. Nearly all of its files are WPF code that
    is ported one at a time, so the project opts in to upstream files (Directory.Build.targets): only
    its ported copies and the upstream files listed in UpstreamCompileInclude compile.

    Ported so far: the Metro windows, MessageBox and its window, NameDialog; the general controls
    (NameTextBox, the numeric text boxes, up-down and slider, the colour picker and its popup,
    ResizableTextBoxControl, SeparatorWithHeader); the property controls (StringListPropertyControl on
    the data grid) and PropertyAttributes; the date and time controls; InsertionAdorner; the data grids
    and their toolbar (DataGrid/, on ProDataGrid); the converters and utilities (Utilities/,
    BooleanToVisibilityConverter, ColorToByteConverter); FolderBrowser; the icon and resource
    dictionaries; and the theme's control styles. Not ported, as nothing BestFit uses needs them:
    Utilities/ValidationRules.cs, GridLengthControl, ThicknessControl, Point3DPropertyControl,
    CalendarWeekRulePropertyControl, DirectorySelectorControl, FolderSelectorControl, DragAdorner and
    File Management/RecentFileList.cs.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GenericControls</RootNamespace>
    <AssemblyName>GenericControls</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <UpstreamProjectDir>$(UpstreamFrameworkSrc)GenericControls/</UpstreamProjectDir>
    <UpstreamCompileMode>OptIn</UpstreamCompileMode>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GenericControls.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The validation data grid's row items and rules compile as upstream wrote them. -->
    <UpstreamCompileInclude Include="DataGrid/ValidationDataGridObjects/DataGridRowItem.cs" />
    <UpstreamCompileInclude Include="DataGrid/ValidationDataGridObjects/PropertyRule.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="ProDataGrid" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Themes/Themes.csproj" />
    <ProjectReference Include="../WpfCompat/WpfCompat.csproj" />
  </ItemGroup>

</Project>
