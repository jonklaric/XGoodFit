<!--
    XGoodFit port of upstream's Properties Controls/ContentPropertyControl.xaml:
    - The resource dictionary is included as an Avalonia resource; the title and dot leader styles
      are ControlThemes, applied as dynamic resources. The dot leader is WpfCompat's Line, which
      stretches as WPF's does, and Visibility bindings are WpfCompat's.
-->
<UserControl x:Class="GenericControls.ContentPropertyControl" x:Name="ContentPropertyCtrl"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:GenericControls"
             xmlns:wpf="using:WpfCompat"
             xmlns:wpfs="using:WpfCompat.Shapes"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://GenericControls/Resources/ResourceDictionary.axaml"/>
                <ResourceDictionary>
                    <local:BooleanToVisibilityConverter x:Key="BoolToVisConverter" TrueValue="Visible" FalseValue="Collapsed"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid 
        Height="{Binding ElementName=ContentPropertyCtrl, Path=PropertyHeight, FallbackValue=22, TargetNullValue=22}" 
        Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width=".001*"/>
            <ColumnDefinition Width="{Binding ElementName=ContentPropertyCtrl, Path=PropertyWidth, FallbackValue=10*}" 
                              MaxWidth="{Binding ElementName=ContentPropertyCtrl, Path=MaxPropertyWidth, FallbackValue=200}"
                              MinWidth="{Binding ElementName=ContentPropertyCtrl, Path=MinPropertyWidth, FallbackValue=10}"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Theme="{DynamicResource TitleTextStyle}"
                   Text="{Binding ElementName=ContentPropertyCtrl, Path=Title}"/>

        <wpfs:Line Theme="{DynamicResource DotLeaderLineStyle}"
              wpf:WpfElement.Visibility="{Binding ShowLeaderLine, ElementName=ContentPropertyCtrl, Converter={StaticResource BoolToVisConverter}}"/>

        <ContentControl Grid.Column="2" SizeChanged="ControlSizeChanged"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        Content="{Binding InnerContent, ElementName=ContentPropertyCtrl}"/>
    </Grid>
</UserControl>
