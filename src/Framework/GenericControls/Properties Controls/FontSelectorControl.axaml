<!--
    XGoodFit port of upstream's Properties Controls/FontSelectorControl.xaml:
    - The resource dictionary is included as an Avalonia resource; the title and dot leader styles
      are ControlThemes, applied as dynamic resources. The dot leader is WpfCompat's Line, which
      stretches as WPF's does, and Visibility bindings are WpfCompat's.
    - Avalonia has no CollectionViewSource: the code-behind adds the system font families, sorted
      by name, as the myFonts resource.
-->
<UserControl x:Class="GenericControls.FontSelectorControl" x:Name="FontSelector"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="using:GenericControls"
             xmlns:wpf="using:WpfCompat"
             xmlns:wpfs="using:WpfCompat.Shapes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://GenericControls/Resources/ResourceDictionary.axaml"/>
                <ResourceDictionary>
                    <local:BooleanToVisibilityConverter x:Key="BoolToVisConverter" TrueValue="Visible" FalseValue="Collapsed"/>
                    <local:FontToFontFamilyConverter x:Key="FontConvert"/>
                    <FontFamily x:Key="DefaultFont">Segoe UI</FontFamily>
                    <!-- myFonts: the system font families sorted by name, from the code-behind. -->
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Height="22" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width=".001*"/>
            <ColumnDefinition Width="{Binding ElementName=FontSelector, Path=PropertyWidth, FallbackValue=10*}" 
                              MaxWidth="{Binding ElementName=FontSelector, Path=MaxPropertyWidth, FallbackValue=200}"
                              MinWidth="{Binding ElementName=FontSelector, Path=MinPropertyWidth, FallbackValue=10}"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Theme="{DynamicResource TitleTextStyle}"
                   Text="{Binding ElementName=FontSelector, Path=Title}" />

        <wpfs:Line Theme="{DynamicResource DotLeaderLineStyle}"
              wpf:WpfElement.Visibility="{Binding ShowLeaderLine, ElementName=FontSelector, Converter={StaticResource BoolToVisConverter}}"/>

        <ComboBox Grid.Column="2" SizeChanged="ControlSizeChanged"
                  HorizontalAlignment="Stretch" VerticalAlignment="Bottom" 
                  VerticalContentAlignment="Center"
                  ItemsSource="{DynamicResource myFonts}" 
                  SelectedValue="{Binding Path=FontFamilyString, ElementName=FontSelector, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource FontConvert}, TargetNullValue={StaticResource DefaultFont}, FallbackValue={StaticResource DefaultFont}}">
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" VerticalAlignment="Center" FontFamily="{Binding}" Foreground="{DynamicResource ComboBox.DropDown.Foreground}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
    </Grid>
</UserControl>
