<!--
    XGoodFit port of upstream's Properties Controls/FontWeightSelectorControl.xaml:
    - The resource dictionary is included as an Avalonia resource; the title and dot leader styles
      are ControlThemes, applied as dynamic resources. The dot leader is WpfCompat's Line, which
      stretches as WPF's does, and Visibility bindings are WpfCompat's.
    - The weights are WpfCompat's FontWeights, Avalonia's FontWeight values, shown with WPF's names
      (.NET names 600 "DemiBold", WPF "SemiBold").
-->
<UserControl x:Class="GenericControls.FontWeightSelectorControl" x:Name="FontWeightSelector"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="using:GenericControls"
             xmlns:wpf="using:WpfCompat"
             xmlns:wpfs="using:WpfCompat.Shapes"
             xmlns:media="using:WpfCompat.Media"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://GenericControls/Resources/ResourceDictionary.axaml"/>
                <ResourceDictionary>
                    <local:BooleanToVisibilityConverter x:Key="BoolToVisConverter" TrueValue="Visible" FalseValue="Collapsed"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Height="22" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width=".001*"/>
            <ColumnDefinition Width="{Binding ElementName=FontWeightSelector, Path=PropertyWidth, FallbackValue=10*}" 
                              MaxWidth="{Binding ElementName=FontWeightSelector, Path=MaxPropertyWidth, FallbackValue=200}"
                              MinWidth="{Binding ElementName=FontWeightSelector, Path=MinPropertyWidth, FallbackValue=10}"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Theme="{DynamicResource TitleTextStyle}"
                   Text="{Binding ElementName=FontWeightSelector, Path=Title}" />

        <wpfs:Line Theme="{DynamicResource DotLeaderLineStyle}"
              wpf:WpfElement.Visibility="{Binding ShowLeaderLine, ElementName=FontWeightSelector, Converter={StaticResource BoolToVisConverter}}"/>

        <ComboBox Grid.Column="2" SizeChanged="ControlSizeChanged"
                  HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                  SelectedValue="{Binding Path=SelectedFontWeight, ElementName=FontWeightSelector, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
            <!--100-->
            <x:Static Member="media:FontWeights.Thin" />
            <!--200-->
            <x:Static Member="media:FontWeights.ExtraLight" />
            <!--300-->
            <x:Static Member="media:FontWeights.Light" />
            <!--400-->
            <x:Static Member="media:FontWeights.Normal" />
            <!--500-->
            <x:Static Member="media:FontWeights.Medium" />
            <!--600-->
            <x:Static Member="media:FontWeights.SemiBold" />
            <!--700-->
            <x:Static Member="media:FontWeights.Bold" />
            <!--800-->
            <x:Static Member="media:FontWeights.ExtraBold" />
            <!--900-->
            <x:Static Member="media:FontWeights.Heavy" />
            <!--950-->
            <x:Static Member="media:FontWeights.ExtraBlack" />
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={x:Static media:FontWeights.NameConverter}}" VerticalAlignment="Center" FontWeight="{Binding}" Foreground="{DynamicResource ComboBox.DropDown.Foreground}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
    </Grid>
</UserControl>
