<!--
    XGoodFit port of upstream's Properties Controls/NameTextPropertyControl.xaml:
    - The resource dictionary is included as an Avalonia resource; the title and dot leader styles
      are ControlThemes, applied as dynamic resources. The dot leader is WpfCompat's Line, which
      stretches as WPF's does, and Visibility bindings are WpfCompat's.
    - PreviewKeyUp is a tunnelling handler added in the code-behind.
    - The name text box is NameTextBoxElement, and the code-behind's public NameTextBox property
      returns it: other assemblies use it, as upstream's public field, and Avalonia's generated
      fields have no documentation comments (a build warning).
-->
<UserControl x:Class="GenericControls.NameTextPropertyControl" x:Name="NameTextPropertyEditor"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="using:GenericControls"
             xmlns:wpf="using:WpfCompat"
             xmlns:wpfs="using:WpfCompat.Shapes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://GenericControls/Resources/ResourceDictionary.axaml"/>
                <ResourceDictionary>
                    <local:BooleanToVisibilityConverter x:Key="BoolToVisConverter" TrueValue="Visible" FalseValue="Collapsed"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Height="22" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width=".001*"/>
            <ColumnDefinition Width="{Binding ElementName=NameTextPropertyEditor, Path=PropertyWidth, FallbackValue=10*}" 
                              MaxWidth="{Binding ElementName=NameTextPropertyEditor, Path=MaxPropertyWidth, FallbackValue=200}"
                              MinWidth="{Binding ElementName=NameTextPropertyEditor, Path=MinPropertyWidth, FallbackValue=10}"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Theme="{DynamicResource TitleTextStyle}"
                   Text="{Binding ElementName=NameTextPropertyEditor, Path=Title}" />

        <wpfs:Line Theme="{DynamicResource DotLeaderLineStyle}"
              wpf:WpfElement.Visibility="{Binding ShowLeaderLine, ElementName=NameTextPropertyEditor, Converter={StaticResource BoolToVisConverter}}"/>

        <local:NameTextBox x:Name="NameTextBoxElement" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                           Text="{Binding Text, ElementName=NameTextPropertyEditor, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                           CharacterLimit="{Binding CharacterLimit, ElementName=NameTextPropertyEditor, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                           InvalidStrings="{Binding ExistingNames, ElementName=NameTextPropertyEditor, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                           InvalidCharacters="{Binding InvalidCharacters, ElementName=NameTextPropertyEditor, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                           SizeChanged="ControlSizeChanged"/>
    </Grid>
</UserControl>
