<!--
    XGoodFit port of upstream's Properties Controls/NumericAutoPropertyControl.xaml:
    - The resource dictionary is included as an Avalonia resource; the title and dot leader styles
      are ControlThemes, applied as dynamic resources. The dot leader is WpfCompat's Line, which
      stretches as WPF's does, and Visibility bindings are WpfCompat's.
    - The hidden text block that sizes the text box is transparent and invisible to the pointer,
      WPF's Hidden.
    - The error border's DataTriggers are an "invalid" class bound to ValueIsValid, as in NameTextBox.
    - PreviewTextInput, PreviewKeyDown and PreviewKeyUp are tunnelling handlers added in the code-behind.
-->
<UserControl x:Class="GenericControls.NumericAutoPropertyControl" x:Name="NumericAutoProperty"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:GenericControls"
             xmlns:wpf="using:WpfCompat"
             xmlns:wpfs="using:WpfCompat.Shapes"
             xmlns:glob="using:System.Globalization"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://GenericControls/Resources/ResourceDictionary.axaml"/>
                <ResourceDictionary>
                    <local:BooleanToVisibilityConverter x:Key="BoolToVisConverter" TrueValue="Visible" FalseValue="Collapsed"/>
                    <local:BooleanToVisibilityConverter x:Key="BoolToHiddenConverter" TrueValue="Hidden" FalseValue="Visible"/>
                    <local:StringToDoubleConverter x:Key="DoubleToStringConverter"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Height="22" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width=".001*"/>
            <ColumnDefinition Width="{Binding ElementName=NumericAutoProperty, Path=PropertyWidth, FallbackValue=10*}" 
                              MaxWidth="{Binding ElementName=NumericAutoProperty, Path=MaxPropertyWidth, FallbackValue=200}"
                              MinWidth="{Binding ElementName=NumericAutoProperty, Path=MinPropertyWidth, FallbackValue=10}"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Theme="{DynamicResource TitleTextStyle}"
                   Text="{Binding ElementName=NumericAutoProperty, Path=Title}"/>

        <wpfs:Line Theme="{DynamicResource DotLeaderLineStyle}"
              wpf:WpfElement.Visibility="{Binding ShowLeaderLine, ElementName=NumericAutoProperty, Converter={StaticResource BoolToVisConverter}}"/>

        <Grid Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" SizeChanged="ControlSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="DummyTextBlock" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Bottom"/>
            <TextBox Grid.Column="0"
                     x:Name="NumericTBox" 
                     Height="22"
                     Text="{Binding Number, ElementName=NumericAutoProperty, UpdateSourceTrigger=Explicit, Mode=TwoWay, StringFormat={}{0:G}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}}"
                     Width="{Binding ElementName=DummyTextBlock, Path=Bounds.Width}"
                     VerticalAlignment="Bottom" 
                     VerticalContentAlignment="Center"
                     LostFocus="TextBox_LostFocus"/>

            <Border Grid.Column="0" 
                HorizontalAlignment="Stretch" 
                Height="{Binding ElementName=NumericTBox, Path=Bounds.Height}" 
                Width="{Binding ElementName=NumericTBox, Path=Bounds.Width}"
                IsHitTestVisible="False" 
                BorderThickness="1"
                Classes.invalid="{Binding ElementName=NumericAutoProperty, Path=!ValueIsValid}">
                <Border.Styles>
                    <Style Selector="Border.invalid">
                        <Setter Property="BorderBrush" Value="{DynamicResource DataGrid.Cell.Error.Border}"/>
                    </Style>
                </Border.Styles>
            </Border>

            <TextBlock Grid.Column="1" Margin="3,0,0,0" Text="Auto" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource EnvironmentWindowText}"/>

            <Button Grid.Column="1" Margin="3,0,0,0" Click="Button_Click" HorizontalAlignment="Center" VerticalContentAlignment="Center" Padding="2 0" BorderThickness="1" wpf:WpfElement.Visibility="{Binding NumberIsDefault, ElementName=NumericAutoProperty, Converter={StaticResource BoolToHiddenConverter}}">Reset</Button>
        </Grid>
        
        
    </Grid>
</UserControl>
