<!--
    XGoodFit port of upstream's Properties Controls/NumericSliderPropertyControl.xaml:
    - The resource dictionary is included as an Avalonia resource; the title and dot leader styles
      are ControlThemes, applied as dynamic resources. The dot leader is WpfCompat's Line, which
      stretches as WPF's does, and Visibility bindings are WpfCompat's.
    - The slider template's track is bound to the slider, as WPF does by itself; the thumb's
      mouse-over triggers are nested styles. SnapsToDevicePixels isn't ported.
    - IsMoveToPointEnabled is WpfCompat's WpfSlider.IsMoveToPointEnabled, which moves the thumb to the
      pointer as WPF does: once, without dragging it.
    - The error border's DataTriggers are an "invalid" class bound to ValueIsValid, as in NameTextBox.
    - PreviewTextInput, PreviewKeyDown and PreviewKeyUp are tunnelling handlers added in the code-behind.
-->
<UserControl x:Class="GenericControls.NumericSliderPropertyControl" x:Name="NumericWithSlider"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:GenericControls"
             xmlns:wpf="using:WpfCompat"
             xmlns:wpfs="using:WpfCompat.Shapes"
             xmlns:glob="using:System.Globalization"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://GenericControls/Resources/ResourceDictionary.axaml"/>
                <ResourceDictionary>
                    <local:BooleanToVisibilityConverter x:Key="BoolToVisConverter" TrueValue="Visible" FalseValue="Collapsed"/>
                    <ControlTemplate x:Key="simpleSlider" TargetType="Slider">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>

                                <Rectangle Height="3" HorizontalAlignment="Stretch" Stroke="{DynamicResource SliderThumb.Track.Border}" Fill="{DynamicResource SliderThumb.Track.Background}" Margin="2 0"/>

                                <Track x:Name="PART_Track"
                                       Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                       Value="{TemplateBinding Value, Mode=TwoWay}" Orientation="{TemplateBinding Orientation}"
                                       IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                                    <Track.Thumb>
                                        <Thumb x:Name="Thumb">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Rectangle StrokeThickness="1" Width="5" Height="18">
                                                        <Rectangle.Styles>
                                                            <Style Selector="Rectangle:pointerover">
                                                                <Setter Property="Stroke" Value="{DynamicResource SliderThumb.MouseOver.Border}"/>
                                                                <Setter Property="Fill" Value="{DynamicResource SliderThumb.MouseOver.Background}"/>
                                                            </Style>
                                                            <Style Selector="Rectangle:not(:pointerover)">
                                                                <Setter Property="Stroke" Value="{DynamicResource SliderThumb.Static.Border}"/>
                                                                <Setter Property="Fill" Value="{DynamicResource SliderThumb.Static.Background}"/>
                                                            </Style>
                                                        </Rectangle.Styles>
                                                    </Rectangle>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Height="22" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width=".001*"/>
            <ColumnDefinition Width="{Binding ElementName=NumericWithSlider, Path=PropertyWidth, FallbackValue=10*}" 
                              MaxWidth="{Binding ElementName=NumericWithSlider, Path=MaxPropertyWidth, FallbackValue=200}"
                              MinWidth="{Binding ElementName=NumericWithSlider, Path=MinPropertyWidth, FallbackValue=10}"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Theme="{DynamicResource TitleTextStyle}"
        Text="{Binding ElementName=NumericWithSlider, Path=Title}"/>

        <wpfs:Line Theme="{DynamicResource DotLeaderLineStyle}"
              wpf:WpfElement.Visibility="{Binding ShowLeaderLine, ElementName=NumericWithSlider, Converter={StaticResource BoolToVisConverter}}"/>

        <Grid 
            x:Name="PropertyGrid"
            Grid.Column="2"
            HorizontalAlignment="Stretch">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{Binding ElementName=NumericWithSlider, Path=TextPropertyWidth, FallbackValue=80}"/>
            </Grid.ColumnDefinitions>
            


        <Slider x:Name="Slider" HorizontalAlignment="Stretch" Grid.Column="0" Orientation="Horizontal" Margin="1 0" VerticalAlignment="Center"
                Maximum="{Binding ElementName=NumericWithSlider, Path=MaxValue, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                Minimum="{Binding ElementName=NumericWithSlider, Path=MinValue, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                Value="{Binding ElementName=NumericWithSlider, Path=Number, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                TickFrequency="{Binding ElementName=NumericWithSlider, Path=Increment, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                Template="{StaticResource simpleSlider}" IsSnapToTickEnabled="True" wpf:WpfSlider.IsMoveToPointEnabled="True">
        </Slider>

            <TextBox Grid.Column="1"
                 x:Name="NumericTBox"
                 Height="22"
                 IsEnabled="{Binding IsTextBoxEnabled, ElementName=NumericWithSlider, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                 Text="{Binding Number, ElementName=NumericWithSlider, UpdateSourceTrigger=LostFocus, Mode=TwoWay, StringFormat='G', ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}}"
                 SizeChanged="ControlSizeChanged"
                 HorizontalAlignment="Stretch" 
                 VerticalAlignment="Bottom" 
                 VerticalContentAlignment="Center">
            </TextBox>

            <Border Grid.Column="1" 
                HorizontalAlignment="Stretch" 
                Height="{Binding ElementName=NumericTBox, Path=Bounds.Height}" 
                Width="{Binding ElementName=NumericTBox, Path=Bounds.Width}"
                IsHitTestVisible="False" 
                BorderThickness="1"
                Classes.invalid="{Binding ElementName=NumericWithSlider, Path=!ValueIsValid}">
                <Border.Styles>
                    <Style Selector="Border.invalid">
                        <Setter Property="BorderBrush" Value="{DynamicResource DataGrid.Cell.Error.Border}"/>
                    </Style>
                </Border.Styles>
            </Border>

        </Grid>
        
  

        <!--<Line Style="{StaticResource DotLeaderLineStyle}"
              Visibility="{Binding ShowLeaderLine, ElementName=NumericWithSlider, Converter={StaticResource BoolToVisConverter}}"/>-->

        <!--StringFormat={}{0:#.#####} StringFormat='G'-->
        
    </Grid>

</UserControl>
