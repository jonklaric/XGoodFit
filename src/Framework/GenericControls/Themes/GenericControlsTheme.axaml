        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
        <Setter Property="Background" Value="{DynamicResource EnvironmentWindowBackground}"/>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type local:ColorPicker}" TargetType="local:ColorPicker" BasedOn="{StaticResource ColorPickerStyle}"/>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- COLOR PICKER POPUP                                                           -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <ControlTheme x:Key="ColorPickerPopupStyle" TargetType="local:ColorPickerPopup">
