    </ControlTheme>

    <ControlTheme x:Key="{x:Type local:NumericSlider}" TargetType="local:NumericSlider" BasedOn="{StaticResource NumericSliderStyle}"/>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- COLOR PICKER                                                                 -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

