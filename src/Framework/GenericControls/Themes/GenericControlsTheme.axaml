        <Setter Property="BorderBrush" Value="{DynamicResource TextBox.Static.Border}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBox.Static.Foreground}"/>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type local:NumericUpDown}" TargetType="local:NumericUpDown" BasedOn="{StaticResource NumericUpDownStyle}"/>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- NUMERIC SLIDER                                                               -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <ControlTheme x:Key="NumericSliderStyle" TargetType="local:NumericSlider">
