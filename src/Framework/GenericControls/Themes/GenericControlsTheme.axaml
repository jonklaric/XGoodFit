    </ControlTheme>

    <ControlTheme x:Key="{x:Type local:ResizableTextBoxControl}" TargetType="local:ResizableTextBoxControl" BasedOn="{StaticResource ResizableTextBoxControlStyle}"/>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- NAME DIALOG                                                                  -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <ControlTheme x:Key="NameDialogStyle" TargetType="local:NameDialog">
        <Setter Property="Background" Value="{DynamicResource EnvironmentWindowBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type local:NameDialog}" TargetType="local:NameDialog" BasedOn="{StaticResource NameDialogStyle}"/>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- MESSAGE BOX WINDOW                                                          -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <ControlTheme x:Key="MessageBoxWindowStyle" TargetType="local:MessageBoxWindow">
        <Setter Property="Background" Value="{DynamicResource EnvironmentWindowBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type local:MessageBoxWindow}" TargetType="local:MessageBoxWindow" BasedOn="{StaticResource MessageBoxWindowStyle}"/>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- PROPERTY CONTROLS                                                            -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Base Property Control Style -->
    <ControlTheme x:Key="PropertyControlBaseStyle" TargetType="UserControl">
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
    </ControlTheme>

    <!-- Text Property Control -->
    <ControlTheme x:Key="TextPropertyControlStyle" TargetType="local:TextPropertyControl">
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type local:TextPropertyControl}" TargetType="local:TextPropertyControl" BasedOn="{StaticResource TextPropertyControlStyle}"/>

    <!-- Name Text Property Control -->
    <ControlTheme x:Key="NameTextPropertyControlStyle" TargetType="local:NameTextPropertyControl">
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type local:NameTextPropertyControl}" TargetType="local:NameTextPropertyControl" BasedOn="{StaticResource NameTextPropertyControlStyle}"/>

    <!-- Resizeable Text Property Control -->
    <ControlTheme x:Key="ResizeableTextPropertyControlStyle" TargetType="local:ResizeableTextPropertyControl">
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type local:ResizeableTextPropertyControl}" TargetType="local:ResizeableTextPropertyControl" BasedOn="{StaticResource ResizeableTextPropertyControlStyle}"/>

    <!-- Boolean Property Control -->
    <ControlTheme x:Key="BooleanPropertyControlStyle" TargetType="local:BooleanPropertyControl">
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type local:BooleanPropertyControl}" TargetType="local:BooleanPropertyControl" BasedOn="{StaticResource BooleanPropertyControlStyle}"/>

    <!-- Numeric Property Control -->
    <ControlTheme x:Key="NumericPropertyControlStyle" TargetType="local:NumericPropertyControl">
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type local:NumericPropertyControl}" TargetType="local:NumericPropertyControl" BasedOn="{StaticResource NumericPropertyControlStyle}"/>

    <!-- Numeric Auto Property Control -->
    <ControlTheme x:Key="NumericAutoPropertyControlStyle" TargetType="local:NumericAutoPropertyControl">
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type local:NumericAutoPropertyControl}" TargetType="local:NumericAutoPropertyControl" BasedOn="{StaticResource NumericAutoPropertyControlStyle}"/>

    <!-- Numeric Slider Property Control -->
    <ControlTheme x:Key="NumericSliderPropertyControlStyle" TargetType="local:NumericSliderPropertyControl">
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type local:NumericSliderPropertyControl}" TargetType="local:NumericSliderPropertyControl" BasedOn="{StaticResource NumericSliderPropertyControlStyle}"/>

    <!-- Numeric Property Selector Control -->
    <ControlTheme x:Key="NumericPropertySelectorControlStyle" TargetType="local:NumericPropertySelectorControl">
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type local:NumericPropertySelectorControl}" TargetType="local:NumericPropertySelectorControl" BasedOn="{StaticResource NumericPropertySelectorControlStyle}"/>

    <!-- Color Property Control -->
    <ControlTheme x:Key="ColorPropertyControlStyle" TargetType="local:ColorPropertyControl">
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type local:ColorPropertyControl}" TargetType="local:ColorPropertyControl" BasedOn="{StaticResource ColorPropertyControlStyle}"/>

    <!-- DateTime Property Control -->
    <ControlTheme x:Key="DateTimePropertyControlStyle" TargetType="local:DateTimePropertyControl">
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type local:DateTimePropertyControl}" TargetType="local:DateTimePropertyControl" BasedOn="{StaticResource DateTimePropertyControlStyle}"/>

    <!-- Font Selector Control -->
    <ControlTheme x:Key="FontSelectorControlStyle" TargetType="local:FontSelectorControl">
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type local:FontSelectorControl}" TargetType="local:FontSelectorControl" BasedOn="{StaticResource FontSelectorControlStyle}"/>

    <!-- Font Weight Selector Control -->
    <ControlTheme x:Key="FontWeightSelectorControlStyle" TargetType="local:FontWeightSelectorControl">
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type local:FontWeightSelectorControl}" TargetType="local:FontWeightSelectorControl" BasedOn="{StaticResource FontWeightSelectorControlStyle}"/>

    <!-- Line Style Selector Control -->
    <ControlTheme x:Key="LineStyleSelectorControlStyle" TargetType="local:LineStyleSelectorControl">
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type local:LineStyleSelectorControl}" TargetType="local:LineStyleSelectorControl" BasedOn="{StaticResource LineStyleSelectorControlStyle}"/>

    <!-- Line Width Selector Control -->
    <ControlTheme x:Key="LineWidthSelectorControlStyle" TargetType="local:LineWidthSelectorControl">
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type local:LineWidthSelectorControl}" TargetType="local:LineWidthSelectorControl" BasedOn="{StaticResource LineWidthSelectorControlStyle}"/>

    <!-- Horizontal Alignment Control -->
    <ControlTheme x:Key="HorizontalAlignmentControlStyle" TargetType="local:HorizontalAlignmentControl">
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type local:HorizontalAlignmentControl}" TargetType="local:HorizontalAlignmentControl" BasedOn="{StaticResource HorizontalAlignmentControlStyle}"/>

    <!-- Vertical Alignment Control -->
    <ControlTheme x:Key="VerticalAlignmentControlStyle" TargetType="local:VerticalAlignmentControl">
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type local:VerticalAlignmentControl}" TargetType="local:VerticalAlignmentControl" BasedOn="{StaticResource VerticalAlignmentControlStyle}"/>

    <!-- Content Property Control -->
    <ControlTheme x:Key="ContentPropertyControlStyle" TargetType="local:ContentPropertyControl">
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type local:ContentPropertyControl}" TargetType="local:ContentPropertyControl" BasedOn="{StaticResource ContentPropertyControlStyle}"/>

    <!-- Point Property Control -->
    <ControlTheme x:Key="PointPropertyControlStyle" TargetType="local:PointPropertyControl">
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type local:PointPropertyControl}" TargetType="local:PointPropertyControl" BasedOn="{StaticResource PointPropertyControlStyle}"/>

    <!-- String List Property Control -->
    <ControlTheme x:Key="StringListPropertyControlStyle" TargetType="local:StringListPropertyControl">
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type local:StringListPropertyControl}" TargetType="local:StringListPropertyControl" BasedOn="{StaticResource StringListPropertyControlStyle}"/>

    <!-- File Selector Control -->
