        <Setter Property="Background" Value="{DynamicResource EnvironmentWindowBackground}"/>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type local:ColorPickerPopup}" TargetType="local:ColorPickerPopup" BasedOn="{StaticResource ColorPickerPopupStyle}"/>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- CLOCK CONTROL                                                                -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <ControlTheme x:Key="ClockControlStyle" TargetType="local:ClockControl">
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type local:ClockControl}" TargetType="local:ClockControl" BasedOn="{StaticResource ClockControlStyle}"/>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- DATE AND TIME CONTROLS                                                       -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <ControlTheme x:Key="DateAndTimePickerControlStyle" TargetType="local:DateAndTimePickerControl">
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type local:DateAndTimePickerControl}" TargetType="local:DateAndTimePickerControl" BasedOn="{StaticResource DateAndTimePickerControlStyle}"/>

    <ControlTheme x:Key="DateAndTimeTextBoxControlStyle" TargetType="local:DateAndTimeTextBoxControl">
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type local:DateAndTimeTextBoxControl}" TargetType="local:DateAndTimeTextBoxControl" BasedOn="{StaticResource DateAndTimeTextBoxControlStyle}"/>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- RESIZABLE TEXTBOX                                                            -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <ControlTheme x:Key="ResizableTextBoxControlStyle" TargetType="local:ResizableTextBoxControl">
