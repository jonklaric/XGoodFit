<!--
    XGoodFit port of upstream's Data/Uncertain Curve Editor/UncertainOrderedTableEditor.xaml:
    - WrappedColumnHeaderStyle is a ControlTheme, its ContentTemplate is ColumnHeaderContent.Template, and
      its Click EventSetter is in the code-behind (ColumnHeaderClick), as in TimeSeriesTable.axaml.
    - The grid's ColumnHeaderStyle and CellStyle are its ColumnHeaderTheme and CellTheme, still bound to the
      editor's ColumnHeaderStyle and CellStyle. MouseDown is added in the code-behind (WpfCompat's
      MouseEvents), as WPF's MouseDown for every button.
    - The merged header's column widths: upstream binds them to the grid's RowHeaderActualWidth and to
      elements named Column1 and Column2, which don't exist, until the columns are generated
      (ValidationGrid_AutoGeneratedColumns). ProDataGrid has no RowHeaderActualWidth and its columns'
      ActualWidth raises no change, so the code-behind sets the widths instead (UpdateMergedColumnWidths):
      the row headers' width, and the star widths the failed bindings leave.
    - ValidationGrid isn't public (x:FieldModifier): nothing outside the assembly uses it, and Avalonia's
      generated fields have no documentation comments.
-->
<UserControl x:Class="NumericControls.UncertainOrderedTableEditor"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="using:NumericControls"
             xmlns:cntrls="using:GenericControls"
             xmlns:themes="using:Themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Control.Resources>
        <!-- Column header style with wrapped text and sorting support -->
        <ControlTheme x:Key="WrappedColumnHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="themes:ColumnHeaderContent.Template">
                <DataTemplate>
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Bottom" FontWeight="Bold" HorizontalAlignment="Stretch" Text="{Binding}"></TextBlock>
                </DataTemplate>
            </Setter>
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Bottom" />
            <!-- XGoodFit port: the Click EventSetter is in the code-behind (see the notes above). -->
        </ControlTheme>
    </Control.Resources>
    <Grid DataContext="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type UserControl}}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <!-- Data grid toolbar -->
        <cntrls:DataGridToolbar Name="ValidationGridToolbar"
                                Grid.Row="0"
                                DataGrid="{Binding ElementName=ValidationGrid, Mode=OneTime}"
                                ToolOrientation="Horizontal"/>

        <!-- Merged column headers for X and Y data -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource DataGrid.Static.Border}" BorderThickness="1">
            <Grid Name="MergedColumnHeaderGrid">
                <!-- XGoodFit port: the widths are set in the code-behind (see the notes above). -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <DataGridColumnHeader Name="XGridColumnHeader" Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsHitTestVisible="False" Content="{Binding XColumnHeader}"/>
                <DataGridColumnHeader Name="YGridColumnHeader" Grid.Column="2" Grid.ColumnSpan="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsHitTestVisible="False" Content="{Binding YColumnHeader}"/>
            </Grid>
        </Border>

        <!-- Validation data grid for uncertain ordered data -->
        <cntrls:ValidationDataGrid
            Name="ValidationGrid" Grid.Row="2"
            AutoGenerateColumns="True"
            CanUserResizeColumns="True"
            SelectionMode="Extended" SelectionUnit="CellOrRowHeader"
            CanUserDeleteRows="False" CanUserAddRows="False" CanUserResizeRows="False" CanUserSortColumns="False"
            CanUserReorderColumns="False"
            CanUserAddInsertDeleteRows="True"
            RowHeight="22"
            VerticalContentAlignment="Center"
            IsReadOnly="{Binding Path=IsReadOnly}"
            ColumnHeaderTheme="{Binding Path=ColumnHeaderStyle}"
            CellTheme="{Binding Path=CellStyle}"
            AutoGeneratedColumns="ValidationGrid_AutoGeneratedColumns"
            PreviewAddRows="ValidationGrid_PreviewAddRows"
            PreviewDeleteRows="ValidationGrid_PreviewDeleteRows"
            DataPasted="ValidationGrid_DataPasted"
            PreviewPasteData="ValidationGrid_PreviewPasteData"/>
    </Grid>
</UserControl>
