<!--
    XGoodFit port of upstream's Annotations/AnnotationSelectorControl.xaml:
    - The resource dictionary is merged with a ResourceInclude; the Style bindings are Theme bindings
      (Avalonia's styles are ControlThemes). ToolTip is ToolTip.Tip.
    - Avalonia has no DataTemplateSelector: GenericControls' ComboBoxItemTemplateSelector is a data
      template that picks its template once it's shown, so it's the combo box's ItemTemplate.
    - Avalonia's ComboBox has no IsSynchronizedWithCurrentItem: the code-behind selects the first item,
      as WPF's does (see AnnotationSelectorControl).
    - Not ported: SnapsToDevicePixels.
-->
<UserControl x:Class="OxyPlotControls.AnnotationSelectorControl" x:Name="AnnotationsControl"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:OxyPlotControls"
             xmlns:cntrls="using:GenericControls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://OxyPlotControls/Resources/ResourceDictionary.axaml"/>
                <ResourceDictionary>
                    <DataTemplate x:Key="ComboItemWithButtonTemplate">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding Text}" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="{DynamicResource ComboBox.DropDown.Foreground}"/>
                            <Button Margin="5,0,0,0" Grid.Column="2" Height="12" Width="12" Padding="0" ToolTip.Tip="Delete Annotation" VerticalAlignment="Center" HorizontalAlignment="Right" Background="Transparent" BorderBrush="Transparent" Click="DeleteAnnotationButton_Click">
                                <Path Data="M 1,1 7,7 M 1,7 7,1" Stroke="{DynamicResource ComboBox.DropDown.Foreground}" StrokeThickness="2"/>
                            </Button>
                        </Grid>
                    </DataTemplate>
                    <DataTemplate x:Key="SelectedItemTemplate">
                        <TextBlock Text="{Binding Text}" VerticalAlignment="Center" TextAlignment="Left" Foreground="{DynamicResource EnvironmentWindowText}"/>
                    </DataTemplate>
                    <cntrls:ComboBoxItemTemplateSelector x:Key="itemTemplateSelector" SelectedTemplate="{StaticResource SelectedItemTemplate}" DropDownTemplate="{StaticResource ComboItemWithButtonTemplate}"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ComboBox x:Name="AnnotationPropertyControlComboBox"
                        Grid.Row="0" ItemTemplate="{StaticResource itemTemplateSelector}"
                        Theme="{Binding ElementName=AnnotationsControl, Path=ComboBoxStyle}"
                        HorizontalContentAlignment="Stretch"
                        HorizontalAlignment="Stretch"
                        MinWidth="60"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        BorderThickness="0"
                        SelectionChanged="AnnotationPropertyControlComboBox_SelectionChanged">
        </ComboBox>
        <TextBlock x:Name="MaskTextBlock" Grid.Row="0" Text=" No plot annotations..." FontStyle="Italic" Background="Transparent" IsHitTestVisible="False" IsVisible="False"/>
        <local:AnnotationControl x:Name="AnnotationPropertiesControl" Margin="0,5,0,0" Grid.Row="1"
                                 ExpanderStyle="{Binding ElementName=AnnotationsControl, Path=ExpanderStyle}"/>
    </Grid>
</UserControl>
