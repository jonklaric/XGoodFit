<!--
    XGoodFit port of upstream's Axes/AxesControl.xaml:
    - The resource dictionary is merged with a ResourceInclude; the Style bindings are Theme bindings
      (Avalonia's styles are ControlThemes).
    - Avalonia has no DataTemplateSelector: GenericControls' ComboBoxItemTemplateSelector is a data
      template that picks its template once it's shown, so it's the combo box's ItemTemplate.
-->
<UserControl x:Class="OxyPlotControls.AxesControl" x:Name="Axes"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:OxyPlotControls"
             xmlns:cntrls="using:GenericControls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="400">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://OxyPlotControls/Resources/ResourceDictionary.axaml"/>
                <ResourceDictionary>
                    <DataTemplate x:Key="ComboItemWithButtonTemplate">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Text="{Binding Title}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Foreground="{DynamicResource ComboBox.DropDown.Foreground}"/>
                        </Grid>
                    </DataTemplate>
                    <DataTemplate x:Key="SelectedItemTemplate">
                        <TextBlock
                            Text="{Binding Title}"
                            VerticalAlignment="Center"
                            TextAlignment="Left"
                            Foreground="{DynamicResource EnvironmentWindowText}"/>
                    </DataTemplate>
                    <cntrls:ComboBoxItemTemplateSelector
                        x:Key="itemTemplateSelector"
                        SelectedTemplate="{StaticResource SelectedItemTemplate}"
                        DropDownTemplate="{StaticResource ComboItemWithButtonTemplate}"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ComboBox
            x:Name="AxesPropertyControlComboBox"
            Grid.Row="0"
            ItemTemplate="{StaticResource itemTemplateSelector}"
            Theme="{Binding ElementName=Axes, Path=ComboBoxStyle}"
            HorizontalContentAlignment="Stretch"
            HorizontalAlignment="Stretch"
            MinWidth="60"
            VerticalAlignment="Center"
            FontWeight="Bold"
            BorderThickness="0"
            SelectionChanged="AxesPropertyControlComboBox_SelectionChanged">
        </ComboBox>
        <local:AxisControl x:Name="AxisPropertiesControl"
                           Margin="0,5,0,0" Grid.Row="1"
                           AxisTypeChanged="AxisPropertiesControl_AxisTypeChanged"
                           ExpanderStyle="{Binding ElementName=Axes, Path=ExpanderStyle}"
                           TabItemStyle="{Binding ElementName=Axes, Path=TabItemStyle}"
                           />
    </Grid>
</UserControl>
