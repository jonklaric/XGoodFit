<!--
    XGoodFit port of upstream's Axes/AxisControl.xaml:
    - The resource dictionary is merged with a ResourceInclude; the Style bindings are Theme bindings
      (Avalonia's styles are ControlThemes); x:Array is WpfCompat's ArrayExtension.
    - The reverse-axis check box's two-way MultiBinding is WpfCompat's (Avalonia's is one-way).
    - Bindings to the axis's IsEnabled read IsEffectivelyEnabled, which includes the parents', as WPF's
      IsEnabled does.
    - WPF's TabPanel style is a style for the tab strip's panel (Avalonia's TabControl lays its tabs out
      in a WrapPanel inside its items presenter).
    - Avalonia's bindings have no NotifyOnSourceUpdated; upstream handles no SourceUpdated events.
    - The hidden dummy property controls, which only measure the property column, are Opacity="0"
      without hit testing, as WPF's Visibility="Hidden".
    - Converters of two-way bindings are wrapped in WpfCompat's TwoWayConverter, one per binding
      (x:Shared="False"): Avalonia's bindings write back the value they show, so a converter that
      shows a default (a NaN font size as 12, an automatic line style as solid) would change the plot.
-->
<UserControl x:Class="OxyPlotControls.AxisControl" x:Name="AxisProperties"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="using:System"
             xmlns:local="using:OxyPlotControls"
             xmlns:cntrls="using:GenericControls"
             xmlns:wpfd="using:WpfCompat.Data"
             xmlns:wpfm="using:WpfCompat.Markup"
             mc:Ignorable="d"
             MinWidth="200"
             MinHeight="100"
             d:DesignHeight="450" d:DesignWidth="800"
             DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://OxyPlotControls/Resources/ResourceDictionary.axaml"/>
                <ResourceDictionary>
                    <wpfm:ArrayExtension Type="{x:Type sys:Double}" x:Key="FractionUnitOptions">
                        <sys:Double>1</sys:Double>
                        <sys:Double>2</sys:Double>
                        <sys:Double>3</sys:Double>
                        <sys:Double>4</sys:Double>
                        <sys:Double>5</sys:Double>
                    </wpfm:ArrayExtension>
                    <wpfd:TwoWayConverter x:Key="DateNumberConverter" x:Shared="False">
                        <local:DateToNumberConverter/>
                    </wpfd:TwoWayConverter>
                    <wpfd:TwoWayConverter x:Key="ConvertColorToBrush" x:Shared="False">
                        <local:OxyAutomaticColorConverter/>
                    </wpfd:TwoWayConverter>
                    <wpfd:TwoWayConverter x:Key="LineStyleConverter" x:Shared="False">
                        <local:OxyLineStyleToDashArrayConverter/>
                    </wpfd:TwoWayConverter>
                    <wpfd:TwoWayConverter x:Key="EmptyToNullConverter" x:Shared="False">
                        <local:EmptyStringToNullConverter/>
                    </wpfd:TwoWayConverter>
                    <local:ReverseAxisConverter x:Key="ReverseConverter"/>
                    <wpfd:TwoWayConverter x:Key="DefaultFontSizeConverter" x:Shared="False">
                        <local:OxyDefaultFontSizeConverter/>
                    </wpfd:TwoWayConverter>
                    <cntrls:DoubleToGridLengthConverter x:Key="ActualToLengthConverter" />
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <TabControl
            x:Name="AxisTabControl"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="0"
            Padding="0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center">
            <TabControl.Styles>
                <Style
                    Selector="TabControl /template/ ItemsPresenter#PART_ItemsPresenter > WrapPanel">
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                </Style>
            </TabControl.Styles>

            <TabItem x:Name="GeneralTab" Header="GENERAL" Theme="{Binding ElementName=AxisProperties, Path=TabItemStyle}" >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="0"/>
                    </Grid.RowDefinitions>

                    <cntrls:ContentPropertyControl
                        Name="DummyPropertyControl"
                        Grid.Row="4"
                        Opacity="0" IsHitTestVisible="False"
                        Title="Position at Zero Crossing"
                        Margin="6 0 0 0"/>

                    <!--AXIS OPTIONS-->
                    <Expander x:Name="GeneralEXP"
                        Grid.Row="0"
                        Margin="0,4,0,8"
                        Header="OPTIONS"
                        IsExpanded="True"
                        Grid.ColumnSpan="2"
                        Theme="{Binding ElementName=AxisProperties, Path=ExpanderStyle}">
                        <!--General-->
                        <DockPanel>

                            <!--Minimum-->
                            <cntrls:DateTimePropertyControl
                                x:Name="DateAxisMinimum"
                                Margin="0 2"
                                Height="24"
                                DockPanel.Dock="Top"
                                MaxPropertyWidth="200"
                                Title="Minimum"
                                IsVisible="False"
                                SelectedDateTime="{Binding ElementName=AxisProperties, Path=Axis.Minimum, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource DateNumberConverter}}"
                                PropertyWidth="{Binding ElementName=DummyPropertyControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"
                                IsEnabled="{Binding ElementName=AxisProperties, Path=Axis.IsEffectivelyEnabled}"/>

                            <!--Minimum-->
                            <cntrls:NumericAutoPropertyControl x:Name="AxisMinimum"
                                Margin="0 2"
                                DockPanel.Dock="Top"
                                MaxPropertyWidth="200"
                                Title="Minimum"
                                CanHaveNegative="True"
                                DefaultNumber="{x:Static sys:Double.NaN}"
                                Number="{Binding ElementName=AxisProperties, Path=Axis.Minimum, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                PropertyWidth="{Binding ElementName=DummyPropertyControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"
                                IsEnabled="{Binding ElementName=AxisProperties, Path=Axis.IsEffectivelyEnabled}"
                                PreviewNumberChanged="AxisMinimum_PreviewNumberChanged"/>

                            <!--Maximum-->
                            <cntrls:DateTimePropertyControl x:Name="DateAxisMaximum"
                                Margin="0 2"
                                DockPanel.Dock="Top"
                                MaxPropertyWidth="200"
                                Title="Maximum"
                                Height="24"
                                IsVisible="False"
                                SelectedDateTime="{Binding ElementName=AxisProperties, Path=Axis.Maximum, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource DateNumberConverter}}"
                                PropertyWidth="{Binding ElementName=DummyPropertyControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"
                                IsEnabled="{Binding ElementName=AxisProperties, Path=Axis.IsEffectivelyEnabled}"/>

                            <!--Maximum-->
                            <cntrls:NumericAutoPropertyControl x:Name="AxisMaximum"
                                Margin="0 2"
                                DockPanel.Dock="Top"
                                MaxPropertyWidth="200"
                                Title="Maximum"
                                CanHaveNegative="True"
                                DefaultNumber="{x:Static sys:Double.NaN}"
                                Number="{Binding ElementName=AxisProperties, Path=Axis.Maximum, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                PropertyWidth="{Binding ElementName=DummyPropertyControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"
                                IsEnabled="{Binding ElementName=AxisProperties, Path=Axis.IsEffectivelyEnabled}"
                                PreviewNumberChanged="AxisMaximum_PreviewNumberChanged"/>

                            <!--Change Axis Type-->
                            <cntrls:ContentPropertyControl
                                x:Name="AxisTypeSelector"
                                Margin="0 2"
                                DockPanel.Dock="Top"
                                MaxPropertyWidth="200"
                                Title="Axis Type"
                                IsEnabled="{Binding ElementName=AxisProperties, Path=Axis.IsEffectivelyEnabled}"
                                PropertyWidth="{Binding ElementName=DummyPropertyControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}">
                                <cntrls:ContentPropertyControl.InnerContent>
                                    <ComboBox
                                        SelectionChanged="AxisTypeComboBox_SelectionChanged">
                                        <ComboBoxItem
                                            Content="Linear"/>
                                        <ComboBoxItem
                                            Content="Logarithmic"/>
                                        <ComboBoxItem
                                            Content="Normal Probability"/>
                                        <ComboBoxItem
                                            Content="Gumbel Probability"/>
                                        <ComboBoxItem
                                            Content="Date Time"/>
                                    </ComboBox>
                                </cntrls:ContentPropertyControl.InnerContent>
                            </cntrls:ContentPropertyControl>

                            <!--Gap Width (Category Axis Only, Binding is set in code behind)-->
                            <cntrls:NumericPropertySelectorControl
                                x:Name="GapWidthSelector"
                                Margin="0 2"
                                DockPanel.Dock="Top"
                                MaxPropertyWidth="200"
                                Title="Gap Width"
                                NumericOptions="{StaticResource LineWidthOptions}"
                                PropertyWidth="{Binding ElementName=DummyPropertyControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"
                                IsVisible="False"
                                IsEnabled="{Binding ElementName=AxisProperties, Path=Axis.IsEffectivelyEnabled}"/>

                            <!--Power Padding (Logarithmic Axis Only, Binding is set in code behind)-->
                            <cntrls:BooleanPropertyControl
                                x:Name="PowerPaddingControl"
                                Margin="0 2"
                                DockPanel.Dock="Top"
                                Title="Power Padding"
                                IsVisible="False"
                                IsEnabled="{Binding ElementName=AxisProperties, Path=Axis.IsEffectivelyEnabled}"/>

                        </DockPanel>
                    </Expander>

                    <!--AXIS OPTIONS-->
                    <Expander x:Name="DisplayEXP"
                        Grid.Row="1"
                        Margin="0,0,0,8"
                        Header="DISPLAY"
                        IsExpanded="True"
                        Grid.ColumnSpan="2"
                        Theme="{Binding ElementName=AxisProperties, Path=ExpanderStyle}">
                        <!--General-->
                        <DockPanel>

                            <!--Axis Line Color  (USER)-->
                            <cntrls:ColorPropertyControl
                                Margin="0 2"
                                DockPanel.Dock="Top"
                                Title="Axis Line Color"
                                SelectedColor="{Binding ElementName=AxisProperties, Path=Axis.AxislineColor, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource ConvertColorToBrush}}"
                                IsEnabled="{Binding ElementName=AxisProperties, Path=Axis.IsEffectivelyEnabled}"/>

                            <!--Axis Line Style  (USER)-->
                            <cntrls:LineStyleSelectorControl
                                x:Name="AxisLineStyleControl"
                                Margin="0 2"
                                DockPanel.Dock="Top"
                                MaxPropertyWidth="200"
                                Title="Axis Line Style"
                                DashArrayOptions="{Binding ElementName=AxisProperties, Path=LineStyleOptions}"
                                SelectedDashArray="{Binding ElementName=AxisProperties, Path=Axis.AxislineStyle, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource LineStyleConverter}}"
                                PropertyWidth="{Binding ElementName=DummyPropertyControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"
                                IsEnabled="{Binding ElementName=AxisProperties, Path=Axis.IsEffectivelyEnabled}"/>

                            <!--Axis Line Thickness  (USER)-->
                            <cntrls:LineWidthSelectorControl
                                Margin="0 2"
                                DockPanel.Dock="Top"
                                MaxPropertyWidth="200"
                                Title="Axis Line Thickness"
                                WidthOptions="{StaticResource LineWidthOptions}"
                                SelectedWidth="{Binding Axis.AxislineThickness, ElementName=AxisProperties, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                PropertyWidth="{Binding ElementName=DummyPropertyControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"
                                IsEnabled="{Binding ElementName=AxisProperties, Path=Axis.IsEffectivelyEnabled}"/>

                            <!--Axis Distance  (USER)-->
                            <cntrls:NumericPropertySelectorControl
                                Margin="0 2"
                                DockPanel.Dock="Top"
                                MaxPropertyWidth="200"
                                Title="Axis Distance"
                                CanHaveNegative="True"
                                NumericOptions="{StaticResource PaddingOptions}"
                                SelectedNumber="{Binding ElementName=AxisProperties, Path=Axis.AxisDistance, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                PropertyWidth="{Binding ElementName=DummyPropertyControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"
                                IsEnabled="{Binding ElementName=AxisProperties, Path=Axis.IsEffectivelyEnabled}"/>

                            <!--Reverse Axis  (USER)-->
                            <cntrls:BooleanPropertyControl
                                x:Name="ReverseBooleanControl"
                                Margin="0 2"
                                DockPanel.Dock="Top"
                                Title="Reverse Axis"
                                IsEnabled="{Binding ElementName=AxisProperties, Path=Axis.IsEffectivelyEnabled}">
                                <cntrls:BooleanPropertyControl.IsSelected>
                                    <wpfd:MultiBinding
                                        Converter="{StaticResource ReverseConverter}"
                                        UpdateSourceTrigger="PropertyChanged" Mode="TwoWay">
                                        <Binding
                                            Path="Axis.StartPosition"
                                            ElementName="AxisProperties"
                                            UpdateSourceTrigger="PropertyChanged"
                                            Mode="TwoWay"/>
                                        <Binding
                                            Path="Axis.EndPosition"
                                            ElementName="AxisProperties"
                                            UpdateSourceTrigger="PropertyChanged"
                                            Mode="TwoWay"/>
                                        <Binding
                                            Path="Axis"
                                            ElementName="AxisProperties"
                                            UpdateSourceTrigger="PropertyChanged"
                                            Mode="OneWay"/>
                                    </wpfd:MultiBinding>
                                </cntrls:BooleanPropertyControl.IsSelected>
                            </cntrls:BooleanPropertyControl>

                            <!--Position axis at zero crossing  (USER)-->
                            <cntrls:BooleanPropertyControl
                                Margin="0 2"
                                DockPanel.Dock="Top"
                                Title="Position at Zero Crossing"
                                IsSelected="{Binding ElementName=AxisProperties, Path=Axis.PositionAtZeroCrossing, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                IsEnabled="{Binding ElementName=AxisProperties, Path=Axis.IsEffectivelyEnabled}"/>


                        </DockPanel>
                    </Expander>

                </Grid>
            </TabItem>

            <!--LABELS-->
            <TabItem
                x:Name="LabelsTab"
                Header="LABELS"
                Theme="{Binding ElementName=AxisProperties, Path=TabItemStyle}"
                IsEnabled="{Binding ElementName=AxisProperties, Path=Axis.IsEffectivelyEnabled}">
                <Grid VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="0"/>
                    </Grid.RowDefinitions>

                    <cntrls:ContentPropertyControl
                        Name="DummyPropertyControl2"
                        Grid.Row="2"
                        Opacity="0" IsHitTestVisible="False"
                        Title="Tick To Label Distance"
                        Margin="6 0 0 0"/>

                    <!--AXIS TITLE-->
                    <Expander x:Name="TitleEXP"
                        Grid.Row="0"
                        Margin="0,4,0,8"
                        Grid.ColumnSpan="2"
                        Header="TITLE"
                        IsExpanded="True"
                        DockPanel.Dock="Top"
                        Theme="{Binding ElementName=AxisProperties, Path=ExpanderStyle}">
                        <!--Title-->
                        <DockPanel>

                            <!--Title Text-->
                            <cntrls:TextPropertyControl
                                Margin="0 2"
                                DockPanel.Dock="Top"
                                MaxPropertyWidth="400"
                                Title="Text"
                                Text="{Binding Axis.Title, ElementName=AxisProperties, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                PropertyWidth="{Binding ElementName=DummyPropertyControl2, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

                            <!--Title Color-->
                            <cntrls:ColorPropertyControl
                                Margin="0 2"
                                DockPanel.Dock="Top"
                                Title="Color"
                                SelectedColor="{Binding Axis.TitleColor, ElementName=AxisProperties, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource ConvertColorToBrush}}"/>

                            <!--Title Font-->
                            <cntrls:FontSelectorControl
                                Margin="0 2"
                                DockPanel.Dock="Top"
                                MaxPropertyWidth="200"
                                Title="Font"
                                FontFamilyString="{Binding Path=Axis.TitleFont, ElementName=AxisProperties, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                PropertyWidth="{Binding ElementName=DummyPropertyControl2, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

                            <!--Title Font Size-->
                            <cntrls:NumericPropertySelectorControl
                                Margin="0 2"
                                DockPanel.Dock="Top"
                                MaxPropertyWidth="200"
                                Title="Font Size"
                                CanHaveNegative="False"
                                NumericOptions="{StaticResource FontSizeOptions}"
                                SelectedNumber="{Binding Axis.TitleFontSize, ElementName=AxisProperties, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource DefaultFontSizeConverter}}"
                                PropertyWidth="{Binding ElementName=DummyPropertyControl2, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

                            <!--Title Font Weight-->
                            <cntrls:FontWeightSelectorControl
                                Margin="0 2"
                                DockPanel.Dock="Top"
                                MaxPropertyWidth="200"
                                Title="Font Weight"
                                SelectedFontWeight="{Binding Path=Axis.TitleFontWeight, ElementName=AxisProperties, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                PropertyWidth="{Binding ElementName=DummyPropertyControl2, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

                            <!--Axis Title Distance (DEVELOPER)-->
                            <cntrls:NumericPropertySelectorControl
                                Margin="0 2"
                                DockPanel.Dock="Top"
                                Title="Distance From Axis"
                                CanHaveNegative="True"
                                NumericOptions="{StaticResource PaddingOptions}"
                                SelectedNumber="{Binding ElementName=AxisProperties, Path=Axis.AxisTitleDistance, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                PropertyWidth="{Binding ElementName=DummyPropertyControl2, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

                            <!--Units-->
                            <cntrls:TextPropertyControl
                                Margin="0 2"
                                DockPanel.Dock="Top"
                                MaxPropertyWidth="200"
                                Title="Units"
                                Text="{Binding Axis.Unit, ElementName=AxisProperties, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource EmptyToNullConverter}}"
                                PropertyWidth="{Binding ElementName=DummyPropertyControl2, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

                        </DockPanel>

                    </Expander>

                    <!--AXIS LABELS-->
                    <Expander x:Name="LabelsEXP"
                        Grid.Row="1"
                        Margin="0,0,0,8"
                        Header="LABELS"
                        IsExpanded="True"
                        DockPanel.Dock="Top"
                        VerticalAlignment="Stretch"

                        Theme="{Binding ElementName=AxisProperties, Path=ExpanderStyle}">
                        <!--Label Controls-->
                        <DockPanel>

                            <!--Label Text Color-->
                            <cntrls:ColorPropertyControl
                                Margin="0 2"
                                DockPanel.Dock="Top"
                                Title="Text Color"
                                SelectedColor="{Binding ElementName=AxisProperties, Path=Axis.TextColor, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource ConvertColorToBrush}}"/>

                            <!--Axis Label Font-->
                            <cntrls:FontSelectorControl
                                Margin="0 2"
                                DockPanel.Dock="Top"
                                MaxPropertyWidth="200"
                                Title="Font"
                                FontFamilyString="{Binding Path=Axis.Font, ElementName=AxisProperties, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                PropertyWidth="{Binding ElementName=DummyPropertyControl2, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

                            <!--Axis Label Font Size-->
                            <cntrls:NumericPropertySelectorControl
                                Margin="0 2"
                                DockPanel.Dock="Top"
                                MaxPropertyWidth="200"
                                Title="Font Size"
                                CanHaveNegative="False"
                                NumericOptions="{StaticResource FontSizeOptions}"
                                SelectedNumber="{Binding Axis.FontSize, ElementName=AxisProperties, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource DefaultFontSizeConverter}}"
                                PropertyWidth="{Binding ElementName=DummyPropertyControl2, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

                            <!--Axis Label Font Weight-->
                            <cntrls:FontWeightSelectorControl
                                Margin="0 2"
                                DockPanel.Dock="Top"
                                MaxPropertyWidth="200"
                                Title="Font Weight"
                                SelectedFontWeight="{Binding Path=Axis.FontWeight, ElementName=AxisProperties, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                PropertyWidth="{Binding ElementName=DummyPropertyControl2, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

                            <!--Axis Text Angle-->
                            <cntrls:NumericPropertySelectorControl
                                Margin="0 2"
                                DockPanel.Dock="Top"
                                MaxPropertyWidth="200"
                                Title="Text Angle"
                                CanHaveNegative="True"
                                NumericOptions="{StaticResource AngleOptions}"
                                SelectedNumber="{Binding ElementName=AxisProperties, Path=Axis.Angle, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                PropertyWidth="{Binding ElementName=DummyPropertyControl2, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

                            <!--Axis Tick Distance-->
                            <cntrls:NumericPropertySelectorControl
                                Margin="0 2"
                                DockPanel.Dock="Top"
                                MaxPropertyWidth="200"
                                Title="Tick To Label Distance"
                                CanHaveNegative="True"
                                NumericOptions="{StaticResource PaddingOptions}"
                                SelectedNumber="{Binding ElementName=AxisProperties, Path=Axis.AxisTickToLabelDistance, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                PropertyWidth="{Binding ElementName=DummyPropertyControl2, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

                            <!--Label Category-->
                            <cntrls:ContentPropertyControl
                                x:Name="LabelTypeSelector"
                                Margin="0 2"
                                DockPanel.Dock="Top"
                                MaxPropertyWidth="200"
                                Title="Label Type"
                                IsEnabled="{Binding ElementName=AxisProperties, Path=Axis.IsEffectivelyEnabled}"
                                PropertyWidth="{Binding ElementName=DummyPropertyControl2, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}">
                                <cntrls:ContentPropertyControl.InnerContent>
                                    <ComboBox
                                        SelectionChanged="LabelType_SelectionChanged">
                                        <ComboBoxItem Content="Currency"/>
                                        <ComboBoxItem Content="General"/>
                                        <ComboBoxItem Content="Number"/>
                                        <ComboBoxItem Content="Percent"/>
                                        <ComboBoxItem Content="Scientific"/>
                                    </ComboBox>
                                </cntrls:ContentPropertyControl.InnerContent>
                            </cntrls:ContentPropertyControl>

                            <!--Decimal Places-->
                            <cntrls:NumericAutoPropertyControl x:Name="DecimalPlaces"
                                Margin="0 2"
                                DockPanel.Dock="Top"
                                MaxPropertyWidth="200"
                                Title="Decimal Places"
                                CanHaveNegative="False"
                                DefaultNumber="{x:Static sys:Double.NaN}"
                                MinValue="0" MaxValue="15"
                                PropertyWidth="{Binding ElementName=DummyPropertyControl2, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"
                                PropertyChanged="DecimalPlaces_PropertyChanged"
                                IsEnabled="{Binding ElementName=AxisProperties, Path=Axis.IsEffectivelyEnabled}"
                                PreviewNumberChanged="DecimalPlaces_PreviewNumberChanged"/>

                            <!--Use SuperScript-->
                            <cntrls:BooleanPropertyControl
                                Margin="0 2"
                                DockPanel.Dock="Top"
                                Title="Superscript Notation"
                                IsSelected="{Binding ElementName=AxisProperties, Path=Axis.UseSuperExponentialFormat, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

                            <!--Axis Labels (Category Axis Only, Binding is set in code behind)-->
                            <cntrls:StringListPropertyControl
                                x:Name="AxisLabelsControl"
                                VerticalAlignment="Top"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                AddRemoveEnabled="False"
                                Title="Labels"
                                IsVisible="False"/>

                        </DockPanel>
                    </Expander>

                </Grid>
            </TabItem>

            <!--GRID LINES-->
            <TabItem x:Name="GridLinesTab" Header="GRID LINES" Theme="{Binding ElementName=AxisProperties, Path=TabItemStyle}"  IsEnabled="{Binding ElementName=AxisProperties, Path=Axis.IsEffectivelyEnabled}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="0"/>
                    </Grid.RowDefinitions>

                    <cntrls:ContentPropertyControl
                        Name="DummyPropertyControl3"
                        Grid.Row="3"
                        Opacity="0" IsHitTestVisible="False"
                        Title="Minor Grid Line Thickness"
                        Margin="6 0 0 0"/>

                    <Expander x:Name="MajorGridLinesEXP"
                        Grid.Row="0"
                        Margin="0,4,0,8"
                        Header="MAJOR GRID LINES"
                        IsExpanded="True"
                        Theme="{Binding ElementName=AxisProperties, Path=ExpanderStyle}"
                        Grid.ColumnSpan="3">
                        <!--Major Grid Line Controls-->
                        <DockPanel>

                            <!--Major Grid Line Color-->
                            <cntrls:ColorPropertyControl
                                Margin="0 2" DockPanel.Dock="Top"
                                Title="Major Grid Line Color"
                                SelectedColor="{Binding ElementName=AxisProperties, Path=Axis.MajorGridlineColor, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource ConvertColorToBrush}}"/>

                            <!--Major Grid Line Style-->
                            <cntrls:LineStyleSelectorControl
                                Margin="0 2"
                                DockPanel.Dock="Top"
                                MaxPropertyWidth="200"
                                Title="Major Grid Line Style"
                                DashArrayOptions="{Binding ElementName=AxisProperties, Path=LineStyleOptions}"
                                SelectedDashArray="{Binding ElementName=AxisProperties, Path=Axis.MajorGridlineStyle, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource LineStyleConverter}}"
                                PropertyWidth="{Binding ElementName=DummyPropertyControl3, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

                            <!--Major Grid Line Thickness-->
                            <cntrls:LineWidthSelectorControl
                                Margin="0 2"
                                DockPanel.Dock="Top"
                                MaxPropertyWidth="200"
                                Title="Major Grid Line Thickness"
                                WidthOptions="{StaticResource LineWidthOptions}"
                                SelectedWidth="{Binding Axis.MajorGridlineThickness, ElementName=AxisProperties, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                PropertyWidth="{Binding ElementName=DummyPropertyControl3, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

                            <!--Major Grid Line Step-->
                            <cntrls:NumericAutoPropertyControl
                                Margin="0 2"
                                DockPanel.Dock="Top"
                                MaxPropertyWidth="200"
                                Title="Major Step"
                                CanHaveNegative="False"
                                DefaultNumber="{x:Static sys:Double.NaN}"
                                Number="{Binding ElementName=AxisProperties, Path=Axis.MajorStep, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                PropertyWidth="{Binding ElementName=DummyPropertyControl3, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

                            <!--Major Tick Size-->
                            <cntrls:NumericPropertyControl
                                Margin="0 2"
                                DockPanel.Dock="Top"
                                MaxPropertyWidth="200"
                                Title="Major Tick Size"
                                CanHaveNegative="False"
                                Number="{Binding ElementName=AxisProperties, Path=Axis.MajorTickSize, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                PropertyWidth="{Binding ElementName=DummyPropertyControl3, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>
                        </DockPanel>

                    </Expander>

                    <!--Minor Grid Line Controls-->
                    <Expander x:Name="MinorGridLinesEXP"
                              Grid.Row="1"
                              Margin="0,0,0,8"
                              Header="MINOR GRID LINES"
                              IsExpanded="True"
                              Theme="{Binding ElementName=AxisProperties, Path=ExpanderStyle}" Grid.ColumnSpan="3">
                        <DockPanel>

                            <!--Minor Grid Line Color-->
                            <cntrls:ColorPropertyControl
                                Margin="0 2"
                                DockPanel.Dock="Top"
                                Title="Minor Grid Line Color"
                                SelectedColor="{Binding ElementName=AxisProperties, Path=Axis.MinorGridlineColor, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource ConvertColorToBrush}}"/>

                            <!--Minor Grid Line Style-->
                            <cntrls:LineStyleSelectorControl
                                Margin="0 2"
                                DockPanel.Dock="Top"
                                MaxPropertyWidth="200"
                                Title="Minor Grid Line Style"
                                DashArrayOptions="{Binding ElementName=AxisProperties, Path=LineStyleOptions}"
                                SelectedDashArray="{Binding ElementName=AxisProperties, Path=Axis.MinorGridlineStyle, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource LineStyleConverter}}"
                                PropertyWidth="{Binding ElementName=DummyPropertyControl3, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

                            <!--Minor Grid Line Thickness-->
                            <cntrls:LineWidthSelectorControl
                                Margin="0 2"
                                DockPanel.Dock="Top"
                                MaxPropertyWidth="200"
                                Title="Minor Grid Line Thickness"
                                WidthOptions="{StaticResource LineWidthOptions}"
                                SelectedWidth="{Binding Axis.MinorGridlineThickness, ElementName=AxisProperties, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                PropertyWidth="{Binding ElementName=DummyPropertyControl3, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

                            <!--Minor Grid Line Step-->
                            <cntrls:NumericAutoPropertyControl
                                Margin="0 2"
                                DockPanel.Dock="Top"
                                MaxPropertyWidth="200"
                                Title="Minor Step"
                                CanHaveNegative="False"
                                DefaultNumber="{x:Static sys:Double.NaN}"
                                Number="{Binding ElementName=AxisProperties, Path=Axis.MinorStep, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                PropertyWidth="{Binding ElementName=DummyPropertyControl3, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

                            <!--Minor Tick Size-->
                            <cntrls:NumericPropertyControl
                                Margin="0 2"
                                DockPanel.Dock="Top"
                                MaxPropertyWidth="200"
                                Title="Minor Tick Size"
                                CanHaveNegative="False"
                                Number="{Binding ElementName=AxisProperties, Path=Axis.MinorTickSize, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                PropertyWidth="{Binding ElementName=DummyPropertyControl3, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

                        </DockPanel>

                    </Expander>

                    <!--TICK OPTIONS-->
                    <Expander x:Name="TickOptionsEXP"
                        Grid.Row="2"
                        Margin="0,0,0,8"
                        Header="TICK OPTIONS"
                        IsExpanded="True"
                        Theme="{Binding ElementName=AxisProperties, Path=ExpanderStyle}" Grid.ColumnSpan="3">
                        <!--Tick Style Controls-->
                        <DockPanel>

                            <!--Axis Tick Style-->
                            <cntrls:ContentPropertyControl
                                Title="Tick Style"
                                Margin="0 2"
                                DockPanel.Dock="Top"
                                MaxPropertyWidth="200"
                                PropertyWidth="{Binding ElementName=DummyPropertyControl3, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}">
                                <cntrls:ContentPropertyControl.InnerContent>
                                    <ComboBox
                                        ItemsSource="{Binding AxisTickStyleOptions}"
                                        SelectedValue="{Binding Path=Axis.TickStyle, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                                </cntrls:ContentPropertyControl.InnerContent>
                            </cntrls:ContentPropertyControl>

                            <!--Tick Line Color-->
                            <cntrls:ColorPropertyControl
                                Margin="0 2"
                                DockPanel.Dock="Top"
                                Title="Tick Line Color"
                                SelectedColor="{Binding ElementName=AxisProperties, Path=Axis.TicklineColor, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource ConvertColorToBrush}}"/>

                            <!--Is Tick Centered (Category Axis Only, Binding is set in code behind)-->
                            <cntrls:BooleanPropertyControl
                                x:Name="TickCenteredControl"
                                Margin="0 2"
                                DockPanel.Dock="Top"
                                Title="Tick Centered"
                                IsVisible="False"/>

                        </DockPanel>
                    </Expander>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
