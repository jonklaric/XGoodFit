<!--
    XGoodFit port of upstream's GeneralPlotControl.xaml:
    - The resource dictionary is merged with a ResourceInclude; the expanders' Style bindings are Theme
      bindings (Avalonia's styles are ControlThemes).
    - The hidden dummy property control, which only measures the property column, is Opacity="0"
      without hit testing, as WPF's Visibility="Hidden".
    - Converters of two-way bindings are wrapped in WpfCompat's TwoWayConverter, one per binding
      (x:Shared="False"): Avalonia's bindings write back the value they show, so a converter that
      shows a default (a NaN font size as 12, an automatic line style as solid) would change the plot.
-->
<UserControl x:Class="OxyPlotControls.GeneralPlotControl" x:Name="GeneralPlotProperties"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:OxyPlotControls"
             xmlns:wpfd="using:WpfCompat.Data"
             xmlns:cntrls="using:GenericControls"
             mc:Ignorable="d"
             MinWidth="200"
             MinHeight="100"
             d:DesignHeight="450" d:DesignWidth="800"
             >
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://OxyPlotControls/Resources/ResourceDictionary.axaml"/>
                <ResourceDictionary>
                    <wpfd:TwoWayConverter x:Key="OxyAutoColorConverter" x:Shared="False">
                        <local:OxyAutomaticColorConverter/>
                    </wpfd:TwoWayConverter>
                    <wpfd:TwoWayConverter x:Key="ConvertThicknessToDouble" x:Shared="False">
                        <cntrls:ThicknessToDoubleConverter/>
                    </wpfd:TwoWayConverter>
                    <wpfd:TwoWayConverter x:Key="DefaultFontSizeConverter" x:Shared="False">
                        <local:OxyDefaultFontSizeConverter/>
                    </wpfd:TwoWayConverter>
                    <cntrls:DoubleToGridLengthConverter x:Key="ActualToLengthConverter" />
                    <wpfd:TwoWayConverter x:Key="BrushToSolidConverter" x:Shared="False">
                        <local:SolidColorBrushConverter/>
                    </wpfd:TwoWayConverter>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="0"/>
        </Grid.RowDefinitions>

        <cntrls:ContentPropertyControl
            Name="DummyPropertyControl"
            Grid.Row="4"
            Opacity="0" IsHitTestVisible="False"
            Title="Border Thickness"
            Margin="6 0 0 0"/>

            <!--Title Controls-->
        <Expander x:Name="PlotTitleEXP"
            Grid.Row="0" Margin="0,0,0,8"
            Header="PLOT TITLE"
            IsExpanded="True"
            Theme="{Binding ElementName=GeneralPlotProperties, Path=ExpanderStyle}">

            <DockPanel>

                <!--Title Text-->
                <cntrls:TextPropertyControl
                    x:Name="TitleTextControl"
                    Margin="0 2"
                    DockPanel.Dock="Top"
                    MaxPropertyWidth="200"
                    Title="Title"
                    TextWrapping="NoWrap"
                    Text="{Binding Plot.Title, ElementName=GeneralPlotProperties, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    PropertyWidth="{Binding ElementName=DummyPropertyControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

                <!--Title Color-->
                <cntrls:ColorPropertyControl
                    x:Name="TitleColorControl"
                    Margin="0 2"
                    DockPanel.Dock="Top"
                    Title="Color"
                    SelectedColor="{Binding Plot.TitleColor, ElementName=GeneralPlotProperties, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource OxyAutoColorConverter}}"/>

                <!--Title Font-->
                <cntrls:FontSelectorControl
                    x:Name="TitleFontControl"
                    Margin="0 2"
                    DockPanel.Dock="Top"
                    MaxPropertyWidth="200"
                    Title="Font"
                    FontFamilyString="{Binding Path=Plot.TitleFont, ElementName=GeneralPlotProperties, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    PropertyWidth="{Binding ElementName=DummyPropertyControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

                <!--Title Font Size-->
                <cntrls:NumericPropertySelectorControl
                    x:Name="TitleFontSizeControl"
                    Margin="0 2"
                    DockPanel.Dock="Top"
                    MaxPropertyWidth="200"
                    Title="Font Size"
                    CanHaveNegative="False"
                    NumericOptions="{StaticResource FontSizeOptions}"
                    SelectedNumber="{Binding Plot.TitleFontSize, ElementName=GeneralPlotProperties, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource DefaultFontSizeConverter}}"
                    PropertyWidth="{Binding ElementName=DummyPropertyControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

                <!--Title Font Weight-->
                <cntrls:FontWeightSelectorControl
                    x:Name="TitleFontWeightControl"
                    Margin="0 2"
                    DockPanel.Dock="Top"
                    MaxPropertyWidth="200"
                    Title="Font Weight"
                    SelectedFontWeight="{Binding Path=Plot.TitleFontWeight, ElementName=GeneralPlotProperties, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    PropertyWidth="{Binding ElementName=DummyPropertyControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

                <!--Title Padding-->
                <cntrls:NumericPropertySelectorControl
                    x:Name="TitlePaddingControl"
                    Margin="0 2"
                    DockPanel.Dock="Top"
                    MaxPropertyWidth="200"
                    Title="Padding"
                    NumericOptions="{StaticResource PaddingOptions}"
                    SelectedNumber="{Binding Path=Plot.TitlePadding, ElementName=GeneralPlotProperties, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    PropertyWidth="{Binding ElementName=DummyPropertyControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>
            </DockPanel>
        </Expander>

        <!--SubTitle Controls-->
        <Expander x:Name="PlotSubtitleEXP"
            Grid.Row="1" Margin="0,0,0,8"
            Header="SUBTITLE"
            IsExpanded="True"
            Theme="{Binding ElementName=GeneralPlotProperties, Path=ExpanderStyle}">
            <DockPanel>

                <!--Subtitle Text-->
                <cntrls:TextPropertyControl
                    x:Name="SubtitleTextControl"
                    Margin="0 2"
                    DockPanel.Dock="Top"
                    MaxPropertyWidth="200"
                    TextWrapping="Wrap"
                    Title="Subtitle"
                    Text="{Binding Plot.Subtitle, ElementName=GeneralPlotProperties, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    PropertyWidth="{Binding ElementName=DummyPropertyControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

                <!--SubTitle Color-->
                <cntrls:ColorPropertyControl
                    x:Name="SubtitleColorControl"
                    Margin="0 2"
                    DockPanel.Dock="Top"
                    Title="Color"
                    SelectedColor="{Binding Plot.SubtitleColor, ElementName=GeneralPlotProperties, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource OxyAutoColorConverter}}"/>

                <!--SubTitle Font-->
                <cntrls:FontSelectorControl
                    x:Name="SubtitleFontControl"
                    Margin="0 2"
                    DockPanel.Dock="Top"
                    MaxPropertyWidth="200"
                    Title="Font"
                    FontFamilyString="{Binding Path=Plot.SubtitleFont, ElementName=GeneralPlotProperties, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    PropertyWidth="{Binding ElementName=DummyPropertyControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

                <!--SubTitle Font Size-->
                <cntrls:NumericPropertySelectorControl
                    x:Name="SubtitleFontSizeControl"
                    Margin="0 2"
                    DockPanel.Dock="Top"
                    MaxPropertyWidth="200"
                    Title="Font Size"
                    CanHaveNegative="False"
                    NumericOptions="{StaticResource FontSizeOptions}"
                    SelectedNumber="{Binding Plot.SubtitleFontSize, ElementName=GeneralPlotProperties, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource DefaultFontSizeConverter}}"
                    PropertyWidth="{Binding ElementName=DummyPropertyControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

                <!--SubTitle Font Weight-->
                <cntrls:FontWeightSelectorControl
                    x:Name="SubtitleFontWeightControl"
                    Margin="0 2"
                    DockPanel.Dock="Top"
                    MaxPropertyWidth="200"
                    Title="Font Weight"
                    SelectedFontWeight="{Binding Path=Plot.SubtitleFontWeight, ElementName=GeneralPlotProperties, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    PropertyWidth="{Binding ElementName=DummyPropertyControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>
            </DockPanel>

        </Expander>

        <!--Plot Area Controls-->
        <Expander x:Name="PlotAreaEXP"
            Grid.Row="2"
            Margin="0,0,0,8"
            Header="PLOT AREA"
            IsExpanded="True"
            Theme="{Binding ElementName=GeneralPlotProperties, Path=ExpanderStyle}">
            <DockPanel>

                <!--Plot Area Color-->
                <cntrls:ColorPropertyControl
                    x:Name="PlotAreaColorControl"
                    Margin="0 2"
                    DockPanel.Dock="Top"
                    Title="Plot Area Color"
                    SelectedColor="{Binding Plot.PlotAreaBackground, ElementName=GeneralPlotProperties, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, TargetNullValue=White, Converter={StaticResource BrushToSolidConverter}}"/>

                <!--Plot Area Border Color-->
                <cntrls:ColorPropertyControl
                    x:Name="PlotAreaBorderColorControl"
                    Margin="0 2"
                    DockPanel.Dock="Top"
                    Title="Border Color"
                    SelectedColor="{Binding Plot.PlotAreaBorderColor, ElementName=GeneralPlotProperties, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource OxyAutoColorConverter}}"/>

                <!--Plot Area Border Thickness-->
                <cntrls:LineWidthSelectorControl
                    x:Name="PlotAreaBorderThicknessControl"
                    Margin="0 2"
                    DockPanel.Dock="Top"
                    MaxPropertyWidth="200"
                    Title="Border Thickness" WidthOptions="{StaticResource LineWidthOptions}"
                    SelectedWidth="{Binding Plot.PlotAreaBorderThickness, ElementName=GeneralPlotProperties, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource ConvertThicknessToDouble}}"/>
            </DockPanel>
        </Expander>

        <!--Plot Controls-->
        <Expander x:Name="PlotBackgroundEXP"
                  Grid.Row="3"
                  Margin="0,0,0,8"
                  Header="BACKGROUND"
                  IsExpanded="True"
                  Theme="{Binding ElementName=GeneralPlotProperties, Path=ExpanderStyle}">
            <DockPanel>

                <!--Chart Area Padding-->
                <cntrls:NumericPropertySelectorControl
                    x:Name="BackgroundPaddingControl"
                    Margin="0 2" DockPanel.Dock="Top" Title="Padding" NumericOptions="{StaticResource PaddingOptions}"
                    SelectedNumber="{Binding Path=Plot.Padding, ElementName=GeneralPlotProperties, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource ConvertThicknessToDouble}}"
                    PropertyWidth="{Binding ElementName=DummyPropertyControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

                <!--Plot Background Color-->
                <cntrls:ColorPropertyControl
                    x:Name="BackgroundColorControl"
                    Margin="0 2"
                    DockPanel.Dock="Top"
                    Title="Background Color"
                    SelectedColor="{Binding Plot.Background, ElementName=GeneralPlotProperties, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource BrushToSolidConverter}}"/>

                <!--Plot Border Color-->
                <cntrls:ColorPropertyControl
                    x:Name="BorderColorControl"
                    Margin="0 2"
                    DockPanel.Dock="Top"
                    Title="Border Color" SelectedColor="{Binding Plot.BorderBrush, ElementName=GeneralPlotProperties, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource BrushToSolidConverter}}"/>

                <!--Plot Border Thickness-->
                <cntrls:LineWidthSelectorControl
                    x:Name="BorderThicknessControl"
                    Margin="0 2"
                    DockPanel.Dock="Top"
                    MaxPropertyWidth="200"
                    Title="Border Thickness"
                    WidthOptions="{StaticResource LineWidthOptions}"
                    SelectedWidth="{Binding Plot.BorderThickness, ElementName=GeneralPlotProperties, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource ConvertThicknessToDouble}}"
                    PropertyWidth="{Binding ElementName=DummyPropertyControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>
            </DockPanel>
        </Expander>

    </Grid>
</UserControl>
