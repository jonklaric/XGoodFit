<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Avalonia port of upstream/WPF-Framework/src/OxyPlotControls: the plot toolbar (pointer, pan, zoom,
    annotations, export), the property editors for plots, axes, series, annotations and legends, the
    image export dialog, settings serialization and the plot themes. It works on the ported
    OxyPlot.Wpf (src/Framework/OxyPlot). Nearly every file is WPF code, so the project opts in to
    upstream files (Directory.Build.targets): only the ported copies and the upstream files listed in
    UpstreamCompileInclude compile.

    Everything is ported, apart from:
    - Properties/AssemblyInfo.cs: the SDK generates the assembly attributes, as for the other ports; its
      ThemeInfo attribute has no Avalonia equivalent.
    - Resources/Save_chart_image.ico and Resources/pointer.ico: nothing uses them.
    - Properties/Resources.resx: its ResXFileRef entries need Windows Forms; Properties/Resources.Designer.cs
      is ported to read the same cursor files as embedded resources.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>OxyPlotControls</RootNamespace>
    <AssemblyName>OxyPlotControls</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <UpstreamProjectDir>$(UpstreamFrameworkSrc)OxyPlotControls/</UpstreamProjectDir>
    <UpstreamCompileMode>OptIn</UpstreamCompileMode>
    <!-- As upstream: the toolbar and the editors use OxyPlot's obsolete mouse events (CS0618). Upstream's
         CA1416 (Windows-only APIs) has nothing left to suppress. -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
    <!-- SavePlotImageDialog, as upstream, has only a constructor that takes the plot, so Avalonia's
         runtime XAML loader (which the previewer uses) can't create it; nothing loads it that way. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);AVLN3001</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OxyPlotControls.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(UpstreamFrameworkSrc)DatabaseManager/DatabaseManager.csproj" />
    <ProjectReference Include="../GenericControls/GenericControls.csproj" />
    <ProjectReference Include="../OxyPlot/OxyPlot.Wpf/OxyPlot.Wpf.csproj" />
    <ProjectReference Include="../Themes/Themes.csproj" />
    <ProjectReference Include="../WpfCompat/WpfCompat.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Upstream files that compile unchanged. -->
    <UpstreamCompileInclude Include="OxyPlotSettingsSerializer.cs" />
    <UpstreamCompileInclude Include="Theming/OxyPlotTheme.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The toolbar's cursors, read by Properties/Resources.Designer.cs (upstream's resx entries). -->
    <EmbeddedResource Include="$(UpstreamProjectDir)Resources/*.cur" LogicalName="OxyPlotControls.Resources.%(Filename)%(Extension)" Link="Resources/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
