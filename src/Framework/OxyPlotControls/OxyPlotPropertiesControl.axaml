<!--
    XGoodFit port of upstream's OxyPlotPropertiesControl.xaml:
    - The resource dictionary is merged with a ResourceInclude; the Style bindings are Theme bindings
      (Avalonia's styles are ControlThemes). The close button's Visibility binding is WpfCompat's.
    - Not ported: SnapsToDevicePixels.
-->
<UserControl x:Class="OxyPlotControls.OxyPlotPropertiesControl" x:Name="OxyplotProperties"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:OxyPlotControls"
             xmlns:cntrls="using:GenericControls"
             xmlns:wpf="using:WpfCompat"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="300">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://OxyPlotControls/Resources/ResourceDictionary.axaml"/>
                <ResourceDictionary>
                    <cntrls:BooleanToVisibilityConverter x:Key="VisibilityConverter" TrueValue="Visible" FalseValue="Collapsed"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="ComboBoxItem.ItemsviewHover.Background" Color="#1F26A0DA"/>
            <SolidColorBrush x:Key="ComboBoxItem.ItemsviewHover.Border" Color="#A826A0DA"/>
            <SolidColorBrush x:Key="ComboBoxItem.ItemsviewSelected.Background" Color="#3D26A0DA"/>
            <SolidColorBrush x:Key="ComboBoxItem.ItemsviewSelected.Border" Color="#FF26A0DA"/>
            <SolidColorBrush x:Key="ComboBoxItem.ItemsviewSelectedHover.Background" Color="#2E0080FF"/>
            <SolidColorBrush x:Key="ComboBoxItem.ItemsviewSelectedHover.Border" Color="#99006CD9"/>
            <SolidColorBrush x:Key="ComboBoxItem.ItemsviewSelectedNoFocus.Background" Color="#3DDADADA"/>
            <SolidColorBrush x:Key="ComboBoxItem.ItemsviewSelectedNoFocus.Border" Color="#FFDADADA"/>
            <SolidColorBrush x:Key="ComboBoxItem.ItemsviewFocus.Border" Color="#FF26A0DA"/>
            <SolidColorBrush x:Key="ComboBoxItem.ItemsviewHoverFocus.Background" Color="#5426A0DA"/>
            <SolidColorBrush x:Key="ComboBoxItem.ItemsviewHoverFocus.Border" Color="#FF26A0DA"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <!-- XGoodFit port: upstream binds the width to the back button's Width, which nothing sets: WPF
                 converts its NaN to Auto, Avalonia can't convert it at all. Auto sizes the column to the
                 button, as WPF does. -->
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--Back Arrow-->
        <Button
                x:Name="BackButton"
                Grid.Row="0"
                Grid.Column="0"
                Margin="0"
                ToolTip.Tip="Close Plot Properties"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch"
                Background="Transparent"
                BorderBrush="Transparent"
                Theme="{Binding ElementName=OxyplotProperties, Path=BackButtonStyle}"
                wpf:WpfElement.Visibility="{Binding ElementName=OxyplotProperties, Path=ShowCloseButton, Converter={StaticResource VisibilityConverter}}"
                Click="ClosePropertiesButton_Click">
            <Viewbox Width="14" Height="12" Margin="4">
                <ContentControl Content="{DynamicResource ClosePropertiesIcon}"/>
            </Viewbox>
        </Button>

        <!--Scrollviewer needs to be initialized before the combobox-->
        <ScrollViewer
            Name="ControlScrollViewer"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Auto"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Grid.Row="1">
            <Grid x:Name="PropertyControlsGrid" Margin="0,5,0,0">
                <!--Plot property controls will be generated on-the-fly in code behind and added to this grid-->
            </Grid>
        </ScrollViewer>

        <ComboBox
            x:Name="PropertyControlComboBox"
            Theme="{Binding ElementName=OxyplotProperties, Path=PropertyControlComboBoxStyle}"
            Grid.Row="0"
            Grid.Column="1"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            SelectedIndex="0"
            ToolTip.Tip="Click to Select Plot Component"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            Margin="0"
            FontSize="12"
            FontWeight="Bold"
            BorderThickness="0"
            SelectionChanged="PropertyControlComboBox_SelectionChanged">

            <ComboBoxItem Name="GeneralSettingsItem" HorizontalContentAlignment="Left" FontSize="12" Content="GENERAL PLOT SETTINGS"/>
            <ComboBoxItem Name="LegendItem" HorizontalContentAlignment="Left" FontSize="12" Content="LEGEND"/>
            <ComboBoxItem Name="AxesItem" HorizontalContentAlignment="Left" FontSize="12" Content="AXES"/>
            <ComboBoxItem Name="SeriesItem" HorizontalContentAlignment="Left" FontSize="12" Content="SERIES"/>
            <ComboBoxItem Name="AnnotationsItem" HorizontalContentAlignment="Left" FontSize="12" Content="ANNOTATIONS"/>
        </ComboBox>
    </Grid>
</UserControl>
