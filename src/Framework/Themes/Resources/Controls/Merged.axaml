<!-- Ported from upstream/WPF-Framework/src/Themes/Resources/Controls/Merged.xaml. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    Merged Control Templates

    This resource dictionary merges all control template definitions.
    Control templates use DynamicResource bindings to color keys,
    making them theme-agnostic. Colors are defined separately in
    the Colors folder and swapped at runtime.

    Based on Visual Studio 2013 styling from the Gemini project:
    https://github.com/tgjones/gemini
    -->

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- SHARED RESOURCES                                                             -->
    <!-- These resources are used by multiple control templates                       -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!--
    Focus Visual Style for keyboard navigation.
    XGoodFit port: WPF's FocusVisualStyle becomes an Avalonia focus adorner template.
    -->
    <FocusAdornerTemplate x:Key="GeminiFocusVisual">
        <Rectangle Margin="2"
                   StrokeDashArray="1,2"
                   Stroke="{DynamicResource FocusStyle.Brush}"
                   StrokeThickness="1"/>
    </FocusAdornerTemplate>

    <!--
    Standard drop shadow effect for popups and menus.
    XGoodFit port: WPF casts this shadow ShadowDepth="3" at Direction="305", measured anticlockwise
    from the right, so down and to the right. Avalonia's DropShadowDirectionEffect measures the angle
    the other way, so the WPF offsets are given directly: 3 cos 305° = 1.7207 right and
    -3 sin 305° = 2.4575 down. BlurRadius is WPF's default.
    -->
    <DropShadowEffect x:Key="StandardDropShadow"
                      OffsetX="1.7207"
                      OffsetY="2.4575"
                      BlurRadius="5"
                      Opacity="0.6"/>

    <!-- Disabled menu item foreground brush -->
    <SolidColorBrush x:Key="DisabledMenuItemBrush" Color="#FF9A9A9A"/>

    <!--
    XGoodFit port: WPF system values that upstream templates read from SystemColors and
    SystemParameters. They are fixed at their values on Windows at 96 DPI with the default settings,
    so every OS looks the same.
    -->
    <SolidColorBrush x:Key="SystemColors.ControlTextBrush" Color="#FF000000"/>
    <SolidColorBrush x:Key="SystemColors.GrayTextBrush" Color="#FF6D6D6D"/>
    <x:Double x:Key="SystemParameters.VerticalScrollBarWidth">17</x:Double>
    <x:Double x:Key="SystemParameters.HorizontalScrollBarHeight">17</x:Double>
    <x:Double x:Key="SystemParameters.VerticalScrollBarButtonHeight">17</x:Double>
    <x:Double x:Key="SystemParameters.HorizontalScrollBarButtonWidth">17</x:Double>
    <!-- WPF's ComboBox.MaxDropDownHeight default: a third of the primary screen's height, here 1080 pixels. -->
    <x:Double x:Key="SystemParameters.ComboBoxMaxDropDownHeight">360</x:Double>

    <!--
    Transparent RepeatButton for Slider and ScrollBar Track areas.
    XGoodFit port: a ControlTheme is complete on its own, as OverridesDefaultStyle="true" made the
    WPF style. Delay and Interval are WPF's RepeatButton defaults with Windows' default keyboard
    settings (500 and 33 ms); Avalonia's are 300 and 100 ms.
    -->
    <ControlTheme x:Key="RepeatButtonTransparent" TargetType="RepeatButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Delay" Value="500"/>
        <Setter Property="Interval" Value="33"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Rectangle Fill="{TemplateBinding Background}" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}"/>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- CONTROL TEMPLATES                                                            -->
    <!-- Ported control themes are merged here as they land, in upstream's order      -->
    <!-- (docs/migration-plan.md §6, Phase 3). Not yet here: DataGrid (with           -->
    <!-- ProDataGrid) and RichTextBox (with its replacements). StatusBar isn't        -->
    <!-- ported: nothing upstream uses one.                                           -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Themes/Resources/Controls/Button.axaml"/>
        <ResourceInclude Source="avares://Themes/Resources/Controls/Calendar.axaml"/>
        <ResourceInclude Source="avares://Themes/Resources/Controls/CheckBox.axaml"/>
        <ResourceInclude Source="avares://Themes/Resources/Controls/RadioButton.axaml"/>
        <ResourceInclude Source="avares://Themes/Resources/Controls/ComboBox.axaml"/>
        <ResourceInclude Source="avares://Themes/Resources/Controls/Expander.axaml"/>
        <ResourceInclude Source="avares://Themes/Resources/Controls/GridSplitter.axaml"/>
        <ResourceInclude Source="avares://Themes/Resources/Controls/GroupBox.axaml"/>
        <ResourceInclude Source="avares://Themes/Resources/Controls/Label.axaml"/>
        <ResourceInclude Source="avares://Themes/Resources/Controls/ListBox.axaml"/>
        <ResourceInclude Source="avares://Themes/Resources/Controls/ListView.axaml"/>
        <ResourceInclude Source="avares://Themes/Resources/Controls/Menu.axaml"/>
        <ResourceInclude Source="avares://Themes/Resources/Controls/MetroWindowStyle.axaml"/>
        <ResourceInclude Source="avares://Themes/Resources/Controls/ProgressBar.axaml"/>
        <ResourceInclude Source="avares://Themes/Resources/Controls/ScrollBar.axaml"/>
        <ResourceInclude Source="avares://Themes/Resources/Controls/Separator.axaml"/>
        <ResourceInclude Source="avares://Themes/Resources/Controls/Slider.axaml"/>
        <ResourceInclude Source="avares://Themes/Resources/Controls/StackPanel.axaml"/>
        <ResourceInclude Source="avares://Themes/Resources/Controls/TabControl.axaml"/>
        <ResourceInclude Source="avares://Themes/Resources/Controls/TextBlock.axaml"/>
        <ResourceInclude Source="avares://Themes/Resources/Controls/TextBox.axaml"/>
        <ResourceInclude Source="avares://Themes/Resources/Controls/ToolBar.axaml"/>
        <ResourceInclude Source="avares://Themes/Resources/Controls/ToolTip.axaml"/>
        <ResourceInclude Source="avares://Themes/Resources/Controls/TreeView.axaml"/>
    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
