<!-- Ported from upstream/WPF-Framework/src/Themes/Resources/Controls/ToolBar.xaml. Conversion rules: Button.axaml. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    XGoodFit port notes:
    - Upstream uses no ToolBar controls. Its toolbars are panels of ordinary buttons and separators
      that take the ToolBar style keys, so those styles are what's ported. The WPF keys
      ({x:Static ToolBar.ButtonStyleKey} and so on) become string keys of the same names.
    - Not ported: the ToolBar control template, with ToolBarThumbStyle and ToolBarOverflowButtonStyle,
      which only it uses. Avalonia has no ToolBar control.
    - ButtonBase is Avalonia's Button. The CheckBox and RadioButton keys share the toggle-button theme,
      as in WPF; both controls derive from ToggleButton in Avalonia too.
    - The MultiTriggers become pseudo-class selectors in the same order, so the later ones still win
      where they overlap.
    -->

    <ControlTheme x:Key="ToolBar.SeparatorStyleKey" TargetType="Separator">
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Orientation="Horizontal" Margin="2,0">
                    <Rectangle Width="1" Fill="{DynamicResource ToolbarDefaultSeparator}" />
                    <Rectangle Width="1" Fill="{DynamicResource ToolbarDefaultSeparatorAccent}" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="ToolBarButtonStyleBase" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource ToolbarButtonDefaultText}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="Border" BorderThickness="1">
                    <ContentPresenter x:Name="Content" Margin="2"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True" />
                </Border>
            </ControlTemplate>
        </Setter>

        <!-- Hovered -->
        <Style Selector="^:pointerover:not(:pressed)">
            <Style Selector="^ /template/ Border#Border">
                <Setter Property="Background" Value="{DynamicResource ToolbarButtonHoveredBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ToolbarButtonHoveredBorder}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#Content">
                <Setter Property="Foreground" Value="{DynamicResource ToolbarButtonHoveredText}" />
            </Style>
        </Style>

        <!-- Pressed -->
        <Style Selector="^:pointerover:pressed">
            <Style Selector="^ /template/ Border#Border">
                <Setter Property="Background" Value="{DynamicResource ToolbarButtonPressedBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ToolbarButtonPressedBorder}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#Content">
                <Setter Property="Foreground" Value="{DynamicResource ToolbarButtonPressedText}" />
            </Style>
        </Style>

        <!-- Disabled: commented out upstream (a grayscale shader effect, the disabled text colour and half opacity). -->
    </ControlTheme>

    <ControlTheme x:Key="ToolBarToggleButtonStyleBase" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource ToolbarButtonDefaultText}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="Border" BorderThickness="1">
                    <ContentPresenter x:Name="Content" Margin="2"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True" />
                </Border>
            </ControlTemplate>
        </Setter>

        <!-- Hovered -->
        <Style Selector="^:pointerover:not(:pressed)">
            <Style Selector="^ /template/ Border#Border">
                <Setter Property="Background" Value="{DynamicResource ToolbarButtonHoveredBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ToolbarButtonHoveredBorder}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#Content">
                <Setter Property="Foreground" Value="{DynamicResource ToolbarButtonHoveredText}" />
            </Style>
        </Style>

        <!-- Pressed -->
        <Style Selector="^:pointerover:pressed">
            <Style Selector="^ /template/ Border#Border">
                <Setter Property="Background" Value="{DynamicResource ToolbarButtonPressedBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ToolbarButtonPressedBorder}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#Content">
                <Setter Property="Foreground" Value="{DynamicResource ToolbarButtonPressedText}" />
            </Style>
        </Style>

        <!-- Checked -->
        <Style Selector="^:checked:not(:pointerover)">
            <Style Selector="^ /template/ Border#Border">
                <Setter Property="Background" Value="{DynamicResource ToolbarButtonCheckedBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ToolbarButtonCheckedBorder}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#Content">
                <Setter Property="Foreground" Value="{DynamicResource ToolbarButtonCheckedText}" />
            </Style>
        </Style>

        <!-- Checked Hovered -->
        <Style Selector="^:checked:pointerover">
            <Style Selector="^ /template/ Border#Border">
                <Setter Property="Background" Value="{DynamicResource ToolbarButtonCheckedHoveredBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ToolbarButtonCheckedHoveredBorder}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#Content">
                <Setter Property="Foreground" Value="{DynamicResource ToolbarButtonCheckedHoveredText}" />
            </Style>
        </Style>

        <!-- Disabled: commented out upstream (a grayscale shader effect, the disabled text colour and half opacity). -->
    </ControlTheme>

    <ControlTheme x:Key="ToolBar.ButtonStyleKey" BasedOn="{StaticResource ToolBarButtonStyleBase}" TargetType="Button" />
    <ControlTheme x:Key="ToolBar.ToggleButtonStyleKey" BasedOn="{StaticResource ToolBarToggleButtonStyleBase}" TargetType="ToggleButton" />
    <ControlTheme x:Key="ToolBar.CheckBoxStyleKey" BasedOn="{StaticResource ToolBarToggleButtonStyleBase}" TargetType="CheckBox" />
    <ControlTheme x:Key="ToolBar.RadioButtonStyleKey" BasedOn="{StaticResource ToolBarToggleButtonStyleBase}" TargetType="RadioButton" />

</ResourceDictionary>
