<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Avalonia port of upstream/WPF-Framework/src/Themes: the VS2013 Light, Blue and Dark palettes,
    the theme service, and the control themes. Upstream C# files compile unchanged unless a ported
    copy exists here (Directory.Build.targets).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Themes</RootNamespace>
    <AssemblyName>Themes</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <UpstreamProjectDir>$(UpstreamFrameworkSrc)Themes/</UpstreamProjectDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <!-- The DataGrid theme (Resources/Controls/DataGrid.axaml) styles ProDataGrid's grid (plan §4.2). -->
    <PackageReference Include="ProDataGrid" />
  </ItemGroup>

  <ItemGroup>
    <!-- The window chrome's caption buttons use WPF's system commands (MetroWindowStyle.axaml). -->
    <ProjectReference Include="../WpfCompat/WpfCompat.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Selawik, the substitute for Segoe UI where it isn't installed (Resources/Defaults.axaml). -->
    <AvaloniaResource Include="$(UpstreamRoot)Selawik/*.ttf" Link="Assets/Fonts/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
