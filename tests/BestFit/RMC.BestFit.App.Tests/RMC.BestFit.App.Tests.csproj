<Project Sdk="MSTest.Sdk/3.6.4">

  <!--
    Upstream's RMC.BestFit.App tests (upstream/RMC-BestFit/src/RMC.BestFit.App.Tests), run against the
    Avalonia port (src/BestFit/RMC.BestFit.App). Most test the application's views, which are ported one
    GUI area at a time, so the project opts in to upstream files (Directory.Build.targets): only the
    upstream test files listed in UpstreamCompileInclude compile, unchanged, besides ported copies.
    - [STATestMethod]: as in RMC.BestFit.UI.Tests, this project's STATestMethodAttribute runs those
      tests on the headless Avalonia session's UI thread (HeadlessSession.cs). It is declared in the
      RMC.BestFit.App.Tests namespace, which the test files' own namespaces search before MSTest's.
    - GUI/Support/WpfTestHost.cs is ported: it merges the same resource dictionaries, as Avalonia
      resources, into the headless application.

    PORT IN PROGRESS: each GUI area's upstream tests are added with the area, in the area's item group
    below (one per area, so that areas ported in parallel merge cleanly).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <!-- As upstream. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>
    <UpstreamProjectDir>$(UpstreamBestFitSrc)RMC.BestFit.App.Tests/</UpstreamProjectDir>
    <UpstreamCompileMode>OptIn</UpstreamCompileMode>
    <!--
      Tests in category External use live web services (USGS, NOAA GHCN and others) and fail whenever
      one is down. dotnet test leaves them out, as in RMC.BestFit.UI.Tests. Run them with the test
      executable and its filter option set to TestCategory=External.
    -->
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --filter TestCategory!=External</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <!-- As upstream: the shared MSTest settings (method-level parallelism) and API snapshot helper. -->
    <Compile Include="$(UpstreamBestFitSrc)TestCommon/MSTestSettings.cs" Link="upstream/MSTestSettings.cs" />
    <Compile Include="$(UpstreamBestFitSrc)TestCommon/PublicApiContractSnapshot.cs" Link="upstream/CoreInfrastructure/PublicApiContractSnapshot.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.HarfBuzz" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Themes.Simple" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(UpstreamBestFitSrc)RMC.BestFit/RMC.BestFit.csproj" />
    <ProjectReference Include="../../../src/BestFit/RMC.BestFit.UI/RMC.BestFit.UI.csproj" />
    <ProjectReference Include="../../../src/BestFit/RMC.BestFit.App/RMC.BestFit.App.csproj" />
  </ItemGroup>

  <ItemGroup>
