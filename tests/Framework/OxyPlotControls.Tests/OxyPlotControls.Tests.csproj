<Project Sdk="MSTest.Sdk/3.6.4">

  <!-- Tests for the Avalonia port of OxyPlotControls (src/Framework/OxyPlotControls), run headlessly. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.HarfBuzz" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Themes.Simple" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/Framework/OxyPlotControls/OxyPlotControls.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- OxyPlot.Wpf.Tests' plots and the settings the WPF fork wrote for them (its Fixtures/README.md),
         which OxyPlotSettingsSerializer must write and read alike. -->
    <Compile Include="../OxyPlot.Wpf.Tests/TestPlots.cs" Link="Fixtures/TestPlots.cs" />
    <None Include="../OxyPlot.Wpf.Tests/Fixtures/*.wpf.xml" Link="Fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
