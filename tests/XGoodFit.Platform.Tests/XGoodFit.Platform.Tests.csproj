<Project Sdk="MSTest.Sdk/3.6.4">

  <!--
    Tests for XGoodFit's platform integration (src/XGoodFit.Platform). Nothing here installs anything,
    writes to the registry or opens a window: the update tests use a pretend Velopack installation in
    a temporary folder, and the registration tests a pretend registry.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/XGoodFit.Platform/XGoodFit.Platform.csproj" />
  </ItemGroup>

</Project>
