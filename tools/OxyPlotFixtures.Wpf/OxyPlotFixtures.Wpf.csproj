<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Writes the plot-settings fixtures of tests/Framework/OxyPlot.Wpf.Tests with the WPF fork itself
    (upstream/WPF-Framework/src/OxyPlot/OxyPlot.Wpf), so the tests can check that the Avalonia port
    writes the same XML. It builds the tests' own plots (TestPlots.cs, compiled here with WPF defined).

    Windows only, as it runs WPF, so it isn't in XGoodFit.slnx. How to run it:
    tests/Framework/OxyPlot.Wpf.Tests/Fixtures/README.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);WPF</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../tests/Framework/OxyPlot.Wpf.Tests/TestPlots.cs" Link="TestPlots.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(UpstreamFrameworkSrc)OxyPlot/OxyPlot.Wpf/OxyPlot.Wpf.csproj" />
  </ItemGroup>

</Project>
