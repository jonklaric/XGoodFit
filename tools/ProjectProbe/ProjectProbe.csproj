<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Opens .bestfit project files through the upstream DatabaseManager/SQLite stack, exactly as
    RMC-BestFit does, and prints a fingerprint per project so the same files can be compared
    across operating systems (docs/migration-plan.md, Phase 0).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(UpstreamRoot)WPF-Framework/src/DatabaseManager/DatabaseManager.csproj" />
  </ItemGroup>

</Project>
