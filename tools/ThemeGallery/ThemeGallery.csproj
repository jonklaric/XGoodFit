<Project Sdk="Microsoft.NET.Sdk">

  <!--
    XGoodFit tool: shows the ported palettes and controls in each theme, with a theme switcher.
    With "capture <folder>" it renders the gallery in every theme to PNG files instead, headlessly.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Themes.Simple" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Framework/ExpressionParserControls/ExpressionParserControls.csproj" />
    <ProjectReference Include="../../src/Framework/GenericControls/GenericControls.csproj" />
    <ProjectReference Include="../../src/Framework/Themes/Themes.csproj" />
  </ItemGroup>

</Project>
