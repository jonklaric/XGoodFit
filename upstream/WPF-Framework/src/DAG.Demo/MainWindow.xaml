<Window x:Class="DAG.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DAG.Demo"
        xmlns:flowgraph="clr-namespace:DAGControls;assembly=DAGControls"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Storyboard x:Key="animate">
            <ObjectAnimationUsingKeyFrames BeginTime="0:0:0" Storyboard.TargetProperty="Visibility">
                <DiscreteObjectKeyFrame KeyTime="0">
                    <DiscreteObjectKeyFrame.Value>
                        <Visibility>Visible</Visibility>
                    </DiscreteObjectKeyFrame.Value>
                </DiscreteObjectKeyFrame>
            </ObjectAnimationUsingKeyFrames>
            <DoubleAnimation BeginTime="0:0:0.0" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.05"/>
            <DoubleAnimation BeginTime="0:0:2.0" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.5"/>
            <ObjectAnimationUsingKeyFrames BeginTime="0:0:2.5" Storyboard.TargetProperty="Visibility">
                <DiscreteObjectKeyFrame KeyTime="0">
                    <DiscreteObjectKeyFrame.Value>
                        <Visibility>Hidden</Visibility>
                    </DiscreteObjectKeyFrame.Value>
                </DiscreteObjectKeyFrame>
            </ObjectAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>
    <Grid>

        <Border Background="DarkGray" BorderBrush="DarkGray" BorderThickness=".5">
            <flowgraph:FlowGraphCanvas
                x:Name="GraphCanvas"
                PreviewCanvasContextMenu="GraphCanvas_PreviewCanvasContextMenu"
                PreviewNodeContextMenu="GraphCanvas_PreviewNodeContextMenu"
                AutoConnection_Clicked="GraphCanvas_AutoConnection_Clicked"/>
        </Border>

        <Grid Margin="5" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="10"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="AddNodeButton" Margin="5" HorizontalAlignment="Left" VerticalAlignment="Center" Click="AddNodeButton_Click">
                <Button.Content>
                        <Grid Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Width="16" Height="16" Source="/DAG.Demo;component/Resources/Add.png"/>
                        </Grid>
                </Button.Content>
            </Button>

            <TextBlock Grid.Column="1" x:Name="ConnectionText" VerticalAlignment="Top" HorizontalAlignment="Right" Visibility="Hidden" Margin="5" FontSize="18" FontWeight="DemiBold"/>
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="5" HorizontalAlignment="Left" VerticalAlignment="Bottom">
             <Button x:Name="SaveGraphButton" Margin="5" HorizontalAlignment="Left" VerticalAlignment="Bottom" Click="SaveGraphButton_Click">
                <Button.Content>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Margin="2,0,0,0" VerticalAlignment="Center" Text="Save"/>
                    </Grid>
                </Button.Content>
            </Button>
            
            <Button x:Name="LoadGraphButton" Margin="5" HorizontalAlignment="Left" VerticalAlignment="Bottom" Click="LoadGraphButton_Click">
                <Button.Content>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Margin="2,0,0,0" VerticalAlignment="Center" Text="Load"/>
                    </Grid>
                </Button.Content>
            </Button>

            <Button x:Name="TestButton" Margin="5" HorizontalAlignment="Left" VerticalAlignment="Bottom" Visibility="Visible" Click="TestButton_Click">
                <Button.Content>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Margin="2,0,0,0" VerticalAlignment="Center" Text="Test"/>
                    </Grid>
                </Button.Content>
            </Button>
        </StackPanel>

       
    </Grid>
</Window>
