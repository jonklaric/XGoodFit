<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>DAGControls</RootNamespace>
    <AssemblyName>DAGControls</AssemblyName>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <IsWpfFrameworkLibrary>true</IsWpfFrameworkLibrary>
    <PackageId>RMC.DAGControls</PackageId>
    <Title>DAGControls</Title>
    <Description>WPF control library for interactive visualization and editing of DAG graphs. Canvas with drag-and-drop node positioning, connection creation via Bezier curves, zoom/pan navigation, and context menus.</Description>
    <PackageTags>wpf; dag; directed-acyclic-graph; flow-graph; graph-editor; canvas; usace-rmc</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\AddPointCursor.cur" />
    <Resource Include="Resources\Delete.png" />
    <Resource Include="Resources\Pan_Hand_Closed.cur" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DAG\DAG.csproj" />
  </ItemGroup>

</Project>
