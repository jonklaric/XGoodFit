<UserControl x:Class="DAGControls.NodeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DAGControls"
             mc:Ignorable="d" 
             d:DesignHeight="80" d:DesignWidth="150" 
             MinWidth="150"
             MaxWidth="400"
             Loaded="UserControl_Loaded"
             DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <UserControl.Resources>
        <Storyboard x:Key="AddButtonSB">
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="AddButton" Storyboard.TargetProperty="Visibility">
                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
            </ObjectAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="RemoveButtonSB">
            <ObjectAnimationUsingKeyFrames Duration="0:0:01" Storyboard.TargetName="AddButton" Storyboard.TargetProperty="Visibility">
                <DiscreteObjectKeyFrame KeyTime="30%" Value="{x:Static Visibility.Collapsed}"/>
            </ObjectAnimationUsingKeyFrames>
        </Storyboard>
        <SolidColorBrush x:Key="OutFillBrush" Color="#FFF7D067"/>
        <DataTemplate x:Key="InListBoxItemTemplate">
            <Grid Margin="0 2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Ellipse 
                    x:Name="InConnector" 
                    Width="15" 
                    Height="15" 
                    Grid.Column="0"
                    Fill="#FFB3BDFB" 
                    StrokeThickness="1"  
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top" 
                    Margin="-7.5,0,0,0">
                    <Ellipse.Stroke>
                        <SolidColorBrush x:Name="StrokeColor" Color="DarkBlue"/>
                    </Ellipse.Stroke>

                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard  x:Name="EllipseSA">
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="StrokeThickness" To="10"/>
                                    <ColorAnimation Storyboard.TargetName="StrokeColor" Storyboard.TargetProperty="Color" To="DarkBlue"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <StopStoryboard BeginStoryboardName="EllipseSA"/>
                        </EventTrigger>

                    </Ellipse.Triggers>
                </Ellipse>

                <TextBlock 
                    Grid.Column="1" 
                    FontSize="10" 
                    Margin="2,0,0,0" 
                    TextAlignment="Left" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Stretch" 
                    Text="{Binding Name}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="OutListBoxItemTemplate">
            <Grid Margin="0 2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock 
                    Grid.Column="0" 
                    FontSize="10" 
                    Margin="0,0,2,0" 
                    TextAlignment="Right" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Stretch" 
                    Text="{Binding Name}"/>

                <Ellipse 
                    x:Name="OutConnector" 
                    Grid.Column="1"
                    Width="15" 
                    Height="15" 
                    Fill="{StaticResource OutFillBrush}" 
                    StrokeThickness="1" 
                    ToolTip="Click and drag to connect, click to add new"
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Bottom" 
                    Margin="0,0,-7.5,0">
                    <Ellipse.Stroke>
                        <SolidColorBrush x:Name="StrokeColor" Color="DarkGoldenrod"/>
                    </Ellipse.Stroke>

                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard Storyboard="{StaticResource AddButtonSB}"/>
                            <BeginStoryboard x:Name="EllipseSB">
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="StrokeThickness" To="10"/>
                                    <ColorAnimation Storyboard.TargetName="StrokeColor" Storyboard.TargetProperty="Color" To="DarkGoldenrod"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <StopStoryboard BeginStoryboardName="EllipseSB"/>
                            <BeginStoryboard Storyboard="{StaticResource RemoveButtonSB}"/>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>

                <Grid 
                    Grid.Column="2"
                    x:Name="AddButton"
                    Width="10"
                    Height="10"
                    Margin="0,-15,-25,0" 
                    Visibility="Collapsed"
                    Background="Transparent"
                    ToolTip="Click to add new"
                    MouseDown="AddButton_MouseDown">
                    <Grid.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard Storyboard="{StaticResource AddButtonSB}"/>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard Storyboard="{StaticResource RemoveButtonSB}"/>
                        </EventTrigger>
                    </Grid.Triggers>
                    <Path 
                        x:Name="AddConnectionPath" 
                        Data="M 5 0 L 5 10 M 0 5 L 10 5" 
                        StrokeThickness="2">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=AddButton, Path=IsMouseOver}" Value="False">
                                        <Setter Property="Stroke" Value="{StaticResource OutFillBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ElementName=AddButton, Path=IsMouseOver}" Value="True">
                                        <Setter Property="Stroke" Value="Yellow" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Grid>
            </Grid>
        </DataTemplate>

    </UserControl.Resources>
 
    <Border 
        x:Name="NodeBorder" 
        CornerRadius="10" 
        MinHeight="80" 
        BorderBrush="Transparent" 
        Background="#FFD9F5F5" 
        BorderThickness="1">

        <Border.Effect>
            <DropShadowEffect ShadowDepth="3" BlurRadius="15" Color="Gray"  />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border CornerRadius="10,10,0,0" Height="20" VerticalAlignment="Top" HorizontalAlignment="Stretch" Background="{Binding HeaderColor, FallbackValue=Red}">
                <Grid Height="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                    </Grid.ColumnDefinitions>

                    <Grid Margin="4,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center" Width="16" Height="16">
                        <!--Icon maybe?-->
                        <Image RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Aliased" Source="{Binding NodeIcon}"/>
                    </Grid>

                    <TextBlock 
                        Text="{Binding Node.Name}" 
                        Grid.Column="1"
                        Margin="2 0"
                        VerticalAlignment="Center" 
                        TextAlignment="Center"/>

                    <Button
                        x:Name="DeleteButton"
                        Grid.Column="2"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Background="Transparent"
                        Width="20"
                        Height="20"
                        Padding="0"
                        ToolTip="Delete"
                        Click="DeleteButton_Click">

                        <Button.Content>
                            <Grid Height="18" Width="18">
                                <Path Data="M 6 6 L 12 12" Stroke="#FFECECEC" StrokeThickness="3" StrokeEndLineCap="Triangle" StrokeStartLineCap="Triangle"/>
                                <Path Data="M 12 6 L 6 12" Stroke="#FFECECEC" StrokeThickness="3" StrokeEndLineCap="Triangle" StrokeStartLineCap="Triangle"/>
                                <Path Data="M 6 6 L 12 12" Stroke="#FF7C2121" StrokeThickness="1"/>
                                <Path Data="M 12 6 L 6 12" Stroke="#FF7C2121" StrokeThickness="1"/>
                            </Grid>
                        </Button.Content>
                        <Button.Style>
                            <Style TargetType="{x:Type Button}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border 
                                                Name="border" 
                                                BorderThickness="1"
                                                BorderBrush="Transparent" 
                                                CornerRadius="0,9,0,0" 
                                                Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="BorderBrush" Value="DarkGray" />
                                                    <Setter TargetName="border" Property="Background" Value="#7FE6E6E6" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver}" Value="True">
                                        <DataTrigger.Setters>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger.Setters>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMouseOver}" Value="False">
                                        <DataTrigger.Setters>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger.Setters>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>

                    </Button>

                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding NodeContent}"/>

            <ItemsControl
                x:Name="InputsListBox"
                Grid.Row="2"
                ItemsSource="{Binding Node.Inputs}"
                ItemTemplate="{StaticResource InListBoxItemTemplate}">
            </ItemsControl>

            <ItemsControl
                x:Name="OutputsListBox"
                Grid.Row="3"
                ItemsSource="{Binding Node.Outputs}"
                ItemTemplate="{StaticResource OutListBoxItemTemplate}">
            </ItemsControl>

        </Grid>
    </Border>
</UserControl>
