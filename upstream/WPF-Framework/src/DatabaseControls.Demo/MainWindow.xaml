<gc:MetroWindow x:Class="DatabaseControls.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DatabaseControls.Demo"
        xmlns:gc="clr-namespace:GenericControls;assembly=GenericControls"
        xmlns:dtview="clr-namespace:DatabaseControls;assembly=DatabaseControls"
        mc:Ignorable="d"
        Title="DatabaseControls Demo" Height="700" Width="1000" MinWidth="800" MinHeight="500"
        Style="{DynamicResource MetroWindowStyle}"
        Background="{DynamicResource EnvironmentWindowBackground}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Bar with Theme Selection -->
        <Border Grid.Row="0"
                Background="{DynamicResource EnvironmentWindowBackground}"
                BorderBrush="{DynamicResource Button.Static.Border}"
                BorderThickness="0,0,0,1"
                Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="DatabaseControls Library Demo"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource EnvironmentWindowText}"/>
                    <TextBlock Text=" - USACE Risk Management Center"
                               FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,2"
                               Foreground="{DynamicResource EnvironmentWindowText}" Opacity="0.6"/>
                </StackPanel>

                <!-- Theme Selection -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Theme:" VerticalAlignment="Center" Margin="0,0,12,0"
                               Foreground="{DynamicResource EnvironmentWindowText}"/>
                    <RadioButton x:Name="LightThemeRadio" Content="Light" GroupName="Theme"
                                 IsChecked="True" Checked="ThemeRadio_Checked" Margin="0,0,12,0"
                                 Foreground="{DynamicResource EnvironmentWindowText}"/>
                    <RadioButton x:Name="BlueThemeRadio" Content="Blue" GroupName="Theme"
                                 Checked="ThemeRadio_Checked" Margin="0,0,12,0"
                                 Foreground="{DynamicResource EnvironmentWindowText}"/>
                    <RadioButton x:Name="DarkThemeRadio" Content="Dark" GroupName="Theme"
                                 Checked="ThemeRadio_Checked"
                                 Foreground="{DynamicResource EnvironmentWindowText}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Database Controls Panel -->
        <Border Grid.Row="1"
                Background="{DynamicResource EnvironmentWindowBackground}"
                BorderBrush="{DynamicResource Button.Static.Border}"
                BorderThickness="0,0,0,1"
                Padding="15,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Database:" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{DynamicResource EnvironmentWindowText}"/>
                <Button Grid.Column="1" Content="Select File..." Height="24" Name="SelectDatabaseButton"
                        Width="90" Click="SelectDatabaseButton_Click" Padding="8,2"/>

                <TextBlock Grid.Column="2" Text="Table:" VerticalAlignment="Center" Margin="20,0,8,0"
                           Foreground="{DynamicResource EnvironmentWindowText}"/>
                <ComboBox Grid.Column="3" Height="24" Name="TableComboBox" Width="200"
                          HorizontalAlignment="Left"
                          IsEnabled="False" SelectionChanged="TableComboBox_SelectionChanged"/>
            </Grid>
        </Border>

        <!-- Main Table Viewer -->
        <Grid Grid.Row="2" Background="{DynamicResource EnvironmentWindowBackground}">
            <dtview:TableViewer
                Name="TestViewer"
                Margin="15"
                Editable="True"
                RowSelectable="True"
                RowHeight="22"
                ColumnSelectable="True"
                CellSelectable="True"
                HasFieldCalculator="True"
                ShowRowHeaders="True"
                AutoFitColumns="True"/>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="3"
                Background="{DynamicResource EnvironmentWindowBackground}"
                BorderBrush="{DynamicResource Button.Static.Border}"
                BorderThickness="0,1,0,0"
                Padding="15,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="StatusText"
                           Text="Select a database file to begin"
                           Foreground="{DynamicResource EnvironmentWindowText}" Opacity="0.7"/>
                <TextBlock Grid.Column="1" x:Name="RowCountText"
                           Text="Ready"
                           Foreground="{DynamicResource EnvironmentWindowText}" Opacity="0.7"/>
            </Grid>
        </Border>
    </Grid>
</gc:MetroWindow>
