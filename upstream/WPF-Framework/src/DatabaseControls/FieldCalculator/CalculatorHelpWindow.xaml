<cntrls:MetroWindow x:Class="DatabaseControls.CalculatorHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:cntrls="clr-namespace:GenericControls;assembly=GenericControls"
        mc:Ignorable="d"
        Title="Calculator Help" Height="550" Width="800"
        WindowStartupLocation="CenterOwner"
        Style="{DynamicResource MetroWindowStyle}"
        Background="{DynamicResource EnvironmentWindowBackground}"
        Foreground="{DynamicResource EnvironmentWindowText}">
    <Grid>
        <WebBrowser x:Name="HelpBrowser" Margin="5"/>
    </Grid>
</cntrls:MetroWindow>
