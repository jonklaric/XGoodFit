<cntrls:MetroDialogWindow x:Class="DatabaseControls.ErrorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:DatabaseControls"
    xmlns:cntrls="clr-namespace:GenericControls;assembly=GenericControls"
    DataContext="{Binding RelativeSource={RelativeSource Self}}"
    Title="ErrorWindow" Height="300" Width="500"
    Style="{DynamicResource MetroDialogStyle}"
    Background="{DynamicResource EnvironmentWindowBackground}"
    Foreground="{DynamicResource EnvironmentWindowText}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <DataGrid Name="ErrorLogGrid" Grid.Row="1" Margin="5" AutoGenerateColumns="False"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  IsReadOnly="True" HeadersVisibility="Column"
                  ItemsSource="{Binding Path=Errors}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Error Message" Binding="{Binding Message}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2" Content="Close" Name="CancelButton" IsCancel="True" Margin="5" HorizontalAlignment="Right" VerticalAlignment="Center" Width="80" Height="24" Click="CancelButton_Click"/>
    </Grid>
</cntrls:MetroDialogWindow>
