                        <DrawingGroup>
                            <DrawingGroup.Children>
                                <GeometryDrawing Brush="#00FFFFFF" Geometry="F1M16,16L0,16 0,0 16,0z" />
                                <GeometryDrawing Brush="#00FFFFFF" Geometry="F1M14.8877,5.9717C14.8967,7.5607,14.2837,9.0537,13.1597,10.1757L7.3357,15.9997 7.0937,15.9997 4.3867,13.2927 10.3317,7.3477C10.6967,6.9837 10.8967,6.4987 10.8967,5.9847 10.8967,5.4697 10.6967,4.9847 10.3317,4.6207 9.9637,4.2527 9.4937,4.0377 8.9997,4.0107L8.9997,7.9997 0.999700000000001,7.9997 0.999700000000001,-0.000300000000000189 4.9997,-0.000300000000000189 4.9997,1.4737C6.0807,0.5217 7.4557,0.00170000000000048 8.9127,0.00170000000000048 10.4977,0.00170000000000048 11.9867,0.6177 13.1047,1.7367 14.2457,2.8777 14.8787,4.3817 14.8877,5.9717" />
                                <GeometryDrawing Brush="{DynamicResource ToolbarIconAccent}" Geometry="F1M12.4531,9.4688L7.2151,14.7068 5.8011,13.2928 11.0391,8.0548C11.5921,7.5018 11.8961,6.7658 11.8961,5.9848 11.8961,5.2018 11.5921,4.4668 11.0391,3.9138 9.8411,2.7158 7.9831,2.7158 6.8421,3.8578L5.7001,4.9998 8.0001,4.9998 8.0001,6.9998 2.0001,6.9998 2.0001,0.9998 4.0001,0.9998 4.0001,3.8718 5.4281,2.4438C7.3491,0.521800000000001 10.4751,0.520799999999999 12.3971,2.4438 14.3751,4.4208 14.3751,7.5478 12.4531,9.4688" />
                            </DrawingGroup.Children>
                        </DrawingGroup>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
        </Rectangle>
    </Viewbox>

    <!-- =============================================================================== -->
    <!-- REDO ICON                                                                        -->
    <!-- =============================================================================== -->

    <Viewbox x:Key="RedoIcon" Width="16" Height="16" x:Shared="False">
        <Rectangle Width="16" Height="16">
            <Rectangle.Fill>
                <DrawingBrush>
                    <DrawingBrush.Drawing>
                        <DrawingGroup>
                            <DrawingGroup.Children>
                                <GeometryDrawing Brush="#00FFFFFF" Geometry="F1M16,16L0,16 0,0 16,0z" />
                                <GeometryDrawing Brush="#00FFFFFF" Geometry="F1M2.8955,1.7363C4.0135,0.6173 5.5015,0.00229999999999997 7.0875,0.00229999999999997 8.5435,0.00229999999999997 9.9185,0.5223 10.9995,1.4743L10.9995,0.000299999999999967 14.9995,0.000299999999999967 14.9995,8.0003 6.9995,8.0003 6.9995,4.0103C6.5055,4.0383 6.0365,4.2523 5.6675,4.6203 5.3035,4.9853 5.1035,5.4693 5.1035,5.9843 5.1035,6.4993 5.3035,6.9833 5.6675,7.3473L11.6135,13.2933 8.9065,16.0003 8.6645,16.0003 2.8395,10.1753C1.7165,9.0533 1.1035,7.5603 1.1125,5.9713 1.1215,4.3813 1.7535,2.8773 2.8955,1.7363" />
                                <GeometryDrawing Brush="{DynamicResource ToolbarIconAccent}" Geometry="F1M3.6025,2.4434C5.5245,0.521400000000001,8.6515,0.5224,10.5725,2.4434L11.9995,3.8714 11.9995,1.0004 13.9995,1.0004 13.9995,7.0004 7.9995,7.0004 7.9995,5.0004 10.2995,5.0004 9.1575,3.8574C8.0165,2.7154 6.1595,2.7154 4.9605,3.9134 4.4085,4.4664 4.1035,5.2024 4.1035,5.9844 4.1035,6.7664 4.4085,7.5014 4.9605,8.0544L10.1995,13.2934 8.7855,14.7074 3.5465,9.4684C1.6245,7.5474,1.6245,4.4214,3.6025,2.4434" />
                            </DrawingGroup.Children>
                        </DrawingGroup>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
        </Rectangle>
    </Viewbox>

    <!-- NOTE: SelectAllIcon sourced from GenericControls IconDictionary -->

    <!-- =============================================================================== -->
    <!-- DESELECT ALL ICON                                                                -->
    <!-- =============================================================================== -->

    <Canvas x:Key="DeselectAllIcon" Width="16" Height="16" x:Shared="False">
        <!-- Table frame: border + header + grid lines, with cell cutouts (EvenOdd) -->
        <Path Fill="{DynamicResource ToolbarIconForeground}">
            <Path.Data>
                <PathGeometry FillRule="EvenOdd"
                    Figures="M2,2 H15 V14 H2 Z M3,5 H6 V7 H3 Z M7,5 H10 V7 H7 Z M11,5 H14 V7 H11 Z M3,8 H6 V10 H3 Z M7,8 H10 V10 H7 Z M11,8 H14 V10 H11 Z M3,11 H6 V13 H3 Z M7,11 H10 V13 H7 Z M11,11 H14 V13 H11 Z"/>
            </Path.Data>
        </Path>
    </Canvas>

    <!-- =============================================================================== -->
    <!-- CALCULATOR ICON                                                                  -->
    <!-- =============================================================================== -->

    <Canvas x:Key="CalculatorIcon" Width="16" Height="16" x:Shared="False">
        <!-- Calculator body fill -->
        <Path Fill="{DynamicResource ToolbarIconDocumentFill}" Data="F1 M1,1 H15 V15 H1 Z"/>
        <!-- Calculator frame with button cutouts (3x3 grid) -->
        <Path Fill="{DynamicResource ToolbarIconForeground}">
            <Path.Data>
                <PathGeometry FillRule="EvenOdd"
                    Figures="M1,1 H15 V15 H1 Z M2,2 H14 V5 H2 Z M2,6 H5 V8 H2 Z M6,6 H9 V8 H6 Z M11,6 H14 V8 H11 Z M2,9 H5 V11 H2 Z M6,9 H9 V11 H6 Z M11,10 H14 V14 H11 Z M2,12 H5 V14 H2 Z M6,12 H9 V14 H6 Z"/>
            </Path.Data>
        </Path>
        <!-- Display (accent blue) -->
        <Rectangle Canvas.Left="2" Canvas.Top="2" Width="12" Height="3" Fill="{DynamicResource ToolbarIconAccent}"/>
        <!-- Red button - top right of button grid -->
        <Rectangle Canvas.Left="11" Canvas.Top="6" Width="3" Height="2" Fill="{DynamicResource SemanticRed}"/>
        <!-- Operator button - right column rows 2-3 (solid) -->
        <Rectangle Canvas.Left="11" Canvas.Top="10" Width="3" Height="4" Fill="{DynamicResource ToolbarIconSelectionFill}"/>
    </Canvas>

    <!-- =============================================================================== -->
    <!-- FIND ICON                                                                        -->
    <!-- =============================================================================== -->

    <Canvas x:Key="FindIcon" Width="16" Height="16" x:Shared="False">
        <Ellipse Canvas.Left="1" Canvas.Top="1" Width="10" Height="10"
                 StrokeThickness="2" Stroke="{DynamicResource ToolbarIconForeground}"
                 Fill="Transparent"/>
        <Path Stroke="{DynamicResource ToolbarIconForeground}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
            <Path.Data>
                <PathGeometry Figures="M 9.5 9.5 L 14.5 14.5"/>
            </Path.Data>
        </Path>
    </Canvas>

    <!-- =============================================================================== -->
    <!-- STATISTICS ICON                                                                  -->
    <!-- =============================================================================== -->

    <Canvas x:Key="StatisticsIcon" Width="16" Height="16" x:Shared="False">
        <Rectangle Canvas.Left="1" Canvas.Top="10" Width="3" Height="5" Fill="{DynamicResource ToolbarIconForeground}"/>
        <Rectangle Canvas.Left="5" Canvas.Top="6" Width="3" Height="9" Fill="{DynamicResource ToolbarIconAccent}"/>
        <Rectangle Canvas.Left="9" Canvas.Top="3" Width="3" Height="12" Fill="{DynamicResource ToolbarIconForeground}"/>
        <Rectangle Canvas.Left="13" Canvas.Top="1" Width="2" Height="14" Fill="{DynamicResource ToolbarIconAccent}"/>
    </Canvas>

    <!-- NOTE: PasteIcon sourced from GenericControls IconDictionary -->

    <!-- =============================================================================== -->
    <!-- SHOW ALL ROWS ICON                                                              -->
    <!-- =============================================================================== -->

    <Canvas x:Key="ShowAllIcon" Width="16" Height="16" x:Shared="False">
        <!-- Canonical table with middle row blue, top/bottom rows document fill, lightning bolt bottom-left -->
        <!-- Top and bottom row fill (bottom-left cell removed for bolt clearance) -->
        <Path Fill="{DynamicResource ToolbarIconDocumentFill}"
              Data="F1 M7,5 H10 V7 H7 Z M11,5 H14 V7 H11 Z M7,11 H10 V13 H7 Z M11,11 H14 V13 H11 Z"/>
        <!-- Middle row blue fill -->
        <Path Fill="{DynamicResource ToolbarIconSelectionFill}"
              Data="F1 M7,8 H10 V10 H7 Z M11,8 H14 V10 H11 Z"/>
        <!-- Table frame with bottom-left cut away for bolt -->
        <Path Fill="{DynamicResource ToolbarIconForeground}">
            <Path.Data>
                <PathGeometry FillRule="EvenOdd"
                    Figures="M2,2 H15 V14 H4 V13 H6 V5 H2 Z M7,5 H10 V7 H7 Z M11,5 H14 V7 H11 Z M7,8 H10 V10 H7 Z M11,8 H14 V10 H11 Z M7,11 H10 V13 H7 Z M11,11 H14 V13 H11 Z"/>
            </Path.Data>
        </Path>
        <!-- Extended row divider -->
        <Path Fill="{DynamicResource ToolbarIconForeground}" Data="F1 M5,10 H6 V11 H5 Z"/>
        <!-- Lightning bolt (same size/position as funnel on SelectByAttribute) -->
        <Path Fill="#FF00CED1" Data="F1 M2,10 L6,10 1,15 0,15 2,11 0,11 2,6 6,6 Z"/>
    </Canvas>

    <!-- =============================================================================== -->
    <!-- SHOW SELECTED ROWS ICON                                                         -->
    <!-- =============================================================================== -->

    <Canvas x:Key="ShowSelectedIcon" Width="16" Height="16" x:Shared="False">
        <!-- SelectAll table with blue fill, lightning bolt bottom-left -->
        <Rectangle Canvas.Left="3" Canvas.Top="5" Width="11" Height="8" Fill="{DynamicResource ToolbarIconSelectionFill}"/>
        <!-- Table frame with bottom-left cut away for bolt -->
        <Path Fill="{DynamicResource ToolbarIconForeground}">
            <Path.Data>
                <PathGeometry FillRule="EvenOdd"
                    Figures="M2,2 H15 V14 H4 V13 H6 V5 H2 Z M7,5 H10 V7 H7 Z M11,5 H14 V7 H11 Z M7,8 H10 V10 H7 Z M11,8 H14 V10 H11 Z M7,11 H10 V13 H7 Z M11,11 H14 V13 H11 Z"/>
            </Path.Data>
        </Path>
        <!-- Extended row divider -->
        <Path Fill="{DynamicResource ToolbarIconForeground}" Data="F1 M5,10 H6 V11 H5 Z"/>
        <!-- Lightning bolt -->
        <Path Fill="#FF00CED1" Data="F1 M2,10 L6,10 1,15 0,15 2,11 0,11 2,6 6,6 Z"/>
    </Canvas>

    <!-- =============================================================================== -->
    <!-- CLEAR SELECTION ICON                                                            -->
    <!-- =============================================================================== -->

    <Canvas x:Key="ClearSelectionIcon" Width="16" Height="16" x:Shared="False">
        <!-- DeselectAll table with document fill, lightning bolt bottom-left -->
        <Rectangle Canvas.Left="2" Canvas.Top="2" Width="13" Height="12" Fill="{DynamicResource ToolbarIconDocumentFill}"/>
        <!-- Table frame with bottom-left cut away for bolt -->
        <Path Fill="{DynamicResource ToolbarIconForeground}">
            <Path.Data>
                <PathGeometry FillRule="EvenOdd"
                    Figures="M2,2 H15 V14 H4 V13 H6 V5 H2 Z M7,5 H10 V7 H7 Z M11,5 H14 V7 H11 Z M7,8 H10 V10 H7 Z M11,8 H14 V10 H11 Z M7,11 H10 V13 H7 Z M11,11 H14 V13 H11 Z"/>
            </Path.Data>
        </Path>
        <!-- Extended row divider -->
        <Path Fill="{DynamicResource ToolbarIconForeground}" Data="F1 M5,10 H6 V11 H5 Z"/>
        <!-- Lightning bolt -->
        <Path Fill="#FF00CED1" Data="F1 M2,10 L6,10 1,15 0,15 2,11 0,11 2,6 6,6 Z"/>
    </Canvas>

    <!-- =============================================================================== -->
    <!-- SELECT BY ATTRIBUTE ICON - Table with sparkle stars                              -->
    <!-- =============================================================================== -->

    <Canvas x:Key="SelectByAttributeIcon" Width="16" Height="16" x:Shared="False">
        <!-- Layer 1: ToolbarIconDocumentFill behind top row and bottom row cells -->
        <Path Fill="{DynamicResource ToolbarIconDocumentFill}"
              Data="F1 M7,5 H10 V7 H7 Z M11,5 H14 V7 H11 Z M7,11 H10 V13 H7 Z M11,11 H14 V13 H11 Z"/>
        <!-- Layer 2: Blue selection fill behind middle row cells (center + right only) -->
        <Path Fill="{DynamicResource ToolbarIconSelectionFill}"
              Data="F1 M7,8 H10 V10 H7 Z M11,8 H14 V10 H11 Z"/>
        <!-- Layer 3: Table frame - canonical table with bottom-left cut away for funnel clearance -->
        <Path Fill="{DynamicResource ToolbarIconForeground}">
            <Path.Data>
                <PathGeometry FillRule="EvenOdd"
                    Figures="M2,2 H15 V14 H4 V13 H6 V5 H2 Z M7,5 H10 V7 H7 Z M11,5 H14 V7 H11 Z M7,8 H10 V10 H7 Z M11,8 H14 V10 H11 Z M7,11 H10 V13 H7 Z M11,11 H14 V13 H11 Z"/>
            </Path.Data>
        </Path>
        <!-- Extended row divider (y=10, 1px left) -->
        <Path Fill="{DynamicResource ToolbarIconForeground}" Data="F1 M5,10 H6 V11 H5 Z"/>
        <!-- Layer 4: Filter funnel (accent blue) -->
        <Path Fill="{DynamicResource ToolbarIconAccent}"
              Data="F1 M6,6 L3,11 3,15 1,15 1,11 0,6 Z"/>
    </Canvas>

</ResourceDictionary>
