<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    =====================================================================================
      DatabaseControls Icon Dictionary
    =====================================================================================
      Contains vector icon definitions for the DatabaseControls library.
      Icons use DynamicResource for theme-aware coloring.

      CONTENTS:
      - Toolbar Icons      - Save, Undo, Redo, Copy, Paste, etc.
      - Selection Icons    - Select all, deselect, show selected
      - Calculator Icons   - Field calculator operations
      - Export Icons       - Export table, export data

      USAGE:
      Icons are available as Canvas resources and can be used:
      <ContentControl Content="{StaticResource SaveIcon}"/>
    =====================================================================================
    -->

    <!-- =============================================================================== -->
    <!-- SORT ARROW                                                                       -->
    <!-- =============================================================================== -->

    <Canvas x:Key="SortArrowIcon" Width="16" Height="16" x:Shared="False">
        <Path Fill="{DynamicResource DataGrid.Header.Foreground}" StrokeThickness="0">
            <Path.Data>
                <PathGeometry Figures="M 8 13.25 0.5 5 V 2.75 L 8 6 15.5 2.75 V 5 Z" FillRule="NonZero"/>
            </Path.Data>
        </Path>
    </Canvas>

    <!-- =============================================================================== -->
    <!-- EXPORT TABLE ICON                                                                -->
    <!-- =============================================================================== -->

    <Viewbox x:Key="ExportTableIcon" Width="16" Height="16" x:Shared="False">
        <Rectangle Width="16" Height="16">
            <Rectangle.Fill>
                <DrawingBrush>
                    <DrawingBrush.Drawing>
                        <DrawingGroup>
                            <DrawingGroup.Children>
                                <!-- Transparent background -->
                                <GeometryDrawing Brush="#00FFFFFF" Geometry="F1M16,16L0,16 0,0 16,0z" />
                                <!-- Knockout layer (transparent) -->
                                <GeometryDrawing Brush="#00FFFFFF" Geometry="F1M1.9998,-0.000199999999999534L2.8548,0.9998 -0.000199999999999978,0.9998 -0.000199999999999978,15.9998 15.9998,15.9998 15.9998,0.9998 7.8528,0.9998 6.9998,-0.000199999999999534z" />
                                <!-- Folder frame + cell borders (foreground) -->
                                <GeometryDrawing Brush="{DynamicResource ToolbarIconForeground}" Geometry="F1M8.7046,2L9.5566,3 13.9996,3 13.9996,14 1.9996,14 1.9996,8.649C1.6266,8.47,1.2866,8.235,0.999599999999999,7.942L0.999599999999999,15 14.9996,15 14.9996,2z" />
                                <!-- Folder frame detail + cell borders (foreground) -->
                                <GeometryDrawing Brush="{DynamicResource ToolbarIconForeground}" Geometry="F1M4,11L6,11 6,12 4,12z M7,11L9,11 9,12 7,12z M7,9L9,9 9,10 7,10z M10,11L12,11 12,12 10,12z M10,9L12,9 12,10 10,10z M10,7L12,7 12,8 10,8z M13,13L13,4 9.586,4 7,7 9,7 9,8 7,8 7,7 6,7 6,8 5,8 5,9 6,9 6,10 4,10 4,9 3.5,9C3.329,9,3.165,8.973,3,8.949L3,13z" />
                                <!-- Cell fills + folder interior (document fill) -->
                                <GeometryDrawing Brush="{DynamicResource ToolbarIconDocumentFill}" Geometry="F1M6,7L5,7 5,8 6,8z M14,14L14,3 9.557,3 10,3.52 9.586,4 13,4 13,13 3,13 3,8.949C2.646,8.898,2.312,8.798,2,8.649L2,14z M5.0004,8.9998L3.9994,8.9998 3.9994,9.9998 6.0004,9.9998 6.0004,8.9998z M7,12L9,12 9,10.999 7,10.999z M7,8L9,8 9,7 7,7z M4,12L6.001,12 6.001,10.999 4,10.999z M10,12L12,12 12,10.999 10,10.999z M7,10L9,10 9,9 7,9z M10,8L12,8 12,7 10,7z M10,10L12,10 12,9 10,9z M9.5566,3L9.9996,3.52 9.5856,4 12.9996,4 12.9996,13 2.9996,13 2.9996,8.949C2.6466,8.898,2.3116,8.798,1.9996,8.649L1.9996,14 13.9996,14 13.9996,3z" />
                                <!-- Export arrow (accent) -->
                                <GeometryDrawing Brush="{DynamicResource ToolbarIconAccent}" Geometry="F1M6,1L4,1 5.988,3 3.5,3C2.119,3,1,4.119,1,5.5 1,6.881,2.119,8,3.5,8L4,8 4,7 3.5,7C2.673,7,2,6.327,2,5.5 2,4.673,2.673,4,3.5,4L6.013,4 4,6 6,6 8.5,3.515z" />
                            </DrawingGroup.Children>
                        </DrawingGroup>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
        </Rectangle>
    </Viewbox>

    <!-- NOTE: CopyIcon, CopyWithHeadersIcon sourced from GenericControls IconDictionary -->

    <!-- =============================================================================== -->
    <!-- SAVE ICON                                                                        -->
    <!-- =============================================================================== -->

    <Canvas x:Key="SaveIcon" Width="16" Height="16" x:Shared="False">
        <!-- White floppy body fill -->
        <Path Fill="#FFFFFFFF" Data="F1 M9,1 L9,9 2,9 1,8 1,1 Z"/>
        <!-- Soft fill behind table cells -->
        <Path Fill="{DynamicResource ToolbarIconDocumentFill}" Data="F1 M2,10 L2,15 15,15 15,3 10,3 10,11 Z"/>
        <!-- Table grid (foreground) -->
        <Path Fill="{DynamicResource ToolbarIconForeground}"
              Data="F0 M10,3 L10,11 7,11 7,10 6,10 6,11 3,11 3,10 2,10 2,15 15,15 15,3 Z M14,8 L11,8 11,6 14,6 Z M14,11 L11,11 11,9 14,9 Z M14,14 L11,14 11,12 14,12 Z M10,14 L7,14 7,12 10,12 Z M6,14 L3,14 3,12 6,12 Z"/>
        <!-- Blue floppy top (accent) -->
        <Path Fill="{DynamicResource ToolbarIconAccent}" Data="F1 M9,1 L9,9 7,9 7,7 3,7 3,9 2,9 1,8 1,1 Z M8,2 L2,2 2,4 8,4 Z M4,8 L5,8 5,9 4,9 Z"/>
    </Canvas>

    <!-- =============================================================================== -->
    <!-- UNDO ICON                                                                        -->
    <!-- =============================================================================== -->

