<UserControl x:Class="ExpressionParserControls.CalculatorControl" x:Name="Calculator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ExpressionParserControls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Icons.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Scrollable content area (expression + expanders) -->
            <RowDefinition Height="*"/>
            <!-- Row 1: Toolbar (always pinned at bottom) -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Scrollable content (expression editor + help/error expanders) -->
        <ScrollViewer Grid.Row="0" x:Name="ContentScroller" VerticalScrollBarVisibility="Auto">
            <Grid MinHeight="{Binding ViewportHeight, ElementName=ContentScroller}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="50"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Expression Editor -->
                <local:ExpressionControl Grid.Row="0" x:Name="LexTextBox" FontWeight="Normal" Text=""
                                         VerticalAlignment="Stretch" HorizontalAlignment="Stretch" FontSize="14"
                                         ExpressionChanged="LexTextBox_ExpressionChanged"
                                         HelpDocumentCalled="LexTextBox_HelpDocumentCalled"/>

                <!-- Function Help Expander -->
                <Expander x:Name="FunctionHelpExpander" Grid.Row="1"
                          Style="{DynamicResource PropertyExpanderStyle}"
                          Visibility="Collapsed" IsExpanded="False"
                          Margin="0,3,0,0">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{DynamicResource HelpImage}" Width="14" Height="14" Margin="0,0,5,0"
                                   VerticalAlignment="Center"/>
                            <TextBlock x:Name="FunctionHelpHeader" Text="Function Help" FontWeight="SemiBold"
                                       Foreground="{DynamicResource EnvironmentWindowText}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>
                    <Border BorderBrush="{DynamicResource TextBox.Static.Border}" BorderThickness="1"
                            Background="{DynamicResource TextBox.Static.Background}" Margin="0,3,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Height="auto" MinHeight="50" MaxHeight="250" Padding="5">
                            <StackPanel x:Name="HelpDetailPanel">
                                <!-- Function Name -->
                                <TextBlock x:Name="HelpFunctionName" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"
                                           Foreground="{DynamicResource AvailableFunctions.DetailHeader}"/>

                                <!-- Syntax -->
                                <TextBlock Text="SYNTAX" FontSize="10" FontWeight="Bold" Margin="0,4,0,2"
                                           Foreground="{DynamicResource AvailableFunctions.DetailLabel}"/>
                                <Border Background="{DynamicResource EnvironmentWindowBackground}" CornerRadius="3" Padding="6,4" Margin="0,0,0,6">
                                    <TextBlock x:Name="HelpSyntax" FontFamily="Consolas" FontSize="12"
                                               Foreground="{DynamicResource AvailableFunctions.SyntaxText}" TextWrapping="Wrap"/>
                                </Border>

                                <!-- Returns -->
                                <TextBlock Text="RETURNS" FontSize="10" FontWeight="Bold" Margin="0,2,0,2"
                                           Foreground="{DynamicResource AvailableFunctions.DetailLabel}"/>
                                <TextBlock x:Name="HelpReturns" Margin="0,0,0,6" TextWrapping="Wrap"
                                           Foreground="{DynamicResource EnvironmentWindowText}"/>

                                <!-- Description -->
                                <TextBlock Text="DESCRIPTION" FontSize="10" FontWeight="Bold" Margin="0,2,0,2"
                                           Foreground="{DynamicResource AvailableFunctions.DetailLabel}"/>
                                <TextBlock x:Name="HelpDescription" Margin="0,0,0,6" TextWrapping="Wrap"
                                           Foreground="{DynamicResource EnvironmentWindowText}"/>

                                <!-- Example -->
                                <TextBlock Text="EXAMPLE" FontSize="10" FontWeight="Bold" Margin="0,2,0,2"
                                           Foreground="{DynamicResource AvailableFunctions.DetailLabel}"/>
                                <Border Background="{DynamicResource EnvironmentWindowBackground}" CornerRadius="3" Padding="6,4" Margin="0,0,0,4">
                                    <TextBlock x:Name="HelpExample" FontFamily="Consolas" FontSize="12"
                                               Foreground="{DynamicResource AvailableFunctions.ExampleText}" TextWrapping="Wrap"/>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Expander>

                <!-- Expression Errors Expander -->
                <Expander x:Name="ErrorsExpander" Grid.Row="2"
                          Style="{DynamicResource PropertyExpanderStyle}"
                          Visibility="Collapsed" IsExpanded="False"
                          Margin="0,3,0,0">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{DynamicResource ErrorImage}" Width="14" Height="14" Margin="0,0,5,0"
                                   VerticalAlignment="Center"/>
                            <TextBlock x:Name="ErrorsExpanderHeader" Text="Expression Errors"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ExpressionError.Text}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Height="Auto" MinHeight="50" Margin="0,3,0,0">
                        <ItemsControl x:Name="ErrorsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,1,0,1">
                                        <TextBlock Text="&#x2022;" DockPanel.Dock="Left" Margin="4,0,6,0" FontWeight="Bold"
                                                   Foreground="{DynamicResource ExpressionError.Text}"/>
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource ExpressionError.Text}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Expander>
            </Grid>
        </ScrollViewer>

        <!-- Row 1: Toolbar (always pinned at bottom) -->
        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,3,0,0">
            <!-- Functions Toggle Button -->
            <ToggleButton x:Name="FunctionsToggleButton" Height="24" Width="28" Padding="0"
                          SnapsToDevicePixels="True" ToolTip="More functions"
                          Checked="FunctionsToggleButton_Checked" Unchecked="FunctionsToggleButton_Unchecked">
                <Viewbox Width="16" Height="16" RenderOptions.EdgeMode="Aliased">
                    <Grid Width="16" Height="16">
                        <TextBlock Text="f" FontFamily="Cambria" FontSize="14" FontStyle="Italic" FontWeight="SemiBold"
                                   Foreground="{DynamicResource EnvironmentWindowText}" Margin="2,-1,0,0"
                                   HorizontalAlignment="Left" VerticalAlignment="Stretch"/>
                        <TextBlock Text="x" FontFamily="Cambria" FontSize="10" FontStyle="Italic" FontWeight="SemiBold"
                                   Foreground="{DynamicResource EnvironmentWindowText}"
                                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="7,0,0,1"/>
                    </Grid>
                </Viewbox>
            </ToggleButton>

            <!-- Separator -->
            <Rectangle Width="1" Margin="4,4,4,4" Fill="{DynamicResource SeparatorBorder}"/>

            <!-- Operator Buttons (native 12×12 vector paths — no Viewbox scaling) -->
            <Button Name="AddButton" Height="24" Width="24" Padding="0" SnapsToDevicePixels="True" ToolTip="Add (+)" Click="AddButton_Click">
                <Path Data="M 0,6 H 12 M 6,0 V 12" Width="12" Height="12" Stroke="{DynamicResource CalculatorControl.OperatorGlyph}" StrokeThickness="1.5" SnapsToDevicePixels="True"/>
            </Button>
            <Button Name="SubtractButton" Height="24" Width="24" Margin="3,0,0,0" Padding="0" SnapsToDevicePixels="True" ToolTip="Subtract (-)" Click="SubtractButton_Click">
                <Path Data="M 1,6 H 11" Width="12" Height="12" Stroke="{DynamicResource CalculatorControl.OperatorGlyph}" StrokeThickness="1.5" SnapsToDevicePixels="True"/>
            </Button>
            <Button Name="MultiplyButton" Height="24" Width="24" Margin="3,0,0,0" Padding="0" SnapsToDevicePixels="True" ToolTip="Multiply (*)" Click="MultiplyButton_Click">
                <Path Data="M 1,1 L 11,11 M 1,11 L 11,1" Width="12" Height="12" Stroke="{DynamicResource CalculatorControl.OperatorGlyph}" StrokeThickness="1.5" SnapsToDevicePixels="True"/>
            </Button>
            <Button Name="DivideButton" Height="24" Width="24" Margin="3,0,0,0" Padding="0" SnapsToDevicePixels="True" ToolTip="Divide (/)" Click="DivideButton_Click">
                <Path Data="M 1,6 H 11 M 5,10 H 7 M 5,2 H 7" Width="12" Height="12" Stroke="{DynamicResource CalculatorControl.OperatorGlyph}" StrokeThickness="1.5" SnapsToDevicePixels="True"/>
            </Button>
            <Button Name="ExponentButton" Height="24" Width="24" Margin="3,0,0,0" Padding="0" SnapsToDevicePixels="True" ToolTip="Exponentiate (^)" Click="ExponentButton_Click">
                <Path Data="M 2,7 L 6,1 L 10,7" Width="12" Height="12" Stroke="{DynamicResource CalculatorControl.OperatorGlyph}" StrokeThickness="1.5" StrokeLineJoin="Round" SnapsToDevicePixels="True"/>
            </Button>
            <Button Name="LessThanButton" Height="24" Width="24" Margin="3,0,0,0" Padding="0" SnapsToDevicePixels="True" ToolTip="Less than (&lt;)" Click="LessThanButton_Click">
                <Path Data="M 10,1 L 2,6 L 10,11" Width="12" Height="12" Stroke="{DynamicResource CalculatorControl.OperatorGlyph}" StrokeThickness="1.5" StrokeLineJoin="Round" SnapsToDevicePixels="True"/>
            </Button>
            <Button Name="GreaterThanButton" Height="24" Width="24" Margin="3,0,0,0" Padding="0" SnapsToDevicePixels="True" ToolTip="Greater than (&gt;)" Click="GreaterThanButton_Click">
                <Path Data="M 2,1 L 10,6 L 2,11" Width="12" Height="12" Stroke="{DynamicResource CalculatorControl.OperatorGlyph}" StrokeThickness="1.5" StrokeLineJoin="Round" SnapsToDevicePixels="True"/>
            </Button>
            <Button Name="EqualsButton" Height="24" Width="24" Margin="3,0,0,0" Padding="0" SnapsToDevicePixels="True" ToolTip="Equals (=)" Click="EqualsButton_Click">
                <Path Data="M 1,4 H 11 M 1,8 H 11" Width="12" Height="12" Stroke="{DynamicResource CalculatorControl.OperatorGlyph}" StrokeThickness="1.5" SnapsToDevicePixels="True"/>
            </Button>

            <!-- Match Case Checkbox -->
            <CheckBox
                Content="Match Case"
                x:Name="IsCaseSensitiveCheckbox"
                Margin="8,0,0,0"
                Checked="IsCaseSensitiveCheckbox_Checked"
                Unchecked="IsCaseSensitiveCheckbox_Checked"
                VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
