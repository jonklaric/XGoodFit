<Application x:Class="FrameworkUI.Demo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FrameworkUI.Demo"
             Startup="Application_Startup"
             ShutdownMode="OnMainWindowClose"
             DispatcherUnhandledException="Application_DispatcherUnhandledException">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Icon resources -->
                <ResourceDictionary Source="pack://application:,,,/FrameworkUI;component/Icons/IconDictionary.xaml"/>

                <!-- Demo element icons (theme-aware vector icons) -->
                <ResourceDictionary Source="pack://application:,,,/FrameworkUI.Demo;component/Resources/IconDictionary.xaml"/>

                <!-- Theme resources are loaded by ThemeService.Initialize() in App.xaml.cs -->
                <!-- This ensures proper loading order and enables runtime theme switching -->

                <!-- GenericControls Theme Resources (for CopyPasteDataGrid, cell/header styles, etc.) -->
                <ResourceDictionary Source="pack://application:,,,/GenericControls;component/Themes/GenericControlsTheme.xaml"/>

                <!-- OxyPlotControls Theme Resources (for PropertyExpanderStyle, PropertiesTabItemStyle, etc.) -->
                <ResourceDictionary Source="pack://application:,,,/OxyPlotControls;component/Themes/OxyPlotControlsTheme.xaml"/>

                <!-- NumericControls Theme Resources (for probability ordinate editing controls) -->
                <ResourceDictionary Source="pack://application:,,,/NumericControls;component/Themes/NumericControlsTheme.xaml"/>

                <!-- DatabaseControls Theme Resources (for TableViewer styles) -->
                <ResourceDictionary Source="pack://application:,,,/DatabaseControls;component/Themes/DatabaseControlsTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
