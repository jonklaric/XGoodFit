<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:FrameworkUI">

    <!--
    FrameworkUI-specific control styles.
    Common control styles (Button, CheckBox, ComboBox, etc.) are provided by the Themes library.
    This file only includes styles that are unique to FrameworkUI.
    -->

    <ResourceDictionary.MergedDictionaries>

        <!-- Icon resources - must be loaded before styles that reference them -->
        <ResourceDictionary Source="/FrameworkUI;component/Icons/IconDictionary.xaml"/>

        <!-- FrameworkUI-specific styles -->
        <ResourceDictionary Source="MainWindowStyle.xaml"/>
        <ResourceDictionary Source="MessageWindow.xaml"/>
        <ResourceDictionary Source="ProjectExplorer.xaml"/>

    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>