<UserControl x:Class="FrameworkUI.GeneralOptions"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:cntrls="clr-namespace:GenericControls;assembly=GenericControls"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="400"
             Background="{DynamicResource EnvironmentWindowBackground}"
             Foreground="{DynamicResource EnvironmentWindowText}" 
              DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!--Visual Experience-->
        <cntrls:SeparatorWithHeader Header="Visual Experience" Grid.Row="0" LeftSeparatorWidth="10" Margin="4"/>
        <Grid Grid.Row="1" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Color theme:" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="0" Grid.Column="0" Margin="4"/>
            <ComboBox x:Name="ColorThemeComboBox" Width="100" Grid.Row="0" Grid.Column="2" Margin="4" 
                      ItemsSource="{Binding ThemeList}" 
                      SelectedValue="{Binding ColorTheme, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
        </Grid>
        <!--Window Docking Manager-->
        <cntrls:SeparatorWithHeader Header="Window Docking Manager" Grid.Row="2" LeftSeparatorWidth="10" Margin="4,6,4,4"/>
        <Grid Grid.Row="3" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <CheckBox x:Name="LayoutCheckBox" Grid.Row="0" Content="Save window docking layout on close" Margin="4" VerticalAlignment="Center" IsChecked="{Binding SaveWindowLayout,Mode=TwoWay}"/>
        </Grid>
        <!--Recent Projects-->
        <cntrls:SeparatorWithHeader Header="Recently Used Files" Grid.Row="4" LeftSeparatorWidth="10" Margin="4,6,4,4"/>
        <Grid Grid.Row="5" Margin="12,2,2,2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <cntrls:NumericUpDown x:Name="WindowMenuItemsUpDown" Maximum="20" Minimum="1" Increment="1" Grid.Row="0" Grid.Column="0" Height="24" Width="52" Margin="4" Value="{Binding MaxWindowMenuItems, Mode=TwoWay}"/>
            <TextBlock Text="items shown in Window menu" VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Row="0" Grid.Column="1" Margin="4"/>
            <cntrls:NumericUpDown x:Name="RecentMenuItemsUpDown" Maximum="20" Minimum="1" Increment="1" Grid.Row="1" Grid.Column="0" Height="24" Width="52" Margin="4" Value="{Binding MaxRecentFileItems, Mode=TwoWay}"/>
            <TextBlock Text="items shown in Recent Projects list" VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="1" Margin="4"/>
        </Grid>
    </Grid>
</UserControl>
