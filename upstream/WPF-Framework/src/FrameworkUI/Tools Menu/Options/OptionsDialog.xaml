<cntrls:MetroWindow x:Class="FrameworkUI.OptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FrameworkUI"
        xmlns:cntrls="clr-namespace:GenericControls;assembly=GenericControls"
        mc:Ignorable="d"
        Title="Options"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterOwner"
        Style="{DynamicResource MetroWindowStyle}"
        Background="{DynamicResource EnvironmentWindowBackground}"
        Foreground="{DynamicResource EnvironmentWindowText}"
        Icon="{DynamicResource OptionsImage}"
        Loaded="OptionsDialog_Loaded"
        DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>
        <TabControl Grid.Row="0" Margin="0,4,0,4" MinHeight="300" MinWidth="500" TabStripPlacement="Left"  >
            <TabItem Header="Application" Style="{DynamicResource VerticalTabItemStyle}">
                <local:GeneralOptions x:Name="GeneralOptions"/>
            </TabItem>
            <TabItem Header="File Management" Style="{DynamicResource VerticalTabItemStyle}">
                <local:FileManagementOptions x:Name="FileManagementOptions"/>
            </TabItem>
            <TabItem Header="Message Window" Style="{DynamicResource VerticalTabItemStyle}">
                <local:MessageWindowOptions x:Name="MessageWindowOptions"/>
            </TabItem>
            <TabItem Header="Defaults" Style="{DynamicResource VerticalTabItemStyle}">
                <local:DefaultsOptions x:Name="DefaultsOptions"/>
            </TabItem>
        </TabControl>

        <!--Add Ok and Cancel Buttons-->
        <Grid Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Name="btn_Ok" Click="btn_Apply_Click" IsDefault="True" Content="Apply" Grid.Column="0" Width="75" Height="24" Margin="6,0,0,6" Cursor="Hand"/>
            <Button Name="btn_Cancel" Click="btn_Cancel_Click" IsCancel="True" Content="Cancel" Grid.Column="1" Width="75" Height="24" Margin="6,0,6,6" Cursor="Hand"/>
        </Grid>

    </Grid>
</cntrls:MetroWindow>
