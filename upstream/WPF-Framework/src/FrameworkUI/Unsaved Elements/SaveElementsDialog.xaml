<cntrls:MetroWindow x:Class="FrameworkUI.SaveElementsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:cntrls="clr-namespace:GenericControls;assembly=GenericControls"
        mc:Ignorable="d"
        Title="Save Changes"
        Icon="{DynamicResource SaveImage}"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight"
        Style="{DynamicResource MetroWindowStyle}"
        Background="{DynamicResource EnvironmentWindowBackground}"
        Foreground="{DynamicResource EnvironmentWindowText}"
        DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Would you like to save changes to the following items?" Margin="6,6,6,0" Grid.Row="0" VerticalAlignment="Bottom"/>

        <!--Data Grid-->
        <DataGrid x:Name="MyDataGrid"  Margin="6" Grid.Row="1" Height="250" Width="400" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True" 
                  Background="{DynamicResource DataGrid.Static.Background}"  
                  BorderBrush="{DynamicResource SeparatorBorder}" 
                  BorderThickness="1"
                  GridLinesVisibility="None" 
                  HeadersVisibility="Column" 
                  IsEnabled="False" >
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn HeaderStyle="{DynamicResource Center_ColumnHeaderStyle_Modal}" Width="SizeToCells" CanUserSort="False" CanUserReorder="False" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding ImageSource}" Width="16" Height="16" RenderOptions.EdgeMode="Aliased" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn HeaderStyle="{DynamicResource Left_ColumnHeaderStyle_Modal}" MinWidth="100" MaxWidth="200" Header="File Type" Binding="{Binding Element.ParentCollection.Name}" CanUserSort="True" CanUserReorder="False">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Left" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="TextAlignment" Value="Left" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn HeaderStyle="{DynamicResource Left_ColumnHeaderStyle_Modal}" MinWidth="100" Width="*" Header=" Name" Binding="{Binding Element.DisplayName}" CanUserSort="True" CanUserReorder="False">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Left" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="TextAlignment" Value="Left" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!--Buttons-->
        <Grid Grid.Row="2" HorizontalAlignment="Right">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Name="btn_Save" Click="Btn_Save_Click" Content="Save" Grid.Column="0" Width="75" Height="24" Margin="6,0,0,6" Cursor="Hand"/>
            <Button Name="btn_DontSave" Click="Btn_DontSave_Click" Content="Don't Save" Grid.Column="1" Width="75" Height="24" Margin="6,0,0,6" Cursor="Hand"/>
            <Button Name="btn_Cancel" Click="Btn_Cancel_Click" Content="Cancel" Grid.Column="2" Width="75" Height="24" Margin="6,0,6,6" Cursor="Hand"/>
        </Grid>
    </Grid>
</cntrls:MetroWindow>
