<cntrls:MetroWindow x:Class="FrameworkUI.OpenWindowsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:cntrls="clr-namespace:GenericControls;assembly=GenericControls"
        mc:Ignorable="d"
        Title="Windows"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight"
        Style="{DynamicResource MetroWindowStyle}"
        Background="{DynamicResource EnvironmentWindowBackground}"
        Foreground="{DynamicResource EnvironmentWindowText}"
        DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <Grid x:Name="MainGrid">

        <!--Add Rows-->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--Add Columns-->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--Data Grid-->
        <DataGrid x:Name="MyDataGrid" Grid.Column="0" Margin="6" Height="250" Width="400" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True" 
                  Background="{DynamicResource DataGrid.Static.Background}"  
                  BorderBrush="{DynamicResource SeparatorBorder}" 
                  BorderThickness="1"
                  GridLinesVisibility="None" 
                  HeadersVisibility="Column" 
                  SelectionChanged="MyDataGrid_SelectionChanged" >
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn HeaderStyle="{DynamicResource Center_ColumnHeaderStyle_Modal}" Width="SizeToCells" CanUserSort="False" CanUserReorder="False" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding ImageSource}" Width="16" Height="16" RenderOptions.EdgeMode="Aliased" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn HeaderStyle="{DynamicResource Left_ColumnHeaderStyle_Modal}" MinWidth="100" MaxWidth="200" Header="File Type" Binding="{Binding Element.ParentCollection.Name}" CanUserSort="True" CanUserReorder="False" >
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Left" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="TextAlignment" Value="Left" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn HeaderStyle="{DynamicResource Left_ColumnHeaderStyle_Modal}" MinWidth="100" Width="*" Header="Name" Binding="{Binding Element.DisplayName}" CanUserSort="True" CanUserReorder="False">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Left" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="TextAlignment" Value="Left" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!--Document Buttons-->
        <Grid x:Name="DocuemntButtonGrid" Grid.Row="0" Grid.Column="1">
            <!--Add Rows-->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Button Name="ActivateButton" Height="24" Width="110" IsEnabled="False" Click="ActivateButton_Click" Content="Activate" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="0" Margin="0,6,6,6" Cursor="Hand"/>
            <Button Name="SaveButton"  Height="24" Width="110" IsEnabled="False"  Click="SaveButton_Click" Content="Save" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="1" Margin="0,0,6,6" Cursor="Hand"/>
            <Button Name="CloseWindowsButton"  Height="24" Width="110" IsEnabled="False" Click="CloseWindowsButton_Click" Content="Close Window(s)" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="2" Margin="0,0,6,6" Cursor="Hand"/>
        </Grid>
    </Grid>
</cntrls:MetroWindow>
