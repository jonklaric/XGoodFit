<UserControl x:Class="GenericControls.ClockControl" x:Name="TimePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GenericControls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Ideal">
    <UserControl.Resources>
        <local:BooleanToVisibilityConverter x:Key="FalseToCollapsed" TrueValue="Visible" FalseValue="Collapsed"/>
        <local:BooleanToVisibilityConverter x:Key="TrueToCollapsed" TrueValue="Collapsed" FalseValue="Visible"/>
        <local:TimeTextConverter x:Key="Hour24TimeToTextConverter" TimeType="Hour" Is24Hour="True"/>
        <local:TimeTextConverter x:Key="Hour12TimeToTextConverter" TimeType="Hour" Is24Hour="False"/>
        <local:TimeTextConverter x:Key="MinuteTimeToTextConverter" TimeType="Minute"/>
        <local:TimeTextConverter x:Key="SecondTimeToTextConverter" TimeType="Second"/>
        <local:TimeTextConverter x:Key="AMPMTimeToTextConverter" TimeType="Meridian"/>
        <Style TargetType="{x:Type Border}" x:Key="AMPMStyle">
            <Setter Property="Width" Value="15"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Background" Value="{Binding ElementName=TimePicker, Path=FaceColor}"/>
            <EventSetter Event="MouseEnter" Handler="AMPMBorder_MouseEnter"/>
            <EventSetter Event="MouseLeave" Handler="AMPMBorder_MouseLeave"/>
            <EventSetter Event="MouseUp" Handler="AMPMBorder_MouseUp"/>
        </Style>
        <Style TargetType="{x:Type local:ClockToggle}" x:Key="ClockMajorValueStyle">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Background" Value="{Binding ElementName=TimePicker, Path=FaceColor}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{Binding ElementName=TimePicker, Path=SelectedColor}"/>
                    <Setter Property="FontColor" Value="{Binding ElementName=TimePicker, Path=SelectedFontColor}"/>
                </Trigger>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{Binding ElementName=TimePicker, Path=HighlightColor}"/>
                    <Setter Property="FontColor" Value="{Binding ElementName=TimePicker, Path=FontColor}"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsHighlighted" Value="False"/>
                        <Condition Property="IsSelected" Value="False"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="FontColor" Value="{Binding ElementName=TimePicker, Path=FontColor}"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type local:ClockToggle}" x:Key="ClockMinorValueStyle">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Height" Value="4"/>
            <Setter Property="Background" Value="{Binding ElementName=TimePicker, Path=FaceColor}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{Binding ElementName=TimePicker, Path=SelectedColor}"/>
                </Trigger>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{Binding ElementName=TimePicker, Path=HighlightColor}"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsHighlighted" Value="False"/>
                        <Condition Property="IsSelected" Value="False"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="Transparent"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border BorderBrush="{Binding ElementName=TimePicker, Path=BorderBrush}"
            BorderThickness="{Binding ElementName=TimePicker, Path=BorderThickness}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource EnvironmentWindowBackground}" Grid.Row="0" Margin="1 0">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <TextBlock MouseUp="HoursMouseUp">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="VerticalAlignment" Value="Bottom"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=TimePicker, Path=IsHours}" Value="True">
                                    <Setter Property="FontSize" Value="{Binding ElementName=TimePicker, Path=SelectedTimeFontSize}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ElementName=TimePicker, Path=IsHours}" Value="False">
                                    <Setter Property="FontSize" Value="{Binding ElementName=TimePicker, Path=TimeFontSize}"/>
                                    <Setter Property="Foreground" Value="{Binding ElementName=TimePicker, Path=TimeColor}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ElementName=TimePicker, Path=Is24Hour}" Value="True">
                                    <Setter Property="Text" Value="{Binding ElementName=TimePicker, Path=Time, Converter={StaticResource Hour24TimeToTextConverter}}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ElementName=TimePicker, Path=Is24Hour}" Value="False">
                                    <Setter Property="Text" Value="{Binding ElementName=TimePicker, Path=Time, Converter={StaticResource Hour12TimeToTextConverter}}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text=":" FontSize="{Binding ElementName=TimePicker, Path=TimeFontSize}"></TextBlock>
                <TextBlock Text="{Binding ElementName=TimePicker, Path=Time, Converter={StaticResource MinuteTimeToTextConverter}}" MouseUp="MinutesMouseUp">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="VerticalAlignment" Value="Bottom"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=TimePicker, Path=IsMinutes}" Value="True">
                                    <Setter Property="FontSize" Value="{Binding ElementName=TimePicker, Path=SelectedTimeFontSize}"/>
                                    <Setter Property="Foreground" Value="{Binding ElementName=TimePicker, Path=SelectedTimeColor}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ElementName=TimePicker, Path=IsMinutes}" Value="False">
                                    <Setter Property="FontSize" Value="{Binding ElementName=TimePicker, Path=TimeFontSize}"/>
                                    <Setter Property="Foreground" Value="{Binding ElementName=TimePicker, Path=TimeColor}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text=":" FontSize="{Binding ElementName=TimePicker, Path=TimeFontSize}" Visibility="{Binding ElementName=TimePicker, Path=HasSeconds, Converter={StaticResource FalseToCollapsed}}"></TextBlock>
                <TextBlock Text="{Binding ElementName=TimePicker, Path=Time, Converter={StaticResource SecondTimeToTextConverter}}" MouseUp="SecondsMouseUp" Visibility="{Binding ElementName=TimePicker, Path=HasSeconds, Converter={StaticResource FalseToCollapsed}}">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="VerticalAlignment" Value="Bottom"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=TimePicker, Path=IsSeconds}" Value="True">
                                    <Setter Property="FontSize" Value="{Binding ElementName=TimePicker, Path=SelectedTimeFontSize}"/>
                                    <Setter Property="Foreground" Value="{Binding ElementName=TimePicker, Path=SelectedTimeColor}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ElementName=TimePicker, Path=IsSeconds}" Value="False">
                                    <Setter Property="FontSize" Value="{Binding ElementName=TimePicker, Path=TimeFontSize}"/>
                                    <Setter Property="Foreground" Value="{Binding ElementName=TimePicker, Path=TimeColor}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text=" " FontSize="{Binding ElementName=TimePicker, Path=TimeFontSize}" VerticalAlignment="Bottom"></TextBlock>
                <TextBlock Text="{Binding ElementName=TimePicker, Path=Time, Converter={StaticResource AMPMTimeToTextConverter}}" FontSize="{Binding ElementName=TimePicker, Path=TimeFontSize}" Foreground="{Binding ElementName=TimePicker, Path=TimeColor}" VerticalAlignment="Bottom" MouseUp="AmPmMouseUp" Visibility="{Binding ElementName=TimePicker, Path=Is24Hour, Converter={StaticResource TrueToCollapsed}}"></TextBlock>
            </StackPanel>
        </Border>

        <Viewbox Grid.Row="1" Margin="0,5,0,5">
            <Canvas x:Name="MyCanvas" Width="100" Height="100">
                <Ellipse Name="ClockFace" Fill="{Binding ElementName=TimePicker, Path=FaceColor}" Width="100" Height="100" MouseMove="ClockFace_MouseMove" MouseDown="ClockFace_MouseDown" MouseUp="ClockFace_MouseUp" MouseEnter="ClockFace_MouseEnter" MouseLeave="ClockFace_MouseLeave"></Ellipse>
                <Border Name="AMFace" Style="{StaticResource AMPMStyle}" Visibility="{Binding ElementName=TimePicker, Path=Is24Hour, Converter={StaticResource TrueToCollapsed}}">
                    <TextBlock Name="AMText" Text="AM" FontSize="7" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                </Border>
                <Border Name="PMFace" Style="{StaticResource AMPMStyle}" Margin="85,0,0,0" Visibility="{Binding ElementName=TimePicker, Path=Is24Hour, Converter={StaticResource TrueToCollapsed}}">
                    <TextBlock Name="PMText" Text="PM" FontSize="7" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                </Border>
                <Grid x:Name="HoursGrid" Width="{Binding ActualWidth, ElementName=MyCanvas}" Height="{Binding ActualHeight, ElementName=MyCanvas}" Visibility="{Binding ElementName=TimePicker, Path=IsHours, Converter={StaticResource FalseToCollapsed}, UpdateSourceTrigger=PropertyChanged}" IsHitTestVisible="False">
                    <Line x:Name="PreviewHourHandLine" X1="0" Y1="0" X2="0" Y2="0" Stroke="{Binding ElementName=TimePicker, Path=PreviewHandColor}" StrokeThickness="1" IsHitTestVisible="False">
                        <Line.RenderTransform>
                            <TranslateTransform X="50" Y="50"/>
                        </Line.RenderTransform>
                    </Line>   
                    <Ellipse Fill="{Binding ElementName=TimePicker, Path=HandColor}" Width="4" Height="4" IsHitTestVisible="False"></Ellipse>
                    <Line x:Name="HourHandLine" X1="0" Y1="0" X2="0" Y2="0" Stroke="{Binding ElementName=TimePicker, Path=HandColor}" StrokeThickness="1" IsHitTestVisible="False">
                        <Line.RenderTransform>
                            <TranslateTransform X="50" Y="50"/>
                        </Line.RenderTransform>
                    </Line>
                </Grid>
                <Grid x:Name="MinutesGrid" Width="{Binding ActualWidth, ElementName=MyCanvas}" Height="{Binding ActualHeight, ElementName=MyCanvas}" Visibility="{Binding ElementName=TimePicker, Path=IsMinutes, Converter={StaticResource FalseToCollapsed}, UpdateSourceTrigger=PropertyChanged}" IsHitTestVisible="False">
                    <Line x:Name="PreviewMinuteHandLine" X1="0" Y1="0" X2="0" Y2="0" Stroke="{Binding ElementName=TimePicker, Path=PreviewHandColor}" StrokeThickness="1" IsHitTestVisible="False">
                        <Line.RenderTransform>
                            <TranslateTransform X="50" Y="50"/>
                        </Line.RenderTransform>
                    </Line>
                    <Ellipse Fill="{Binding ElementName=TimePicker, Path=HandColor}" Width="4" Height="4"></Ellipse>
                    <Line x:Name="MinuteHandLine" X1="0" Y1="0" X2="0" Y2="0" Stroke="{Binding ElementName=TimePicker, Path=HandColor}" StrokeThickness="1">
                        <Line.RenderTransform>
                            <TranslateTransform X="50" Y="50"/>
                        </Line.RenderTransform>
                    </Line>
                </Grid>
                <Grid x:Name="SecondsGrid" Width="{Binding ActualWidth, ElementName=MyCanvas}" Height="{Binding ActualHeight, ElementName=MyCanvas}" Visibility="{Binding ElementName=TimePicker, Path=IsSeconds, Converter={StaticResource FalseToCollapsed}, UpdateSourceTrigger=PropertyChanged}" IsHitTestVisible="False">
                    <Line x:Name="PreviewSecondHandLine" X1="0" Y1="0" X2="0" Y2="0" Stroke="{Binding ElementName=TimePicker, Path=PreviewHandColor}" StrokeThickness="1" IsHitTestVisible="False">
                        <Line.RenderTransform>
                            <TranslateTransform X="50" Y="50"/>
                        </Line.RenderTransform>
                    </Line>
                    <Ellipse Fill="{Binding ElementName=TimePicker, Path=HandColor}" Width="4" Height="4"></Ellipse>
                    <Line x:Name="SecondHandLine" X1="0" Y1="0" X2="0" Y2="0" Stroke="{Binding ElementName=TimePicker, Path=HandColor}" StrokeThickness="1">
                        <Line.RenderTransform>
                            <TranslateTransform X="50" Y="50"/>
                        </Line.RenderTransform>
                    </Line>
                </Grid>
            </Canvas>
        </Viewbox>


        </Grid>
    </Border>
</UserControl>
