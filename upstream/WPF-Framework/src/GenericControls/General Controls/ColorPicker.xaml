<UserControl x:Class="GenericControls.ColorPicker" x:Name="ColorPickerRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:PresentationOptions="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GenericControls"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="126">
    <UserControl.Resources>
        <local:ColorToByteConverter x:Key="AlphaColorConverter" Component="A"/>
        <local:ColorToByteConverter x:Key="RedColorConverter" Component="R"/>
        <local:ColorToByteConverter x:Key="GreenColorConverter" Component="G"/>
        <local:ColorToByteConverter x:Key="BlueColorConverter" Component="B"/>

        <ControlTemplate x:Key="ColorSliderTemplate" TargetType="{x:Type Slider}">
            <Border Cursor="SizeWE" SnapsToDevicePixels="true" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                <Grid>
                    <Track x:Name="PART_Track">
                        <Track.Thumb>
                            <Thumb x:Name="Thumb">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Grid Height="18">
                                            <Rectangle StrokeThickness="1" Width="10" SnapsToDevicePixels="True">
                                                <Rectangle.Style>
                                                    <Style TargetType="Rectangle">
                                                        <Setter Property="Stroke" Value="{DynamicResource Button.Static.Border}"/>
                                                        <Setter Property="Fill" Value="{DynamicResource TextBox.Static.Background}"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Stroke" Value="{DynamicResource Button.MouseOver.Border}"/>
                                                                <Setter Property="Fill" Value="{DynamicResource Button.MouseOver.Background}"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Rectangle.Style>
                                            </Rectangle>
                                        </Grid>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </Grid>
            </Border>
        </ControlTemplate>

        <ControlTemplate x:Key="VerticalColorSliderTemplate" TargetType="{x:Type Slider}">
            <Border Cursor="SizeNS" SnapsToDevicePixels="true" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                <Grid>
                    <Track x:Name="PART_Track">
                        <Track.Thumb>
                            <Thumb x:Name="Thumb">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Grid Width="18">
                                            <Rectangle StrokeThickness="1" Height="10" SnapsToDevicePixels="True">
                                                <Rectangle.Style>
                                                    <Style TargetType="Rectangle">
                                                        <Setter Property="Stroke" Value="{DynamicResource Button.Static.Border}"/>
                                                        <Setter Property="Fill" Value="{DynamicResource TextBox.Static.Background}"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Stroke" Value="{DynamicResource Button.MouseOver.Border}"/>
                                                                <Setter Property="Fill" Value="{DynamicResource Button.MouseOver.Background}"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Rectangle.Style>
                                            </Rectangle>
                                        </Grid>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </Grid>
            </Border>
        </ControlTemplate>

        <DrawingBrush x:Key="CheckerBrush" Viewport="0,0,10,10" ViewportUnits="Absolute" TileMode="Tile">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="White">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0 50,50" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="LightGray">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0 50,50" />
                                <RectangleGeometry Rect="50,50 50,50" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        
        <Style TargetType="Rectangle">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Margin" Value="1,1,1,1"/>
            <Setter Property="Stroke" Value="{DynamicResource Button.Static.Border}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <EventSetter Event="MouseLeftButtonUp" Handler="Rectangle_MouseLeftButtonUp"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Stroke" Value="{DynamicResource Button.MouseOver.Border}"/>
                    <Setter Property="StrokeThickness" Value="2"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Stroke" Value="{DynamicResource Button.Static.Border}"/>
                    <Setter Property="StrokeThickness" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
    </UserControl.Resources>
    <Grid Background="{Binding Background, ElementName=ColorPickerRoot}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" MinHeight="30"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--Color Tone Window-->
        <Border
            Grid.Row="0"
            Grid.Column="0"
            Background="{DynamicResource EnvironmentWindowBackground}"
            BorderBrush="{DynamicResource Button.Static.Border}"
            BorderThickness="1">
            <Border
                Name="PreviewBorderBackground"
                Background="{StaticResource CheckerBrush}">
            <Border 
                Name="PreviewBorder" 
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch" 
                Cursor="Cross" 
                MouseLeftButtonDown="PreviewBorder_MouseLeftButtonDown" 
                MouseUp="PreviewBorder_MouseUp" 
                MouseMove="PreviewBorder_MouseMove" 
                MouseLeave="PreviewBorder_MouseLeave"
                SizeChanged="PreviewBorder_SizeChanged">
                <Border.Background>
                    <DrawingBrush x:Name="PreviewDrawingBrush">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing>
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0,0,50,50" />
                                    </GeometryDrawing.Geometry>
                                    <GeometryDrawing.Brush>
                                        <SolidColorBrush x:Name="GradBrush1"/>
                                    </GeometryDrawing.Brush>
                                </GeometryDrawing>
                                <GeometryDrawing>
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0,0,50,50" />
                                    </GeometryDrawing.Geometry>
                                    <GeometryDrawing.Brush>
                                        <LinearGradientBrush StartPoint="0.5,1" EndPoint="0.5,0">
                                            <GradientStop Offset="0.0" Color="Black" />
                                            <GradientStop x:Name="GradStop2" Offset="1.0" Color="Transparent"/>
                                        </LinearGradientBrush>
                                    </GeometryDrawing.Brush>
                                </GeometryDrawing>
                                <DrawingGroup PresentationOptions:Freeze="True">
                                    <GeometryDrawing>
                                        <GeometryDrawing.Geometry>
                                            <RectangleGeometry Rect="0,0,50,50" />
                                        </GeometryDrawing.Geometry>
                                        <GeometryDrawing.Brush>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Offset="0.0" Color="White" />
                                                <GradientStop Offset="1" Color="Black" />
                                            </LinearGradientBrush>
                                        </GeometryDrawing.Brush>
                                    </GeometryDrawing>
                                    <DrawingGroup.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop Offset="0.0" Color="#FF000000" />
                                            <GradientStop Offset="1" Color="#00000000" />
                                        </LinearGradientBrush>
                                    </DrawingGroup.OpacityMask>
                                </DrawingGroup>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Border.Background>
                <Grid>
                    <Path Name="PART_ColorMarker1" StrokeThickness="2" Fill="Transparent" Stroke="White">
                        <Path.Data>
                            <EllipseGeometry RadiusX="5" RadiusY="5"/>
                        </Path.Data>
                    </Path>
                    <Path Name="PART_ColorMarker2" StrokeThickness="1" Fill="Transparent" Stroke="Black">
                        <Path.Data>
                            <EllipseGeometry RadiusX="3.5" RadiusY="3.5"/>
                        </Path.Data>
                    </Path>
                </Grid>
            </Border>
            </Border>
        </Border>

        <!--Vertical Slider-->
        <Slider
            x:Name="PART_ColorSlider"
                Cursor="SizeNS"
                Margin="2,0,0,0"
                Grid.Column="1"
                Value="0" 
                IsMoveToPointEnabled="True" 
                IsSnapToTickEnabled="False" 
                Maximum="360" 
                Orientation="Vertical" 
                HorizontalAlignment="Center" 
                Template="{StaticResource VerticalColorSliderTemplate}"
                ValueChanged="PART_ColorSlider_ValueChanged">
        </Slider>

        <!--Opacity Slider-->
        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,1,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="A" HorizontalAlignment="Center" TextAlignment="Center" Width="12" VerticalAlignment="Center"
                       Foreground="{DynamicResource EnvironmentWindowText}"/>
            <Border 
                Grid.Column="1" 
                BorderThickness="0" 
                Padding="0"
                Background="{StaticResource CheckerBrush}" 
                VerticalAlignment="Stretch">
                <Slider 
                    Orientation="Horizontal"
                    Minimum="0" 
                    Maximum="255" 
                    TickFrequency="2.55" 
                    SmallChange="2.55" 
                    LargeChange="5.1" 
                    VerticalAlignment="Stretch" 
                    IsMoveToPointEnabled="True"
                    Template="{StaticResource ColorSliderTemplate}"
                    Value="{Binding ElementName=ColorPickerRoot, Path=Color, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource AlphaColorConverter}}">
                    <Slider.Background>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Offset="0.0" Color="Transparent" />
                            <GradientStop x:Name="MaxAStop" Offset="1.0" Color="Black" />
                        </LinearGradientBrush>
                    </Slider.Background>
                </Slider>
            </Border>

            <local:NumericTextBox2
                x:Name="AlphaTextBox"
                Grid.Column="2"
                Margin="1,0,0,0"
                Width="30" 
                MinValue="0"
                MaxValue="255"
                IsWholeNumber="True"
                Value="{Binding ElementName=ColorPickerRoot, Path=Color, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource AlphaColorConverter}}"/>
        </Grid>

        <!--Red Slider-->
        <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,1,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="R" HorizontalAlignment="Center" TextAlignment="Center" Width="12" VerticalAlignment="Center"
                       Foreground="{DynamicResource EnvironmentWindowText}"/>
            <Slider 
                x:Name="RSlider" 
                Grid.Column="1"
                Orientation="Horizontal"
                Minimum="0" 
                Maximum="255" 
                TickFrequency="2.55" 
                SmallChange="2.55" 
                LargeChange="5.1" 
                VerticalAlignment="Stretch"
                IsMoveToPointEnabled="True"
                Template="{StaticResource ColorSliderTemplate}"
                Value="{Binding ElementName=ColorPickerRoot, Path=Color, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource RedColorConverter}}"
            >
                <Slider.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop x:Name="MinRStop" Offset="0.0" Color="Black" />
                        <GradientStop x:Name="MaxRStop" Offset="1.0" Color="Red" />
                    </LinearGradientBrush>
                </Slider.Background>
            </Slider>

            <local:NumericTextBox2
                x:Name="RedTextBox"
                Grid.Column="2"
                Margin="1,0,0,0"
                Width="30" 
                MinValue="0"
                MaxValue="255"
                IsWholeNumber="True"
                Value="{Binding ElementName=ColorPickerRoot, Path=Color, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource RedColorConverter}}"/>
        </Grid>

        <!--Green Slider-->
        <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,1,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="G" HorizontalAlignment="Center" TextAlignment="Center" Width="12" VerticalAlignment="Center"
                       Foreground="{DynamicResource EnvironmentWindowText}"/>

            <Slider 
                x:Name="GSlider" 
                Grid.Column="1"
                Orientation="Horizontal"
                Minimum="0" 
                Maximum="255" 
                TickFrequency="2.55" 
                SmallChange="2.55" 
                LargeChange="5.1" 
                VerticalAlignment="Stretch"
                IsMoveToPointEnabled="True"
                Template="{StaticResource ColorSliderTemplate}"
                Value="{Binding ElementName=ColorPickerRoot, Path=Color, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource GreenColorConverter}}"
            >
                <Slider.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop x:Name="MinGStop" Offset="0.0" Color="Black" />
                        <GradientStop x:Name="MaxGStop" Offset="1.0" Color="Green" />
                    </LinearGradientBrush>
                </Slider.Background>
            </Slider>

            <local:NumericTextBox2
                x:Name="GreenTextBox"
                Grid.Column="2"
                Margin="1,0,0,0"
                Width="30" 
                MinValue="0"
                MaxValue="255"
                IsWholeNumber="True"
                Value="{Binding ElementName=ColorPickerRoot, Path=Color, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource GreenColorConverter}}"/>
        </Grid>

        <!--Blue Slider-->
        <Grid Grid.Row="4" Grid.ColumnSpan="2" Margin="0,1,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="B" HorizontalAlignment="Center" TextAlignment="Center" Width="12" VerticalAlignment="Center"
                       Foreground="{DynamicResource EnvironmentWindowText}"/>

            <Slider 
                x:Name="BSlider" 
                Grid.Column="1"
                Orientation="Horizontal"
                Minimum="0" 
                Maximum="255" 
                TickFrequency="2.55" 
                SmallChange="2.55" 
                LargeChange="5.1" 
                VerticalAlignment="Stretch"
                IsMoveToPointEnabled="True"
                Template="{StaticResource ColorSliderTemplate}"
                Value="{Binding ElementName=ColorPickerRoot, Path=Color, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource BlueColorConverter}}"
            >
                <Slider.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop x:Name="MinBStop" Offset="0.0" Color="Black" />
                        <GradientStop x:Name="MaxBStop" Offset="1.0" Color="Blue" />
                    </LinearGradientBrush>
                </Slider.Background>
            </Slider>

            <local:NumericTextBox2
                x:Name="BlueTextBox"
                Grid.Column="2"
                Margin="1,0,0,0"
                Width="30" 
                MinValue="0"
                MaxValue="255"
                IsWholeNumber="True"
                Value="{Binding ElementName=ColorPickerRoot, Path=Color, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource BlueColorConverter}}"/>
        </Grid>


        <!--Quick Select Colors-->
        <Grid Grid.Row="5" Grid.ColumnSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <local:SeparatorWithHeader Header="Common Colors" Grid.Row="0"/>
            <WrapPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Left">
                <Rectangle Fill="White" ToolTip="White"/>
                <Rectangle Fill="Black" ToolTip="Black"/>
                <Rectangle Fill="DarkRed" ToolTip="Dark Red"/>
                <Rectangle Fill="Red" ToolTip="Red"/>
                <Rectangle Fill="Orange" ToolTip="Orange"/>
                <Rectangle Fill="Yellow" ToolTip="Yellow"/>

                <Rectangle Fill="LightGreen" ToolTip="Light Green"/>
                <Rectangle Fill="Green" ToolTip="Green"/>
                <Rectangle Fill="Turquoise" ToolTip="Turquoise"/>

                <Rectangle Fill="LightBlue" ToolTip="Light Blue"/>
                <Rectangle Fill="Blue" ToolTip="Blue"/>
                <Rectangle Fill="DarkBlue" ToolTip="Dark Blue"/>
                <Rectangle Fill="Purple" ToolTip="Purple"/>
                <Rectangle Fill="Maroon" ToolTip="Maroon"/>
            </WrapPanel>
        </Grid>
    </Grid>
</UserControl>
