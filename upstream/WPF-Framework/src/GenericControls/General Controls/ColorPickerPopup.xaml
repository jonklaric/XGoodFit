<UserControl x:Class="GenericControls.ColorPickerPopup" x:Name="ColorPickerPopupRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GenericControls"
             mc:Ignorable="d"
             d:DesignHeight="30"
             d:DesignWidth="44">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <local:ReverseBooleanConverter x:Key="ReverseBoolConverter"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <ToggleButton
            x:Name="PopupToggleButton"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            BorderThickness="1"
            Padding="0"
            Background="{DynamicResource TextBox.Static.Background}"
            BorderBrush="{DynamicResource Button.Static.Border}"
            IsHitTestVisible="{Binding ElementName=PickerPopup, Path=IsOpen, Converter={StaticResource ReverseBoolConverter}}">
            <ToggleButton.Style>
                <Style TargetType="ToggleButton">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border
                                    x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    SnapsToDevicePixels="True">
                                    <ContentPresenter
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Button.MouseOver.Border}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ToggleButton.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Rectangle
                    x:Name="ColorRectangle"
                    Height="14"
                    Width="14"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Margin="3,0,0,0">
                    <Rectangle.Resources>
                        <Style TargetType="Rectangle">
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Fill" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                                    <Setter Property="Stroke" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="True">
                                    <Setter Property="Fill" Value="{Binding ElementName=ColorPickerPopupRoot, Path=Color, UpdateSourceTrigger=PropertyChanged, TargetNullValue=Black}"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                        <Condition Property="IsEnabled" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <MultiTrigger.Setters>
                                        <Setter Property="Stroke" Value="{DynamicResource Button.MouseOver.Border}"/>
                                        <Setter Property="StrokeThickness" Value="2"/>
                                    </MultiTrigger.Setters>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="False"/>
                                        <Condition Property="IsEnabled" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <MultiTrigger.Setters>
                                        <Setter Property="Stroke" Value="{DynamicResource Button.Static.Border}"/>
                                        <Setter Property="StrokeThickness" Value="1"/>
                                    </MultiTrigger.Setters>
                                </MultiTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Resources>
                </Rectangle>
                
                <Path
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Visibility="{Binding ElementName=ColorPickerPopupRoot, Path=ArrowButtonVisibility, UpdateSourceTrigger=PropertyChanged}"
                    Margin="4 0"
                    Fill="{DynamicResource EnvironmentWindowText}" Data="M 0,0 L 3,5 L 6,0 Z"/>
            </Grid>

        </ToggleButton>

        <!-- Invisible anchor element for popup placement relative to the toggle button's bottom-right corner -->
        <Rectangle x:Name="PART_PopPlacer" Fill="Transparent" Width="0" Height="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                   Focusable="False" Visibility="Hidden" IsHitTestVisible="False"/>

        <Popup
            x:Name="PickerPopup"
            PopupAnimation="Slide"
            AllowsTransparency="True"
            StaysOpen="False"
            Placement="Left"
            Height="250"
            Width="175"
            IsOpen="{Binding ElementName=PopupToggleButton, Path=IsChecked, Mode=TwoWay}"
            PlacementTarget="{Binding ElementName=PART_PopPlacer}">
                <local:ColorPicker
                    x:Name="ColorPicker"
                    Padding="2"
                    BorderBrush ="{DynamicResource Button.Static.Border}" 
                    BorderThickness="1" 
                    Background="{DynamicResource EnvironmentWindowBackground}"
                    Color="{Binding ElementName=ColorPickerPopupRoot, Path=Color, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

        </Popup>
    </Grid>
</UserControl>
