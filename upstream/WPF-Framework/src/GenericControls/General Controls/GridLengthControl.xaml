<UserControl x:Class="GenericControls.GridLengthControl" x:Name="GridLengthEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GenericControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
            
        <TextBox Grid.Column="0" Width="80" VerticalContentAlignment="Center"
                 Text="{Binding ElementName=GridLengthEditor, Path=GridLengthValue, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
        <ComboBox Grid.Column="1" HorizontalAlignment="Right" Margin="5,0,0,0" Width="70" ItemsSource="{Binding ElementName=GridLengthEditor, Path=GridLengthUnitOptions}" SelectedValue="{Binding Path=GridLengthUnit, ElementName=GridLengthEditor, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

    </Grid>
</UserControl>
