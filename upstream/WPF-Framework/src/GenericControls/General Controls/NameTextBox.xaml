<UserControl x:Class="GenericControls.NameTextBox" x:Name="NameTextBoxControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GenericControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <local:BooleanToVisibilityConverter x:Key="BoolToVisConverter" TrueValue="Visible" FalseValue="Collapsed"/>
    </UserControl.Resources>
    <Grid x:Name="NameGrid">
        <TextBox x:Name="NameTBox" x:FieldModifier="public" TextChanged="NameTBox_TextChanged"
                 VerticalContentAlignment="Center"
                 VerticalAlignment="Stretch"
                 Text="{Binding ElementName=NameTextBoxControl, Path=Text, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                 PreviewKeyDown="TextBox_PreviewKeyDown" PreviewKeyUp="TextBox_PreviewKeyUp">
            <TextBox.Style>
                <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ElementName=NameTextBoxControl, Path=IsValid}" Value="True">
                            <Setter Property="ToolTip" Value="{x:Null}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBox.Style>
        </TextBox>
        <Border x:Name="NameBorder" 
                Width="{Binding ElementName=NameTBox, Path=ActualWidth}" 
                Height="{Binding ElementName=NameTBox, Path=ActualHeight}" 
                Visibility="{Binding ElementName=NameGrid, Path=IsEnabled, Converter={StaticResource BoolToVisConverter}}"
                IsHitTestVisible="False" BorderThickness="1">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ElementName=NameTextBoxControl, Path=IsValid}" Value="False">
                            <Setter Property="BorderBrush" Value="{DynamicResource DataGrid.Cell.Error.Border}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ElementName=NameTextBoxControl, Path=IsValid}" Value="True">
                            <Setter Property="BorderBrush" Value="{x:Null}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
    </Grid>
</UserControl>
