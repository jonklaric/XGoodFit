<UserControl x:Class="GenericControls.ResizableTextBoxControl" x:Name="ResizableTextControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GenericControls"
             mc:Ignorable="d" 
             d:DesignHeight="23" d:DesignWidth="300">
    <Grid>

        <TextBox x:Name="ResizableTextBox" 
                 Text="{Binding Text, ElementName=ResizableTextControl}" 
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 IsReadOnly="{Binding IsReadOnly, ElementName=ResizableTextControl, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                 PreviewKeyUp="TextBox_PreviewKeyUp">
        </TextBox> 
        <Thumb x:Name="ResizeThumb" Width="18" Height="18" VerticalAlignment="Bottom" HorizontalAlignment="Right" Cursor="Hand" DragDelta="ResizeThumb_DragDelta">
            <Thumb.Style>
                <Style TargetType="{x:Type Thumb}" BasedOn="{x:Null}">
                    <Style.Setters>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate>
                                    <Grid VerticalAlignment="Bottom">
                                        <Line X1="6" Y1="18" X2="18" Y2="6" Stroke="{DynamicResource Button.Static.Border}" StrokeThickness="1.5"/>
                                        <!--smallest/right|bottom most -->
                                        <Line X1="10" Y1="18" X2="18" Y2="10" Stroke="{DynamicResource Button.Static.Border}" StrokeThickness="1.5"/>
                                        <Line X1="14" Y1="18" X2="18" Y2="14" Stroke="{DynamicResource Button.Static.Border}" StrokeThickness="1.5"/>
                                        <!--longer/left|top most-->
                                        <Grid.Style>
                                            <Style TargetType="{x:Type Grid}">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Cursor" Value="SizeNWSE"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style.Setters>
                </Style>
            </Thumb.Style>
        </Thumb>
    </Grid>
</UserControl>
