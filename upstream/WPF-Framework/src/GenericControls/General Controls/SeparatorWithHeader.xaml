<UserControl x:Class="GenericControls.SeparatorWithHeader" x:Name="HeaderSeparator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary Source="../Resources/ResourceDictionary.xaml"/>
    </UserControl.Resources>
    <Grid Background="{StaticResource SeparatorBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding ElementName=HeaderSeparator, Path=LeftSeparatorWidth, UpdateSourceTrigger=PropertyChanged, TargetNullValue=.5*, FallbackValue=.5*}"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="{Binding ElementName=HeaderSeparator, Path=RightSeparatorWidth, UpdateSourceTrigger=PropertyChanged, TargetNullValue=.5*, FallbackValue=.5*}"/>
        </Grid.ColumnDefinitions>
        <Separator Grid.Column="0"/>
        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="5 0" Text="{Binding Path=Header, ElementName=HeaderSeparator, UpdateSourceTrigger=PropertyChanged}"/>
        <Separator Grid.Column="2"/>
    </Grid>
</UserControl>
