<UserControl x:Class="GenericControls.CalendarWeekRulePropertyControl" x:Name="CalendarWeekRuleProperty"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GenericControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/ResourceDictionary.xaml"/>
                <ResourceDictionary>
                    <local:BooleanToVisibilityConverter x:Key="BoolToVisConverter" TrueValue="Visible" FalseValue="Collapsed"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Height="22" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width=".001*"/>
            <ColumnDefinition Width="{Binding ElementName=CalendarWeekRuleProperty, Path=PropertyWidth, FallbackValue=10*}" 
                              MaxWidth="{Binding ElementName=CalendarWeekRuleProperty, Path=MaxPropertyWidth, FallbackValue=200}"
                              MinWidth="{Binding ElementName=CalendarWeekRuleProperty, Path=MinPropertyWidth, FallbackValue=10}"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" 
                   Text="{Binding ElementName=CalendarWeekRuleProperty, Path=Title}" 
                   Style="{StaticResource TitleTextStyle}"/>

        <Line Style="{StaticResource DotLeaderLineStyle}"
              Visibility="{Binding ShowLeaderLine, ElementName=CalendarWeekRuleProperty, Converter={StaticResource BoolToVisConverter}}"/>
        
        <ComboBox Grid.Column="2" SizeChanged="ControlSizeChanged"
                  HorizontalAlignment="Stretch" 
                  VerticalAlignment="Bottom"
                  ItemsSource="{Binding ElementName=CalendarWeekRuleProperty, Path=CalendarRuleOptions}" 
                  SelectedValue="{Binding Path=SelectedCalendarWeekRule, ElementName=CalendarWeekRuleProperty, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

    </Grid>
</UserControl>
