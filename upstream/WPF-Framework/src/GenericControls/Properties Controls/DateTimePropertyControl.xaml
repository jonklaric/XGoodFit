<UserControl x:Class="GenericControls.DateTimePropertyControl" 
             x:Name="DateTimePropertyEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GenericControls"
             mc:Ignorable="d" 
             d:DesignHeight="22" 
             d:DesignWidth="300">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/ResourceDictionary.xaml"/>
                <ResourceDictionary>
                    <local:BooleanToVisibilityConverter x:Key="BoolToVisConverter" TrueValue="Visible" FalseValue="Collapsed"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Height="22" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width=".001*"/>
            <ColumnDefinition Width="{Binding ElementName=DateTimePropertyEditor, Path=PropertyWidth}"
                              MaxWidth="{Binding ElementName=DateTimePropertyEditor, Path=MaxPropertyWidth, FallbackValue=200}"
                              MinWidth="{Binding ElementName=DateTimePropertyEditor, Path=MinPropertyWidth, FallbackValue=10}"/>
        </Grid.ColumnDefinitions>

        <TextBlock
            Style="{StaticResource TitleTextStyle}"
            Text="{Binding ElementName=DateTimePropertyEditor, Path=Title}" />

        <Line 
            Style="{StaticResource DotLeaderLineStyle}"
            Visibility="{Binding ShowLeaderLine, ElementName=DateTimePropertyEditor, Converter={StaticResource BoolToVisConverter}}"/>

        <local:DateAndTimeTextBoxControl 
            x:Name="DateTimeControl" 
            Grid.Column="2" 
            SizeChanged="ControlSizeChanged" 
            SelectedDateTime="{Binding SelectedDateTime, ElementName=DateTimePropertyEditor, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
            HorizontalAlignment="Stretch" 
            VerticalAlignment="Stretch"/>
    </Grid>
</UserControl>
