<UserControl x:Class="GenericControls.FontWeightSelectorControl" x:Name="FontWeightSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GenericControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/ResourceDictionary.xaml"/>
                <ResourceDictionary>
                    <local:BooleanToVisibilityConverter x:Key="BoolToVisConverter" TrueValue="Visible" FalseValue="Collapsed"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Height="22" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width=".001*"/>
            <ColumnDefinition Width="{Binding ElementName=FontWeightSelector, Path=PropertyWidth, FallbackValue=10*}" 
                              MaxWidth="{Binding ElementName=FontWeightSelector, Path=MaxPropertyWidth, FallbackValue=200}"
                              MinWidth="{Binding ElementName=FontWeightSelector, Path=MinPropertyWidth, FallbackValue=10}"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Style="{StaticResource TitleTextStyle}"
                   Text="{Binding ElementName=FontWeightSelector, Path=Title}" />

        <Line Style="{StaticResource DotLeaderLineStyle}"
              Visibility="{Binding ShowLeaderLine, ElementName=FontWeightSelector, Converter={StaticResource BoolToVisConverter}}"/>

        <ComboBox Grid.Column="2" SizeChanged="ControlSizeChanged"
                  HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                  SelectedValue="{Binding Path=SelectedFontWeight, ElementName=FontWeightSelector, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
            <!--100-->
            <x:Static Member="FontWeights.Thin" />
            <!--200-->
            <x:Static Member="FontWeights.ExtraLight" />
            <!--300-->
            <x:Static Member="FontWeights.Light" />
            <!--400-->
            <x:Static Member="FontWeights.Normal" />
            <!--500-->
            <x:Static Member="FontWeights.Medium" />
            <!--600-->
            <x:Static Member="FontWeights.SemiBold" />
            <!--700-->
            <x:Static Member="FontWeights.Bold" />
            <!--800-->
            <x:Static Member="FontWeights.ExtraBold" />
            <!--900-->
            <x:Static Member="FontWeights.Heavy" />
            <!--950-->
            <x:Static Member="FontWeights.ExtraBlack" />
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" VerticalAlignment="Center" FontWeight="{Binding}" Foreground="{DynamicResource ComboBox.DropDown.Foreground}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
    </Grid>
</UserControl>
