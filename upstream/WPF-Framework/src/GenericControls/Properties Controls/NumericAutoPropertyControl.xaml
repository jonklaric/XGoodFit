<UserControl x:Class="GenericControls.NumericAutoPropertyControl" x:Name="NumericAutoProperty"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GenericControls"
             xmlns:glob="clr-namespace:System.Globalization;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/ResourceDictionary.xaml"/>
                <ResourceDictionary>
                    <local:BooleanToVisibilityConverter x:Key="BoolToVisConverter" TrueValue="Visible" FalseValue="Collapsed"/>
                    <local:BooleanToVisibilityConverter x:Key="BoolToHiddenConverter" TrueValue="Hidden" FalseValue="Visible"/>
                    <local:StringToDoubleConverter x:Key="DoubleToStringConverter"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Height="22" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width=".001*"/>
            <ColumnDefinition Width="{Binding ElementName=NumericAutoProperty, Path=PropertyWidth, FallbackValue=10*}" 
                              MaxWidth="{Binding ElementName=NumericAutoProperty, Path=MaxPropertyWidth, FallbackValue=200}"
                              MinWidth="{Binding ElementName=NumericAutoProperty, Path=MinPropertyWidth, FallbackValue=10}"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Style="{StaticResource TitleTextStyle}"
                   Text="{Binding ElementName=NumericAutoProperty, Path=Title}"/>

        <Line Style="{StaticResource DotLeaderLineStyle}"
              Visibility="{Binding ShowLeaderLine, ElementName=NumericAutoProperty, Converter={StaticResource BoolToVisConverter}}"/>

        <Grid Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" SizeChanged="ControlSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="DummyTextBlock" Visibility="Hidden" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Bottom"/>
            <TextBox Grid.Column="0"
                     x:Name="NumericTBox" 
                     Height="22"
                     Text="{Binding Number, ElementName=NumericAutoProperty, UpdateSourceTrigger=Explicit, Mode=TwoWay, StringFormat={}{0:G}, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}}"
                     Width="{Binding ElementName=DummyTextBlock, Path=ActualWidth}"
                     VerticalAlignment="Bottom" 
                     VerticalContentAlignment="Center" 
                     PreviewTextInput="TextBox_PreviewTextInput" 
                     PreviewKeyDown="TextBox_PreviewKeyDown" 
                     PreviewKeyUp="TextBox_PreviewKeyUp"
                     LostFocus="TextBox_LostFocus"/>

            <Border Grid.Column="0" 
                HorizontalAlignment="Stretch" 
                Height="{Binding ElementName=NumericTBox, Path=ActualHeight}" 
                Width="{Binding ElementName=NumericTBox, Path=ActualWidth}"
                IsHitTestVisible="False" 
                BorderThickness="1">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=NumericAutoProperty, Path=ValueIsValid}" Value="False">
                                <Setter Property="BorderBrush" Value="{DynamicResource DataGrid.Cell.Error.Border}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ElementName=NumericAutoProperty, Path=ValueIsValid}" Value="True">
                                <Setter Property="BorderBrush" Value="{x:Null}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <TextBlock Grid.Column="1" Margin="3,0,0,0" Text="Auto" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource EnvironmentWindowText}"/>

            <Button Grid.Column="1" Margin="3,0,0,0" Click="Button_Click" HorizontalAlignment="Center" VerticalContentAlignment="Center" Padding="2 0" BorderThickness="1" Visibility="{Binding NumberIsDefault, ElementName=NumericAutoProperty, Converter={StaticResource BoolToHiddenConverter}}">Reset</Button>
        </Grid>
        
        
    </Grid>
</UserControl>
