<UserControl x:Class="GenericControls.NumericPropertyControl" x:Name="NumericProperty"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GenericControls"
             xmlns:glob="clr-namespace:System.Globalization;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/ResourceDictionary.xaml"/>
                <ResourceDictionary>
                    <local:BooleanToVisibilityConverter x:Key="BoolToVisConverter" TrueValue="Visible" FalseValue="Collapsed"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Height="22" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width=".001*"/>
            <ColumnDefinition Width="{Binding ElementName=NumericProperty, Path=PropertyWidth, FallbackValue=10*}" 
                              MaxWidth="{Binding ElementName=NumericProperty, Path=MaxPropertyWidth, FallbackValue=200}"
                              MinWidth="{Binding ElementName=NumericProperty, Path=MinPropertyWidth, FallbackValue=10}"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Style="{StaticResource TitleTextStyle}"
                   Text="{Binding ElementName=NumericProperty, Path=Title}"/>

        <Line Style="{StaticResource DotLeaderLineStyle}"
              Visibility="{Binding ShowLeaderLine, ElementName=NumericProperty, Converter={StaticResource BoolToVisConverter}}"/>

        <!--StringFormat={}{0:#.#####} StringFormat='G'-->
        <TextBox Grid.Column="2"   
                 x:Name="NumericTBox"
                 Height="22"
                 IsEnabled="{Binding IsTextBoxEnabled, ElementName=NumericProperty, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                 Text="{Binding Number, ElementName=NumericProperty, UpdateSourceTrigger=LostFocus, Mode=TwoWay, StringFormat='G', ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}}"
                 SizeChanged="ControlSizeChanged"
                 HorizontalAlignment="Stretch" 
                 VerticalAlignment="Bottom" 
                 VerticalContentAlignment="Center" 
                 PreviewTextInput="TextBox_PreviewTextInput" 
                 PreviewKeyDown="TextBox_PreviewKeyDown" 
                 PreviewKeyUp="TextBox_PreviewKeyUp">
        </TextBox>

        <Border Grid.Column="2" 
                HorizontalAlignment="Stretch" 
                Height="{Binding ElementName=NumericTBox, Path=ActualHeight}" 
                Width="{Binding ElementName=NumericTBox, Path=ActualWidth}"
                IsHitTestVisible="False" 
                BorderThickness="1">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ElementName=NumericProperty, Path=ValueIsValid}" Value="False">
                            <Setter Property="BorderBrush" Value="{DynamicResource DataGrid.Cell.Error.Border}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ElementName=NumericProperty, Path=ValueIsValid}" Value="True">
                            <Setter Property="BorderBrush" Value="{x:Null}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
    </Grid>
</UserControl>
