<UserControl x:Class="GenericControls.Point3DPropertyControl" x:Name="Point3DProperty"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GenericControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/ResourceDictionary.xaml"/>
                <ResourceDictionary>
                    <local:BooleanToVisibilityConverter x:Key="BoolToVisConverter" TrueValue="Visible" FalseValue="Collapsed"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Height="22" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width=".001*"/>
            <ColumnDefinition Width="{Binding ElementName=Point3DProperty, Path=PropertyWidth, FallbackValue=10*}" 
                              MaxWidth="{Binding ElementName=Point3DProperty, Path=MaxPropertyWidth, FallbackValue=200}"
                              MinWidth="{Binding ElementName=Point3DProperty, Path=MinPropertyWidth, FallbackValue=10}"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Style="{StaticResource TitleTextStyle}"
                   Text="{Binding ElementName=Point3DProperty, Path=Title}"
                   Visibility="{Binding ElementName=Point3DProperty, Path=ShowTitle, Converter={StaticResource BoolToVisConverter}}"/>

        <Line Style="{StaticResource DotLeaderLineStyle}"
              Visibility="{Binding ShowLeaderLine, ElementName=Point3DProperty, Converter={StaticResource BoolToVisConverter}}"/>

        <Grid Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" SizeChanged="ControlSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="X " FontSize="10" VerticalAlignment="Bottom" Foreground="{DynamicResource EnvironmentWindowText}"/>
            <local:NumericTextBox x:Name="DataPointX" Grid.Column="1" Height="22" IsWholeNumber="False" CanBeBlank="True" CanBeNegative="True" ToolTip="X Value" IsReadOnly="{Binding ElementName=Point3DProperty, Path=IsReadOnly}"/>
            <TextBlock Grid.Column="2" Text="  Y " FontSize="10" VerticalAlignment="Bottom" Foreground="{DynamicResource EnvironmentWindowText}"/>
            <local:NumericTextBox x:Name="DataPointY" Grid.Column="3" Height="22" IsWholeNumber="False" CanBeBlank="True" CanBeNegative="True" ToolTip="Y Value" IsReadOnly="{Binding ElementName=Point3DProperty, Path=IsReadOnly}"/>
            <TextBlock Grid.Column="4" Text="  Z " FontSize="10" VerticalAlignment="Bottom" Foreground="{DynamicResource EnvironmentWindowText}"/>
            <local:NumericTextBox x:Name="DataPointZ" Grid.Column="5" Height="22" IsWholeNumber="False" CanBeBlank="True" CanBeNegative="True" ToolTip="Z Value" IsReadOnly="{Binding ElementName=Point3DProperty, Path=IsReadOnly}"/>
        </Grid>
    </Grid>
</UserControl>
