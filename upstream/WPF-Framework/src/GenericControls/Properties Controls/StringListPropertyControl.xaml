<UserControl x:Class="GenericControls.StringListPropertyControl" 
             x:Name="StringListEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GenericControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <local:DataGridWidthConverter x:Key="dgWidthConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock
            TextWrapping="Wrap"
            TextAlignment="Center"
            VerticalAlignment="Bottom"
            FontWeight="Bold"
            HorizontalAlignment="Stretch"
            Foreground="{DynamicResource EnvironmentWindowText}"
            Text="{Binding ElementName=StringListEditor, Path=Title}"
            MouseUp="TextBlock_MouseUp"/>

        <local:CopyPasteDataGrid
            x:Name="StringListDataGrid"
            Width="{Binding Path=ActualWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ScrollContentPresenter}}, Converter={StaticResource dgWidthConverter}}"
            MinWidth="30"
            GridLinesVisibility="Horizontal"
            Grid.Row="1"
            HeadersVisibility="None"
            CanUserResizeColumns="False"
            AutoGenerateColumns="False"
            SelectionMode="Extended"
            SelectionUnit="Cell"
            CanUserDeleteRows="False"
            CanUserAddRows="False"
            CanUserResizeRows="False"
            CanUserSortColumns="False"
            CanUserReorderColumns="False"
            CellEditEnding="StringListDataGrid_CellEditEnding"
            RowsAdded="StringListDataGrid_RowsAdded" DataPasted="StringListDataGrid_DataPasted">

            <local:CopyPasteDataGrid.Columns>
                <DataGridTextColumn x:Name="StringColumn" Width="*" Binding="{Binding Path=TheString, Mode=TwoWay}" IsReadOnly="False"/>
            </local:CopyPasteDataGrid.Columns>
        </local:CopyPasteDataGrid>  

    </Grid>
</UserControl>
