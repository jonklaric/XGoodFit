<UserControl x:Class="GenericControls.TextPropertyControl" x:Name="TextPropertyEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GenericControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/ResourceDictionary.xaml"/>
                <ResourceDictionary>
                    <local:BooleanToVisibilityConverter x:Key="BoolToVisConverter" TrueValue="Visible" FalseValue="Collapsed"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Height="22" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width=".001*"/>
            <ColumnDefinition Width="{Binding ElementName=TextPropertyEditor, Path=PropertyWidth}"
                              MaxWidth="{Binding ElementName=TextPropertyEditor, Path=MaxPropertyWidth, FallbackValue=200}"
                              MinWidth="{Binding ElementName=TextPropertyEditor, Path=MinPropertyWidth, FallbackValue=10}"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Style="{StaticResource TitleTextStyle}"
                   Text="{Binding ElementName=TextPropertyEditor, Path=Title}" />
        
        <Line Style="{StaticResource DotLeaderLineStyle}"
              Visibility="{Binding ShowLeaderLine, ElementName=TextPropertyEditor, Converter={StaticResource BoolToVisConverter}}"/>
        
        <TextBox Grid.Column="2" SizeChanged="ControlSizeChanged" Height="22"
                 HorizontalAlignment="Stretch" VerticalAlignment="Bottom" VerticalContentAlignment="Center" 
                 TextWrapping="{Binding TextWrapping, ElementName=TextPropertyEditor, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                 Text="{Binding Text, ElementName=TextPropertyEditor, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                 IsReadOnly="{Binding IsReadOnly, ElementName=TextPropertyEditor, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

    </Grid>
</UserControl>
