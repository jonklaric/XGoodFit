    <!-- CLIPBOARD OPERATIONS                                                        -->
    <!-- Icons for copy, paste, and selection operations                             -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Select All - Table with selection highlight in data cells -->
    <Canvas x:Key="SelectAllIcon" Width="16" Height="16" x:Shared="False">
        <!-- Blue fill behind data cells -->
        <Rectangle Canvas.Left="3" Canvas.Top="5" Width="11" Height="8" Fill="{DynamicResource ToolbarIconSelectionFill}"/>
        <!-- Table frame: border + header + grid lines, with cell cutouts (EvenOdd) -->
        <Path Fill="{DynamicResource ToolbarIconForeground}">
            <Path.Data>
                <PathGeometry FillRule="EvenOdd"
                    Figures="M2,2 H15 V14 H2 Z M3,5 H6 V7 H3 Z M7,5 H10 V7 H7 Z M11,5 H14 V7 H11 Z M3,8 H6 V10 H3 Z M7,8 H10 V10 H7 Z M11,8 H14 V10 H11 Z M3,11 H6 V13 H3 Z M7,11 H10 V13 H7 Z M11,11 H14 V13 H11 Z"/>
            </Path.Data>
        </Path>
    </Canvas>

    <!-- Deselect All - Table without selection highlight -->
    <Canvas x:Key="DeselectAllIcon" Width="16" Height="16" x:Shared="False">
        <!-- Soft fill behind table cells -->
        <Rectangle Canvas.Left="2" Canvas.Top="2" Width="13" Height="12" Fill="{DynamicResource ToolbarIconDocumentFill}"/>
        <!-- Table frame: border + header + grid lines, with cell cutouts (EvenOdd) -->
        <Path Fill="{DynamicResource ToolbarIconForeground}">
            <Path.Data>
                <PathGeometry FillRule="EvenOdd"
                    Figures="M2,2 H15 V14 H2 Z M3,5 H6 V7 H3 Z M7,5 H10 V7 H7 Z M11,5 H14 V7 H11 Z M3,8 H6 V10 H3 Z M7,8 H10 V10 H7 Z M11,8 H14 V10 H11 Z M3,11 H6 V13 H3 Z M7,11 H10 V13 H7 Z M11,11 H14 V13 H11 Z"/>
            </Path.Data>
        </Path>
    </Canvas>

    <!-- Copy - Back L-shape (top row + left column) top-left, front full 3x3 table bottom-right -->
    <Canvas x:Key="CopyIcon" Width="16" Height="16" x:Shared="False">
        <!-- Soft fill behind L-shape cells -->
        <Path Fill="{DynamicResource ToolbarIconDocumentFill}" Data="M1,1 H11 V4 H4 V11 H1 Z"/>
        <!-- L-shape grid lines -->
        <Path Fill="{DynamicResource ToolbarIconForeground}">
            <Path.Data>
                <PathGeometry FillRule="EvenOdd"
                    Figures="M1,1 H11 V4 H4 V11 H1 Z M2,2 H4 V4 H2 Z M5,2 H7 V4 H5 Z M8,2 H10 V4 H8 Z M2,5 H4 V7 H2 Z M2,8 H4 V10 H2 Z"/>
            </Path.Data>
        </Path>
        <!-- Soft fill behind front table cells -->
        <Rectangle Canvas.Left="5" Canvas.Top="5" Width="10" Height="10" Fill="{DynamicResource ToolbarIconDocumentFill}"/>
        <!-- Front table (full 3x3 grid) -->
        <Path Fill="{DynamicResource ToolbarIconForeground}">
            <Path.Data>
                <PathGeometry FillRule="EvenOdd"
                    Figures="M5,5 H15 V15 H5 Z M6,6 H8 V8 H6 Z M9,6 H11 V8 H9 Z M12,6 H14 V8 H12 Z M6,9 H8 V11 H6 Z M9,9 H11 V11 H9 Z M12,9 H14 V11 H12 Z M6,12 H8 V14 H6 Z M9,12 H11 V14 H9 Z M12,12 H14 V14 H12 Z"/>
            </Path.Data>
        </Path>
    </Canvas>

    <!-- Copy with Headers - Same layout, top row solid (no cell cutouts) to indicate headers -->
    <Canvas x:Key="CopyWithHeadersIcon" Width="16" Height="16" x:Shared="False">
        <!-- Soft fill behind L-shape cells -->
        <Path Fill="{DynamicResource ToolbarIconDocumentFill}" Data="M1,1 H11 V4 H4 V11 H1 Z"/>
        <!-- L-shape: top row solid, left column has cell cutouts -->
        <Path Fill="{DynamicResource ToolbarIconForeground}">
            <Path.Data>
                <PathGeometry FillRule="EvenOdd"
                    Figures="M1,1 H11 V4 H4 V11 H1 Z M2,5 H4 V7 H2 Z M2,8 H4 V10 H2 Z"/>
            </Path.Data>
        </Path>
        <!-- Soft fill behind front table cells -->
        <Rectangle Canvas.Left="5" Canvas.Top="5" Width="10" Height="10" Fill="{DynamicResource ToolbarIconDocumentFill}"/>
        <!-- Front table: top row solid, bottom 2 rows have cell cutouts -->
        <Path Fill="{DynamicResource ToolbarIconForeground}">
            <Path.Data>
                <PathGeometry FillRule="EvenOdd"
                    Figures="M5,5 H15 V15 H5 Z M6,9 H8 V11 H6 Z M9,9 H11 V11 H9 Z M12,9 H14 V11 H12 Z M6,12 H8 V14 H6 Z M9,12 H11 V14 H9 Z M12,12 H14 V14 H12 Z"/>
            </Path.Data>
        </Path>
    </Canvas>

    <!-- Paste - Clipboard with table -->
    <Viewbox x:Key="PasteIcon" Width="16" Height="16" x:Shared="False">
        <Canvas Width="16" Height="16">
            <!-- Background fill for inner areas only (clipboard body, clip, table) -->
            <Path Fill="{DynamicResource ToolbarIconDocumentFill}"
                  Data="F1 M13,14 L8,14 8,8 13,8 Z M3,13 L3,4 4,4 4,6 10,6 10,4 11,4 11,7 7,7 7,13 Z M5,4 L6,4 6,3 C6,2.449 6.449,2 7,2 7.551,2 8,2.449 8,3 L8,4 9,4 9,5 5,5 Z"/>
