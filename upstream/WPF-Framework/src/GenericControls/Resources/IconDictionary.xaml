<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ╔═══════════════════════════════════════════════════════════════════════════════╗
    ║  GenericControls Icon Dictionary                                              ║
    ╠═══════════════════════════════════════════════════════════════════════════════╣
    ║  A centralized collection of theme-aware vector icons for use throughout      ║
    ║  the WPF Framework. Icons are defined as Viewbox elements containing          ║
    ║  Path/Shape elements with DynamicResource bindings for theme support.         ║
    ║                                                                               ║
    ║  THEME SUPPORT:                                                               ║
    ║  Icons use DynamicResource bindings for colors that adapt to themes:          ║
    ║  • EnvironmentWindowText      - Main icon stroke/fill (adapts to light/dark)  ║
    ║  • TextBox.Static.Background  - Background fill for document icons            ║
    ║  • DataGrid.Header.Border     - Header elements                               ║
    ║  • ToolbarIconAccent          - Accent color for emphasis                     ║
    ║  • ToolbarIconForeground      - Secondary foreground color                    ║
    ║                                                                               ║
    ║  SEMANTIC COLORS (consistent across themes):                                  ║
    ║  • #16A34A (Green)  - Add/Plus/Create operations                              ║
    ║  • #DC2626 (Red)    - Delete/Remove/Stop operations                           ║
    ║  • Accent (Blue)    - Insert/Selection/Filter operations                      ║
    ║                                                                               ║
    ║  USAGE:                                                                       ║
    ║  <ContentControl Content="{StaticResource AddRowIcon}"/>                      ║
    ║                                                                               ║
    ║  For buttons with explicit sizing:                                            ║
    ║  <Button>                                                                     ║
    ║      <Viewbox Width="16" Height="16">                                         ║
    ║          <ContentControl Content="{StaticResource AddRowIcon}"/>              ║
    ║      </Viewbox>                                                               ║
    ║  </Button>                                                                    ║
    ║                                                                               ║
    ║  NOTE: All icons use x:Shared="False" to allow multiple instances.            ║
    ╚═══════════════════════════════════════════════════════════════════════════════╝
    -->

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- ROW OPERATIONS                                                              -->
    <!-- Icons for adding, inserting, and deleting table rows                        -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Add Row(s) - Table with green plus sign, last row highlighted -->
    <Viewbox x:Key="AddRowIcon" Width="16" Height="16" x:Shared="False">
        <Rectangle Width="16" Height="16">
            <Rectangle.Fill>
                <DrawingBrush>
                    <DrawingBrush.Drawing>
                        <DrawingGroup>
                            <DrawingGroup.Children>
                                <!-- Transparent background -->
                                <GeometryDrawing Brush="#00FFFFFF" Geometry="F1M16,16L0,16 0,0 16,0z" />
                                <!-- Knockout layer (transparent) -->
                                <GeometryDrawing Brush="#00FFFFFF" Geometry="F1M1.9998,-0.000199999999999534L1.9998,1.9998 -0.000199999999999978,1.9998 -0.000199999999999978,5.9998 0.9998,5.9998 0.9998,15.9998 15.9998,15.9998 15.9998,1.9998 6.0008,1.9998 6.0008,-0.000199999999999534z" />
                                <!-- Table frame + cell borders (foreground) -->
                                <GeometryDrawing Brush="{DynamicResource ToolbarIconForeground}" Geometry="F1M14,8L11,8 11,6 14,6z M14,11L11,11 11,9 14,9z M14,14L11,14 11,12 14,12z M10,11L7,11 7,9 10,9z M10,14L7,14 7,12 10,12z M6,11L3,11 3,9 6,9z M6,14L3,14 3,12 6,12z M2,8L2,15 15,15 15,3 8,3 8,6 10,6 10,8 7,8 7,6 6,6 6,8z" />
                                <!-- Last row cells (light blue selection fill) -->
                                <GeometryDrawing Brush="{DynamicResource ToolbarIconSelectionFill}" Geometry="F1M11,14L14,14 14,12 11,12z M7,14L10,14 10,12 7,12z M3,14L6,14 6,12 3,12z" />
                                <!-- Top + middle row cells (document fill) -->
                                <GeometryDrawing Brush="{DynamicResource ToolbarIconDocumentFill}" Geometry="F1M11,8L14,8 14,6 11,6z M7,8L10,8 10,6 8,6 7,6z M11,11L14,11 14,9 11,9z M7,11L10,11 10,9 7,9z M3,11L6,11 6,9 3,9z" />
                                <!-- Green plus sign -->
                                <GeometryDrawing Brush="{DynamicResource SemanticGreen}" Geometry="F1M7,5L5,5 5,7 3,7 3,5 1,5 1,3 3,3 3,1 5,1 5,3 7,3z" />
                            </DrawingGroup.Children>
                        </DrawingGroup>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
        </Rectangle>
    </Viewbox>

