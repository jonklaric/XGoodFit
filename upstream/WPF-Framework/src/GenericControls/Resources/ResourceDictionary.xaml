<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
    ╔═══════════════════════════════════════════════════════════════════════════════╗
    ║  GenericControls Resource Dictionary                                          ║
    ╠═══════════════════════════════════════════════════════════════════════════════╣
    ║  This dictionary provides shared resources used throughout the                ║
    ║  GenericControls library:                                                     ║
    ║                                                                               ║
    ║  • Data arrays for common ComboBox selections (line widths, font sizes, etc.) ║
    ║  • Text and line styles for property controls                                 ║
    ║  • Vector icons (merged from IconDictionary.xaml)                             ║
    ║                                                                               ║
    ║  Usage:                                                                       ║
    ║  Reference resources using StaticResource or DynamicResource:                 ║
    ║  <ComboBox ItemsSource="{StaticResource LineWidthOptions}"/>                  ║
    ╚═══════════════════════════════════════════════════════════════════════════════╝
    -->

    <!-- Merge Icon Dictionary for centralized vector icons -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="IconDictionary.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- PROPERTY CONTROL STYLES                                                     -->
    <!-- Styles used in GenericControls property controls for consistent appearance  -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Dotted leader line style connecting property labels to values -->
    <Style TargetType="{x:Type Line}" x:Key="DotLeaderLineStyle">
        <Setter Property="Grid.Column" Value="1"/>
        <Setter Property="X1" Value="0"/>
        <Setter Property="Y1" Value="0"/>
        <Setter Property="X2" Value="1"/>
        <Setter Property="Y2" Value="0"/>
        <Setter Property="Stroke" Value="{DynamicResource Button.Static.Border}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="StrokeDashArray" Value="2 2"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Margin" Value="0,0,3,0"/>
    </Style>

    <!-- Title text style for property labels -->
    <Style TargetType="{x:Type TextBlock}" x:Key="TitleTextStyle">
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="0,0,3,0"/>
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- COMMON DATA ARRAYS                                                          -->
    <!-- Reusable option arrays for ComboBox controls throughout the framework       -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Line width options (0-10 pixels) -->
    <x:Array x:Key="LineWidthOptions" Type="{x:Type sys:Double}">
        <sys:Double>0</sys:Double>
        <sys:Double>1</sys:Double>
        <sys:Double>2</sys:Double>
        <sys:Double>3</sys:Double>
        <sys:Double>4</sys:Double>
        <sys:Double>5</sys:Double>
        <sys:Double>7</sys:Double>
        <sys:Double>10</sys:Double>
    </x:Array>

    <!-- Font size options (8-72pt, standard font size increments) -->
    <x:Array x:Key="FontSizeOptions" Type="{x:Type sys:Double}">
        <sys:Double>8</sys:Double>
        <sys:Double>9</sys:Double>
        <sys:Double>10</sys:Double>
        <sys:Double>11</sys:Double>
        <sys:Double>12</sys:Double>
        <sys:Double>14</sys:Double>
        <sys:Double>16</sys:Double>
        <sys:Double>18</sys:Double>
        <sys:Double>20</sys:Double>
        <sys:Double>22</sys:Double>
        <sys:Double>24</sys:Double>
        <sys:Double>26</sys:Double>
        <sys:Double>28</sys:Double>
        <sys:Double>36</sys:Double>
        <sys:Double>48</sys:Double>
        <sys:Double>72</sys:Double>
    </x:Array>

    <!-- Padding/margin options (-4 to 30 pixels) -->
    <x:Array x:Key="PaddingOptions" Type="{x:Type sys:Double}">
        <sys:Double>-4</sys:Double>
        <sys:Double>-2</sys:Double>
        <sys:Double>0</sys:Double>
        <sys:Double>1</sys:Double>
        <sys:Double>2</sys:Double>
        <sys:Double>3</sys:Double>
        <sys:Double>4</sys:Double>
        <sys:Double>6</sys:Double>
        <sys:Double>8</sys:Double>
        <sys:Double>10</sys:Double>
        <sys:Double>14</sys:Double>
        <sys:Double>18</sys:Double>
        <sys:Double>22</sys:Double>
        <sys:Double>26</sys:Double>
        <sys:Double>30</sys:Double>
    </x:Array>

    <!-- Rotation angle options (0-360 degrees in 15-degree increments) -->
    <x:Array x:Key="AngleOptions" Type="{x:Type sys:Double}">
        <sys:Double>0</sys:Double>
        <sys:Double>15</sys:Double>
        <sys:Double>30</sys:Double>
        <sys:Double>45</sys:Double>
        <sys:Double>60</sys:Double>
        <sys:Double>75</sys:Double>
        <sys:Double>90</sys:Double>
        <sys:Double>105</sys:Double>
        <sys:Double>120</sys:Double>
        <sys:Double>135</sys:Double>
        <sys:Double>150</sys:Double>
        <sys:Double>165</sys:Double>
        <sys:Double>180</sys:Double>
        <sys:Double>195</sys:Double>
        <sys:Double>210</sys:Double>
        <sys:Double>225</sys:Double>
        <sys:Double>240</sys:Double>
        <sys:Double>255</sys:Double>
        <sys:Double>270</sys:Double>
        <sys:Double>285</sys:Double>
        <sys:Double>300</sys:Double>
        <sys:Double>315</sys:Double>
        <sys:Double>330</sys:Double>
        <sys:Double>345</sys:Double>
        <sys:Double>360</sys:Double>
    </x:Array>

    <!--#region Toggle Styles-->

    <Style x:Key="PlusMinusToggleStyle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Width="11" Height="11" Background="Transparent">
                        <Rectangle Fill="{DynamicResource primaryBackgroundBrush}" />
                        <Border Name="ExpandBorder" RenderOptions.EdgeMode="Aliased" BorderBrush="{DynamicResource EnvironmentWindowText}" BorderThickness="1" CornerRadius="0">
                            <Path RenderOptions.EdgeMode="Aliased" Name="ExpandPath" Stroke="{DynamicResource EnvironmentWindowText}" Margin="0" StrokeThickness="1" Data="M 4.5,1 V 8 M 1,4.5 H 8" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Data" TargetName="ExpandPath" Value="M 1,4.5 H 8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ExpandBorder" Property="BorderBrush" Value="{DynamicResource Button.Disabled.Foreground}" />
                            <Setter TargetName="ExpandPath" Property="Stroke" Value="{DynamicResource Button.Disabled.Foreground}" />
                            <Setter Property="Data" TargetName="ExpandPath" Value=""/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--#endregion-->

</ResourceDictionary>
