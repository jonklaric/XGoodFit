    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Column Header Gripper Style for resizing columns -->
    <Style x:Key="ColumnHeaderGripperStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Width" Value="2"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="SizeWE"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Row Header Gripper Style for resizing rows -->
    <Style x:Key="RowHeaderGripperStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Height" Value="2"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="SizeNS"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Theme-aware Column Header Style with gradient background and hover effects -->
    <Style x:Key="ColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock TextWrapping="Wrap"
                               TextAlignment="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}, Converter={x:Static local:HorizontalAlignmentToTextAlignmentConverter.Instance}}"
                               VerticalAlignment="Center"
                               FontWeight="Bold"
                               HorizontalAlignment="Stretch"
                               Text="{Binding}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="Foreground" Value="{DynamicResource DataGrid.Header.Foreground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DataGrid.Header.Border}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="6,3,6,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                    <Grid>
                        <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                            <Grid Name="HeaderGrid" SnapsToDevicePixels="True" Margin="1,0,0,0">
                                <Grid.Background>
                                    <LinearGradientBrush StartPoint="0 0" EndPoint="0 1">
                                        <LinearGradientBrush.GradientStops>
                                            <GradientStop Offset="0.25" Color="{DynamicResource DataGrid.Header.Background}"/>
                                            <GradientStop Offset="1" Color="{DynamicResource DataGrid.Header.GradientEnd}"/>
                                        </LinearGradientBrush.GradientStops>
                                    </LinearGradientBrush>
                                </Grid.Background>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Margin="{TemplateBinding Padding}" Grid.Column="0" SnapsToDevicePixels="True"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                <Path x:Name="SortArrow" Visibility="Collapsed" Data="M0,0 L1,0 0.5,1 z" Stretch="Fill"
                                      Grid.Column="1" Width="8" Height="6" Fill="{DynamicResource DataGrid.Header.Foreground}" Margin="0,0,8,0"
                                      VerticalAlignment="Center" RenderTransformOrigin="0.5,0.4"/>
                            </Grid>
                        </Border>
                        <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Style="{StaticResource ColumnHeaderGripperStyle}"/>
                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Style="{StaticResource ColumnHeaderGripperStyle}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="SortArrow" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" TargetName="HeaderGrid" Value="{DynamicResource DataGrid.Header.MouseOver.Background}"/>
                            <Setter TargetName="HeaderGrid" Property="Margin" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="Background" TargetName="HeaderGrid" Value="{DynamicResource DataGrid.Header.MouseOver.Background}"/>
                            <Setter TargetName="HeaderGrid" Property="Margin" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Default style for DataGridColumnHeader -->
    <Style TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource ColumnHeaderStyle}"/>

    <!-- Left-aligned Column Header Style -->
    <Style x:Key="LeftAlignedColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource ColumnHeaderStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <!-- Right-aligned Column Header Style -->
    <Style x:Key="RightAlignedColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource ColumnHeaderStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- BACKWARD COMPATIBLE COLUMN HEADER STYLES (Bold)                              -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Left-aligned Column Header Style (Bold) -->
    <Style x:Key="Left_ColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource ColumnHeaderStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock TextWrapping="Wrap" TextAlignment="Left" VerticalAlignment="Center"
                               FontWeight="Bold" HorizontalAlignment="Stretch" Text="{Binding}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Center-aligned Column Header Style (Bold) -->
    <Style x:Key="Center_ColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource ColumnHeaderStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"
                               FontWeight="Bold" HorizontalAlignment="Stretch" Text="{Binding}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Right-aligned Column Header Style (Bold) -->
    <Style x:Key="Right_ColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource ColumnHeaderStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center"
                               FontWeight="Bold" HorizontalAlignment="Stretch" Text="{Binding}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- MODAL COLUMN HEADER STYLES (Normal Weight)                                   -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Left-aligned Modal Column Header Style (Normal Weight) -->
    <Style x:Key="Left_ColumnHeaderStyle_Modal" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource ColumnHeaderStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock TextWrapping="Wrap" TextAlignment="Left" VerticalAlignment="Center"
                               FontWeight="Normal" HorizontalAlignment="Stretch" Text="{Binding}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Center-aligned Modal Column Header Style (Normal Weight) -->
    <Style x:Key="Center_ColumnHeaderStyle_Modal" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource ColumnHeaderStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"
                               FontWeight="Normal" HorizontalAlignment="Stretch" Text="{Binding}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Right-aligned Modal Column Header Style (Normal Weight) -->
    <Style x:Key="Right_ColumnHeaderStyle_Modal" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource ColumnHeaderStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center"
                               FontWeight="Normal" HorizontalAlignment="Stretch" Text="{Binding}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- ROW HEADER STYLES                                                            -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Theme-aware Row Header Style - matches default WPF DataGrid row header width -->
    <Style x:Key="RowHeaderStyle" TargetType="{x:Type DataGridRowHeader}">
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock TextWrapping="Wrap"
                               TextAlignment="Center"
                               VerticalAlignment="Center"
                               FontWeight="Bold"
                               HorizontalAlignment="Stretch"
                               Text="{Binding}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="{DynamicResource DataGrid.Header.Foreground}"/>
        <Setter Property="Background" Value="{DynamicResource DataGrid.Row.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DataGrid.Header.Border}"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="2,0,2,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridRowHeader}">
                    <Grid>
                        <Border Name="HeaderBorder"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid Name="HeaderGrid" SnapsToDevicePixels="True" Margin="1,0,0,0">
                                <Grid.Background>
                                    <SolidColorBrush Color="{DynamicResource DataGrid.RowHeader.Background}"/>
                                </Grid.Background>
                                <ContentPresenter Margin="{TemplateBinding Padding}" SnapsToDevicePixels="True"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Grid>
                        </Border>
                        <Thumb x:Name="PART_TopHeaderGripper" VerticalAlignment="Top" Style="{StaticResource RowHeaderGripperStyle}"/>
                        <Thumb x:Name="PART_BottomHeaderGripper" VerticalAlignment="Bottom" Style="{StaticResource RowHeaderGripperStyle}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" TargetName="HeaderGrid" Value="{DynamicResource DataGrid.Header.MouseOver.Background}"/>
                            <Setter TargetName="HeaderGrid" Property="Margin" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="Background" TargetName="HeaderGrid" Value="{DynamicResource DataGrid.Header.MouseOver.Background}"/>
                            <Setter TargetName="HeaderGrid" Property="Margin" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Default style for DataGridRowHeader -->
    <Style TargetType="{x:Type DataGridRowHeader}" BasedOn="{StaticResource RowHeaderStyle}"/>

    <!-- Right-aligned Row Header Style -->
    <Style x:Key="Right_RowHeaderStyle" TargetType="{x:Type DataGridRowHeader}" BasedOn="{StaticResource RowHeaderStyle}">
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center"
                               FontWeight="Bold" HorizontalAlignment="Stretch" Text="{Binding}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- COPY PASTE DATAGRID                                                          -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- DataGrid Row Style for CopyPasteDataGrid -->
    <Style x:Key="CopyPasteDataGridRowStyle" TargetType="{x:Type DataGridRow}">
        <Setter Property="Background" Value="{DynamicResource DataGrid.Row.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource DataGrid.Row.Foreground}"/>
        <Style.Triggers>
            <Trigger Property="AlternationIndex" Value="1">
                <Setter Property="Background" Value="{DynamicResource DataGrid.Row.Alternating.Background}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource DataGrid.Row.MouseOver.Background}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource DataGrid.Row.Selection.Background}"/>
                <Setter Property="Foreground" Value="{DynamicResource DataGrid.Row.Selection.Foreground}"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True"/>
                    <Condition Property="Selector.IsSelectionActive" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource DataGrid.Row.Selection.Inactive.Background}"/>
                <Setter Property="Foreground" Value="{DynamicResource DataGrid.Row.Selection.Inactive.Foreground}"/>
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <!-- DataGrid Cell Style for CopyPasteDataGrid -->
    <Style x:Key="CopyPasteDataGridCellStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource SelectableDataGridCellStyle}"/>

    <Style x:Key="CopyPasteDataGridStyle" TargetType="{x:Type local:CopyPasteDataGrid}">
        <Setter Property="Background" Value="{DynamicResource EnvironmentWindowBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DataGrid.Static.Border}"/>
        <Setter Property="Foreground" Value="{DynamicResource DataGrid.Static.Foreground}"/>
        <Setter Property="RowBackground" Value="{DynamicResource DataGrid.Row.Background}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource DataGrid.Row.Alternating.Background}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DataGrid.GridLines}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource DataGrid.GridLines}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="AlternationCount" Value="2"/>
        <Setter Property="RowHeight" Value="22"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="GridLinesVisibility" Value="All"/>
        <Setter Property="RowStyle" Value="{StaticResource CopyPasteDataGridRowStyle}"/>
        <Setter Property="CellStyle" Value="{StaticResource CopyPasteDataGridCellStyle}"/>
        <Setter Property="ColumnHeaderStyle" Value="{DynamicResource ColumnHeaderStyle}"/>
        <Setter Property="RowHeaderStyle" Value="{DynamicResource RowHeaderStyle}"/>
    </Style>

    <Style TargetType="{x:Type local:CopyPasteDataGrid}" BasedOn="{StaticResource CopyPasteDataGridStyle}"/>

    <!-- Editing TextBox style for DataGridTextColumn cells. Uses DynamicResource
         for all color properties so they resolve at runtime after ThemeService has
         loaded the active color dictionary. BasedOn with StaticResource would resolve
         at XAML parse time (before theme loading) and fall back to the WPF system
         default white background. -->
    <Style x:Key="DataGridEditingTextBoxStyle" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{DynamicResource TextBox.Static.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentToolWindowText}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextBox.Caret}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource TextBox.Selection.Background}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- VALIDATION DATAGRID                                                          -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- DataGrid Row Style for ValidationDataGrid -->
    <Style x:Key="ValidationDataGridRowStyle" TargetType="{x:Type DataGridRow}">
        <Setter Property="Background" Value="{DynamicResource DataGrid.Row.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource DataGrid.Row.Foreground}"/>
        <Style.Triggers>
            <Trigger Property="AlternationIndex" Value="1">
                <Setter Property="Background" Value="{DynamicResource DataGrid.Row.Alternating.Background}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource DataGrid.Row.MouseOver.Background}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource DataGrid.Row.Selection.Background}"/>
                <Setter Property="Foreground" Value="{DynamicResource DataGrid.Row.Selection.Foreground}"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True"/>
                    <Condition Property="Selector.IsSelectionActive" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource DataGrid.Row.Selection.Inactive.Background}"/>
                <Setter Property="Foreground" Value="{DynamicResource DataGrid.Row.Selection.Inactive.Foreground}"/>
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <!-- DataGrid Cell Style for ValidationDataGrid (includes error handling) -->
    <Style x:Key="ValidationDataGridCellStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource SelectableDataGridCellStyle}"/>

    <Style x:Key="ValidationDataGridStyle" TargetType="{x:Type local:ValidationDataGrid}">
        <Setter Property="Background" Value="{DynamicResource EnvironmentWindowBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DataGrid.Static.Border}"/>
        <Setter Property="Foreground" Value="{DynamicResource DataGrid.Static.Foreground}"/>
        <Setter Property="RowBackground" Value="{DynamicResource DataGrid.Row.Background}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource DataGrid.Row.Alternating.Background}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DataGrid.GridLines}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource DataGrid.GridLines}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="AlternationCount" Value="2"/>
        <Setter Property="RowHeight" Value="22"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="GridLinesVisibility" Value="All"/>
        <Setter Property="RowStyle" Value="{StaticResource ValidationDataGridRowStyle}"/>
        <Setter Property="CellStyle" Value="{StaticResource ValidationDataGridCellStyle}"/>
        <Setter Property="ColumnHeaderStyle" Value="{DynamicResource ColumnHeaderStyle}"/>
        <Setter Property="RowHeaderStyle" Value="{DynamicResource RowHeaderStyle}"/>
        <!-- Theme-aware error colors -->
        <Setter Property="ErrorCellBorderBrush" Value="{DynamicResource DataGrid.Cell.Error.Border}"/>
        <Setter Property="ErrorCellBackgroundBrush" Value="{DynamicResource DataGrid.Cell.Error.Background}"/>
    </Style>

    <Style TargetType="{x:Type local:ValidationDataGrid}" BasedOn="{StaticResource ValidationDataGridStyle}"/>

</ResourceDictionary>
