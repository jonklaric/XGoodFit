<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:GenericControls">

    <!--
    ╔═══════════════════════════════════════════════════════════════════════════════╗
    ║  GenericControls Theme Resource Dictionary                                    ║
    ╠═══════════════════════════════════════════════════════════════════════════════╣
    ║  Contains theme-aware styles for all GenericControls components that use      ║
    ║  DynamicResource bindings to respond to runtime theme changes.                ║
    ║                                                                               ║
    ║  CONTENTS:                                                                    ║
    ║  • Common Styles      - Separators, title text, dot leaders                   ║
    ║  • DataGrid Toolbar   - Toolbar button and separator styles                   ║
    ║  • General Controls   - NumericTextBox, ColorPicker, DateTimePicker, etc.    ║
    ║  • Property Controls  - TextPropertyControl, NumericPropertyControl, etc.    ║
    ║  • DataGrid Styles    - Cell, column header, and row header styles           ║
    ║  • CopyPasteDataGrid  - Enhanced DataGrid with copy/paste support            ║
    ║  • ValidationDataGrid - DataGrid with validation error highlighting          ║
    ║                                                                               ║
    ║  THEME SUPPORT:                                                               ║
    ║  All colors use DynamicResource bindings to the Themes library.               ║
    ║  Common theme resources referenced:                                           ║
    ║  • EnvironmentWindowText/Background - Window text and background colors       ║
    ║  • TextBox.Static.*                 - TextBox colors                          ║
    ║  • Button.MouseOver/Pressed.*       - Interactive button states               ║
    ║  • DataGrid.*                       - DataGrid-specific theming               ║
    ║                                                                               ║
    ║  USAGE:                                                                       ║
    ║  Styles are automatically applied to controls via implicit styling.           ║
    ║  Named styles can be explicitly referenced:                                   ║
    ║  <DataGrid Style="{StaticResource CopyPasteDataGridStyle}"/>                  ║
    ╚═══════════════════════════════════════════════════════════════════════════════╝
    -->

    <!-- Merge Icon Dictionary for centralized vector icons -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/GenericControls;component/Resources/IconDictionary.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- COMMON STYLES                                                                -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Separator Background (transparent) -->
    <SolidColorBrush x:Key="SeparatorBackground">#00FFFFFF</SolidColorBrush>

    <!-- Dot Leader Line Style for property controls -->
    <Style TargetType="{x:Type Line}" x:Key="DotLeaderLineStyle">
        <Setter Property="Grid.Column" Value="1"/>
        <Setter Property="X1" Value="0"/>
        <Setter Property="Y1" Value="0"/>
        <Setter Property="X2" Value="1"/>
        <Setter Property="Y2" Value="0"/>
        <Setter Property="Stroke" Value="{DynamicResource Button.Static.Border}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="StrokeDashArray" Value="2 2"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Margin" Value="0,0,3,0"/>
    </Style>

    <!-- Title Text Style -->
    <Style TargetType="{x:Type TextBlock}" x:Key="TitleTextStyle">
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="0,0,3,0"/>
        <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- DATAGRID TOOLBAR                                                             -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Toolbar Button Style Base -->
    <Style x:Key="StackPanelButtonStyleBase" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
        <Setter Property="Height" Value="24"/>
        <Setter Property="Width" Value="24"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="2"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Button.MouseOver.Background}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Button.MouseOver.Border}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Button.Pressed.Background}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Button.Pressed.Border}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Vertical Separator Style for Toolbar -->
    <Style x:Key="VerticalSeparatorStyle" TargetType="{x:Type Separator}">
        <Setter Property="Margin" Value="2,4,2,4"/>
        <Setter Property="Background" Value="{DynamicResource SeparatorBorder}"/>
        <Setter Property="LayoutTransform">
            <Setter.Value>
                <RotateTransform Angle="90"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DataGridToolbarStyle" TargetType="{x:Type local:DataGridToolbar}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="StackPanelButtonStyle" Value="{DynamicResource StackPanelButtonStyleBase}"/>
        <Setter Property="StackPanelSeparatorStyle" Value="{DynamicResource VerticalSeparatorStyle}"/>
    </Style>

    <Style TargetType="{x:Type local:DataGridToolbar}" BasedOn="{StaticResource DataGridToolbarStyle}"/>

