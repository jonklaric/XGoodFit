<local:MetroDialogWindow x:Class="GenericControls.NameDialog" x:Name="NewNameDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GenericControls"
    Title="Name Dialog"
        Width="346"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Height"
        Style="{DynamicResource MetroDialogStyle}"
        Background="{DynamicResource EnvironmentWindowBackground}"
        >
    <Grid>
        <!--Add Rows-->
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="6,0,6,0" Text="Name:" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>

        <local:NameTextBox x:Name="NameTBox" Grid.Row="1" HorizontalAlignment="Stretch" Height="24" Margin="6" VerticalAlignment="Stretch"
                            Text="{Binding ElementName=NewNameDialog, Path=Text, Mode=TwoWay}"/>

        <!--Custom Content-->
        <ContentControl Grid.Row="2" Margin="6,0,6,0" Name="CustomContentUserControl"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        Content="{Binding InnerContent, ElementName=NewNameDialog}"/>

        <!--Ok and Cancel buttons-->
        <Grid Grid.Row="3" HorizontalAlignment="Right">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Name="OKButton" IsDefault="True" Click="OKButton_Click" Content="OK" Grid.Column="0" Width="75" Height="24" Cursor="Hand" Margin="6,0,0,6"/>
            <Button Name="CancelButton" IsCancel="True" Click="CancelButton_Click" Content="Cancel" Grid.Column="1" Width="75" Height="24" Cursor="Hand" Margin="6,0,6,6"/>
        </Grid>
    </Grid>
</local:MetroDialogWindow>
