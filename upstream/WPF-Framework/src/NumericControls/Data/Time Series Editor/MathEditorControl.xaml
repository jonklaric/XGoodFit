<UserControl x:Class="NumericControls.MathEditorControl"
             x:Name="MathEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NumericControls"
             xmlns:cntrls="clr-namespace:GenericControls;assembly=GenericControls"
             mc:Ignorable="d"
             Background="{DynamicResource EnvironmentWindowBackground}"
             d:DesignHeight="140" d:DesignWidth="260">
    <UserControl.Resources>
        <ResourceDictionary>
            <local:MathFunctionTypeToNameConverter x:Key="FnToNameCvrtr"/>
            <local:MathFunctionTypeToTooltipConverter x:Key="FnToTipCvrtr"/>
            <local:MathFunctionTypeToIconConverter x:Key="FnToIconCvrtr"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Math function buttons and operand input -->
        <DockPanel Width="72">
            <!-- Operand input field -->
            <cntrls:NumericTextBox2 x:Name="ValueTextBox"
                                    DockPanel.Dock="Top"
                                    Width="68"
                                    Height="22"
                                    HorizontalAlignment="Center"
                                    ToolTip="Operand for the math function."
                                    CanHaveNegative="True"/>

            <!-- Math function buttons requiring an operand -->
            <ItemsControl x:Name="OperandItemsControl"
                          BorderBrush="Transparent"
                          Background="{DynamicResource EnvironmentWindowBackground}"
                          BorderThickness="1"
                          AlternationCount="1"
                          Padding="0"
                          Width="72"
                          DockPanel.Dock="Top"
                          HorizontalContentAlignment="Stretch">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Stretch"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Click="Button_Click"
                                Cursor="Hand"
                                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                            <Button.ToolTip>
                                <ToolTip>
                                    <StackPanel>
                                        <TextBlock FontWeight="Bold"
                                                   FontSize="12"
                                                   Margin="0,0,0,5"
                                                   Text="{Binding {}, Converter={StaticResource FnToNameCvrtr}}"/>
                                        <TextBlock FontWeight="Normal"
                                                   FontSize="11"
                                                   Text="{Binding {}, Converter={StaticResource FnToTipCvrtr}}"
                                                   TextWrapping="WrapWithOverflow"/>
                                    </StackPanel>
                                </ToolTip>
                            </Button.ToolTip>
                            <ContentControl Width="16" Height="16"
                                            Content="{Binding {}, Converter={StaticResource FnToIconCvrtr}}"/>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Math function buttons not requiring an operand -->
            <ItemsControl x:Name="NoOperandItemsControl"
                          BorderBrush="Transparent"
                          Background="{DynamicResource EnvironmentWindowBackground}"
                          BorderThickness="1"
                          AlternationCount="1"
                          Padding="0"
                          Width="72"
                          DockPanel.Dock="Top"
                          HorizontalContentAlignment="Stretch">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Click="Button_Click"
                                Cursor="Hand"
                                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                            <Button.ToolTip>
                                <ToolTip>
                                    <StackPanel>
                                        <TextBlock FontWeight="Bold"
                                                   FontSize="12"
                                                   Margin="0,0,0,5"
                                                   Text="{Binding {}, Converter={StaticResource FnToNameCvrtr}}"/>
                                        <TextBlock FontWeight="Normal"
                                                   FontSize="11"
                                                   Text="{Binding {}, Converter={StaticResource FnToTipCvrtr}}"
                                                   TextWrapping="WrapWithOverflow"/>
                                    </StackPanel>
                                </ToolTip>
                            </Button.ToolTip>
                            <ContentControl Width="16" Height="16"
                                            Content="{Binding {}, Converter={StaticResource FnToIconCvrtr}}"/>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Separator DockPanel.Dock="Top"
                       HorizontalAlignment="Stretch"/>

            <!-- Information text about operation scope -->
            <TextBlock x:Name="NotificationText"
                       DockPanel.Dock="Top"
                       Text="Applies to all."
                       Foreground="{DynamicResource EnvironmentWindowText}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,2"
                       VerticalAlignment="Top"
                       HorizontalAlignment="Stretch"/>
        </DockPanel>
    </Grid>
</UserControl>
