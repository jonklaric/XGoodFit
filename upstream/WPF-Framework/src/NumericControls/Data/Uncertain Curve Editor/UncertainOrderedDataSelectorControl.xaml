<UserControl x:Class="NumericControls.UncertainOrderedDataSelectorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NumericControls"
             xmlns:cntrls="clr-namespace:GenericControls;assembly=GenericControls"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:oxyCntrls="clr-namespace:OxyPlotControls;assembly=OxyPlotControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Control.Resources>
        <!-- Column header style with wrapped text and sorting support -->
        <Style x:Key="WrappedColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Bottom" FontWeight="Bold" HorizontalAlignment="Stretch" Text="{Binding}"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Bottom" />
            <EventSetter Event="Click" Handler="DataGridColumnHeader_Click"/>
        </Style>
    </Control.Resources>
    <Grid DataContext="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type UserControl}}}" >
        <Grid.Resources>
            <cntrls:BooleanToVisibilityConverter x:Key="VisibilityConverter" TrueValue="Collapsed" FalseValue="Visible"></cntrls:BooleanToVisibilityConverter>
            <cntrls:ReverseBooleanConverter x:Key="RevBoolConverter"/>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding TableWidth}" MinWidth="197"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <!-- Distribution selector panel -->
        <DockPanel Name="CurveUncertaintyPanel" VerticalAlignment="Stretch" Margin="0,0,2,5" Visibility="{Binding Path=IsReadOnly, Converter={StaticResource VisibilityConverter}}">
            <TextBlock Text="Distribution" TextAlignment="Right" VerticalAlignment="Center" DockPanel.Dock="Left" Foreground="{DynamicResource EnvironmentWindowText}"/>
            <ComboBox Name="CurveUncertaintyComboBox" Margin="5,0,0,0" IsEnabled="{Binding Path=IsReadOnly, Converter={StaticResource RevBoolConverter}, FallbackValue=False, TargetNullValue=False}" HorizontalAlignment="Stretch" VerticalAlignment="Center" SelectionChanged="CurveUncertaintyComboBox_SelectionChanged" DockPanel.Dock="Left">
            </ComboBox>
        </DockPanel>

        <!-- Data table with merged headers -->
        <Grid Grid.Column="0" Grid.Row="1" Margin="0,0,2,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <Border Grid.Column="0" BorderBrush="{DynamicResource DataGrid.Static.Border}" BorderThickness="1">
                <Grid Grid.Row="0" Name="MergedColumnHeaderGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding ElementName=ValidationGrid, Path=RowHeaderWidth}" />
                        <ColumnDefinition Width="{Binding ElementName=Column1, Path=ActualWidth}" />
                        <ColumnDefinition Width="{Binding ElementName=Column2, Path=ActualWidth}" />
                    </Grid.ColumnDefinitions>
                    <DataGridColumnHeader Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsHitTestVisible="False" Content="{Binding XColumnHeader}"/>
                    <DataGridColumnHeader Grid.Column="2" Grid.ColumnSpan="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsHitTestVisible="False" Content="{Binding YColumnHeader}"/>
                </Grid>
            </Border>

            <cntrls:ValidationDataGrid Name="ValidationGrid" Grid.Row="1"
                                       AutoGenerateColumns="True"
                                       CanUserResizeColumns="False"
                                       SelectionMode="Extended" SelectionUnit="CellOrRowHeader"
                                       CanUserDeleteRows="False" CanUserAddRows="False" CanUserResizeRows="False" CanUserSortColumns="False"
                                       CanUserReorderColumns="False"
                                       CanUserAddInsertDeleteRows="True"
                                       RowHeight="24"
                                       VerticalContentAlignment="Center"
                                       IsReadOnly="{Binding Path=IsReadOnly}"
                                       ColumnHeaderStyle="{StaticResource WrappedColumnHeaderStyle}"
                                       AutoGeneratedColumns="ValidationGrid_AutoGeneratedColumns"
                                       RowsAdded="ValidationGrid_RowsAdded"
                                       PreviewAddRows="ValidationGrid_PreviewAddRows"
                                       RowsDeleted="ValidationGrid_RowsDeleted"
                                       PreviewPasteData="ValidationGrid_PreviewPasteData"
                                       DataPasted="ValidationGrid_DataPasted"/>
        </Grid>

        <!-- Resizable splitter between table and plot -->
        <GridSplitter Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Margin="-2,0,0,0" Width="4" HorizontalAlignment="Left" VerticalAlignment="Stretch" Background="Transparent"/>

        <!-- Plot grid with uncertainty visualization -->
        <Grid Grid.Column="1" Grid.RowSpan="2" Margin="2,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <oxy:Plot x:Name="Plot" x:FieldModifier="public"
                      Grid.Column="0"
                      LegendPosition="{Binding PlotLegendPosition}"
                      Title="{Binding PlotTitle}">
                <oxy:Plot.Axes>
                    <oxy:LinearAxis Position="Left" Title="{Binding YAxisLabel}" AbsoluteMinimum="{Binding YAxisMinimum}" AbsoluteMaximum="{Binding YAxisMaximum}" AxisTitleDistance="20" TitleFontSize="20" MajorGridlineStyle="Solid" MinorGridlineStyle="Dash"/>
                    <oxy:LinearAxis Position="Bottom" Title="{Binding XAxisLabel}" AbsoluteMinimum="{Binding XAxisMinimum}" AbsoluteMaximum="{Binding XAxisMaximum}" AxisTitleDistance="15" TitleFontSize="20" MajorGridlineStyle="Solid" MinorGridlineStyle="Dash"/>
                </oxy:Plot.Axes>
                <oxy:Plot.Series>
                    <oxy:AreaSeries Name="UncertaintyBoundsArea" Title="Uncertainty Bounds" Fill="#CC7DC8E6" MarkerFill="Transparent" StrokeThickness="0" ItemsSource="{Binding AreaPoints}" DataFieldX="X1" DataFieldX2="X2" DataFieldY="Y1" DataFieldY2="Y2"/>
                    <oxy:LineSeries Name="MinimumLine" Title="Minimum" Color="Blue" MarkerFill="Transparent" ItemsSource="{Binding MinimumLinePoints}"/>
                    <oxy:LineSeries Name="MaximumLine" Title="Maximum" Color="Red" MarkerFill="Transparent" ItemsSource="{Binding MaximumLinePoints}"/>
                    <oxy:LineSeries Name="MeanLine" Title="Mean" Color="Black" MarkerFill="Transparent" ItemsSource="{Binding MeanLinePoints}"/>
                    <oxy:LineSeries Name="MedianLine" Title="Median" Color="Black" MarkerFill="Transparent" LineStyle="DashDashDot" ItemsSource="{Binding MedianLinePoints}"/>
                    <oxy:LineSeries Name="ModeLine" Title="Mode" Color="Black" MarkerFill="Transparent" LineStyle="Dot" ItemsSource="{Binding ModeLinePoints}"/>
                </oxy:Plot.Series>
            </oxy:Plot>
            <oxyCntrls:OxyPlotToolbar Grid.Column="1" VerticalAlignment="Stretch" ToolBarOrientation="Vertical" 
                                      Plot="{Binding ElementName=Plot, Mode=OneTime}" 
                                      Background="{Binding ElementName=Plot, Path=Background}" 
                                      PropertiesCalled="OxyplotToolbar_PropertiesCalled"/>
        </Grid>
        
    </Grid>
</UserControl>
