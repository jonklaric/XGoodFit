<UserControl x:Class="NumericControls.UncertainOrderedDataTableEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NumericControls"
             xmlns:cntrls="clr-namespace:GenericControls;assembly=GenericControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- Column header style with wrapped text -->
        <Style x:Key="WrappedColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Bottom" FontWeight="Bold" HorizontalAlignment="Stretch" Text="{Binding}"></TextBlock>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Bottom" />
        </Style>
    </UserControl.Resources>
    <Grid DataContext="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type UserControl}}}">
        <Grid.Resources>
            <cntrls:BooleanToVisibilityConverter x:Key="VisibilityConverter" TrueValue="Collapsed" FalseValue="Visible"></cntrls:BooleanToVisibilityConverter>
            <cntrls:ReverseBooleanConverter x:Key="RevBoolConverter"/>
            <local:DistributionNameConverter x:Key="NameConverter"/>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Distribution selector panel with layout constraints -->
        <Grid x:Name="CurveUncertaintyPanel" VerticalAlignment="Stretch" Margin="0,0,0,5" Visibility="{Binding Path=IsReadOnly, Converter={StaticResource VisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width=".00001*"/>
                <ColumnDefinition Width="10000*" MaxWidth="{Binding DistributionSelectorMaxWidth}"/>
            </Grid.ColumnDefinitions>
            <TextBlock 
                Text="Distribution" Foreground="{DynamicResource EnvironmentWindowText}"
                TextAlignment="Right" 
                Margin="0,0,5,0"
                VerticalAlignment="Center"/>

            <ComboBox 
                Name="CurveUncertaintyComboBox" 
                Grid.Column="2" 
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Center" 
                DockPanel.Dock="Right"
                SelectionChanged="CurveUncertaintyComboBox_SelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource NameConverter}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <!-- Uncertain ordered data table editor -->
        <local:UncertainOrderedTableEditor 
            x:Name="UncertainTableEditor"
            Grid.Row="1" 
            AddRemoveRows="{Binding AddRemoveRows}"
            XColumnHeader="{Binding XColumnHeader}"
            YColumnHeader="{Binding YColumnHeader}"
            IsStrictX="{Binding IsStrictX}"
            IsStrictY="{Binding IsStrictY}"
            OrderX="{Binding OrderX}"
            OrderY="{Binding OrderY}"
            MinimumX="{Binding MinimumX}"
            MaximumX="{Binding MaximumX}"
            MinimumY="{Binding MinimumY}"
            MaximumY="{Binding MaximumY}"
            IsReadOnly="{Binding IsReadOnly}"
            ShowToolBar="{Binding ShowToolBar}"
            ColumnHeaderStyle="{StaticResource WrappedColumnHeaderStyle}"
            CellStyle="{Binding CellStyle}"
            UncertainOrderedData="{Binding ElementName=CurveUncertaintyComboBox, Path=SelectedValue}"/>

    </Grid>
</UserControl>
