<UserControl x:Class="NumericControls.UncertainOrderedTableEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NumericControls"
             xmlns:cntrls="clr-namespace:GenericControls;assembly=GenericControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Control.Resources>
        <!-- Column header style with wrapped text and sorting support -->
        <Style x:Key="WrappedColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Bottom" FontWeight="Bold" HorizontalAlignment="Stretch" Text="{Binding}"></TextBlock>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Bottom" />
            <EventSetter Event="Click" Handler="DataGridColumnHeader_Click"/>
        </Style>
    </Control.Resources>
    <Grid DataContext="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type UserControl}}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <!-- Data grid toolbar -->
        <cntrls:DataGridToolbar Name="ValidationGridToolbar"
                                Grid.Row="0"
                                DataGrid="{Binding ElementName=ValidationGrid, Mode=OneTime}"
                                ToolOrientation="Horizontal"/>

        <!-- Merged column headers for X and Y data -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource DataGrid.Static.Border}" BorderThickness="1">
            <Grid Name="MergedColumnHeaderGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding ElementName=ValidationGrid, Path=RowHeaderActualWidth}" />
                    <ColumnDefinition Width="{Binding ElementName=Column1, Path=ActualWidth}" />
                    <ColumnDefinition Width="{Binding ElementName=Column2, Path=ActualWidth}" />
                </Grid.ColumnDefinitions>
                <DataGridColumnHeader Name="XGridColumnHeader" Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsHitTestVisible="False" Content="{Binding XColumnHeader}"/>
                <DataGridColumnHeader Name="YGridColumnHeader" Grid.Column="2" Grid.ColumnSpan="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsHitTestVisible="False" Content="{Binding YColumnHeader}"/>
            </Grid>
        </Border>

        <!-- Validation data grid for uncertain ordered data -->
        <cntrls:ValidationDataGrid
            Name="ValidationGrid" x:FieldModifier="public" Grid.Row="2"
            AutoGenerateColumns="True"
            CanUserResizeColumns="True"
            SelectionMode="Extended" SelectionUnit="CellOrRowHeader"
            CanUserDeleteRows="False" CanUserAddRows="False" CanUserResizeRows="False" CanUserSortColumns="False"
            CanUserReorderColumns="False"
            CanUserAddInsertDeleteRows="True"
            RowHeight="22"
            VerticalContentAlignment="Center"
            IsReadOnly="{Binding Path=IsReadOnly}"
            ColumnHeaderStyle="{Binding Path=ColumnHeaderStyle}"
            CellStyle="{Binding Path=CellStyle}"
            AutoGeneratedColumns="ValidationGrid_AutoGeneratedColumns"
            PreviewAddRows="ValidationGrid_PreviewAddRows"
            PreviewDeleteRows="ValidationGrid_PreviewDeleteRows"
            DataPasted="ValidationGrid_DataPasted"
            PreviewPasteData="ValidationGrid_PreviewPasteData"
            MouseDown="ValidationGrid_MouseDown"/>
    </Grid>
</UserControl>
