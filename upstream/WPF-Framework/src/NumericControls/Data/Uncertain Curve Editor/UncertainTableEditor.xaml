<UserControl x:Class="NumericControls.UncertainTableEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NumericControls"
             xmlns:cntrls="clr-namespace:GenericControls;assembly=GenericControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- Column header style with wrapped text -->
        <Style x:Key="WrappedColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   VerticalAlignment="Bottom"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Stretch"
                                   Text="{Binding}"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Bottom"/>
        </Style>
    </UserControl.Resources>

    <Grid DataContext="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type UserControl}}}">
        <Grid.Resources>
            <cntrls:BooleanToVisibilityConverter x:Key="VisibilityConverter" TrueValue="Collapsed" FalseValue="Visible"/>
            <cntrls:ReverseBooleanConverter x:Key="RevBoolConverter"/>
            <local:DistributionNameConverter x:Key="NameConverter"/>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Distribution selector panel -->
        <DockPanel Name="CurveUncertaintyPanel"
                   VerticalAlignment="Stretch"
                   Margin="0,0,0,5"
                   Visibility="{Binding Path=IsReadOnly, Converter={StaticResource VisibilityConverter}}">
            <TextBlock Text="Distribution"
                       TextAlignment="Right"
                       VerticalAlignment="Center"
                       DockPanel.Dock="Left"/>
            <ComboBox Name="CurveUncertaintyComboBox"
                      Margin="5,0,0,0"
                      IsEnabled="{Binding Path=IsReadOnly, Converter={StaticResource RevBoolConverter}, FallbackValue=False, TargetNullValue=False}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      DockPanel.Dock="Left"
                      SelectionChanged="CurveUncertaintyComboBox_SelectionChanged"
                      ItemsSource="{Binding Distributions, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                      SelectedItem="{Binding SelectedUncertainOrderedData, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource NameConverter}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </DockPanel>

        <!-- Uncertain ordered data table editor -->
        <local:UncertainOrderedTableEditor x:Name="MyUncertainTableEditor"
                                           x:FieldModifier="public"
                                           Grid.Row="1"
                                           AddRemoveRows="{Binding AddRemoveRows}"
                                           XColumnHeader="{Binding XColumnHeader}"
                                           YColumnHeader="{Binding YColumnHeader}"
                                           IsStrictX="{Binding IsStrictX}"
                                           IsStrictY="{Binding IsStrictY}"
                                           OrderX="{Binding OrderX}"
                                           OrderY="{Binding OrderY}"
                                           MinimumX="{Binding MinimumX}"
                                           MaximumX="{Binding MaximumX}"
                                           MinimumY="{Binding MinimumY}"
                                           MaximumY="{Binding MaximumY}"
                                           IsReadOnly="{Binding IsReadOnly}"
                                           ShowToolBar="{Binding ShowToolBar}"
                                           ColumnHeaderStyle="{Binding ColumnHeaderStyle}"
                                           CellStyle="{Binding CellStyle}"
                                           UncertainOrderedData="{Binding ElementName=CurveUncertaintyComboBox, Path=SelectedItem}"/>
    </Grid>
</UserControl>
