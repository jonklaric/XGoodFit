<UserControl x:Class="NumericControls.XYDataGridControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NumericControls"
             xmlns:cntrls="clr-namespace:GenericControls;assembly=GenericControls"
             mc:Ignorable="d"
             d:DesignHeight="300"
             d:DesignWidth="200"
             Height="400"
             Background="White">
    <UserControl.Resources>
        <!-- Right-aligned cell style for numeric values -->
        <Style x:Key="ParameterValueCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="White"/>
            <Setter Property="TextBlock.TextAlignment" Value="Right"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Data grid for X and Y value pairs -->
        <cntrls:CopyPasteDataGrid x:Name="XYDataTable"
                                  HeadersVisibility="All"
                                  CanUserResizeColumns="False"
                                  HorizontalGridLinesBrush="#FF353B7A"
                                  VerticalGridLinesBrush="#FF353B7A"
                                  AutoGenerateColumns="False"
                                  SelectionMode="Extended"
                                  SelectionUnit="Cell"
                                  Margin="2,4,2,2"
                                  CanUserDeleteRows="True"
                                  CanUserAddRows="True"
                                  CanUserResizeRows="False"
                                  CanUserSortColumns="False"
                                  CanUserReorderColumns="False"
                                  Background="Transparent"
                                  VerticalContentAlignment="Center"
                                  CanUserAddInsertDeleteRows="True"
                                  PasteAddsRows="True">
            <cntrls:CopyPasteDataGrid.Columns>
                <DataGridTextColumn x:Name="XColumn"
                                    Header="X Values"
                                    IsReadOnly="False"
                                    Width="100"
                                    Binding="{Binding Path=X}"
                                    CellStyle="{StaticResource ParameterValueCellStyle}"
                                    EditingElementStyle="{StaticResource DataGridEditingTextBoxStyle}"/>
                <DataGridTextColumn x:Name="YColumn"
                                    Header="Y Values"
                                    IsReadOnly="False"
                                    Width="100"
                                    Binding="{Binding Path=Y}"
                                    CellStyle="{StaticResource ParameterValueCellStyle}"
                                    EditingElementStyle="{StaticResource DataGridEditingTextBoxStyle}"/>
            </cntrls:CopyPasteDataGrid.Columns>
        </cntrls:CopyPasteDataGrid>
    </Grid>
</UserControl>
