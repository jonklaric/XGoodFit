<UserControl x:Class="NumericControls.Distributions.Univariate.DistributionSelectorPopup" 
             x:Name="DistributionPopupSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NumericControls.Distributions.Univariate"
             xmlns:cntrls="clr-namespace:GenericControls;assembly=GenericControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <cntrls:ReverseBooleanConverter x:Key="ReverseBoolConverter"/>
    </UserControl.Resources>

    <Grid>
        <!-- Toggle button displaying selected distribution -->
        <ToggleButton Name="PopupToggleButton"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left"
                      IsHitTestVisible="{Binding ElementName=DistributionPopup, Path=IsOpen, Converter={StaticResource ReverseBoolConverter}}">
            <TextBlock Name="DistributionTextBlock"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Margin="3,0,0,0"/>
        </ToggleButton>

        <!-- Hidden rectangle used for popup placement alignment -->
        <Rectangle x:Name="PART_PopPlacer"
                   Fill="Red"
                   Width="0"
                   Height="0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Focusable="False"
                   Visibility="Hidden"
                   IsHitTestVisible="False"/>

        <!-- Distribution selector popup with full plot features -->
        <Popup Name="DistributionPopup"
               IsOpen="{Binding ElementName=PopupToggleButton, Path=IsChecked, Mode=TwoWay}"
               Placement="Right"
               PlacementTarget="{Binding ElementName=PART_PopPlacer}"
               PopupAnimation="Slide"
               AllowsTransparency="True"
               StaysOpen="False">
            <Border Background="{DynamicResource EnvironmentWindowBackground}"
                    BorderBrush="{DynamicResource Button.Static.Border}"
                    BorderThickness="1"
                    MouseEnter="Border_MouseEnter"
                    MouseLeave="Border_MouseLeave"
                    ContextMenuClosing="Border_ContextMenuClosing">
                <local:DistributionSelectorControl x:Name="SelectorControl"
                                                   Margin="5"
                                                   Width="300"
                                                   BackgroundColor="{DynamicResource EnvironmentWindowBackground}"
                                                   ShowAxisTitle="True"
                                                   ShowTickLines="True"
                                                   ShowAxisLabel="True"
                                                   ExpandPlot="False"
                                                   SelectedDistribution="{Binding ElementName=DistributionPopupSelector, Path=SelectedDistribution, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                   Distributions="{Binding ElementName=DistributionPopupSelector, Path=Distributions, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                   ShowPlot="{Binding ElementName=DistributionPopupSelector, Path=ShowPlot}"
                                                   ShowStatistics="{Binding ElementName=DistributionPopupSelector, Path=ShowStatistics}">
                </local:DistributionSelectorControl>
            </Border>
        </Popup>
    </Grid>
</UserControl>
