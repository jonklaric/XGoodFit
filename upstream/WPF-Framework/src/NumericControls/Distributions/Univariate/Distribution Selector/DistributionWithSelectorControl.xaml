<UserControl x:Class="NumericControls.Distributions.Univariate.DistributionWithSelectorControl" x:Name="DistributionWithSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NumericControls.Distributions.Univariate"
             xmlns:cntrls="clr-namespace:GenericControls;assembly=GenericControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <cntrls:ReverseBooleanConverter x:Key="ReverseBoolConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Edit button to toggle distribution selector popup -->
        <ToggleButton Grid.Column="0"
                      Name="PopupToggleButton"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      IsHitTestVisible="{Binding ElementName=DistributionPopup, Path=IsOpen, Converter={StaticResource ReverseBoolConverter}}"
                      Padding="0"
                      Background="Transparent"
                      BorderBrush="Transparent"
                      BorderThickness="0">
            <Rectangle Width="16" Height="16"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Fill="{DynamicResource EditIconBrush}"/>
        </ToggleButton>

        <!-- Display text for selected distribution -->
        <TextBlock Grid.Column="1"
                   Name="DistributionTextBlock"
                   VerticalAlignment="Center"
                   Margin="3,0,0,0"/>

        <!-- Hidden rectangle used for popup placement alignment -->
        <Rectangle x:Name="PART_PopPlacer"
                   Fill="Red"
                   Width="0"
                   Height="0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Focusable="False"
                   Visibility="Hidden"
                   IsHitTestVisible="False"/>

        <!-- Distribution selector popup -->
        <Popup Name="DistributionPopup"
               IsOpen="{Binding ElementName=PopupToggleButton, Path=IsChecked, Mode=TwoWay}"
               Placement="Right"
               PlacementTarget="{Binding ElementName=PART_PopPlacer}"
               PopupAnimation="Slide"
               AllowsTransparency="True"
               StaysOpen="False">
            <Border Background="{DynamicResource EnvironmentWindowBackground}"
                    BorderBrush="{DynamicResource Button.Static.Border}"
                    BorderThickness="1"
                    MouseEnter="Border_MouseEnter"
                    MouseLeave="Border_MouseLeave"
                    ContextMenuClosing="Border_ContextMenuClosing">
                <local:DistributionSelectorControl x:Name="SelectorControl"
                                                   Margin="5"
                                                   Width="300"
                                                   BackgroundColor="{DynamicResource EnvironmentWindowBackground}"
                                                   ShowAxisTitle="False"
                                                   ShowTickLines="False"
                                                   SelectedDistribution="{Binding ElementName=DistributionWithSelector, Path=SelectedDistribution, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                   Distributions="{Binding ElementName=DistributionWithSelector, Path=Distributions, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                   ShowPlot="{Binding ElementName=DistributionWithSelector, Path=ShowPlot}"
                                                   ShowStatistics="{Binding ElementName=DistributionWithSelector, Path=ShowStatistics}">
                </local:DistributionSelectorControl>
            </Border>
        </Popup>
    </Grid>
</UserControl>
