<cntrls:MetroWindow x:Class="OxyPlotControls.Demo.MainWindow" x:Name="TestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OxyPlotControls.Demo"
        xmlns:cntrls="clr-namespace:GenericControls;assembly=GenericControls"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:controls="clr-namespace:OxyPlotControls;assembly=OxyPlotControls"
        mc:Ignorable="d"
        Title="OxyPlotControls Demo - USACE Risk Management Center"
        Height="750" Width="1100" MinWidth="900" MinHeight="600"
        Style="{DynamicResource MetroWindowStyle}"
        Background="{DynamicResource EnvironmentWindowBackground}">

    <cntrls:MetroWindow.Resources>
        <ResourceDictionary>
            <!-- Demo section header style -->
            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
                <Setter Property="Margin" Value="0,10,0,8"/>
            </Style>

            <!-- Demo description style -->
            <Style x:Key="DescriptionStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
                <Setter Property="Opacity" Value="0.7"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <!-- Toolbar button style -->
            <Style x:Key="ToolbarButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource Button.Static.Background}"/>
                <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Button.Static.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Button.MouseOver.Background}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Button.MouseOver.Border}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Button.Pressed.Background}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </cntrls:MetroWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Bar with Theme Selection -->
        <Border Grid.Row="0"
                Background="{DynamicResource EnvironmentWindowBackground}"
                BorderBrush="{DynamicResource Button.Static.Border}"
                BorderThickness="0,0,0,1"
                Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="OxyPlotControls Library Demo"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource EnvironmentWindowText}"/>
                    <TextBlock Text=" - USACE Risk Management Center"
                               FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,2"
                               Foreground="{DynamicResource EnvironmentWindowText}" Opacity="0.6"/>
                </StackPanel>

                <!-- Theme Selection -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Theme:" VerticalAlignment="Center" Margin="0,0,12,0"
                               Foreground="{DynamicResource EnvironmentWindowText}"/>
                    <RadioButton x:Name="LightThemeRadio" Content="Light" GroupName="Theme"
                                 IsChecked="True" Checked="ThemeRadio_Checked" Margin="0,0,12,0"
                                 Foreground="{DynamicResource EnvironmentWindowText}"/>
                    <RadioButton x:Name="BlueThemeRadio" Content="Blue" GroupName="Theme"
                                 Checked="ThemeRadio_Checked" Margin="0,0,12,0"
                                 Foreground="{DynamicResource EnvironmentWindowText}"/>
                    <RadioButton x:Name="DarkThemeRadio" Content="Dark" GroupName="Theme"
                                 Checked="ThemeRadio_Checked"
                                 Foreground="{DynamicResource EnvironmentWindowText}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1"
                Background="{DynamicResource EnvironmentWindowBackground}"
                BorderBrush="{DynamicResource Button.Static.Border}"
                BorderThickness="0,0,0,1"
                Padding="15,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Settings Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Name="SaveSettingsButton"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="SaveSettingsButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Save Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Name="LoadSettingsButton"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="LoadSettingsButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Load Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Series Type Selector -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0">
                    <TextBlock Text="Series Type:" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource EnvironmentWindowText}"/>
                    <ComboBox x:Name="Combobox1"
                              Width="200" VerticalContentAlignment="Center"
                              SelectionChanged="ComboBox_SelectionChanged"
                              Style="{DynamicResource OxyComboBoxStyle}">
                        <ComboBoxItem>Line Series</ComboBoxItem>
                        <ComboBoxItem>Line Series (Bound)</ComboBoxItem>
                        <ComboBoxItem>Scatter Series</ComboBoxItem>
                        <ComboBoxItem>Scatter Series (Bound)</ComboBoxItem>
                        <ComboBoxItem>Histogram Series</ComboBoxItem>
                        <ComboBoxItem>Histogram Series (Bound)</ComboBoxItem>
                        <ComboBoxItem>Column Series</ComboBoxItem>
                        <ComboBoxItem>Column Series (Bound)</ComboBoxItem>
                        <ComboBoxItem>Bar Series</ComboBoxItem>
                        <ComboBoxItem>Bar Series (Bound)</ComboBoxItem>
                        <ComboBoxItem>Box Plot Series</ComboBoxItem>
                        <ComboBoxItem>Box Plot Series (Bound)</ComboBoxItem>
                        <ComboBoxItem>Area Series</ComboBoxItem>
                        <ComboBoxItem>Area Series (Bound)</ComboBoxItem>
                        <ComboBoxItem>Heat Map Series</ComboBoxItem>
                        <ComboBoxItem>Heat Map Series (Bound)</ComboBoxItem>
                        <ComboBoxItem>Scatter Error Series</ComboBoxItem>
                        <ComboBoxItem>Scatter Error Series (Bound)</ComboBoxItem>
                        <ComboBoxItem>Date Time Series</ComboBoxItem>
                        <ComboBoxItem>Two Color Line Series</ComboBoxItem>
                        <ComboBoxItem>Three Color Line Series</ComboBoxItem>
                        <ComboBoxItem>Pie Series</ComboBoxItem>
                        <ComboBoxItem>Candlestick Series</ComboBoxItem>
                        <ComboBoxItem>Stair Step Series</ComboBoxItem>
                        <ComboBoxItem>Stem Series</ComboBoxItem>
                        <ComboBoxItem>100K Line Series (Linear)</ComboBoxItem>
                        <ComboBoxItem>100K Line Series (Log)</ComboBoxItem>
                        <ComboBoxItem>100K Scatter Series (Linear)</ComboBoxItem>
                        <ComboBoxItem>100K Scatter Series (Log)</ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <!-- Rendering Backend & Benchmark -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Backend:" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource EnvironmentWindowText}"/>
                    <ComboBox x:Name="BackendComboBox"
                              Width="140" VerticalContentAlignment="Center"
                              SelectionChanged="BackendComboBox_SelectionChanged"
                              Style="{DynamicResource OxyComboBoxStyle}">
                        <ComboBoxItem IsSelected="True">Canvas</ComboBoxItem>
                        <ComboBoxItem>DrawingVisual</ComboBoxItem>
                    </ComboBox>
                    <Button Name="ReRenderButton"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="ReRenderButton_Click"
                            Margin="12,0,0,0">
                        <TextBlock Text="Re-render" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="280" MinWidth="250"/>
            </Grid.ColumnDefinitions>

            <!-- Plot Area -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource Button.Static.Border}"
                    BorderThickness="1">
                <Grid x:Name="PlotHostGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Canvas Name="TestCanvas" Grid.Column="0"/>

                    <oxy:Plot Name="TestPlot"
                              Grid.Column="0"
                              BorderBrush="Transparent"
                              BorderThickness="0"
                              SnapsToDevicePixels="True"
                              Title="Test Title"
                              IsLegendVisible="True"
                              LegendPosition="RightBottom"
                              Margin="5"/>

                    <controls:OxyPlotToolbar
                        Name="OxyPlotToolBar"
                        Plot="{Binding ElementName=TestPlot, Mode=OneTime}"
                        ToolBarOrientation="Vertical"
                        Grid.Column="1"
                        Margin="4,4,4,4"
                        VerticalAlignment="Top"
                        PropertiesCalled="OxyPlotToolBar_PropertiesCalled"/>
                </Grid>
            </Border>

            <!-- GridSplitter -->
            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          Cursor="SizeWE"/>

            <!-- Properties Panel -->
            <Border Grid.Column="2"
                    BorderBrush="{DynamicResource Button.Static.Border}"
                    BorderThickness="1"
                    Background="{DynamicResource PropertyGrid.Content.Background}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Properties Header -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource EnvironmentWindowBackground}"
                            BorderBrush="{DynamicResource Button.Static.Border}"
                            BorderThickness="0,0,0,1"
                            Padding="10,5">
                        <TextBlock Text="Plot Properties"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource EnvironmentWindowText}"/>
                    </Border>

                    <!-- Properties Control -->
                    <controls:OxyPlotPropertiesControl
                        Grid.Row="1"
                        Name="PropertiesControl"
                        ShowCloseButton="True"
                        Plot="{Binding ElementName=TestPlot, Mode=OneTime}"
                        ClosePropertiesCalled="PropertiesControl_ClosePropertiesCalled"
                        Margin="5,0"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="3"
                Background="{DynamicResource EnvironmentWindowBackground}"
                BorderBrush="{DynamicResource Button.Static.Border}"
                BorderThickness="0,1,0,0"
                Padding="15,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="OxyPlotControls Demo Application"
                           Foreground="{DynamicResource EnvironmentWindowText}"
                           Opacity="0.6"
                           FontSize="11"/>


                <TextBlock x:Name="RenderTimeLabel"
                           Grid.Column="1"
                           HorizontalAlignment="Center"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}"/>

                <TextBlock x:Name="PropertyChangedLabel"
                           Grid.Column="2"
                           HorizontalAlignment="Right"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"/>
            </Grid>
        </Border>
    </Grid>
</cntrls:MetroWindow>
