<!-- OxyPlotControls - Modern C# WPF Controls for OxyPlot -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>OxyPlotControls</RootNamespace>
    <AssemblyName>OxyPlotControls</AssemblyName>
    <NoWarn>$(NoWarn);CA1416;CS0618</NoWarn>

    <IsWpfFrameworkLibrary>true</IsWpfFrameworkLibrary>
    <PackageId>RMC.OxyPlotControls</PackageId>
    <Title>OxyPlotControls</Title>
    <Description>WPF controls for configuring and interacting with OxyPlot charts. Provides property editors for plot settings, axes, series, annotations, and legends; a toolbar with pan/zoom/annotation/export; and an image export dialog.</Description>
    <PackageTags>wpf; oxyplot; charting; plotting; toolbar; property-editor; usace-rmc</PackageTags>
  </PropertyGroup>

  <!-- Resource files -->
  <ItemGroup>
    <Resource Include="Resources\*.cur" />
    <Resource Include="Resources\*.png" />
    <Resource Include="Resources\*.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GenericControls\GenericControls.csproj" />
    <ProjectReference Include="..\Themes\Themes.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DatabaseManager\DatabaseManager.csproj" />
    <ProjectReference Include="..\OxyPlot\OxyPlot\OxyPlot.csproj" />
    <ProjectReference Include="..\OxyPlot\OxyPlot.Wpf\OxyPlot.Wpf.csproj" />
    <ProjectReference Include="..\OxyPlot\OxyPlot.Wpf.Shared\OxyPlot.Wpf.Shared.csproj" />
  </ItemGroup>
</Project>