<UserControl x:Class="OxyPlotControls.OxyPlotToolbar" x:Name="OxyToolBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:OxyPlotControls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="80">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/IconDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Background="Transparent" Orientation="{Binding ElementName=OxyToolBar, Path=ToolBarOrientation, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
        <RadioButton x:Name="PointerButton" Style="{StaticResource {x:Static ToolBar.RadioButtonStyleKey}}" Margin="1,1,1,2" Padding="0" ToolTip="Track Data" Click="PointerButton_Click" IsChecked="True">
            <Viewbox Width="{Binding ElementName=OxyToolBar, Path=IconSize}" Height="{Binding ElementName=OxyToolBar, Path=IconSize}">
                <ContentControl Padding="0" Content="{StaticResource PointerIcon}"/>
            </Viewbox>
        </RadioButton>
        <RadioButton Name="PanButton" Style="{StaticResource {x:Static ToolBar.RadioButtonStyleKey}}" Margin="1,1,1,2" Padding="0" ToolTip="Pan" Click="PanButton_Click">
            <Viewbox Width="{Binding ElementName=OxyToolBar, Path=IconSize}" Height="{Binding ElementName=OxyToolBar, Path=IconSize}">
                <ContentControl Padding="0" Content="{StaticResource PanHandIcon}"/>
            </Viewbox>
        </RadioButton>
        <RadioButton x:Name="ZoomButton" Style="{StaticResource {x:Static ToolBar.RadioButtonStyleKey}}" Margin="1,1,1,2" Padding="0" ToolTip="Zoom In" Click="ZoomButton_Click">
            <Viewbox Width="{Binding ElementName=OxyToolBar, Path=IconSize}" Height="{Binding ElementName=OxyToolBar, Path=IconSize}">
                <ContentControl Padding="0" Content="{StaticResource ZoomInIcon}" />
            </Viewbox>
        </RadioButton>
        <Button x:Name="ZoomAllButton" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Margin="1,1,1,2" Padding="0" ToolTip="Zoom Full Extents" Click="ZoomAllButton_Click">
            <Viewbox Width="{Binding ElementName=OxyToolBar, Path=IconSize}" Height="{Binding ElementName=OxyToolBar, Path=IconSize}">
                <ContentControl Padding="0" Content="{StaticResource ZoomAllIcon}" />
            </Viewbox>
        </Button>
        <Button x:Name="AddAnnotationToggleButton" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Margin="1,1,1,2" Padding="0" ToolTip="Add Annotation" Click="AddAnnotationToggleButton_Click">
            <Viewbox Width="{Binding ElementName=OxyToolBar, Path=IconSize}" Height="{Binding ElementName=OxyToolBar, Path=IconSize}">
                <ContentControl Padding="0" Content="{StaticResource PlusIcon}" />
            </Viewbox>
        </Button>
        <Button x:Name="SaveImageButton" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Margin="1,1,1,2" Padding="0" ToolTip="Save Plot Image" Click="SaveImageButton_Click">
            <Viewbox Width="{Binding ElementName=OxyToolBar, Path=IconSize}" Height="{Binding ElementName=OxyToolBar, Path=IconSize}">
                <ContentControl Padding="0" Content="{StaticResource CameraIcon}" />
            </Viewbox>
        </Button>
        <Button x:Name="ExportDataButton" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Margin="1,1,1,2" Padding="0" ToolTip="Export Series Data" Click="ExportDataButton_Click">
            <Viewbox Width="{Binding ElementName=OxyToolBar, Path=IconSize}" Height="{Binding ElementName=OxyToolBar, Path=IconSize}">
                <ContentControl Padding="0" Content="{StaticResource ExportTableIcon}" />
            </Viewbox>
        </Button>
        <Button x:Name="PropertiesButton" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Margin="1,1,1,2" Padding="0" Focusable="False" ToolTip="Plot Properties" Click="PropertiesButton_Click">
            <Viewbox Width="{Binding ElementName=OxyToolBar, Path=IconSize}" Height="{Binding ElementName=OxyToolBar, Path=IconSize}">
                <ContentControl Padding="0" Content="{StaticResource PropertiesIcon}" />
            </Viewbox>
        </Button>
    </StackPanel>
</UserControl>
