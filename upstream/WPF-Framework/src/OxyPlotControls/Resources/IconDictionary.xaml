<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ╔═══════════════════════════════════════════════════════════════════════════════╗
    ║  OxyPlotControls Icon Dictionary                                              ║
    ╠═══════════════════════════════════════════════════════════════════════════════╣
    ║  Vector icons specific to OxyPlot charting controls.                          ║
    ║  Extends GenericControls icons for shared action icons.                       ║
    ║                                                                               ║
    ║  INHERITED ICONS (from GenericControls):                                      ║
    ║  DeleteIcon, RunIcon, StopIcon, BrowseIcon, DownloadIcon                      ║
    ║                                                                               ║
    ║  TOOLBAR ICONS:                                                               ║
    ║  • PointerIcon         - Mouse cursor for track data mode                     ║
    ║  • ClosePropertiesIcon - Back arrow for closing properties panel              ║
    ║  • ZoomInIcon          - Magnifying glass with plus                           ║
    ║  • ZoomAllIcon         - Fit all content in view                              ║
    ║  • PlusIcon            - Generic plus/add                                     ║
    ║  • CameraIcon          - Screenshot/capture                                   ║
    ║  • PropertiesIcon      - Settings gear/cog                                    ║
    ║  • PanHandIcon         - Pan/drag hand cursor                                 ║
    ║  • ExportTableIcon     - Export data to table                                 ║
    ║                                                                               ║
    ║  ANNOTATION ICONS:                                                            ║
    ║  • ArrowAnnotationIcon         - Arrow pointing to data                       ║
    ║  • TextAnnotationIcon          - Text label on chart                          ║
    ║  • VerticalLineAnnotationIcon  - Vertical line marker                         ║
    ║  • HorizontalLineAnnotationIcon - Horizontal line marker                      ║
    ║  • RectangleAnnotationIcon     - Rectangle highlight                          ║
    ║  • EllipseAnnotationIcon       - Ellipse/circle highlight                     ║
    ║  • PointAnnotationIcon         - Point/dot marker                             ║
    ║  • PolygonAnnotationIcon       - Closed polygon shape                         ║
    ║  • PolylineAnnotationIcon      - Open polyline path                           ║
    ║                                                                               ║
    ║  THEME SUPPORT:                                                               ║
    ║  Icons use DynamicResource bindings for theme-aware colors:                   ║
    ║  • EnvironmentWindowText - Main icon stroke/fill (adapts to light/dark)       ║
    ║  • TextBox.Static.Background - Background fill for document icons             ║
    ║                                                                               ║
    ║  USAGE:                                                                       ║
    ║  <ContentControl Content="{StaticResource PointerIcon}"/>                     ║
    ║                                                                               ║
    ║  NOTE: All icons use x:Shared="False" to allow multiple instances.            ║
    ╚═══════════════════════════════════════════════════════════════════════════════╝
    -->

    <!-- Merge with GenericControls for shared action icons -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/GenericControls;component/Resources/IconDictionary.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- TOOLBAR ICONS                                                               -->
    <!-- Icons for the OxyPlot toolbar                                               -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Pointer/Cursor Icon - Mouse cursor arrow for track data mode -->
    <Viewbox x:Key="PointerIcon" Width="16" Height="16" x:Shared="False">
        <Grid Width="16" Height="16">
            <Path Data="M 2,1 L 2,14 L 5.5,10.5 L 8.5,15.5 L 10.5,14.5 L 7.5,9.5 L 12,9.5 Z"
                  Fill="Transparent"
                  Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1"
                  StrokeLineJoin="Round"/>
        </Grid>
    </Viewbox>

    <!-- Close/Back Arrow Icon - For closing properties panel -->
    <Viewbox x:Key="ClosePropertiesIcon" Width="16" Height="16" x:Shared="False">
        <Grid Width="16" Height="16">
            <Path Data="M 10,3 L 5,8 L 10,13 M 5,8 L 15,8"
                  Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="2"
                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Grid>
    </Viewbox>

    <!-- Zoom In Icon - Magnifying glass with plus -->
    <Viewbox x:Key="ZoomInIcon" Width="16" Height="16" x:Shared="False">
        <Canvas Width="64" Height="64">
            <Ellipse Canvas.Left="3.5" Canvas.Top="3.5" Width="43" Height="43" StrokeThickness="5" Stroke="{DynamicResource EnvironmentWindowText}"/>
            <Path StrokeThickness="5" Stroke="{DynamicResource EnvironmentWindowText}" Data="F1 M 25 14.5000 V 35.5" />
            <Path StrokeThickness="5" Stroke="{DynamicResource EnvironmentWindowText}" Data="F1 M 35.5 25 H 14.5" />
            <Path Fill="{DynamicResource EnvironmentWindowText}" Data="F1 M 52 52 33 44.9 44.9 33 Z" />
            <Path StrokeThickness="7" Stroke="{DynamicResource EnvironmentWindowText}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="F0 m 41.5 41.5 18 18" />
        </Canvas>
    </Viewbox>

    <!-- Zoom All Icon - Fit all content in view -->
    <Viewbox x:Key="ZoomAllIcon" Width="16" Height="16" x:Shared="False">
        <Canvas Width="16" Height="16">
            <Path StrokeThickness="2" Stroke="{DynamicResource EnvironmentWindowText}" Data="F1 m 14.75 11.375 v 3.375 h -3.375 m -6.75 0 H 1.25 v -3.375 m 0 -6.75 V 1.25 h 3.375 m 6.75 0 h 3.375 v 3.375" />
            <Path StrokeThickness="1" Stroke="{DynamicResource EnvironmentWindowText}" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="F1 m 9.5 3.2573844 -1.5 0 0 3.4926156 0 -3.4926156 -1.5 0 1.5 -2.5073844 z" />
            <Path StrokeThickness="1" Stroke="{DynamicResource EnvironmentWindowText}" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="F1 m 12.742616 9.5 0 -1.5 L 9.25 8 l 3.492616 0 0 -1.5 L 15.25 8 z" />
            <Path StrokeThickness="1" Stroke="{DynamicResource EnvironmentWindowText}" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="F1 m 6.5 12.742615 1.4999999 0 0 -3.4926153 0 3.4926153 1.5 0 -1.5 2.507385 z" />
            <Path StrokeThickness="1" Stroke="{DynamicResource EnvironmentWindowText}" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="F1 m 3.2573844 6.5 0 1.5 3.4926161 0 -3.4926161 0 0 1.5 L 0.75 8 z" />
        </Canvas>
    </Viewbox>

    <!-- Plus Icon - Generic add/plus -->
    <Viewbox x:Key="PlusIcon" Width="16" Height="16" x:Shared="False"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             RenderOptions.EdgeMode="Aliased" RenderOptions.BitmapScalingMode="HighQuality">
        <Canvas Width="16" Height="16">
            <Path StrokeThickness="3" Stroke="{DynamicResource EnvironmentWindowText}" Data="F0 M 2 8 H 14" />
            <Path StrokeThickness="3" Stroke="{DynamicResource EnvironmentWindowText}" Data="F0 M 8 2 V 14" />
        </Canvas>
    </Viewbox>

    <!-- Camera Icon - Screenshot/capture -->
    <Viewbox x:Key="CameraIcon" Width="16" Height="16" x:Shared="False">
        <Canvas Width="16" Height="16">
            <Path Fill="{DynamicResource EnvironmentWindowText}"
                  Data="F0 M 5.40625 1.828125 C 5.2435365 1.828125 5.1126068 1.9997109 5.03125 2.140625 C 4.7248392 2.671344 4.09375 3.734375 4.09375 3.734375 L 2.4375 3.734375 C 1.5394159 3.734375 0 5.1192214 0 6.265625 L 0 12.015625 C 0 13.322471 1.2946973 14.734375 2.40625 14.734375 L 7.96875 14.734375 L 13.53125 14.734375 C 14.642803 14.734375 16 13.322471 16 12.015625 L 16 6.265625 C 16 5.1192214 14.398084 3.734375 13.5 3.734375 L 11.84375 3.734375 C 11.84375 3.734375 11.212661 2.671344 10.90625 2.140625 C 10.82489 1.9997109 10.693963 1.828125 10.53125 1.828125 L 7.96875 1.828125 L 5.40625 1.828125 z M 2.4277344 4.7910156 A 0.75 0.75 0 0 1 3.1777344 5.5410156 A 0.75 0.75 0 0 1 2.4277344 6.2910156 A 0.75 0.75 0 0 1 1.6777344 5.5410156 A 0.75 0.75 0 0 1 2.4277344 4.7910156 z M 8 4.8203125 C 10.421762 4.8203125 12.400391 6.7989415 12.400391 9.2207031 C 12.400391 11.642465 10.421762 13.619141 8 13.619141 C 5.5782383 13.619141 3.5996094 11.642465 3.5996094 9.2207031 C 3.5996094 6.7989415 5.5782383 4.8203125 8 4.8203125 z M 8 6.2207031 C 6.3348545 6.2207031 5 7.5555576 5 9.2207031 C 5 10.885849 6.3348545 12.220703 8 12.220703 C 9.6651455 12.220703 11 10.885849 11 9.2207031 C 11 7.5555576 9.6651455 6.2207031 8 6.2207031 z " />
        </Canvas>
    </Viewbox>

