        </Canvas>
    </Viewbox>

    <!-- Pan Hand Icon - Drag/pan cursor -->
    <Viewbox x:Key="PanHandIcon" Width="16" Height="16" x:Shared="False">
        <Canvas Width="16" Height="16">
            <Path Fill="Transparent" StrokeThickness="1" Stroke="{DynamicResource EnvironmentWindowText}" StrokeLineJoin="Bevel"
                  Data="F0 M 6 15.875 V 13.75 L 3.1875 11.375 3.125 10.25 1.5 8.6875 1.625 7.25 2.6875 6.625 3.875 7.375 4.6875 8.6875 5 8.5625 5.0625 6.9375 4 5.0625 3.25 4.0625 3.375 2.8125 4.125 2.25 5.0625 2.3125 5.625 3.1875 6.4375 4.8125 6.7610485 5.7787039 6.875 5.875 7.125 5.75 V 2.125 L 7.4375 1.5 h 1.25 l 0.5 0.375 0.25 0.625 V 5.678807 L 9.6418981 5.881932 9.8462961 5.678807 9.8459709 3.0669417 10.534122 2.25 H 11.625 l 0.75 0.625 v 3.75 L 12.61016 6.6635631 13.625 4.6875 14.25 4.125 14.6875 4.375 14.8125 5.6875 14.6875 7.25 14.25 8.875 13.5625 10.8125 12.5 13.1875 V 15.75" />
        </Canvas>
    </Viewbox>

    <!-- Export Table Icon - Export data to table format -->
    <Viewbox x:Key="ExportTableIcon" Width="16" Height="16" x:Shared="False">
        <Canvas Width="16" Height="16">
            <Path Fill="{DynamicResource EnvironmentWindowText}" Data="F1 M 4.25 4.5454547 6.75 2.0000001 H 2.006 C 0.898 2.0000001 0 3.1454547 0 4.5352729 V 13.464727 C 0 14.864728 0.897 16 2.006 16 h 9.988 C 13.102 16 14 14.854546 14 13.464727 V 8.8727275 l -2 2.0363635 v 2.545455 H 2 V 4.5454547 Z" />
            <Path Fill="{DynamicResource EnvironmentWindowText}" Data="F1 M 11.013712 2.4101745 C 7.4844178 2.4528431 4 6.2186639 4 11 5.6893543 8.9884744 7.6898529 7.1768817 11.013712 7.3231746 V 9.7528544 L 16 4.8764274 11.013712 2.65318e-7 Z" />
        </Canvas>
    </Viewbox>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- CONTEXT MENU ICONS                                                          -->
    <!-- Icons for chart context menu actions                                        -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Edit Textbox Icon - For editing text in-place -->
    <Viewbox x:Key="EditTextboxIcon" Width="16" Height="16" x:Shared="False" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
        <Rectangle Width="16" Height="16">
            <Rectangle.Fill>
                <DrawingBrush>
                    <DrawingBrush.Drawing>
                        <DrawingGroup>
                            <DrawingGroup.Children>
                                <GeometryDrawing Brush="#00FFFFFF" Geometry="F1M16,16L0,16 0,0 16,0z" />
                                <GeometryDrawing Brush="#00FFFFFF" Geometry="F1M10.9998,-0.000199999999999534L10.9998,3.0008 5.0008,3.0008 5.0008,-0.000199999999999534 -0.000199999999999534,-0.000199999999999534 -0.000199999999999534,4.9998 3.9998,4.9998 3.9998,6.9998 6.0008,6.9998 6.0008,13.9998 9.9998,13.9998 9.9998,6.9998 11.9998,6.9998 11.9998,4.9998 15.9998,4.9998 15.9998,-0.000199999999999534z" />
                                <GeometryDrawing Brush="#00FFFFFF" Geometry="F1M0,16L5,16 5,11 0,11z" />
                                <GeometryDrawing Brush="#00FFFFFF" Geometry="F1M11,16L16,16 16,11 11,11z" />
                                <GeometryDrawing Brush="{DynamicResource EnvironmentWindowText}" Geometry="F1M3,3L2,3 2,2 3,2z M1,4L4,4 4,1 1,1z" />
                                <GeometryDrawing Brush="{DynamicResource EnvironmentWindowText}" Geometry="F1M14,3L13,3 13,2 14,2z M12,4L15,4 15,1 12,1z" />
                                <GeometryDrawing Brush="{DynamicResource EnvironmentWindowText}" Geometry="F1M3,14L2,14 2,13 3,13z M1,15L4,15 4,12 1,12z" />
                                <GeometryDrawing Brush="{DynamicResource EnvironmentWindowText}" Geometry="F1M14,14L13,14 13,13 14,13z M12,15L15,15 15,12 12,12z" />
                                <GeometryDrawing Brush="{DynamicResource EnvironmentWindowText}" Geometry="F1M5,4L5,6 7,6 7,13 9,13 9,6 11,6 11,4z" />
                                <GeometryDrawing Brush="#00FFFFFF" Geometry="F1M2,3L3,3 3,1.999 2,1.999z" />
                                <GeometryDrawing Brush="#00FFFFFF" Geometry="F1M13,3L14.001,3 14.001,1.999 13,1.999z" />
                                <GeometryDrawing Brush="#00FFFFFF" Geometry="F1M2,14L3,14 3,13 2,13z" />
                                <GeometryDrawing Brush="#00FFFFFF" Geometry="F1M13,14L14.001,14 14.001,13 13,13z" />
                            </DrawingGroup.Children>
                        </DrawingGroup>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
        </Rectangle>
    </Viewbox>

    <!-- Format Icon - For formatting/properties dialogs -->
    <Viewbox x:Key="FormatIcon" Width="16" Height="16" x:Shared="False" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
        <Rectangle Width="16" Height="16">
            <Rectangle.Fill>
                <DrawingBrush>
                    <DrawingBrush.Drawing>
                        <DrawingGroup>
                            <DrawingGroup.Children>
                                <GeometryDrawing Brush="#00FFFFFF" Geometry="F1M16,16L0,16 0,0 16,0z" />
                                <GeometryDrawing Brush="#00FFFFFF" Geometry="F1M8,5L7,4 1,10 6,15 12,9 11,7 15,3 13,1z" />
                                <GeometryDrawing Brush="{DynamicResource EnvironmentWindowText}" Geometry="F1M14,3L13,2 9,6 10,7z M11,9L7,5 6,6 10,10z M6,14L2,10 5,7 9,11z" />
                            </DrawingGroup.Children>
                        </DrawingGroup>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
        </Rectangle>
    </Viewbox>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- ANNOTATION ICONS                                                            -->
    <!-- Icons for chart annotation types                                            -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Arrow Annotation Icon - Arrow pointing from one point to another -->
    <Viewbox x:Key="ArrowAnnotationIcon" Width="16" Height="16" x:Shared="False">
        <Grid Width="16" Height="16">
            <Path Data="M 2,14 L 12,4" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1.5" StrokeStartLineCap="Round"/>
            <Path Data="M 9,2 L 14,2 L 14,7" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
            <Path Data="M 14,2 L 10,6" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Grid>
    </Viewbox>

    <!-- Text Annotation Icon - Text label symbol -->
    <Viewbox x:Key="TextAnnotationIcon" Width="16" Height="16" x:Shared="False">
        <Grid Width="16" Height="16">
            <Rectangle Width="14" Height="12" Margin="1,2,1,2" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1" Fill="Transparent" RadiusX="1" RadiusY="1"/>
            <Path Data="M 5,11 L 8,5 L 11,11 M 6,9 L 10,9" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Grid>
    </Viewbox>

    <!-- Vertical Line Annotation Icon -->
    <Viewbox x:Key="VerticalLineAnnotationIcon" Width="16" Height="16" x:Shared="False">
        <Grid Width="16" Height="16">
            <Path Data="M 8,1 L 8,15" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Grid>
    </Viewbox>

    <!-- Horizontal Line Annotation Icon -->
    <Viewbox x:Key="HorizontalLineAnnotationIcon" Width="16" Height="16" x:Shared="False">
        <Grid Width="16" Height="16">
            <Path Data="M 1,8 L 15,8" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Grid>
    </Viewbox>

    <!-- Rectangle Annotation Icon -->
    <Viewbox x:Key="RectangleAnnotationIcon" Width="16" Height="16" x:Shared="False">
        <Grid Width="16" Height="16">
            <Rectangle Width="12" Height="10" Margin="2,3,2,3" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1.5" Fill="Transparent"/>
        </Grid>
    </Viewbox>

    <!-- Ellipse Annotation Icon -->
    <Viewbox x:Key="EllipseAnnotationIcon" Width="16" Height="16" x:Shared="False">
        <Grid Width="16" Height="16">
            <Ellipse Width="12" Height="10" Margin="2,3,2,3" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1.5" Fill="Transparent"/>
        </Grid>
    </Viewbox>

    <!-- Point Annotation Icon - Dot/marker point -->
    <Viewbox x:Key="PointAnnotationIcon" Width="16" Height="16" x:Shared="False">
        <Grid Width="16" Height="16">
            <Ellipse Width="10" Height="10" Margin="3,3,3,3" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1.5" Fill="Transparent"/>
            <Ellipse Width="4" Height="4" Margin="6,6,6,6" Fill="{DynamicResource EnvironmentWindowText}"/>
        </Grid>
    </Viewbox>

    <!-- Polygon Annotation Icon - Closed multi-sided shape -->
    <Viewbox x:Key="PolygonAnnotationIcon" Width="16" Height="16" x:Shared="False">
        <Grid Width="16" Height="16">
            <Path Data="M 8,2 L 14,6 L 12,13 L 4,13 L 2,6 Z" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1.5" Fill="Transparent" StrokeLineJoin="Round"/>
        </Grid>
    </Viewbox>

    <!-- Polyline Annotation Icon - Open multi-segment line -->
    <Viewbox x:Key="PolylineAnnotationIcon" Width="16" Height="16" x:Shared="False">
        <Grid Width="16" Height="16">
            <Path Data="M 2,12 L 5,5 L 9,10 L 14,3" Stroke="{DynamicResource EnvironmentWindowText}" StrokeThickness="1.5" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Ellipse Width="3" Height="3" Margin="0.5,10.5,0,0" Fill="{DynamicResource EnvironmentWindowText}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Ellipse Width="3" Height="3" Margin="3.5,3.5,0,0" Fill="{DynamicResource EnvironmentWindowText}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Ellipse Width="3" Height="3" Margin="7.5,8.5,0,0" Fill="{DynamicResource EnvironmentWindowText}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Ellipse Width="3" Height="3" Margin="12.5,1.5,0,0" Fill="{DynamicResource EnvironmentWindowText}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        </Grid>
    </Viewbox>

</ResourceDictionary>
