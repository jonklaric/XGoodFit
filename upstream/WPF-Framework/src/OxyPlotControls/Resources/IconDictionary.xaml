            <Path Fill="{DynamicResource EnvironmentWindowText}" Data="F1 M 6.28125 0.1875 C 5.3447289 0.3915249 4.4691013 0.74994766 3.6875 1.25 C 4.1568062 1.5670571 4.46875 2.1097533 4.46875 2.71875 C 4.46875 3.6931447 3.6931447 4.46875 2.71875 4.46875 C 2.124744 4.46875 1.6009733 4.1686977 1.28125 3.71875 C 0.78408428 4.4957038 0.43098371 5.3594095 0.21875 6.28125 C 0.31406081 6.2653166 0.40016447 6.25 0.5 6.25 C 1.4743947 6.25 2.28125 7.0256053 2.28125 8 C 2.28125 8.9743947 1.4743947 9.75 0.5 9.75 C 0.38918257 9.75 0.29265428 9.7382933 0.1875 9.71875 C 0.39200833 10.651974 0.78274472 11.501138 1.28125 12.28125 C 1.6009733 11.831302 2.124744 11.53125 2.71875 11.53125 C 3.6931447 11.53125 4.46875 12.306855 4.46875 13.28125 C 4.46875 13.881814 4.1771403 14.431356 3.71875 14.75 C 4.4918148 15.240134 5.3577375 15.611309 6.28125 15.8125 C 6.2617067 15.707346 6.25 15.610817 6.25 15.5 C 6.25 14.525605 7.0256053 13.71875 8 13.71875 C 8.9743947 13.71875 9.75 14.525605 9.75 15.5 C 9.75 15.610817 9.7382933 15.707346 9.71875 15.8125 C 10.655271 15.608475 11.530899 15.250052 12.3125 14.75 C 11.843194 14.432943 11.53125 13.890247 11.53125 13.28125 C 11.53125 12.306855 12.306855 11.53125 13.28125 11.53125 C 13.875256 11.53125 14.399027 11.831302 14.71875 12.28125 C 15.215916 11.504296 15.569016 10.64059 15.78125 9.71875 C 15.685939 9.7346834 15.599836 9.75 15.5 9.75 C 14.525605 9.75 13.71875 8.9743947 13.71875 8 C 13.71875 7.0256053 14.525605 6.25 15.5 6.25 C 15.610817 6.25 15.707346 6.2617067 15.8125 6.28125 C 15.608475 5.3447289 15.250052 4.4691013 14.75 3.6875 C 14.432943 4.1568062 13.890247 4.46875 13.28125 4.46875 C 12.306855 4.46875 11.53125 3.6931447 11.53125 2.71875 C 11.53125 2.124744 11.831302 1.6009733 12.28125 1.28125 C 11.504296 0.78408428 10.64059 0.43098371 9.71875 0.21875 C 9.7346834 0.31406081 9.75 0.40016447 9.75 0.5 C 9.75 1.4743947 8.9743947 2.28125 8 2.28125 C 7.0256053 2.28125 6.25 1.4743947 6.25 0.5 C 6.25 0.38918257 6.2617067 0.29265428 6.28125 0.1875 z