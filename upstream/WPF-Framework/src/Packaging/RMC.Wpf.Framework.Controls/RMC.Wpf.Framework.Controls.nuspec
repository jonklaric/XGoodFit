    <file src="..\..\FrameworkUI\bin\$configuration$\net10.0-windows\FrameworkUI.dll" target="lib\net10.0-windows7.0" />
    <file src="..\..\FrameworkUI\bin\$configuration$\net10.0-windows\FrameworkUI.xml" target="lib\net10.0-windows7.0" />
