    <!-- Subtle hover effect -->
    <SolidColorBrush x:Key="DataGrid.Row.MouseOver.Background" Color="#333337"/>
    <!-- Grid lines that are visible but not distracting -->
    <SolidColorBrush x:Key="DataGrid.GridLines" Color="#3F3F46"/>
    <!-- Focus border with accent color -->
    <SolidColorBrush x:Key="DataGrid.Cell.Focus.Border" Color="#007ACC"/>
    <!-- Validation Error Colors - Optimized for dark theme visibility -->
    <SolidColorBrush x:Key="DataGrid.Cell.Error.Border" Color="#FF6B6B"/>
    <SolidColorBrush x:Key="DataGrid.Cell.Error.Background" Color="#4D2020"/>

    <!-- Expression Error Expander Colors - Bright red for dark backgrounds -->
    <SolidColorBrush x:Key="ExpressionError.Text" Color="#FF6B6B"/>
    <SolidColorBrush x:Key="ExpressionError.Glyph" Color="#FF6B6B"/>

