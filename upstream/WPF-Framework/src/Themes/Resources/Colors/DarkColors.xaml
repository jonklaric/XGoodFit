    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- DATAGRID - Enhanced for Dark Theme                                           -->
    <!-- Professional, modern appearance with excellent visibility                    -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="DataGrid.Static.Background" Color="#252526"/>
    <SolidColorBrush x:Key="DataGrid.Static.Border" Color="#3F3F46"/>
    <SolidColorBrush x:Key="DataGrid.Static.Foreground" Color="#F1F1F1"/>
    <!-- Header with subtle gradient for depth -->
    <Color x:Key="DataGrid.Header.Background">#3F3F46</Color>
    <Color x:Key="DataGrid.Header.GradientEnd">#2D2D30</Color>
    <SolidColorBrush x:Key="DataGrid.Header.Border" Color="#555558"/>
    <SolidColorBrush x:Key="DataGrid.Header.Foreground" Color="#F1F1F1"/>
    <SolidColorBrush x:Key="DataGrid.Header.MouseOver.Background" Color="#4E4E52"/>
    <SolidColorBrush x:Key="DataGrid.Header.Pressed.Background" Color="#007ACC"/>
    <Color x:Key="DataGrid.RowHeader.Background">#333337</Color>
    <!-- Row colors with alternating for readability -->
    <SolidColorBrush x:Key="DataGrid.Row.Background" Color="#252526"/>
    <SolidColorBrush x:Key="DataGrid.Row.Alternating.Background" Color="#2D2D30"/>
    <SolidColorBrush x:Key="DataGrid.Row.Foreground" Color="#F1F1F1"/>
    <!-- Vibrant selection colors that pop -->
