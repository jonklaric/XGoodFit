<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    Dark Theme Color Definitions
    Visual Studio 2013 Dark Theme Color Palette

    This resource dictionary contains ONLY color brush definitions.
    Control templates are loaded separately from the Controls folder.
    All controls using DynamicResource bindings will automatically
    update when this dictionary is swapped at runtime.

    This theme is optimized for low-light environments and extended
    screen use. The DataGrid colors have been specifically enhanced
    for excellent visibility and modern aesthetics.
    -->

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- ACCENT COLORS                                                                -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <Color x:Key="AccentColor">#007ACC</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#007ACC"/>
    <SolidColorBrush x:Key="FocusStyle.Brush" Color="#F1F1F1"/>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <!-- ENVIRONMENT / GENERAL                                                        -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="EnvironmentWindowText" Color="#FFF1F1F1"/>
    <SolidColorBrush x:Key="EnvironmentWindowBackground" Color="#FF2D2D30"/>
    <SolidColorBrush x:Key="PlotWindowBackground" Color="#FF5A5A5E"/>
    <SolidColorBrush x:Key="EnvironmentToolWindowText" Color="#FFF1F1F1"/>
    <SolidColorBrush x:Key="EnvironmentToolWindowDisabledText" Color="#FF656565"/>

    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
