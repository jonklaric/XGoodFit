<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Themes">

    <local:CutoffConverter x:Key="CutoffConverter" Cutoff="50" />

    <Style x:Key="HorizontalGridSplitterStyle" TargetType="{x:Type GridSplitter}">
        <Setter Property="Background" Value="{DynamicResource EnvironmentWindowBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBorder}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridSplitter}">
                    <Border BorderThickness="{TemplateBinding BorderThickness}">
                        <Canvas x:Name="GridCanvas" RenderOptions.EdgeMode="Aliased" UseLayoutRounding="True" Height="6" VerticalAlignment="Center" Width="50" HorizontalAlignment="Center">
                            <Line X1="0" X2="50" Y1="0" Y2="0" Stroke="{DynamicResource GridSplitter.Handle.Light}" StrokeThickness="1"/>
                            <Line X1="0" X2="50" Y1="1" Y2="1" Stroke="{DynamicResource GridSplitter.Handle.Dark}" StrokeThickness="1"/>
                            <Line X1="0" X2="50" Y1="4" Y2="4" Stroke="{DynamicResource GridSplitter.Handle.Light}" StrokeThickness="1"/>
                            <Line X1="0" X2="50" Y1="5" Y2="5" Stroke="{DynamicResource GridSplitter.Handle.Dark}" StrokeThickness="1"/>
                        </Canvas>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Path=ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type Grid}}, Converter={StaticResource CutoffConverter}}">
                            <DataTrigger.Value>true</DataTrigger.Value>
                            <Setter TargetName="GridCanvas" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type Grid}}, Converter={StaticResource CutoffConverter}}">
                            <DataTrigger.Value>false</DataTrigger.Value>
                            <Setter TargetName="GridCanvas" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VerticalGridSplitterStyle" TargetType="{x:Type GridSplitter}">
        <Setter Property="Background" Value="{DynamicResource EnvironmentWindowBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBorder}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridSplitter}">
                    <Border BorderThickness="{TemplateBinding BorderThickness}">
                        <Canvas x:Name="GridCanvas" RenderOptions.EdgeMode="Aliased" UseLayoutRounding="True" Height="50" VerticalAlignment="Center" Width="6" HorizontalAlignment="Center">
                            <Line Y1="0" Y2="50" X1="0" X2="0" Stroke="{DynamicResource GridSplitter.Handle.Light}" StrokeThickness="1"/>
                            <Line Y1="0" Y2="50" X1="1" X2="1" Stroke="{DynamicResource GridSplitter.Handle.Dark}" StrokeThickness="1"/>
                            <Line Y1="0" Y2="50" X1="4" X2="4" Stroke="{DynamicResource GridSplitter.Handle.Light}" StrokeThickness="1"/>
                            <Line Y1="0" Y2="50" X1="5" X2="5" Stroke="{DynamicResource GridSplitter.Handle.Dark}" StrokeThickness="1"/>
                        </Canvas>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Path=ActualHeight, RelativeSource={RelativeSource AncestorType={x:Type Grid}}, Converter={StaticResource CutoffConverter}}">
                            <DataTrigger.Value>true</DataTrigger.Value>
                            <Setter TargetName="GridCanvas" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=ActualHeight, RelativeSource={RelativeSource AncestorType={x:Type Grid}}, Converter={StaticResource CutoffConverter}}">
                            <DataTrigger.Value>false</DataTrigger.Value>
                            <Setter TargetName="GridCanvas" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    
</ResourceDictionary>